         m_radio[i] = obj.m_radio[i];
     }
 
@@ -157,7 +158,9 @@ int dm_easy_mesh_t::commit_config(dm_easy_mesh_t& dm, em_commit_target_t target)
                     break;
                 }
             }
-            if (i == m_num_radios) { //New Radio
+            if (i == m_num_radios && m_num_radios >= EM_MAX_BANDS) {
+                em_printfout("Radio %s not added: %u radios already", target.params, m_num_radios);
+            } else if (i == m_num_radios) { //New Radio
                 m_radio[m_num_radios] = *(radio);
                 radio_cap = dm.get_radio_cap(mac);
                 if (radio_cap != NULL) {
@@ -290,6 +293,10 @@ int dm_easy_mesh_t::commit_config(em_cmd_t  *cmd)
                         break;
                     }
                     case dm_orch_type_em_insert:
+                        if (m_num_radios >= EM_MAX_BANDS) {
+                            em_printfout("Radio not inserted: %u radios already", m_num_radios);
+                            break;
+                        }
                         m_radio[m_num_radios] = cmd->m_data_model.m_radio[0];
                         m_num_radios++;
 
@@ -979,6 +986,10 @@ int dm_easy_mesh_t::decode_config_set_radio(em_subdoc_info_t *subdoc, const char
        		return EM_PARSE_ERR_GEN;
 		}
 		
+		if (m_num_radios >= EM_MAX_BANDS) {
+			em_printfout("RadioList has more than %u radios, the rest ignored", EM_MAX_BANDS);
+			break;
+		}
 		snprintf(parent, sizeof(em_long_string_t), "%s@%s", dev_mac_str, net_id);	
 		m_radio[m_num_radios].decode(radio_obj, parent);
 		m_num_radios++;
@@ -3725,8 +3736,11 @@ void dm_easy_mesh_t::reset()
     }
 }
 
+// Built from the network alone (dm_easy_mesh_t dm = *this in the controller's analyze
+// functions): the counts must start at zero like the default constructor's, or a copy of
+// this model reads as many radios as the stack happened to hold.
 dm_easy_mesh_t::dm_easy_mesh_t(const dm_network_t& net)
-    : m_wifi_data(nullptr)
+    : dm_easy_mesh_t()
 {
     memcpy(&m_device.m_device_info.id, &net.m_net_info.ctrl_id, sizeof(em_interface_t));
     memcpy(&m_device.m_device_info.backhaul_alid, &net.m_net_info.ctrl_id, sizeof(em_interface_t));
diff --git a/src/dm/dm_easy_mesh_list.cpp b/src/dm/dm_easy_mesh_list.cpp
index 21af7fd..c030d19 100644
--- a/src/dm/dm_easy_mesh_list.cpp
+++ b/src/dm/dm_easy_mesh_list.cpp
@@ -367,6 +367,10 @@ void dm_easy_mesh_list_t::put_radio(const char *key, const dm_radio_t *radio)
         }
 
         //em_printfout("Current Number of Radios: %d", dm->get_num_radios());
+        if (dm->get_num_radios() >= EM_MAX_BANDS) {
+            em_printfout("Radio %s not added: %u radios already", key, dm->get_num_radios());
+            return;
+        }
         dm->set_num_radios(dm->get_num_radios() + 1);
         pradio = dm->get_radio(dm->get_num_radios() - 1);
     }
