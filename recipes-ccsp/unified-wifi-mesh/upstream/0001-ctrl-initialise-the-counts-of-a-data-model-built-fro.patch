 src/dm/dm_easy_mesh.cpp             | 26 ++++++++++++++++++++------
 src/dm/dm_easy_mesh_list.cpp        |  4 ++++
 src/em/capability/em_capability.cpp |  4 ++++
 src/em/config/em_configuration.cpp  |  4 ++++
 5 files changed, 38 insertions(+), 9 deletions(-)

