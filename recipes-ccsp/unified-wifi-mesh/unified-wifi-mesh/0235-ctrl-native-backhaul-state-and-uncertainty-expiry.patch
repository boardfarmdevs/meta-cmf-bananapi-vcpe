+                em_printfout("Native backhaul state nodes=%zu aps=%zu candidates=%zu queried_stations=%zu uncertain=[%s] ambiguous=[%s] skipped=[nosta %u parent %u own %u channel %u serving %u route %u queried %u]",
+                    network.nodes.size(), network.aps.size(), network.candidates.size(), queried_stations,
+                    uncertain_agents.c_str(), ambiguous.c_str(), skipped[0], skipped[1], skipped[2], skipped[3],
+                    skipped[4], skipped[5], skipped[6]);
+                std::string table;
+                for (const auto &entry : network.aps)
+                    table += " " + backhaul_label(entry.first) + "@" + backhaul_label(entry.second.al) + "/" +
+                        std::to_string(entry.second.op_class) + "/" + std::to_string(entry.second.channel);
+                em_printfout("Native backhaul state aps:%s", table.c_str());
+                std::string stations;
+                for (const auto &entry : network.nodes) {
+                    const auto &station = entry.second;
+                    const auto route = em_backhaul::root_path(network, station.al, "", now);
+                    stations += " " + backhaul_label(station.al) + ">" + backhaul_label(station.parent_bssid) + "/" +
+                        std::to_string(station.serving.rcpi) + "/" +
+                        std::to_string(station.serving.observed ? now - station.serving.observed : -1) +
+                        (route.valid ? "/rooted" : "/unrooted");
+                }
+                em_printfout("Native backhaul state stations:%s", stations.c_str());
+            }
         }
     }
     for (auto &packet : outgoing) {
