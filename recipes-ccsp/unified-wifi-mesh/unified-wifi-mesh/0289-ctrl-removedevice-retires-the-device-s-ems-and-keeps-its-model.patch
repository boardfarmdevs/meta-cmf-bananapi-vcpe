+dm_easy_mesh_t *dm_easy_mesh_ctrl_t::unlink_device(const char *net_id, const unsigned char *al_mac)
+{
+    std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+    dm_easy_mesh_t *dm = m_data_model_list.get_data_model(net_id, al_mac);
+    if (dm == NULL) {
+        return NULL;
+    }
+    /* as retire_agent: its node first, since the topology holds the model's address */
+    if (g_network_topology != NULL) {
+        g_network_topology->remove(dm);
+    }
+    m_data_model_list.unlink_data_model(net_id, al_mac);
+    return dm;
+}
