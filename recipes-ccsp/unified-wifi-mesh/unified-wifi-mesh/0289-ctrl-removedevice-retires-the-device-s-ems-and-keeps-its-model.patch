+unsigned int em_ctrl_t::remove_device_ems(const char *net_id, const unsigned char *al_mac)
+{
+	dm_easy_mesh_t *dm = m_data_model.get_data_model(net_id, al_mac);
+	if (dm == NULL) {
+		return 0;
+	}
+	return retire_ems_of_model(dm, util::mac_to_string(al_mac));
+}
+
+void em_ctrl_t::remove_device(const char *net_id, const unsigned char *al_mac)
+{
+	const std::string al = util::mac_to_string(al_mac);
+	dm_easy_mesh_t *dm = m_data_model.get_data_model(net_id, al_mac);
+	if (dm == NULL) {
+		/* already gone (a RemoveDevice for a device retired meanwhile) */
+		em_printfout("RemoveDevice %s: no model to remove", al.c_str());
+		return;
+	}
+	const unsigned int ems = retire_ems_of_model(dm, al);
+	if (m_data_model.unlink_device(net_id, al_mac) != dm) {
+		return;
+	}
+	m_retired_models.push_back({dm, al, std::chrono::steady_clock::now()});
+	em_printfout("RemoveDevice %s: model %p out of the list and the topology, %u ems on it retired, freed in "
+		"%ld s at the earliest", al.c_str(), static_cast<void *>(dm), ems,
+		static_cast<long>(EM_AGENT_MODEL_KEPT.count()));
+	update_network_topology();
+	publish_network_topology();
+}
+
+bool em_ctrl_t::is_retired_model(const dm_easy_mesh_t *dm) const
+{
+	for (const retired_model_t &retired : m_retired_models) {
+		if (retired.dm == dm) {
+			return true;
+		}
+	}
+	return false;
+}
