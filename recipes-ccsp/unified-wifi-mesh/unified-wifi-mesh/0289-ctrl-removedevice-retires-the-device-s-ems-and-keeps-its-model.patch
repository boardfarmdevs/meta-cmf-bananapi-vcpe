+extern em_network_topo_t *g_network_topology;
+
+/* the controller with its topology publish counted, not sent: no bus in the unit build */
+class em_ctrl_removal_t : public em_ctrl_t {
+public:
+    unsigned int publishes = 0;
+    void publish_network_topology() override { publishes++; }
+};
+
+/* 0289: RemoveDevice of an agent with two radios. Each radio's em points at the agent's model:
+ * the em step retires both, not only the em that last set itself on the model (deleted at once
+ * before, under its own thread), and the model step takes the model out of the list and the
+ * network topology and keeps it with the retired models, not freed under the ems and the topology
+ * that pointed at it (ASan). A RemoveDevice for a device gone meanwhile changes nothing. */
+TEST(em_ctrl_t, remove_device_retires_every_em_and_keeps_the_model)
+{
+    __lsan_disable();
+    em_ctrl_removal_t ctrl;
+    ctrl.init("/tmp/test_config.db");
+    ctrl.orch_init();
+    /* the model list made here: init stops before the data model when the command socket finds
+     * no certificates, as in the unit build */
+    ctrl.get_dm_ctrl()->test_data_model_list().init(&ctrl);
+
+    const char *net_id = "OneWifiMesh";
+    const unsigned char ctrl_mac[6] = {0x02, 0x00, 0x00, 0x28, 0x09, 0x00};
+    const unsigned char agent_mac[6] = {0x02, 0x00, 0x00, 0x28, 0x09, 0x10};
+    em_interface_t ctrl_intf = {}, agent_intf = {};
+    strncpy(ctrl_intf.name, "eth0", sizeof(ctrl_intf.name) - 1);
+    memcpy(ctrl_intf.mac, ctrl_mac, sizeof(ctrl_intf.mac));
+    strncpy(agent_intf.name, "eth1", sizeof(agent_intf.name) - 1);
+    memcpy(agent_intf.mac, agent_mac, sizeof(agent_intf.mac));
+
+    dm_easy_mesh_t *ctrl_dm = ctrl.create_data_model(net_id, &ctrl_intf);
+    ASSERT_NE(ctrl_dm, nullptr);
+    ctrl.init_network_topology();
+    ASSERT_NE(g_network_topology, nullptr);
+    /* the agent's model into the topology by hand: update_network_topology asks the controller
+     * instance (get_em_ctrl_instance), not this one, whether an agent is reachable, and passes
+     * over the models made as the controller's (create_data_model here) */
+    dm_easy_mesh_t *dm = ctrl.create_data_model(net_id, &agent_intf);
+    ASSERT_NE(dm, nullptr);
+    g_network_topology->add(dm);
+    ASSERT_NE(g_network_topology->find_topology(dm), nullptr);
+
+    em_interface_t radio[2] = {};
+    const em_freq_band_t band[2] = {em_freq_band_24, em_freq_band_5};
+    for (unsigned int i = 0; i < 2; i++) {
+        const unsigned char mac[6] = {0x02, 0x00, 0x00, 0x28, 0x09, static_cast<unsigned char>(0x11 + i)};
+        strncpy(radio[i].name, "radio", sizeof(radio[i].name) - 1);
+        memcpy(radio[i].mac, mac, sizeof(radio[i].mac));
+        radio[i].media = (i == 0) ? em_media_type_ieee80211n_24 : em_media_type_ieee80211ac_5;
+        ASSERT_NE(ctrl.create_node(&radio[i], band[i], dm, false, em_profile_type_3, em_service_type_agent), nullptr);
+    }
+    ASSERT_EQ(ctrl.get_nodes().size(), 2U);
+
+    /* the em step (dm_orch_type_em_delete) */
+    EXPECT_EQ(ctrl.remove_device_ems(net_id, agent_mac), 2U);
+    EXPECT_TRUE(ctrl.get_nodes().empty());
+    EXPECT_EQ(ctrl.get_data_model(net_id, agent_mac), dm);
+
+    /* the model step (dm_orch_type_dm_delete) */
+    ctrl.remove_device(net_id, agent_mac);
+    EXPECT_EQ(ctrl.get_data_model(net_id, agent_mac), nullptr);
+    EXPECT_EQ(g_network_topology->find_topology(dm), nullptr);
+    EXPECT_TRUE(ctrl.is_retired_model(dm));
+    EXPECT_EQ(memcmp(dm->m_device.m_device_info.intf.mac, agent_mac, sizeof(agent_mac)), 0);
+    EXPECT_EQ(ctrl.publishes, 1U);
+    EXPECT_EQ(ctrl.get_data_model(net_id, ctrl_mac), ctrl_dm);
+
+    /* a RemoveDevice for the device again: already gone */
+    EXPECT_EQ(ctrl.remove_device_ems(net_id, agent_mac), 0U);
+    ctrl.remove_device(net_id, agent_mac);
+    EXPECT_EQ(ctrl.publishes, 1U);
+    EXPECT_TRUE(ctrl.is_retired_model(dm));
+    __lsan_enable();
+}
