+// getNetworkTreeByKey confines ownership of the temporary C key string to a
+// single lookup. Returning a node is safe because the parent tree owns it.
+func getNetworkTreeByKey(tree *C.em_network_node_t, key string) *C.em_network_node_t {
+    if tree == nil {
+        return nil
+    }
+    cKey := C.CString(key)
+    defer C.free(unsafe.Pointer(cKey))
+    return C.get_network_tree_by_key(tree, cKey)
+}
+
+func setNodeArrayValue(node *C.em_network_node_t, value string) {
+    if node == nil {
+        return
+    }
+    cValue := C.CString(value)
+    defer C.free(unsafe.Pointer(cValue))
+    C.set_node_array_value(node, cValue)
+}
