+++ b/src/rdkb-cli/em_cli.cpp
@@ -225,6 +225,7 @@
 
     if (cli_cmd->init() != 0) {
 		printf("%s:%d: Failed to init command\n", __func__, __LINE__);
+		delete cli_cmd;
 		return NULL;
 	}
 
