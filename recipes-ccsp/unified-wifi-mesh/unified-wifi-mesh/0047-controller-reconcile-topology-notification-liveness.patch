diff --git a/src/ctrl/em_ctrl.cpp b/src/ctrl/em_ctrl.cpp
--- a/src/ctrl/em_ctrl.cpp
+++ b/src/ctrl/em_ctrl.cpp
@@ -515,6 +515,99 @@ void em_ctrl_t::handle_2s_tick()
 
 void em_ctrl_t::handle_1s_tick()
 {
+    std::vector<std::string> expired;
+    const auto now = std::chrono::steady_clock::now();
+
+    {
+        std::lock_guard<std::mutex> lock(m_liveness_mutex);
+        for (auto &entry : m_agent_liveness) {
+            agent_liveness_t &state = entry.second;
+            if (state.probe_pending && now >= state.probe_deadline) {
+                state.probe_pending = false;
+                if (state.reachable) {
+                    state.reachable = false;
+                    expired.push_back(entry.first);
+                }
+            }
+        }
+    }
+
+    if (!expired.empty()) {
+        for (const auto &al_mac : expired) {
+            em_printfout("Agent reachability expired after topology-change probe: %s",
+                al_mac.c_str());
+        }
+        update_network_topology();
+        publish_network_topology();
+    }
+}
+
+void em_ctrl_t::handle_topology_change(mac_address_t source_al_mac)
+{
+    dm_network_t *network = m_data_model.get_first_network();
+    if (network != NULL && memcmp(source_al_mac,
+            network->get_colocated_agent_interface_mac(), sizeof(mac_address_t)) == 0) {
+        em_printfout("Ignoring remote-neighbor liveness probe for colocated agent %s",
+            util::mac_to_string(source_al_mac).c_str());
+        return;
+    }
+
+    std::vector<em_t *> radios;
+    const std::string key = util::mac_to_string(source_al_mac);
+    const auto now = std::chrono::steady_clock::now();
+    get_all_em_for_al_mac(source_al_mac, radios);
+    if (radios.empty()) {
+        em_printfout("Neighbor-only Topology Notification from unknown agent %s; ignoring",
+            key.c_str());
+        return;
+    }
+
+    {
+        std::lock_guard<std::mutex> lock(m_liveness_mutex);
+        agent_liveness_t &state = m_agent_liveness[key];
+        state.probe_pending = true;
+        state.probe_deadline = now + std::chrono::seconds(10);
+    }
+
+    int rc = static_cast<em_configuration_t *>(radios.front())->send_topology_query_msg();
+    em_printfout("Neighbor-only Topology Notification; liveness query agent=%s rc=%d",
+        key.c_str(), rc);
+}
+
+void em_ctrl_t::note_agent_activity(mac_address_t al_mac)
+{
+    const std::string key = util::mac_to_string(al_mac);
+    bool restored = false;
+    {
+        std::lock_guard<std::mutex> lock(m_liveness_mutex);
+        agent_liveness_t &state = m_agent_liveness[key];
+        state.last_seen = std::chrono::steady_clock::now();
+        state.probe_pending = false;
+        if (!state.reachable) {
+            state.reachable = true;
+            restored = true;
+        }
+    }
+
+    if (restored) {
+        em_printfout("Agent reachability restored: %s", key.c_str());
+        update_network_topology();
+        publish_network_topology();
+    }
+}
+
+bool em_ctrl_t::is_agent_reachable(mac_address_t al_mac)
+{
+    dm_network_t *network = m_data_model.get_first_network();
+    if (network != NULL && memcmp(al_mac,
+            network->get_colocated_agent_interface_mac(), sizeof(mac_address_t)) == 0) {
+        return true;
+    }
+
+    const std::string key = util::mac_to_string(al_mac);
+    std::lock_guard<std::mutex> lock(m_liveness_mutex);
+    const auto state = m_agent_liveness.find(key);
+    return state == m_agent_liveness.end() || state->second.reachable;
 
 }
 
