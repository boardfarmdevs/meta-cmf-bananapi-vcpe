 	agentCount, extenderCount := 1, 1
@@ -3242,7 +3288,7 @@ func buildLiveInventory() ([]Device, []Client, error) {
 		if deviceID == "" || backhaul == nil {
 			return
 		}
-		radios := parseRadioList(deviceNode.child[2])
+        radios := radioInventory[strings.ToLower(deviceID)]
 		backhaulMedia := getTreeValue(backhaul, "MediaType")
 
 		role := "Controller"
@@ -4738,6 +4784,12 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
         return
     }
 
+    radioInventory, err := loadLiveRadioInventory()
+    if err != nil {
