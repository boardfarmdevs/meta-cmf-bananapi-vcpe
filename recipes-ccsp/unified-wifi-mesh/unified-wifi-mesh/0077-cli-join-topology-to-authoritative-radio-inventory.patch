         var staList []map[string]interface{}
@@ -4765,8 +4817,7 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
             return
         }
 
-        radioTree := getNetworkTreeByKey(deviceNode, "RadioList")
-        radioList := parseRadioList(radioTree)
+        radioList := radioInventory[strings.ToLower(deviceID)]
         haulTypes := buildHaulTypes(radioList)
 
         backhaulMacAddr := getTreeValue(backhaulTree, "MACAddress")
@@ -4825,8 +4876,8 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
             channel := 0
 
             // parse the band with extender connected
-            childRadioTree := getNetworkTreeByKey(child, "RadioList")
-            band, channel = getBandAndChannelFromRadioTree(childRadioTree)
+            childRadios := radioInventory[strings.ToLower(childID)]
+            band, channel = getBandAndChannelFromRadios(childRadios)
 
            edges = append(edges, map[string]interface{}{
                 "from":     deviceID,
@@ -5073,6 +5124,17 @@ func parseRadioList(tree *C.em_network_node_t) []Radio {
     return radios
 }
 
+func getBandAndChannelFromRadios(radios []Radio) (int, int) {
+    for _, radio := range radios {
+        for _, bss := range radio.BSSList {
+            if bss.VapMode == 1 && bss.BSSID != "00:00:00:00:00:00" {
+                return radio.Band, radio.Channel
+            }
+        }
+    }
+    return -1, 0
+}
+
