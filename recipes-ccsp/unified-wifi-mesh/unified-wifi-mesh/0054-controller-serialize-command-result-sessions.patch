     tmp = reinterpret_cast<unsigned char *> (m_cmd.status_to_string(status, str));
 
+    pthread_mutex_lock(&m_result_lock);
     if (m_ssl == NULL) {
         printf("%s:%d: SSL is NULL\n", __func__, __LINE__);
+        pthread_mutex_unlock(&m_result_lock);
         free(str);
         return -1;
     }
@@ -175,6 +229,8 @@ int em_cmd_ctrl_t::send_result(em_cmd_out_status_t status)
 	SSL_free(m_ssl);
 	m_ssl = NULL;
 	close(sd);
+    pthread_cond_broadcast(&m_result_cond);
+    pthread_mutex_unlock(&m_result_lock);
 
 	free(str);
 
@@ -186,6 +242,8 @@ em_cmd_ctrl_t::em_cmd_ctrl_t()
 {
     dm_easy_mesh_t dm;
 
+    pthread_mutex_init(&m_result_lock, NULL);
+    pthread_cond_init(&m_result_cond, NULL);
+
     m_cmd.init(dm);
 }
