-class em_cmd_ctrl_t : public em_cmd_exec_t { 
+class em_cmd_ctrl_t : public em_cmd_exec_t {
+    pthread_mutex_t m_result_lock;
+    pthread_cond_t m_result_cond;
+
+    bool wait_for_result(unsigned int timeout_sec);
+    void set_result_session(SSL *ssl);
+    void close_result_session_locked();
 
 public:
     
diff --git a/src/ctrl/em_cmd_ctrl.cpp b/src/ctrl/em_cmd_ctrl.cpp
index d06b536..0e8eab0 100644
--- a/src/ctrl/em_cmd_ctrl.cpp
+++ b/src/ctrl/em_cmd_ctrl.cpp
@@ -35,6 +35,7 @@
 #include <sys/uio.h>
 #include <sys/time.h>
 #include <sys/un.h>
+#include <time.h>
 #include <unistd.h>
 #include <pthread.h>
 #include <cjson/cJSON.h>
@@ -49,6 +50,7 @@ int em_cmd_ctrl_t::execute(char *result)
     bool wait = false;
     em_ctrl_t *em_ctrl = em_ctrl_t::get_em_ctrl_instance();
     struct timeval io_timeout = {30, 0};
+    SSL *accepted_ssl;
 
     m_cmd.reset();
 
@@ -69,6 +71,7 @@ int em_cmd_ctrl_t::execute(char *result)
     }
 
     while (1) {
+        wait = false;
 
         //printf("%s:%d: Waiting for client connection\n", __func__, __LINE__);
         if ((dsock = accept(lsock, NULL, NULL)) == -1) {
@@ -91,22 +94,22 @@ int em_cmd_ctrl_t::execute(char *result)
         //printf("%s:%d: Connection accepted from client\n", __func__, __LINE__);
 
         tmp = reinterpret_cast<unsigned char *> (get_event());
-        m_ssl = SSL_new(get_ssl_ctx());
-        SSL_set_fd(m_ssl, dsock);
+        accepted_ssl = SSL_new(get_ssl_ctx());
+        SSL_set_fd(accepted_ssl, dsock);
 
-        if (SSL_accept(m_ssl) <= 0) {
-            SSL_free(m_ssl);
-            m_ssl = NULL;
+        if (SSL_accept(accepted_ssl) <= 0) {
+            SSL_free(accepted_ssl);
             close(dsock);
             continue;
         }
 
-		if ((ret = SSL_read(m_ssl, tmp, sizeof(em_event_t) + EM_MAX_EVENT_DATA_LEN)) <= 0) {
+        set_result_session(accepted_ssl);
+
+		if ((ret = SSL_read(accepted_ssl, tmp, sizeof(em_event_t) + EM_MAX_EVENT_DATA_LEN)) <= 0) {
 			printf("%s:%d: listen error on socket, err:%d\n", __func__, __LINE__, errno);
-            SSL_shutdown(m_ssl);
-            SSL_free(m_ssl);
-            m_ssl = NULL;
-            close(dsock);
+            pthread_mutex_lock(&m_result_lock);
+            close_result_session_locked();
+            pthread_mutex_unlock(&m_result_lock);
             m_cmd.reset();
             continue;
 		}
@@ -136,8 +139,13 @@ int em_cmd_ctrl_t::execute(char *result)
 		//printf("%s:%d: Sending result: Wait: %d\n", __func__, __LINE__, wait);
         if (wait == false) {
             send_result(em_cmd_out_status_other);
+        } else if (wait_for_result(10) == false) {
+            printf("%s:%d: command result timed out after 10 seconds\n",
+                    __func__, __LINE__);
         }
 
+        // The manager's send_result() consumes m_cmd.  Do not reset the
+        // shared command while its queued event is still outstanding.
         m_cmd.reset();
 		
 
@@ -148,6 +156,50 @@ int em_cmd_ctrl_t::execute(char *result)
     return 0;
 }
 
+void em_cmd_ctrl_t::set_result_session(SSL *ssl)
+{
+    pthread_mutex_lock(&m_result_lock);
+    m_ssl = ssl;
+    pthread_mutex_unlock(&m_result_lock);
+}
+
+void em_cmd_ctrl_t::close_result_session_locked()
+{
+    int sd;
+
+    if (m_ssl == NULL) {
+        return;
+    }
+
+    sd = SSL_get_fd(m_ssl);
+    SSL_free(m_ssl);
+    m_ssl = NULL;
+    close(sd);
+    pthread_cond_broadcast(&m_result_cond);
+}
+
+bool em_cmd_ctrl_t::wait_for_result(unsigned int timeout_sec)
+{
+    struct timespec deadline;
+    int rc = 0;
+
+    clock_gettime(CLOCK_REALTIME, &deadline);
+    deadline.tv_sec += timeout_sec;
+
+    pthread_mutex_lock(&m_result_lock);
+    while (m_ssl != NULL && rc != ETIMEDOUT) {
+        rc = pthread_cond_timedwait(&m_result_cond, &m_result_lock, &deadline);
+    }
+
+    bool completed = (m_ssl == NULL);
+    if (completed == false) {
+        close_result_session_locked();
+    }
+    pthread_mutex_unlock(&m_result_lock);
+
+    return completed;
+}
+
 int em_cmd_ctrl_t::send_result(em_cmd_out_status_t status)
 {
     ssize_t ret;
