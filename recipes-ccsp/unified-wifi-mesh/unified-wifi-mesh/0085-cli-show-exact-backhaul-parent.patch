From 0000000000000000000000000000000000000085 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Sat, 22 Aug 2026 17:55:00 -0700
Subject: [PATCH] cli: show the exact wireless backhaul parent

The topology hierarchy already follows the Controller's authoritative parent
tree, but the HTTP model discarded the upstream AP BSSID which justified each
parent-child relationship.  It also inferred the link band from the child's
bSTA radio even when the exact parent BSS was available.

Carry the upstream BSSID and media type into both nodes and edges.  Resolve the
band and channel against the matching BSS on the parent, with the existing
bSTA-radio path retained as a bounded fallback.  Render wireless edges as
directed uplinks and expose child, parent, upstream BSSID, band and channel in
the hover details.  A multi-hop reassociation therefore moves the edge to the
new parent and identifies the exact BSS used for that hop.

Upstream-Status: Inappropriate [HWSIM evaluation WebUI]

Its page hunks (src/rdkb-cli/static) moved to easymesh-medium's topology-ui,
which builds the page the controller image serves.
---
 src/rdkb-cli/main.go |   51 ++++++++++++++++++++++++++++++++++++++++++++------
 1 file changed, 45 insertions(+), 6 deletions(-)

diff --git a/src/rdkb-cli/main.go b/src/rdkb-cli/main.go
index 86e0a2c..65acba1 100644
--- a/src/rdkb-cli/main.go
+++ b/src/rdkb-cli/main.go
@@ -4832,8 +4832,10 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
             "fixed":  map[string]bool{"x": true, "y": true},
             "STAList": createSTAList(x, y, radioList),
+            "upstreamBSSID": strings.ToLower(backhaulMacAddr),
+            "backhaulMedia": backhaulMediaType,
         })

         childList := getNetworkTreeByKey(backhaulTree, "Child")
         if childList == nil {
             return
         }
@@ -4850,18 +4852,35 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {

             band := -1
             channel := 0
+            upstreamBSSID := ""
+            mediaType := ""
+            childBackhaul := getNetworkTreeByKey(child, "Backhaul")
+            if childBackhaul != nil {
+                upstreamBSSID = strings.ToLower(getTreeValue(childBackhaul, "MACAddress"))
+                mediaType = getTreeValue(childBackhaul, "MediaType")
+            }

-            // parse the band with extender connected
+            // The topology hierarchy says which device is the parent.  Match
+            // the child's reported upstream BSSID against that parent's BSS
+            // inventory so the displayed link identifies the exact AP radio.
+            band, channel = getBandAndChannelForBSSID(radioList, upstreamBSSID)
+
+            // Retain the bSTA radio as a bounded fallback during the short
+            // interval before the parent BSS inventory becomes complete.
             childRadios := radioInventory[strings.ToLower(childID)]
-            band, channel = getBandAndChannelFromRadios(childRadios)
+            if band == -1 {
+                band, channel = getBandAndChannelFromRadios(childRadios)
+            }
             channel = resolveTopologyBackhaulChannel(deviceName == "Agent-1",
                 band, channel, localRadioChannels)

            edges = append(edges, map[string]interface{}{
-                "from":     deviceID,
-                "to":       childID,
-                "band":     band,
-                "channel":  channel,
+                "from":          deviceID,
+                "to":            childID,
+                "band":          band,
+                "channel":       channel,
+                "upstreamBSSID": upstreamBSSID,
+                "mediaType":     mediaType,
             })
             traverse(child, x, y, childAngle, depth+1)
         }
@@ -5172,6 +5191,26 @@ func getBandAndChannelFromRadios(radios []Radio) (int, int) {
     return -1, 0
 }

+// getBandAndChannelForBSSID resolves a wireless hop at its authoritative
+// endpoint: the AP BSSID on the parent node.  This remains correct when an
+// extender re-parents through another extender on a different radio.
+func getBandAndChannelForBSSID(radios []Radio, bssid string) (int, int) {
+    wanted := strings.ToLower(strings.TrimSpace(bssid))
+    if wanted == "" || wanted == "00:00:00:00:00:00" {
+        return -1, 0
+    }
+
+    for _, radio := range radios {
+        for _, bss := range radio.BSSList {
+            if strings.ToLower(strings.TrimSpace(bss.BSSID)) == wanted {
+                return radio.Band, radio.Channel
+            }
+        }
+    }
+
+    return -1, 0
+}
+
 // loadLocalRadioChannels reads the colocated Agent's actual kernel radio
 // state. EasyMesh Operating Channel Reports remain the primary source; this
 // bounded cache fills the startup gap before the Controller has received one.
