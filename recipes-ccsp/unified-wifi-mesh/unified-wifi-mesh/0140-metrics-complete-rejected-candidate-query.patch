+em_unassoc_query_list_t make_unassoc_ack_query(
+    std::initializer_list<const char *> stations)
+{
+    em_unassoc_query_list_t query{};
+    query.num_opclass = 1;
+    query.opclass_list[0].op_class = 115;
+    query.opclass_list[0].num_channels = 1;
+    query.opclass_list[0].channel_list[0].channel = 36;
+    for (const char *station : stations) {
+        unsigned int idx = query.opclass_list[0].channel_list[0].num_sta++;
+        dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(station),
+            query.opclass_list[0].channel_list[0].sta_list[idx]);
+    }
+    return query;
+}
+
+std::vector<unsigned char> make_unassoc_ack(
+    unsigned short mid,
+    std::initializer_list<std::pair<const char *, unsigned char>> errors)
+{
+    const size_t base = sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t);
+    const size_t error_size = sizeof(em_tlv_t) + sizeof(em_error_code_t);
+    std::vector<unsigned char> frame(
+        base + errors.size() * error_size + sizeof(em_tlv_t), 0);
+    auto *cmdu = reinterpret_cast<em_cmdu_t *>(
+        frame.data() + sizeof(em_raw_hdr_t));
+    cmdu->type = htons(em_msg_type_1905_ack);
+    cmdu->id = htons(mid);
+    cmdu->last_frag_ind = 1;
+
+    unsigned char *cursor = frame.data() + base;
+    for (const auto &item : errors) {
+        auto *tlv = reinterpret_cast<em_tlv_t *>(cursor);
+        tlv->type = em_tlv_type_error_code;
+        tlv->len = htons(sizeof(em_error_code_t));
+        auto *error = reinterpret_cast<em_error_code_t *>(tlv->value);
+        error->reason_code = item.second;
+        dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(item.first),
+            error->sta_mac_addr);
+        cursor += error_size;
+    }
+    auto *eom = reinterpret_cast<em_tlv_t *>(cursor);
+    eom->type = em_tlv_type_eom;
+    eom->len = 0;
+    return frame;
+}
+
+} // namespace
+
+TEST_F(EmMetricsTest, UnassocAckWrongMidDoesNotMatchTransaction) {
+    auto query = make_unassoc_ack_query({"02:00:00:00:0c:00"});
+    auto frame = make_unassoc_ack(43, {});
+    auto result = em_metrics_t::classify_unassoc_sta_ack(
+        frame.data(), frame.size(), 42, &query);
+    EXPECT_EQ(result.status, em_unassoc_ack_wrong_mid);
+    EXPECT_EQ(result.num_rejected, 0U);
+}
+
+TEST_F(EmMetricsTest, EmptyUnassocAckAwaitsMetrics) {
+    auto query = make_unassoc_ack_query({"02:00:00:00:0c:00"});
+    auto frame = make_unassoc_ack(42, {});
+    auto result = em_metrics_t::classify_unassoc_sta_ack(
+        frame.data(), frame.size(), 42, &query);
+    EXPECT_EQ(result.status, em_unassoc_ack_empty);
+    EXPECT_EQ(result.num_requested, 1U);
+    EXPECT_EQ(result.num_rejected, 0U);
+}
+
+TEST_F(EmMetricsTest, PartialUnassocAckAwaitsRemainingMetrics) {
+    auto query = make_unassoc_ack_query({
+        "02:00:00:00:0b:00", "02:00:00:00:0c:00"});
+    auto frame = make_unassoc_ack(42, {
+        {"02:00:00:00:0c:00", 0x01},
+        /* A duplicate error cannot make a partial ACK terminal. */
+        {"02:00:00:00:0c:00", 0x01},
+    });
+    auto result = em_metrics_t::classify_unassoc_sta_ack(
+        frame.data(), frame.size(), 42, &query);
+    EXPECT_EQ(result.status, em_unassoc_ack_partial_reject);
+    EXPECT_EQ(result.num_requested, 2U);
+    ASSERT_EQ(result.num_rejected, 1U);
+    EXPECT_EQ(result.rejected[0].reason_code, 0x01);
+}
+
+TEST_F(EmMetricsTest, AllRejectedUnassocAckIsTerminal) {
+    auto query = make_unassoc_ack_query({
+        "02:00:00:00:0b:00", "02:00:00:00:0c:00"});
+    auto frame = make_unassoc_ack(42, {
+        {"02:00:00:00:0b:00", 0x01},
+        {"02:00:00:00:0c:00", 0x01},
+    });
+    auto result = em_metrics_t::classify_unassoc_sta_ack(
+        frame.data(), frame.size(), 42, &query);
+    EXPECT_EQ(result.status, em_unassoc_ack_all_rejected);
+    EXPECT_EQ(result.num_requested, 2U);
+    EXPECT_EQ(result.num_rejected, 2U);
+}
