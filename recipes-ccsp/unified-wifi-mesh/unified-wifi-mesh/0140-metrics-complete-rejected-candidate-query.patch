+em_unassoc_ack_result_t em_metrics_t::classify_unassoc_sta_ack(
+    const unsigned char *buff, unsigned int len, unsigned short expected_mid,
+    const em_unassoc_query_list_t *query)
+{
+    em_unassoc_ack_result_t result{};
+    result.status = em_unassoc_ack_invalid;
+
+    const unsigned int base_len = static_cast<unsigned int>(
+        sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t));
+    if (buff == nullptr || query == nullptr || len < base_len ||
+        query->num_opclass > EM_MAX_OPCLASS) {
+        return result;
+    }
+
+    const em_cmdu_t *cmdu = reinterpret_cast<const em_cmdu_t *>(
+        buff + sizeof(em_raw_hdr_t));
+    result.msg_id = ntohs(cmdu->id);
+    if (ntohs(cmdu->type) != em_msg_type_1905_ack) {
+        return result;
+    }
+    if (result.msg_id != expected_mid) {
+        result.status = em_unassoc_ack_wrong_mid;
+        return result;
+    }
+
+    mac_address_t requested[EM_MAX_UNASSOC_STA] = {};
+    for (unsigned int op_idx = 0; op_idx < query->num_opclass; op_idx++) {
+        const em_unassoc_query_opclass_t *op = &query->opclass_list[op_idx];
+        if (op->num_channels > EM_MAX_CHANNELS_PER_OPCLASS) {
+            return result;
+        }
+        for (unsigned int channel_idx = 0; channel_idx < op->num_channels;
+             channel_idx++) {
+            const em_unassoc_query_channel_t *channel =
+                &op->channel_list[channel_idx];
+            if (channel->num_sta > EM_MAX_STA_PER_CHANNEL) {
+                return result;
+            }
+            for (unsigned int sta_idx = 0; sta_idx < channel->num_sta; sta_idx++) {
+                bool duplicate = false;
+                for (unsigned int requested_idx = 0;
+                     requested_idx < result.num_requested; requested_idx++) {
+                    if (memcmp(requested[requested_idx], channel->sta_list[sta_idx],
+                               sizeof(mac_address_t)) == 0) {
+                        duplicate = true;
+                        break;
+                    }
+                }
+                if (!duplicate) {
+                    if (result.num_requested >= EM_MAX_UNASSOC_STA) {
+                        return result;
+                    }
+                    memcpy(requested[result.num_requested++],
+                           channel->sta_list[sta_idx], sizeof(mac_address_t));
+                }
+            }
+        }
+    }
+    if (result.num_requested == 0) {
+        return result;
+    }
+
+    unsigned int remaining = len - base_len;
+    const unsigned char *cursor = buff + base_len;
+    bool saw_eom = false;
+    while (remaining >= sizeof(em_tlv_t)) {
+        const em_tlv_t *tlv = reinterpret_cast<const em_tlv_t *>(cursor);
+        const unsigned int value_len = ntohs(tlv->len);
+        const unsigned int total_len = static_cast<unsigned int>(sizeof(em_tlv_t)) +
+            value_len;
+        if (total_len > remaining) {
+            return result;
+        }
+        if (tlv->type == em_tlv_type_eom) {
+            if (value_len != 0) {
+                return result;
+            }
+            saw_eom = true;
+            break;
+        }
+        if (tlv->type == em_tlv_type_error_code) {
+            if (value_len != sizeof(em_error_code_t)) {
+                return result;
+            }
+            const em_error_code_t *error =
+                reinterpret_cast<const em_error_code_t *>(tlv->value);
+            if (error->reason_code != 0) {
+                bool requested_sta = false;
+                for (unsigned int requested_idx = 0;
+                     requested_idx < result.num_requested; requested_idx++) {
+                    if (memcmp(requested[requested_idx], error->sta_mac_addr,
+                               sizeof(mac_address_t)) == 0) {
+                        requested_sta = true;
+                        break;
+                    }
+                }
+                bool duplicate = false;
+                for (unsigned int rejected_idx = 0;
+                     rejected_idx < result.num_rejected; rejected_idx++) {
+                    if (memcmp(result.rejected[rejected_idx].sta_mac_addr,
+                               error->sta_mac_addr, sizeof(mac_address_t)) == 0) {
+                        duplicate = true;
+                        break;
+                    }
+                }
+                if (requested_sta && !duplicate) {
+                    result.rejected[result.num_rejected++] = *error;
+                }
+            }
+        }
+        cursor += total_len;
+        remaining -= total_len;
+    }
+
+    if (!saw_eom) {
+        return result;
+    }
+    if (result.num_rejected == 0) {
+        result.status = em_unassoc_ack_empty;
+    } else if (result.num_rejected == result.num_requested) {
+        result.status = em_unassoc_ack_all_rejected;
+    } else {
+        result.status = em_unassoc_ack_partial_reject;
+    }
+    return result;
+}
+
 int em_metrics_t::handle_1905_ack(unsigned char *buff, unsigned int len)
 {
     std::vector<em_t *> em_radios;
@@ -2184,13 +2311,63 @@ int em_metrics_t::handle_1905_ack(unsigned char *buff, unsigned int len)
         }
     }
 
-    if (matched_em != nullptr) {
+    if (matched_em == nullptr) {
+        em_printfout("Ignoring uncorrelated Unassociated STA ACK MID %u",
+            response_msg_id);
+        return -1;
+    }
+
+    em_cmd_t *current = matched_em->get_current_cmd();
+    if (current == nullptr || current->get_type() != em_cmd_type_unassoc_sta_query) {
+        em_printfout("Unassociated STA ACK MID %u has no matching active command",
+            response_msg_id);
+        return -1;
+    }
+    auto *query_cmd = static_cast<em_cmd_unassoc_sta_query_t *>(current);
+    em_unassoc_ack_result_t ack = classify_unassoc_sta_ack(
+        buff, len, matched_em->get_unassoc_sta_query_msg_id(), query_cmd->get_query());
+    if (ack.status == em_unassoc_ack_invalid ||
+        ack.status == em_unassoc_ack_wrong_mid) {
+        em_printfout("Ignoring invalid Unassociated STA ACK MID %u status=%d",
+            response_msg_id, static_cast<int>(ack.status));
+        return -1;
+    }
+
+    if (ack.status == em_unassoc_ack_empty) {
         em_printfout("Unassociated STA query MID %u accepted; awaiting metrics response",
             response_msg_id);
+        return 0;
+    }
+
+    dm_easy_mesh_t *dm = matched_em->get_data_model();
+    memset(dm->m_unassoc_sta_errors, 0, sizeof(dm->m_unassoc_sta_errors));
+    dm->m_num_unassoc_sta_errors = ack.num_rejected;
+    memcpy(dm->m_unassoc_sta_errors, ack.rejected,
+           ack.num_rejected * sizeof(em_error_code_t));
+    struct timeval received_at;
+    gettimeofday(&received_at, NULL);
+    dm->m_unassoc_sta_errors_received_ms =
+        static_cast<uint64_t>(received_at.tv_sec) * 1000ULL +
+        static_cast<uint64_t>(received_at.tv_usec) / 1000ULL;
+    dm->m_unassoc_sta_errors_msg_id = response_msg_id;
+    memcpy(dm->m_unassoc_sta_errors_ruid,
+           matched_em->get_radio_interface_mac(), sizeof(mac_address_t));
+
+    if (ack.status == em_unassoc_ack_partial_reject) {
+        em_printfout("Unassociated STA query MID %u rejected %u/%u STAs; awaiting metrics for the remainder",
+            response_msg_id, ack.num_rejected, ack.num_requested);
+        return 0;
     }
 
-    em_radios.clear();
-    em_printfout("Unassociated STA Link Metrics Query Ack handled successfully");
+    matched_em->clear_unassoc_sta_query_msg_id();
+    matched_em->set_state(em_state_ctrl_configured);
+    em_orch_t *orch = get_mgr()->get_orch();
+    if (orch == nullptr || !orch->complete_command(em_cmd_type_unassoc_sta_query)) {
+        em_printfout("All-rejected candidate ACK MID %u had no active command",
+            response_msg_id);
+    }
+    em_printfout("Completed candidate query MID %u with %u explicit STA rejection(s)",
+        response_msg_id, ack.num_rejected);
     return 0;
 }
 
diff --git a/src/rdkb-cli/candidate_rejection.go b/src/rdkb-cli/candidate_rejection.go
new file mode 100644
index 0000000..84a6b97
--- /dev/null
+++ b/src/rdkb-cli/candidate_rejection.go
@@ -0,0 +1,17 @@
+package main
+
+type candidateLinkError struct {
+	AgentAL    string `json:"agent_al"`
+	RUID       string `json:"ruid"`
+	STA        string `json:"sta"`
+	ErrorCode  int    `json:"error_code"`
+	ReceivedAt uint64 `json:"received_at_ms"`
+	MessageID  int    `json:"message_id"`
+}
+
+const candidateErrorFreshnessMillis uint64 = 15000
+
+func candidateErrorIsFresh(receivedAt, baseline, now uint64) bool {
+	return receivedAt > baseline && receivedAt <= now &&
+		now-receivedAt <= candidateErrorFreshnessMillis
+}
diff --git a/src/rdkb-cli/candidate_rejection_test.go b/src/rdkb-cli/candidate_rejection_test.go
new file mode 100644
index 0000000..03bec6c
--- /dev/null
+++ b/src/rdkb-cli/candidate_rejection_test.go
@@ -0,0 +1,50 @@
+package main
+
+import (
+	"encoding/json"
+	"strings"
+	"testing"
+)
+
+func TestCandidateErrorFreshness(t *testing.T) {
+	const now uint64 = 20000
+	if !candidateErrorIsFresh(19000, 18000, now) {
+		t.Fatal("new in-window rejection was not fresh")
+	}
+	if candidateErrorIsFresh(18000, 18000, now) {
+		t.Fatal("baseline rejection was treated as fresh")
+	}
+	if candidateErrorIsFresh(
+		now-candidateErrorFreshnessMillis-1, 0, now) {
+		t.Fatal("expired rejection was treated as fresh")
+	}
+	if candidateErrorIsFresh(now+1, 0, now) {
+		t.Fatal("future rejection was treated as fresh")
+	}
+}
+
+func TestCandidateErrorSerializationIsExplicit(t *testing.T) {
+	encoded, err := json.Marshal(candidateLinkError{
+		AgentAL:    "02:00:00:00:08:20",
+		RUID:       "02:00:00:00:08:00",
+		STA:        "02:00:00:00:0c:00",
+		ErrorCode:  1,
+		ReceivedAt: 1234,
+		MessageID:  42,
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	text := string(encoded)
+	for _, field := range []string{
+		`"agent_al"`, `"ruid"`, `"sta"`, `"error_code"`,
+		`"received_at_ms"`, `"message_id"`,
+	} {
+		if !strings.Contains(text, field) {
+			t.Fatalf("serialized rejection omitted %s: %s", field, text)
+		}
+	}
+	if strings.Contains(text, `"rcpi"`) {
+		t.Fatalf("rejection invented an RCPI sentinel: %s", text)
+	}
+}
