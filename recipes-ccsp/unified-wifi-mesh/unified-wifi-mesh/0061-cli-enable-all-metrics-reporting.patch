From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <revogelaar@gmail.com>
Date: Thu, 20 Aug 2026 15:15:00 -0700
Subject: [PATCH] cli: enable metrics reporting across the live mesh

Editing metrics one device and radio at a time is unsuitable for a repeatable
evaluation lab.  It also cannot repair a restarted agent when the controller's
desired database values are unchanged: the generic policy POST intentionally
skips equal configurations even though the agent's volatile reporting timer
may no longer be active.

Add a dedicated idempotent action that reads the live policy inventory,
requires discovered radio rows for every agent, applies the lab's reporting
defaults to every radio, and deliberately re-sends one serialized EasyMesh
Policy Configuration Request per device.  Expose that action as a clear
Policy Settings button and wait briefly for Connected Clients to acquire RCPI
so the operator sees an end-to-end result rather than only request admission.

Upstream-Status: Pending
Signed-off-by: Rob Vogelaar <revogelaar@gmail.com>

Its page hunks (src/rdkb-cli/static) moved to easymesh-medium's topology-ui,
which builds the page the controller image serves.
---
 src/rdkb-cli/main.go |   99 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 99 insertions(+)

diff --git a/src/rdkb-cli/main.go b/src/rdkb-cli/main.go
--- a/src/rdkb-cli/main.go
+++ b/src/rdkb-cli/main.go
@@ -2226,6 +2226,104 @@ func getWirelessSettingsHandler(w http.ResponseWriter, r *http.Request) {
 }
 
 // ===== WIRELESS Policy HANDLERS =====
+func enableMetricsReportingHandler(w http.ResponseWriter, r *http.Request) {
+    if r.Method != http.MethodPost {
+        http.Error(w, "Method not allowed", http.StatusMethodNotAllowed)
+        return
+    }
+
+    policyCmd := C.CString("get_policy OneWifiMesh")
+    defer C.free(unsafe.Pointer(policyCmd))
+
+    policyTree := execEMCommand(policyCmd, nil)
+    if policyTree == nil {
+        http.Error(w, "Controller policy model unavailable", http.StatusServiceUnavailable)
+        return
+    }
+    defer C.free_network_tree(policyTree)
+
+    deviceListNode := getNetworkTreeByKey(policyTree, "DeviceList")
+    if deviceListNode == nil {
+        http.Error(w, "Controller policy device list unavailable", http.StatusServiceUnavailable)
+        return
+    }
+
+    configs := getPolicyConfiguration(deviceListNode)
+    if len(configs) == 0 {
+        http.Error(w, "No EasyMesh agents are available", http.StatusConflict)
+        return
+    }
+
+    radioCount := 0
+    for i := range configs {
+        policy := &configs[i]
+        if len(policy.RadioSpecificMetricsPolicy) == 0 {
+            http.Error(w, fmt.Sprintf("No live radios are available for %s", policy.ID), http.StatusConflict)
+            return
+        }
+
+        policy.APMetricReportingPolicy.Interval = 5
+        for j := range policy.RadioSpecificMetricsPolicy {
+            metrics := &policy.RadioSpecificMetricsPolicy[j]
+            metrics.STARCPIThreshold = 120
+            metrics.STARCPIHysteresis = 5
+            metrics.APUtilizationThreshold = 60
+            metrics.STATrafficStats = 1
+            metrics.STALinkMetrics = 1
+            metrics.STAStatus = 0
+            radioCount++
+        }
+
+        if err := updatePolicySettings(deviceListNode, *policy); err != nil {
+            http.Error(w, fmt.Sprintf("Failed to stage metrics policy for %s", policy.ID), http.StatusInternalServerError)
+            return
+        }
+        // This action deliberately re-sends even an unchanged desired policy:
+        // after a process or container cold start the agent's volatile timer
+        // state may be absent while the controller database still compares
+        // equal to the requested configuration.
+        if !applyWifiPolicyConfigForDevice(policyTree, policy.ID) {
+            http.Error(w, fmt.Sprintf("Failed to apply metrics policy for %s", policy.ID), http.StatusInternalServerError)
+            return
+        }
+        if !waitForWifiPolicyConfig(*policy, 8*time.Second) {
+            http.Error(w, fmt.Sprintf("Timed out applying metrics policy for %s", policy.ID), http.StatusGatewayTimeout)
+            return
+        }
+        time.Sleep(2 * time.Second)
+    }
+
+    // Policy command admission is not an agent acknowledgement.  During cold
+    // multi-hop onboarding an agent may have published its radios while its
+    // policy command path is still converging, and one accepted request can
+    // consequently produce no reporting timer.  Repeat the idempotent
+    // activation after every device has had one complete pass.  This keeps a
+    // single UI/API action reliable without changing the desired policy or
+    // requiring an operator to press the button twice.
+    time.Sleep(5 * time.Second)
+    for i := range configs {
+        policy := &configs[i]
+        if !applyWifiPolicyConfigForDevice(policyTree, policy.ID) {
+            http.Error(w, fmt.Sprintf("Failed to confirm metrics policy for %s", policy.ID), http.StatusInternalServerError)
+            return
+        }
+        if !waitForWifiPolicyConfig(*policy, 8*time.Second) {
+            http.Error(w, fmt.Sprintf("Timed out confirming metrics policy for %s", policy.ID), http.StatusGatewayTimeout)
+            return
+        }
+        time.Sleep(time.Second)
+    }
+
+    w.Header().Set("Content-Type", "application/json")
+    json.NewEncoder(w).Encode(map[string]interface{}{
+        "success": true,
+        "message": "Metrics reporting enabled for all live EasyMesh radios",
+        "devices": len(configs),
+        "radios": radioCount,
+        "interval_seconds": 5,
+    })
+}
+
 func getWirelessPolicyHandler(w http.ResponseWriter, r *http.Request) {
 
     // formate get policy tree
@@ -2866,6 +2943,7 @@ func SetupRoutes(api *mux.Router) {
 
 	// Wireless Policy settings
 	api.HandleFunc("/wifipolicy", getWirelessPolicyHandler).Methods("GET", "POST")
+	api.HandleFunc("/metricsreporting/enable", enableMetricsReportingHandler).Methods("POST")
 
         // ===== NEW COVERAGE MAP ROUTES =====
 	
