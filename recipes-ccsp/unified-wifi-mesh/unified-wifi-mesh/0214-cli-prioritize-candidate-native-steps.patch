Subject: [PATCH] cli: candidate queries go first for the native lock and poll early

A candidate (Unassociated STA Link Metrics) query spent about 530 ms
per radio in fifty-client rooms: 181 ms waiting for the native lock
behind topology, client and inventory reads, 185 ms in four or five
native calls and 144 ms sleeping between polls, while the controller
completes the query within about 10 ms. One candidate round over 16
radios took 9 s.

Candidate native steps now take the lock ahead of waiting ordinary
requests (never preempting a running one), and the result is polled
10, 20, 30 and 50 ms after submission before the 100 ms cadence.
The coordination status reports candidate_native_priority.

The lock ordering itself is in the layer's candidate_coordination.go:
the recipe copies that file into the tree after the patches, so a patch
cannot change it.

Upstream-Status: Pending
---
--- a/src/rdkb-cli/main.go
+++ b/src/rdkb-cli/main.go
@@ -4695,7 +4695,7 @@
     deadline := time.Now().Add(8 * time.Second)
     var observed []candidateLinkMetric
     var observedErrors []candidateLinkError
-    for time.Now().Before(deadline) {
+    for attempt := 0; time.Now().Before(deadline); attempt++ {
         if r.Context().Err() != nil { return }
         all, allErrors, completions, err := readState()
         if err == nil {
@@ -4783,7 +4783,7 @@
         }
         select {
         case <-r.Context().Done(): return
-        case <-time.After(100 * time.Millisecond):
+        case <-time.After(candidatePollWait(attempt)):
         }
     }
 
--- /dev/null
+++ b/src/rdkb-cli/candidate_priority_test.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+func TestCandidateStepGoesBeforeWaitingRequests(t *testing.T) {
+	lock := newNativeLock()
+	lock.Lock() // an ordinary request is running
+	order := make(chan string, 2)
+	ordinaryWaiting := make(chan struct{})
+	go func() {
+		close(ordinaryWaiting)
+		lock.Lock()
+		order <- "ordinary"
+		lock.Unlock()
+	}()
+	<-ordinaryWaiting
+	time.Sleep(20 * time.Millisecond)
+	go func() {
+		lock.LockPriority()
+		order <- "candidate"
+		lock.Unlock()
+	}()
+	time.Sleep(20 * time.Millisecond)
+	lock.Unlock()
+	if first := <-order; first != "candidate" {
+		t.Fatalf("first after release: %s, want candidate", first)
+	}
+	if second := <-order; second != "ordinary" {
+		t.Fatalf("second after release: %s, want ordinary", second)
+	}
+}
+
+func TestCandidateStepDoesNotPreemptRunningRequest(t *testing.T) {
+	lock := newNativeLock()
+	lock.Lock()
+	acquired := make(chan struct{})
+	go func() { lock.LockPriority(); close(acquired); lock.Unlock() }()
+	select {
+	case <-acquired:
+		t.Fatal("candidate step took the lock from a running request")
+	case <-time.After(30 * time.Millisecond):
+	}
+	lock.Unlock()
+	<-acquired
+}
+
+func TestCandidatePollWaitBacksOff(t *testing.T) {
+	want := []time.Duration{10, 20, 30, 50, 100, 100}
+	for attempt, ms := range want {
+		if got := candidatePollWait(attempt); got != ms*time.Millisecond {
+			t.Fatalf("attempt %d: %v, want %v", attempt, got, ms*time.Millisecond)
+		}
+	}
+}
