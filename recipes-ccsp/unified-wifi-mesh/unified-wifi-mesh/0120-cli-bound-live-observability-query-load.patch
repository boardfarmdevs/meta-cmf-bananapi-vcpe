 // ===== INITIALIZATION =====
 
 func init() {
@@ -3588,13 +3597,25 @@
 }
 
 func getLiveClientsWithMetrics() ([]Client, error) {
-	// Keep get_network as a device/topology availability gate, but never use
-	// its optional STA projection as the association authority.
-	_, _, err := getLiveInventory()
+	now := time.Now()
+	detailedClientsMutex.RLock()
+	if !detailedClientsUpdatedAt.IsZero() &&
+		now.Sub(detailedClientsUpdatedAt) < liveQueryCacheTTL {
+		cached := append([]Client(nil), detailedClients...)
+		detailedClientsMutex.RUnlock()
+		return cached, nil
+	}
+	detailedClientsMutex.RUnlock()
+
+	clients, err := loadDetailedLiveClients()
 	if err != nil {
 		return nil, err
 	}
-	return loadDetailedLiveClients()
+	detailedClientsMutex.Lock()
+	detailedClients = append([]Client(nil), clients...)
+	detailedClientsUpdatedAt = time.Now()
+	detailedClientsMutex.Unlock()
+	return clients, nil
 }
 
 // loadLiveBSSInventory exposes target identities without turning simulator or
@@ -3686,12 +3707,23 @@
 
 // getLiveInventory falls back only to the last successful live snapshot.
 func getLiveInventory() ([]Device, []Client, error) {
+	now := time.Now()
+	liveInventoryMutex.RLock()
+	if haveLiveInventory && now.Sub(liveInventoryUpdatedAt) < liveQueryCacheTTL {
+		cachedDevices := append([]Device(nil), liveDevices...)
+		cachedClients := append([]Client(nil), liveClients...)
+		liveInventoryMutex.RUnlock()
+		return cachedDevices, cachedClients, nil
+	}
+	liveInventoryMutex.RUnlock()
+
 	inventoryDevices, inventoryClients, err := buildLiveInventory()
 	if err == nil {
 		liveInventoryMutex.Lock()
 		liveDevices = append([]Device(nil), inventoryDevices...)
 		liveClients = append([]Client(nil), inventoryClients...)
 		haveLiveInventory = true
+		liveInventoryUpdatedAt = time.Now()
 		liveInventoryMutex.Unlock()
 		return inventoryDevices, inventoryClients, nil
 	}
@@ -4809,6 +4841,16 @@
 }
 
 func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
+	topologyResponseMutex.RLock()
+	if len(topologyResponse) != 0 &&
+		time.Since(topologyResponseUpdatedAt) < liveQueryCacheTTL {
+		cached := append([]byte(nil), topologyResponse...)
+		topologyResponseMutex.RUnlock()
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write(cached)
+		return
+	}
+	topologyResponseMutex.RUnlock()
 
     agentCount := 1
     extenderCount := 1
@@ -5016,12 +5058,21 @@
 	resolveTopologyWirelessParents(edges, topologyAPOwnersFromInventory(radioInventory))
     overlayLiveTopologyClients(nodes)
 
-    // Send the response to frontend
-    w.Header().Set("Content-Type", "application/json")
-    json.NewEncoder(w).Encode(map[string]interface{}{
+    payload, err := json.Marshal(map[string]interface{}{
         "nodes": nodes,
         "edges": edges,
     })
+    if err != nil {
+        http.Error(w, "Failed to encode controller topology", http.StatusInternalServerError)
+        return
+    }
+    topologyResponseMutex.Lock()
+    topologyResponse = append(topologyResponse[:0], payload...)
+    topologyResponseUpdatedAt = time.Now()
+    topologyResponseMutex.Unlock()
+
+    w.Header().Set("Content-Type", "application/json")
+    _, _ = w.Write(payload)
 }
 
