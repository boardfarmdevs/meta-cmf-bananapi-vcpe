From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <robvogelaar@users.noreply.github.com>
Date: Fri, 28 Aug 2026 12:00:00 -0700
Subject: [PATCH] cli: stage steering cues and shape topology layouts

Keep the topology viewport bounded when the browser changes size, choose
deterministic layouts suited to star and full-chain topologies, and retain
solid backhaul links when signal telemetry is temporarily unavailable.

Expose a short-lived steering-intent endpoint so the host steering adapter can
identify a client before BTM, animate its move, and highlight its arrival.
The event is presentation-only and does not alter the EasyMesh model or issue
the steering request.

Its page hunks (src/rdkb-cli/static) moved to easymesh-medium's topology-ui,
which builds the page the controller image serves.
---
diff --git a/src/rdkb-cli/main.go b/src/rdkb-cli/main.go
index ebf777861514789c823339dac5d4c40cffc12115..07427600b9fbe3e39e5d48da39a6dac74ef3b4e0 100644
--- a/src/rdkb-cli/main.go
+++ b/src/rdkb-cli/main.go
@@ -122,6 +122,11 @@ var topologyRadioChannelCache = struct {
 	channels map[int]int
 }{channels: make(map[int]int)}
 
+var steeringEventState = struct {
+	sync.Mutex
+	event *SteeringEvent
+}{}
+
 // ===== SIMPLIFIED DATA MODELS =====
 
 type RemoteIPConfig struct {
@@ -129,6 +134,18 @@ type RemoteIPConfig struct {
     Port string `json:"port"`
 }
 
+// SteeringEvent is a short-lived operator-intent hint for the topology UI.
+// It does not alter the EasyMesh model or perform the steering operation.
+type SteeringEvent struct {
+	ID         string    `json:"id"`
+	STAMAC     string    `json:"sta_mac"`
+	ClientName string    `json:"client_name"`
+	TargetName string    `json:"target_name"`
+	Phase      string    `json:"phase"`
+	ReceivedAt time.Time `json:"received_at"`
+	ExpiresAt  time.Time `json:"expires_at"`
+}
+
 // classChannelMap struct to store channel capability
 type classChannelMap struct {
 	class       int
@@ -3108,6 +3125,7 @@ func main() {
 	// Existing routes continue...
 	api.HandleFunc("/topology", getTopologyHandler).Methods("GET")
 	api.HandleFunc("/topology/optimize", optimizeTopologyHandler).Methods("POST")
+	api.HandleFunc("/steering-event", steeringEventHandler).Methods("GET", "POST", "DELETE")
  
 	// Metrics and Monitoring
 	api.HandleFunc("/metrics/devices", getDeviceMetricsHandler).Methods("GET")
@@ -4840,6 +4858,113 @@ func applyResetConfig(resetTree *C.em_network_node_t) bool {
     return true
 }
 
+func currentSteeringEvent(now time.Time) *SteeringEvent {
+	steeringEventState.Lock()
+	defer steeringEventState.Unlock()
+	if steeringEventState.event == nil {
+		return nil
+	}
+	if !now.Before(steeringEventState.event.ExpiresAt) {
+		steeringEventState.event = nil
+		return nil
+	}
+	copy := *steeringEventState.event
+	return &copy
+}
+
+func writeSteeringJSON(w http.ResponseWriter, status int, value interface{}) {
+	w.Header().Set("Content-Type", "application/json")
+	w.WriteHeader(status)
+	if value != nil {
+		_ = json.NewEncoder(w).Encode(value)
+	}
+}
+
+func steeringEventHandler(w http.ResponseWriter, r *http.Request) {
+	now := time.Now().UTC()
+	switch r.Method {
+	case http.MethodGet:
+		writeSteeringJSON(w, http.StatusOK, map[string]interface{}{
+			"event": currentSteeringEvent(now),
+		})
+		return
+	case http.MethodDelete:
+		steeringEventState.Lock()
+		steeringEventState.event = nil
+		steeringEventState.Unlock()
+		w.WriteHeader(http.StatusNoContent)
+		return
+	case http.MethodPost:
+	default:
+		writeSteeringJSON(w, http.StatusMethodNotAllowed,
+			map[string]string{"error": "method not allowed"})
+		return
+	}
+
+	var request struct {
+		STAMAC     string `json:"sta_mac"`
+		ClientName string `json:"client_name"`
+		TargetName string `json:"target_name"`
+		Phase      string `json:"phase"`
+	}
+	decoder := json.NewDecoder(http.MaxBytesReader(w, r.Body, 4096))
+	decoder.DisallowUnknownFields()
+	if err := decoder.Decode(&request); err != nil {
+		writeSteeringJSON(w, http.StatusBadRequest,
+			map[string]string{"error": "invalid steering event: " + err.Error()})
+		return
+	}
+	request.STAMAC = strings.ToLower(strings.TrimSpace(request.STAMAC))
+	request.ClientName = strings.TrimSpace(request.ClientName)
+	request.TargetName = strings.TrimSpace(request.TargetName)
+	request.Phase = strings.ToLower(strings.TrimSpace(request.Phase))
+	if request.STAMAC == "" || request.ClientName == "" || request.TargetName == "" {
+		writeSteeringJSON(w, http.StatusBadRequest,
+			map[string]string{"error": "sta_mac, client_name and target_name are required"})
+		return
+	}
+
+	ttl := 45 * time.Second
+	switch request.Phase {
+	case "planned":
+		ttl = 15 * time.Second
+	case "moving":
+	case "completed", "failed":
+		ttl = 8 * time.Second
+	default:
+		writeSteeringJSON(w, http.StatusBadRequest,
+			map[string]string{"error": "phase must be planned, moving, completed or failed"})
+		return
+	}
+	event := &SteeringEvent{
+		ID: now.Format("20060102T150405.000000000Z07:00"),
+		STAMAC: request.STAMAC, ClientName: request.ClientName,
+		TargetName: request.TargetName, Phase: request.Phase,
+		ReceivedAt: now, ExpiresAt: now.Add(ttl),
+	}
+	steeringEventState.Lock()
+	steeringEventState.event = event
+	steeringEventState.Unlock()
+	writeSteeringJSON(w, http.StatusAccepted, event)
+}
+
+func topologyPayloadWithSteering(payload []byte) []byte {
+	event := currentSteeringEvent(time.Now().UTC())
+	if event == nil {
+		return payload
+	}
+	var topology map[string]interface{}
+	if err := json.Unmarshal(payload, &topology); err != nil {
+		return payload
+	}
+	topology["steeringEvent"] = event
+	updated, err := json.Marshal(topology)
+	if err != nil {
+		return payload
+	}
+	return updated
+}
+
 func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
 	topologyResponseMutex.RLock()
 	if len(topologyResponse) != 0 &&
@@ -4847,7 +4972,7 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
 		cached := append([]byte(nil), topologyResponse...)
 		topologyResponseMutex.RUnlock()
 		w.Header().Set("Content-Type", "application/json")
-		_, _ = w.Write(cached)
+		_, _ = w.Write(topologyPayloadWithSteering(cached))
 		return
 	}
 	topologyResponseMutex.RUnlock()
@@ -5072,7 +5197,7 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
     topologyResponseMutex.Unlock()
 
     w.Header().Set("Content-Type", "application/json")
-    _, _ = w.Write(payload)
+	_, _ = w.Write(topologyPayloadWithSteering(payload))
 }
 
 func loadTopologyFromStaticJSON(w http.ResponseWriter) {
