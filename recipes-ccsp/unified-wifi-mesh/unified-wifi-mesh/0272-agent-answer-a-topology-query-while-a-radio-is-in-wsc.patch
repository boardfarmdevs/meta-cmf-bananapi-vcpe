+                em_printfout("%s radios are configured for al_mac:%s, sending topology response",
+                    in_wsc.empty() ? "All" : "Not all", util::mac_to_string(hdr->dst).c_str());
                 len = send_topology_response_msg(data, ntohs(cmdu->id));
                 if(len) {
                     auto command_lock = get_mgr()->get_orch()->lock_commands();
