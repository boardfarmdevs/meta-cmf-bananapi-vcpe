@@ -7109,7 +7109,8 @@ void em_configuration_t::process_msg(unsigned char *data, unsigned int len)
         case em_msg_type_topo_query:
             {
                 int len = 0;
-                std::vector<em_t*> em_radios;
+                std::vector<em_t*> em_radios, in_wsc;
+                bool configured = false;
                 get_mgr()->get_all_em_for_al_mac(hdr->dst, em_radios);
                 for (auto &em : em_radios) {
                     if (em->get_service_type() != em_service_type_agent) {
@@ -7121,12 +7122,32 @@ void em_configuration_t::process_msg(unsigned char *data, unsigned int len)
                         continue;
                     }
                     if (em->get_state() < em_state_agent_onewifi_bssconfig_ind) {
+                        in_wsc.push_back(em);
+                    } else {
+                        configured = true;
+                    }
+                }
+                // A radio still in its WSC exchange (first onboarding, a Renew, a lost M2) kept the
