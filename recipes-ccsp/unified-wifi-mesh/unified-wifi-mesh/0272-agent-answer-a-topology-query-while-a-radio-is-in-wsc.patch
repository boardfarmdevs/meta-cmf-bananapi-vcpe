+                // radio configured yet, the agent waits for them as before.
+                if (!in_wsc.empty() && !configured) {
+                    for (auto &em : in_wsc) {
                         em_printfout("radio %s is not configured, ignoring", util::mac_to_string(em->get_radio_interface_mac()).c_str());
-                        em_radios.clear();
-                        return;
+                    }
+                    em_radios.clear();
+                    return;
+                }
+                for (auto &em : in_wsc) {
