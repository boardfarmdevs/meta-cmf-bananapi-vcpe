+void em_ctrl_t::collect_native_backhaul_refresh(const em_backhaul::snapshot &network,
+    int64_t now, std::vector<std::vector<unsigned char>> &outgoing)
+{
+    auto &steer = m_backhaul_steer;
+    if (steer.mid == 0 || !steer.response || now - steer.sent >= 15000) return;
+    const auto current = network.nodes.find(steer.request.al);
+    if (current == network.nodes.end() || current->second.sta != steer.request.sta) return;
+    if (current->second.parent_bssid == steer.request.target) {
+        if (!steer.parent_observed) {
+            steer.parent_observed = true;
+            m_backhaul_last_query = 0;
+        }
+        return;
+    }
+    if (steer.topology_queries >= 3 ||
+        (steer.topology_queries != 0 && now - steer.topology_queried < 2000)) return;
+    const unsigned short mid = get_next_msg_id();
+    outgoing.push_back(em_backhaul::frame(steer.request.al, m_backhaul_controller,
+        em_msg_type_topo_query, mid, em_tlv_type_profile, {em_profile_type_3}));
+    steer.topology_queried = now;
+    ++steer.topology_queries;
+    em_printfout("Native backhaul topology refresh steer_mid=%u query_mid=%u attempt=%u",
+        steer.mid, mid, steer.topology_queries);
+}
