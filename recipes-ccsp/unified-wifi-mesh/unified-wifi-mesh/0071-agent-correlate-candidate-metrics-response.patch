@@ -440,16 +462,18 @@ int em_metrics_t::handle_unassoc_sta_link_metrics_rsp(unsigned char *buff, unsi
     if (dm->m_num_unassoc_sta_metrics > 0) {
         struct timeval received_at;
-        em_cmdu_t *cmdu = reinterpret_cast<em_cmdu_t *>(buff + sizeof(em_raw_hdr_t));
         em_t *em = static_cast<em_t *>(this);
 
