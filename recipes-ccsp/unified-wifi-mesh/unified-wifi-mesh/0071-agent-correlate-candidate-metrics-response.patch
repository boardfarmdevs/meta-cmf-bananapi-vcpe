     em_cmd_unassoc_sta_query_t *cmd = static_cast<em_cmd_unassoc_sta_query_t *>(get_current_cmd());
     if (cmd == NULL) {
         return -1;
@@ -2494,7 +2524,6 @@ int em_metrics_t::send_unassoc_sta_link_metrics_query_msg()
 
