--- a/src/agent/em_agent.cpp
+++ b/src/agent/em_agent.cpp
@@ -2296,15 +2296,53 @@ em_t *em_agent_t::find_em_for_msg_type(unsigned char *data, unsigned int len,
            }
            break;
 
-        case em_msg_type_unassoc_sta_link_metrics_query:
-           em = (em_t *)hash_map_get_first(m_em_map);
-           while (em != NULL) {
-                if ((em->is_al_interface_em() == false)) {
-                    break;
-                }
-                em = (em_t *)hash_map_get_next(m_em_map, em);
-            }
-            break;
+        case em_msg_type_unassoc_sta_link_metrics_query: {
+            unsigned char requested_opclass = 0;
+            unsigned char *tlv_ptr = data + sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t);
+            unsigned char *frame_end = data + len;
+
+            while (tlv_ptr + sizeof(em_tlv_t) <= frame_end) {
+                em_tlv_t *query_tlv = reinterpret_cast<em_tlv_t *>(tlv_ptr);
+                unsigned short query_tlv_len = ntohs(query_tlv->len);
+                if (tlv_ptr + sizeof(em_tlv_t) + query_tlv_len > frame_end) {
+                    break;
+                }
+                if (query_tlv->type == em_tlv_type_unassoc_sta_link_metric_query &&
+                    query_tlv_len >= 2) {
+                    requested_opclass = query_tlv->value[0];
+                    break;
+                }
+                if (query_tlv->type == em_tlv_type_eom) {
+                    break;
+                }
+                tlv_ptr += sizeof(em_tlv_t) + query_tlv_len;
+            }
+
+            em = static_cast<em_t *>(hash_map_get_first(m_em_map));
+            while (em != NULL) {
+                bool matches = false;
+                if (!em->is_al_interface_em() && requested_opclass != 0) {
+                    dm_easy_mesh_t *radio_dm = em->get_data_model();
+                    for (unsigned int idx = 0; idx < radio_dm->get_num_op_class(); idx++) {
+                        em_op_class_info_t *op = radio_dm->get_op_class_info(idx);
+                        if (op != NULL && op->op_class == requested_opclass &&
+                            memcmp(op->id.ruid, em->get_radio_interface_mac(),
+                                sizeof(mac_address_t)) == 0) {
+                            matches = true;
+                            break;
+                        }
+                    }
+                }
+                if (matches) {
+                    em_printfout("Unassociated STA query routed to radio %s for operating class %u",
+                        util::mac_to_string(em->get_radio_interface_mac()).c_str(),
+                        requested_opclass);
+                    break;
+                }
+                em = static_cast<em_t *>(hash_map_get_next(m_em_map, em));
+            }
+            break;
+        }
 
         case em_msg_type_unassoc_sta_link_metrics_rsp:
            printf("%s:%d: Sending Unassoc STA Link Metrics response\n", __func__, __LINE__);
diff --git a/src/em/em.cpp b/src/em/em.cpp
