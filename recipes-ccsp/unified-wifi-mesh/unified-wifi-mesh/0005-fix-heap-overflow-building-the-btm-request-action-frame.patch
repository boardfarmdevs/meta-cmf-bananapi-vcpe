+#include <stddef.h>
 #include "dm_easy_mesh_agent.h"
 #include <cjson/cJSON.h>
 #include "ieee80211.h"
@@ -800,12 +801,32 @@ int dm_easy_mesh_agent_t::analyze_btm_request_action_frame(em_bus_event_t *evt,
     action_frame_params_t *aframe;
     raw_data_t l_bus_data;
     int len = 0;
+    size_t scratch_len = 0, alloc_len = 0;
     mac_addr_str_t mac_str;
     em_steering_req_t *steer_req = reinterpret_cast<em_steering_req_t *> (&evt->u.raw_buff);
 
     len = sizeof(ieeeframe->u.action.category) + sizeof(ieeeframe->u.action.u.bss_tm_req) \
         + sizeof(em_80211_neighbor_report_t);
-    aframe = static_cast<action_frame_params_t *> (malloc(sizeof(action_frame_params_t) + static_cast<size_t>(len)));
+    // The buffer is used two different ways and must be sized for the LARGER.
+    //
+    // 'len' is the action payload -- category + bss_tm_req + one neighbour report
+    // -- which is what frame_len reports and what is memcpy'd down to frame_data
+    // at the end. But the code below builds that payload through an
+    // ieee80211_mgmt overlay placed at frame_data, and u.action sits 24 bytes
+    // into that struct, after the 802.11 header (frame_control, duration, da,
+    // sa, bssid, seq_ctrl). Writing the candidate list through the overlay
+    // therefore touches offsetof(u.action.u.bss_tm_req.variable) + 15 bytes,
+    // NOT len bytes.
+    //
+    // Sizing on len alone under-allocates by exactly the 24-byte header and
+    // corrupts the heap; glibc then aborts the whole agent at its next
+    // allocation, which is why no BTM Request was ever transmitted. Measured
+    // before this fix: ALLOC=44, last byte written at offset 68, OVERFLOW=24.
+    scratch_len = offsetof(struct ieee80211_mgmt, u.action.u.bss_tm_req.variable)
+        + sizeof(em_80211_neighbor_report_t);
+    alloc_len = sizeof(action_frame_params_t)
+        + ((static_cast<size_t>(len) > scratch_len) ? static_cast<size_t>(len) : scratch_len);
+    aframe = static_cast<action_frame_params_t *> (malloc(alloc_len));
     if (aframe == NULL) {
         em_printfout("Error: Failed to allocate action frame");
         return -1;
