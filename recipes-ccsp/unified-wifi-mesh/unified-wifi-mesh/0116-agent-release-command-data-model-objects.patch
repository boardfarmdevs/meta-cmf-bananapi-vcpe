 src/dm/dm_easy_mesh.cpp          | 18 +++++++++++++-----
 tests/test_l1_dm_easy_mesh.cpp   | 48 +++++++++++++++++++++++++++++++++++++++++
 3 files changed, 67 insertions(+), 9 deletions(-)

