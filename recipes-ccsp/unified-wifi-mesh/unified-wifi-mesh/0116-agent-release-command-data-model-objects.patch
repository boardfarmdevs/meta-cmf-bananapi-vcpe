diff --git a/tests/test_l1_dm_easy_mesh.cpp b/tests/test_l1_dm_easy_mesh.cpp
index b4eafc1..07dcdad 100644
--- a/tests/test_l1_dm_easy_mesh.cpp
+++ b/tests/test_l1_dm_easy_mesh.cpp
@@ -92,6 +92,54 @@ static em_sta_info_t create_sta_info(const mac_address_t sta,
     return info;
 }
 
+TEST(dm_easy_mesh_t, cloned_hash_maps_own_their_station_objects)
+{
+    dm_easy_mesh_t source;
+    dm_easy_mesh_t clone;
+    mac_address_t sta = {0x02, 0x00, 0x00, 0x00, 0x00, 0x11};
+    mac_address_t bssid = {0x02, 0x00, 0x00, 0x00, 0x00, 0x22};
+    mac_address_t radio = {0x02, 0x00, 0x00, 0x00, 0x00, 0x33};
+    em_sta_info_t info = create_sta_info(sta, bssid, radio);
+
+    source.init();
+    clone.init();
+    source.put_sta_info(&info, em_target_sta_map_consolidated);
+    source.put_sta_info(&info, em_target_sta_map_assoc);
+    source.put_sta_info(&info, em_target_sta_map_disassoc);
+    source.clone_hash_maps(clone);
+
+    dm_sta_t *source_consolidated =
+        static_cast<dm_sta_t *>(hash_map_get_first(source.m_sta_map));
+    dm_sta_t *clone_consolidated =
+        static_cast<dm_sta_t *>(hash_map_get_first(clone.m_sta_map));
+    dm_sta_t *source_assoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(source.m_sta_assoc_map));
+    dm_sta_t *clone_assoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(clone.m_sta_assoc_map));
+    dm_sta_t *source_disassoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(source.m_sta_dassoc_map));
+    dm_sta_t *clone_disassoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(clone.m_sta_dassoc_map));
+
+    ASSERT_NE(source_consolidated, nullptr);
+    ASSERT_NE(clone_consolidated, nullptr);
+    ASSERT_NE(source_assoc, nullptr);
+    ASSERT_NE(clone_assoc, nullptr);
+    ASSERT_NE(source_disassoc, nullptr);
+    ASSERT_NE(clone_disassoc, nullptr);
+    EXPECT_NE(source_consolidated, clone_consolidated);
+    EXPECT_NE(source_assoc, clone_assoc);
+    EXPECT_NE(source_disassoc, clone_disassoc);
+
+    source.deinit();
+    EXPECT_EQ(memcmp(clone_consolidated->m_sta_info.id, sta,
+        sizeof(mac_address_t)), 0);
+    clone.deinit();
+    EXPECT_EQ(clone.m_sta_map, nullptr);
+    EXPECT_EQ(clone.m_sta_assoc_map, nullptr);
+    EXPECT_EQ(clone.m_sta_dassoc_map, nullptr);
+}
