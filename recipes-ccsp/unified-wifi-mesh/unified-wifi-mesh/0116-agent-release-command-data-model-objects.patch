From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Tue, 25 Aug 2026 14:10:00 -0700
Subject: [PATCH] agent: release command data-model station objects

Every periodic metrics event is decoded into a temporary data model and copied
into commands. Decode link metrics before constructing the command so it owns
the current report directly rather than sharing pointers, and retain a test
that proves cloned station maps own independent objects.

Fresh upstream now deep-copies station maps, deletes station and scan objects
during idempotent deinit(), and releases the other temporary decoder models.
Those integrated ownership changes are omitted from this rebased patch.

Upstream-Status: Pending
---
 src/agent/dm_easy_mesh_agent.cpp |  5 ++---
 tests/test_l1_dm_easy_mesh.cpp   | 54 ++++++++++++++++++++++++++++++++++++++++
 2 files changed, 56 insertions(+), 3 deletions(-)

diff --git a/src/agent/dm_easy_mesh_agent.cpp b/src/agent/dm_easy_mesh_agent.cpp
index b0c4f5b..bb7f9c1 100644
--- a/src/agent/dm_easy_mesh_agent.cpp
+++ b/src/agent/dm_easy_mesh_agent.cpp
@@ -852,12 +852,11 @@ int dm_easy_mesh_agent_t::analyze_sta_link_metrics(em_bus_event_t *evt, em_cmd_t
 
     dm.init();
     dm = *this;
-
-    pcmd[num] = new em_cmd_sta_link_metrics_t(dm);
     dm.translate_and_decode_onewifi_subdoc(reinterpret_cast<char *> (evt->u.raw_buff), webconfig_subdoc_type_em_sta_link_metrics,
         "Link Metrics");
+
+    pcmd[num] = new em_cmd_sta_link_metrics_t(dm);
     pcmd[num]->m_svc = em_service_type_agent;
-    dm.clone_hash_maps(pcmd[num]->m_data_model);
 
     tmp = pcmd[num];
     num++;
diff --git a/tests/test_l1_dm_easy_mesh.cpp b/tests/test_l1_dm_easy_mesh.cpp
index 94ad217..a23fde3 100644
--- a/tests/test_l1_dm_easy_mesh.cpp
+++ b/tests/test_l1_dm_easy_mesh.cpp
@@ -100,6 +100,60 @@ static em_sta_info_t create_sta_info(const mac_address_t sta,
     return info;
 }
 
+TEST(dm_easy_mesh_t, cloned_hash_maps_own_their_station_objects)
+{
+    dm_easy_mesh_t source;
+    dm_easy_mesh_t clone;
+    mac_address_t sta = {0x02, 0x00, 0x00, 0x00, 0x00, 0x11};
+    mac_address_t bssid = {0x02, 0x00, 0x00, 0x00, 0x00, 0x22};
+    mac_address_t radio = {0x02, 0x00, 0x00, 0x00, 0x00, 0x33};
+    em_sta_info_t info = create_sta_info(sta, bssid, radio);
+
+    source.init();
+    clone.init();
+    source.put_sta_info(&info, em_target_sta_map_consolidated);
+    source.put_sta_info(&info, em_target_sta_map_assoc);
+    source.put_sta_info(&info, em_target_sta_map_disassoc);
+    // Existing values with the same keys must be replaced without leaking.
+    clone.put_sta_info(&info, em_target_sta_map_consolidated);
+    clone.put_sta_info(&info, em_target_sta_map_assoc);
+    clone.put_sta_info(&info, em_target_sta_map_disassoc);
+    source.clone_hash_maps(clone);
+
+    dm_sta_t *source_consolidated =
+        static_cast<dm_sta_t *>(hash_map_get_first(source.m_sta_map));
+    dm_sta_t *clone_consolidated =
+        static_cast<dm_sta_t *>(hash_map_get_first(clone.m_sta_map));
+    dm_sta_t *source_assoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(source.m_sta_assoc_map));
+    dm_sta_t *clone_assoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(clone.m_sta_assoc_map));
+    dm_sta_t *source_disassoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(source.m_sta_dassoc_map));
+    dm_sta_t *clone_disassoc =
+        static_cast<dm_sta_t *>(hash_map_get_first(clone.m_sta_dassoc_map));
+
+    ASSERT_NE(source_consolidated, nullptr);
+    ASSERT_NE(clone_consolidated, nullptr);
+    ASSERT_NE(source_assoc, nullptr);
+    ASSERT_NE(clone_assoc, nullptr);
+    ASSERT_NE(source_disassoc, nullptr);
+    ASSERT_NE(clone_disassoc, nullptr);
+    EXPECT_NE(source_consolidated, clone_consolidated);
+    EXPECT_NE(source_assoc, clone_assoc);
+    EXPECT_NE(source_disassoc, clone_disassoc);
+
+    source.deinit();
+    EXPECT_EQ(memcmp(clone_consolidated->m_sta_info.id, sta,
+        sizeof(mac_address_t)), 0);
+    clone.deinit();
+    EXPECT_EQ(clone.m_sta_map, nullptr);
+    EXPECT_EQ(clone.m_sta_assoc_map, nullptr);
+    EXPECT_EQ(clone.m_sta_dassoc_map, nullptr);
+    EXPECT_NO_THROW(clone.deinit());
+    EXPECT_NO_THROW(source.deinit());
+}
+
 
 static void add_sta(
     dm_easy_mesh_t &mesh,
