From: Codex <codex@openai.com>
Date: Mon, 17 Aug 2026 06:10:00 +0000
Subject: [PATCH] ctrl: publish association topology after table commit

Client capability handling updates a per-command station map and queues
db_cfg_type_sta_list_update.  The controller's periodic table worker later
applies that map to MariaDB and to dm_sta_list_t, which is the central list
used by em_network_topo's WebUI encoder.

Publishing from the association command therefore races ahead of the table
worker.  The physical link and MariaDB can converge after a steer while the
nested `/api/v1/topology` snapshot omits the station or retains its old parent.

Track station-list work in update_tables() and rebuild/publish topology only
after the central list has been updated.  This places the side effect at the
actual data-ownership boundary and covers association and disassociation
without another over-the-air Topology Query.

Upstream-Status: Pending
---
 src/ctrl/dm_easy_mesh_ctrl.cpp | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/src/ctrl/dm_easy_mesh_ctrl.cpp b/src/ctrl/dm_easy_mesh_ctrl.cpp
--- a/src/ctrl/dm_easy_mesh_ctrl.cpp
+++ b/src/ctrl/dm_easy_mesh_ctrl.cpp
@@ -4112,6 +4112,7 @@ int dm_easy_mesh_ctrl_t::update_tables(dm_easy_mesh_t *dm)
     em_2xlong_string_t parent, key;
     em_string_t haul_str;
     bool at_least_one_failed = false;
+    bool sta_topology_changed = false;
 	char *criteria;
 
     //printf("%s:%d: Database Config Bitmask: 0x%08x\n", __func__, __LINE__, dm->get_db_cfg_type());
@@ -4297,6 +4298,7 @@ int dm_easy_mesh_ctrl_t::update_tables(dm_easy_mesh_t *dm)
         }
 
 		dm->reset_db_cfg_type(db_cfg_type_sta_list_update);
+        sta_topology_changed = true;
     }
 
     if (dm->db_cfg_type_is_set(db_cfg_type_sta_list_delete)) {
@@ -4327,5 +4329,6 @@ int dm_easy_mesh_ctrl_t::update_tables(dm_easy_mesh_t *dm)
         }
 		dm->reset_db_cfg_type(db_cfg_type_sta_list_delete);
+        sta_topology_changed = true;
 
     }
 
@@ -4425,6 +4428,13 @@ int dm_easy_mesh_ctrl_t::update_tables(dm_easy_mesh_t *dm)
         }
     }
 
+    if (sta_topology_changed) {
+        /* dm_sta_list_t is now authoritative; rebuild and publish from it,
+         * rather than racing the queued table update from the association
+         * command. */
+        update_network_topology();
+        em_ctrl_t::get_em_ctrl_instance()->publish_network_topology();
+    }
     return 0;
 }
 
