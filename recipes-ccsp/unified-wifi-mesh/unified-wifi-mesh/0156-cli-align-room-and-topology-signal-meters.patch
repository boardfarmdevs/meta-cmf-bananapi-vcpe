                     <div class="topology-container">
                         <div class="topology-main">
                             <div id="topology-visualization">
@@ -2024,7 +2025,8 @@
     <div id="toast-container" class="toast-container"></div>
 
     <!-- Scripts -->
-    <script src="static/script.js?v=topology-preserve-arrangement-1"></script>
