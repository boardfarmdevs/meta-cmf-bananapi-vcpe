+// loadLocalRadioChannels reads the colocated Agent's actual kernel radio
+// state. EasyMesh Operating Channel Reports remain the primary source; this
+// bounded cache fills the startup gap before the Controller has received one.
+func loadLocalRadioChannels() map[int]int {
+	topologyRadioChannelCache.Lock()
+	defer topologyRadioChannelCache.Unlock()
+
+	if time.Since(topologyRadioChannelCache.updated) < 5*time.Second &&
+		len(topologyRadioChannelCache.channels) > 0 {
+		return topologyRadioChannelCache.channels
+	}
+
+	channels := make(map[int]int)
+	output, err := exec.Command("/usr/sbin/iw", "dev").Output()
+	if err == nil {
+		for _, match := range iwChannelLine.FindAllStringSubmatch(string(output), -1) {
+			channel, channelErr := strconv.Atoi(match[1])
+			frequency, frequencyErr := strconv.Atoi(match[2])
+			if channelErr != nil || frequencyErr != nil || channel <= 0 {
+				continue
+			}
+			band := -1
+			switch {
+			case frequency >= 2400 && frequency < 2500:
+				band = 0
+			case frequency >= 4900 && frequency < 5925:
+				band = 1
+			case frequency >= 5925 && frequency <= 7125:
+				band = 3
+			}
+			if band >= 0 {
+				channels[band] = channel
+			}
+		}
+	}
+
+	topologyRadioChannelCache.channels = channels
+	topologyRadioChannelCache.updated = time.Now()
+	return topologyRadioChannelCache.channels
+}
+
+func resolveTopologyBackhaulChannel(localParent bool, band, reported int,
+	localChannels map[int]int) int {
+	if reported > 0 {
+		return reported
+	}
+	if localParent {
+		if channel := localChannels[band]; channel > 0 {
+			return channel
+		}
+	}
+	return 0
+}
