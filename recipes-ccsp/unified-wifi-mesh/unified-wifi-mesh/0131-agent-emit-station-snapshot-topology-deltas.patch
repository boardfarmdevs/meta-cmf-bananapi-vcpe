+++ b/src/orch/em_orch.cpp
@@ -149,6 +149,14 @@ bool em_orch_t::submit_command(em_cmd_t *pcmd)
     } else {
         queue_push(m_pending, pcmd);
         push_stats(pcmd);
+        unsigned int pending = queue_count(m_pending);
+        if (pending > m_pending_high_water) {
+            m_pending_high_water = pending;
+            if ((pending & (pending - 1)) == 0) {
