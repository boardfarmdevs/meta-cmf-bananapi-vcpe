+namespace {
+
+em_sta_info_t make_associated_sta(const char *sta, const char *bssid,
+    const char *radio)
+{
+    em_sta_info_t info{};
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(sta), info.id);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(bssid), info.bssid);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(radio), info.radiomac);
+    info.associated = true;
+    return info;
+}
+
+} // namespace
+
+TEST(em_orch_agent_snapshot_delta_TEST, IdenticalFullSnapshotsEmitNoNotifications)
+{
+    const char *sta = "02:00:00:00:01:00";
+    const char *bssid = "02:00:00:10:00:01";
+    const char *radio = "02:00:00:20:00:01";
+    mac_address_t reporting_radio;
+    dm_easy_mesh_t current{};
+    em_sta_info_t current_info = make_associated_sta(sta, bssid, radio);
+
+    ASSERT_EQ(current.init(), 0);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(radio),
+        reporting_radio);
+    current.put_sta_info(&current_info, em_target_sta_map_consolidated);
+
+    for (unsigned int repeat = 0; repeat < 2; repeat++) {
+        dm_easy_mesh_t snapshot{};
+        em_sta_info_t snapshot_info = make_associated_sta(sta, bssid, radio);
+        ASSERT_EQ(snapshot.init(), 0);
+        snapshot.put_sta_info(&snapshot_info, em_target_sta_map_assoc);
+
+        EXPECT_EQ(em_orch_agent_t::retain_full_sta_snapshot_deltas(
+            &current, &snapshot, reporting_radio), 0u);
+        EXPECT_EQ(hash_map_count(snapshot.m_sta_assoc_map), 0u);
+        EXPECT_EQ(hash_map_count(snapshot.m_sta_dassoc_map), 0u);
+        EXPECT_EQ(hash_map_count(current.m_sta_map), 1u);
+        EXPECT_NE(current.get_sta_info(current_info.id, current_info.bssid,
+            current_info.radiomac, em_target_sta_map_consolidated), nullptr);
+
+        snapshot.deinit();
+    }
+
+    current.deinit();
+}
+
+TEST(em_orch_agent_snapshot_delta_TEST, BssMoveEmitsOneDisassocAndOneAssoc)
+{
+    const char *sta = "02:00:00:00:01:00";
+    const char *old_bssid = "02:00:00:10:00:01";
+    const char *new_bssid = "02:00:00:10:00:02";
+    const char *radio = "02:00:00:20:00:01";
+    mac_address_t reporting_radio;
+    dm_easy_mesh_t current{};
+    dm_easy_mesh_t snapshot{};
+    em_sta_info_t old_info = make_associated_sta(sta, old_bssid, radio);
+    em_sta_info_t new_info = make_associated_sta(sta, new_bssid, radio);
+
+    ASSERT_EQ(current.init(), 0);
+    ASSERT_EQ(snapshot.init(), 0);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(radio),
+        reporting_radio);
+    current.put_sta_info(&old_info, em_target_sta_map_consolidated);
+    snapshot.put_sta_info(&new_info, em_target_sta_map_assoc);
+
+    EXPECT_EQ(em_orch_agent_t::retain_full_sta_snapshot_deltas(
+        &current, &snapshot, reporting_radio), 2u);
+    EXPECT_EQ(hash_map_count(snapshot.m_sta_assoc_map), 1u);
+    EXPECT_EQ(hash_map_count(snapshot.m_sta_dassoc_map), 1u);
+    EXPECT_NE(snapshot.get_sta_info(new_info.id, new_info.bssid,
+        new_info.radiomac, em_target_sta_map_assoc), nullptr);
+    em_sta_info_t *disassoc = snapshot.get_sta_info(old_info.id,
+        old_info.bssid, old_info.radiomac, em_target_sta_map_disassoc);
+    ASSERT_NE(disassoc, nullptr);
+    EXPECT_FALSE(disassoc->associated);
+    EXPECT_EQ(current.get_sta_info(old_info.id, old_info.bssid,
+        old_info.radiomac, em_target_sta_map_consolidated), nullptr);
+
+    snapshot.deinit();
+    current.deinit();
+}
