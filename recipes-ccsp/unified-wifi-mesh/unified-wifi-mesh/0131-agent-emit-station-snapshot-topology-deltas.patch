+unsigned int em_orch_agent_t::retain_full_sta_snapshot_deltas(
+    dm_easy_mesh_t *current, dm_easy_mesh_t *snapshot,
+    const mac_address_t reporting_radio)
+{
+    if (current == NULL || snapshot == NULL || reporting_radio == NULL) {
+        return 0;
+    }
+
+    std::set<std::string> reported_keys;
+    std::vector<std::string> unchanged_keys;
+    dm_sta_t *sta = static_cast<dm_sta_t *>(
+        hash_map_get_first(snapshot->m_sta_assoc_map));
+    unsigned int assoc_delta = 0;
+    unsigned int disassoc_delta = 0;
+
+    while (sta != NULL) {
+        mac_addr_str_t sta_mac_str, bss_mac_str, radio_mac_str;
+        em_long_string_t key;
+        dm_easy_mesh_t::macbytes_to_string(sta->m_sta_info.id, sta_mac_str);
+        dm_easy_mesh_t::macbytes_to_string(sta->m_sta_info.bssid, bss_mac_str);
+        dm_easy_mesh_t::macbytes_to_string(sta->m_sta_info.radiomac,
+            radio_mac_str);
+        snprintf(key, sizeof(key), "%s@%s@%s", sta_mac_str, bss_mac_str,
+            radio_mac_str);
+        reported_keys.insert(key);
+
+        dm_sta_t *stale_dassoc = static_cast<dm_sta_t *>(
+            hash_map_remove(current->m_sta_dassoc_map, key));
+        delete stale_dassoc;
+
+        em_sta_info_t *existing = current->get_sta_info(sta->m_sta_info.id,
+            sta->m_sta_info.bssid, sta->m_sta_info.radiomac,
+            em_target_sta_map_consolidated);
+        if (existing != NULL && existing->associated) {
+            /* Refresh metrics/capabilities without advertising unchanged
+             * ownership as another association event. */
+            memcpy(existing, &sta->m_sta_info, sizeof(em_sta_info_t));
+            unchanged_keys.emplace_back(key);
+        } else {
+            assoc_delta++;
+        }
+        sta = static_cast<dm_sta_t *>(
+            hash_map_get_next(snapshot->m_sta_assoc_map, sta));
+    }
+
+    sta = static_cast<dm_sta_t *>(hash_map_get_first(current->m_sta_map));
+    while (sta != NULL) {
+        dm_sta_t *next = static_cast<dm_sta_t *>(
+            hash_map_get_next(current->m_sta_map, sta));
+        if (memcmp(sta->m_sta_info.radiomac, reporting_radio,
+                sizeof(mac_address_t)) == 0) {
+            mac_addr_str_t sta_mac_str, bss_mac_str, radio_mac_str;
+            em_long_string_t key;
+            dm_easy_mesh_t::macbytes_to_string(sta->m_sta_info.id,
+                sta_mac_str);
+            dm_easy_mesh_t::macbytes_to_string(sta->m_sta_info.bssid,
+                bss_mac_str);
+            dm_easy_mesh_t::macbytes_to_string(sta->m_sta_info.radiomac,
+                radio_mac_str);
+            snprintf(key, sizeof(key), "%s@%s@%s", sta_mac_str, bss_mac_str,
+                radio_mac_str);
+
+            if (reported_keys.find(key) == reported_keys.end()) {
+                em_sta_info_t removed_info = sta->m_sta_info;
+                removed_info.associated = false;
+                em_sta_info_t *current_disassoc = current->get_sta_info(
+                    removed_info.id, removed_info.bssid,
+                    removed_info.radiomac, em_target_sta_map_disassoc);
+                if (current_disassoc != NULL) {
+                    memcpy(current_disassoc, &removed_info,
+                        sizeof(em_sta_info_t));
+                } else {
+                    current->put_sta_info(&removed_info,
+                        em_target_sta_map_disassoc);
+                }
+                snapshot->put_sta_info(&removed_info,
+                    em_target_sta_map_disassoc);
+                dm_sta_t *old = static_cast<dm_sta_t *>(
+                    hash_map_remove(current->m_sta_map, key));
+                delete old;
+                disassoc_delta++;
+            }
+        }
+        sta = next;
+    }
+
+    for (const std::string &key : unchanged_keys) {
+        dm_sta_t *unchanged = static_cast<dm_sta_t *>(
+            hash_map_remove(snapshot->m_sta_assoc_map, key.c_str()));
+        delete unchanged;
+    }
+
+    if (assoc_delta != 0 || disassoc_delta != 0) {
+        em_printfout("Full STA snapshot delta radio=%s assoc=%u disassoc=%u suppressed=%zu",
+            util::mac_to_string(reporting_radio).c_str(), assoc_delta,
+            disassoc_delta, unchanged_keys.size());
+    }
+    return assoc_delta + disassoc_delta;
+}
