-    // filter: InitGoogleTest consumes --gtest_filter out of argv, so testing
-    // GTEST_FLAG(filter) afterwards cannot distinguish "caller asked for *"
-    // from "caller asked for nothing". Assigning the built-in exclusion list
-    // unconditionally after InitGoogleTest -- as this file used to -- overrides
-    // both --gtest_filter and GTEST_FILTER, so no subset can ever be selected
-    // and every invocation runs the entire binary.
-    bool caller_supplied_filter = (getenv("GTEST_FILTER") != NULL);
-    for (int i = 1; i < argc; i++) {
-        if (argv[i] != NULL && strncmp(argv[i], "--gtest_filter=", 15) == 0) {
-            caller_supplied_filter = true;
-            break;
-        }
-    }
-
-    ::testing::InitGoogleTest(&argc, argv);
-
-    if (!caller_supplied_filter)
-
-    // Only apply the built-in exclusion list when the caller did not ask for a
-    // specific filter. Assigning unconditionally here overrides both
-    // --gtest_filter and GTEST_FILTER, which makes it impossible to run a single
-    // test or suite -- every invocation runs the whole binary.
-    if (::testing::GTEST_FLAG(filter) == "*") {
-::testing::GTEST_FLAG(filter) =
+// The tests no run takes, the default run and a caller's filter alike (see main): upstream's list,
+// then the ones named after it, each with its cause.
+static const char k_excluded[] =
     "-dm_ap_mld_t_Test.DecodeValidJsonObjectWithNullParentID:"
     "dm_ap_mld_t_Test.DecodeNullJsonObjectWithValidParentID:"
     "dm_ap_mld_t_Test.DecodeInvalidJsonObjectWithValidParentID:"
@@ -737,7 +715,66 @@ int main(int argc, char **argv) {
     "ec_manager_t.process_direct_encap_dpp_msg_enrollee_null_src_mac:"
     "em_ctrl_t_Test.input_listen_default:"
