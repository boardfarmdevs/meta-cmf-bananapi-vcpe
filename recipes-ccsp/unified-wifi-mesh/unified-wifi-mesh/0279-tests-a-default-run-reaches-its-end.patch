+    "em_ctrl_t_Test.delete_node_existing_ieee80211g_24:"
+    "em_ctrl_t_Test.delete_node_existing_ieee80211n_5:"
+    "em_ctrl_t_Test.delete_node_existing_ieee8023ab:"
+    "em_ctrl_t_Test.delete_node_one_of_multiple_nodes:"
+    "em_ctrl_t_Test.get_al_node_non_al_nodes:"
+    "em_ctrl_t_Test.get_node_by_freq_band_24GHz:"
+    "em_ctrl_t_Test.get_node_by_freq_band_5GHz:"
+    "em_ctrl_t_Test.get_node_by_freq_band_6GHz:"
+    "em_ctrl_t_Test.get_node_by_freq_band_no_match:"
+    "em_ctrl_t_Test.get_phy_al_node_no_virtual_al:"
+    "em_ctrl_t_Test.reset_listeners_only_non_al_nodes:"
+    // init_network_topology asserts m_topology != NULL, and the fixture's controller has no
+    // topology: the process aborts.
+    "em_ctrl_t_Test.is_network_topology_initialized_valid:"
+    "em_ctrl_t_Test.init_network_topology_default:"
+    "em_ctrl_t_Test.update_network_topology_colocated:"
+    "em_ctrl_t_Test.update_network_topology_non_colocated:"
+    // em_simulator_t::configure writes past a stack array for the test's out-of-range number of
+    // operating classes (stack-buffer-overflow).
+    "EmSimulatorTest.ConfigureWithInvalidNumOperationalClasses:"
+    // These fail on the baseline (the lab image's sources through 0270 v4) as here: a fixture
+    // that sets up no data models, no operating class or interface of the kind the test
+    // expects, the agent's twin of a ctrl test upstream excludes, and 0132's test, whose command
+    // model has a STA map now.
+    "dm_easy_mesh_list_tTEST.get_first_op_class_valid:"
+    "dm_easy_mesh_t.get_bsta_bss_info_radio_not_found:"
+    "dm_easy_mesh_t.get_interfaces_list_success:"
+    "em_ctrl_t_Test.get_first_dm_valid:"
+    "em_ctrl_t_Test.get_next_dm_iterate_all_dms:"
+    "em_ctrl_t_Test.get_data_model_valid_al_mac:"
+    "em_network_topo_t.find_topology_by_bh_associated_root:"
+    "em_orch_agent_t_TEST.is_em_ready_for_orch_fini_set_ssid_not_ready:"
+    "em_cmd_sta_assoc_t.stage_clones_are_lightweight_and_preserve_overrides";
+
+int main(int argc, char **argv) {
+    ::testing::InitGoogleTest(&argc, argv);
+
+    // The exclusion list holds for every run: the default one, and a caller's filter
+    // (--gtest_filter or GTEST_FILTER), whose positive part then selects among the other tests,
+    // so a suite's filter cannot run an excluded crash in its process. EM_UT_RUN_EXCLUDED=1 runs
+    // exactly the caller's filter, excluded tests included.
+    const char *run_excluded = getenv("EM_UT_RUN_EXCLUDED");
+    if (run_excluded == NULL || strcmp(run_excluded, "1") != 0) {
+        std::string filter = ::testing::GTEST_FLAG(filter);
+        filter += (filter.find('-') == std::string::npos) ? "-" : ":";
+        filter += k_excluded + 1;
+        ::testing::GTEST_FLAG(filter) = filter;
     }
     return RUN_ALL_TESTS();
 }
