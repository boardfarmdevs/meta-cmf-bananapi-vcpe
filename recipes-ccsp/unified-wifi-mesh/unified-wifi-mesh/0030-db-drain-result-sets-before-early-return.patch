From: Codex <codex@openai.com>
Date: Mon, 17 Aug 2026 06:00:00 +0000
Subject: [PATCH] db: drain result sets before early return

db_client_t owns a MYSQL_RES plus a heap-allocated result_context_t until
next_result() reaches end-of-results.  The table existence searches and the
STA/device database comparisons returned immediately after finding a match,
leaving both allocations live.

This is especially costly in the controller's AP-metrics path.  Every report
persists every station, and each unchanged station performs both an existence
search and a full-row comparison.  A normal successful match therefore leaked
two MariaDB result sets per station per reporting cycle, producing the observed
linear em_ctrl RSS growth and eventual cgroup OOM kill.

Drain the remaining rows before successful early returns.  The existing
next_result() end-of-results behavior then releases MYSQL_RES and its context;
the query and data-model behavior are otherwise unchanged.

Upstream-Status: Pending
---
 src/db/db_easy_mesh.cpp     | 9 ++++++++-
 src/dm/dm_device_list.cpp   | 1 +
 src/dm/dm_sta_list.cpp      | 1 +
 3 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/src/db/db_easy_mesh.cpp b/src/db/db_easy_mesh.cpp
--- a/src/db/db_easy_mesh.cpp
+++ b/src/db/db_easy_mesh.cpp
@@ -254,7 +254,14 @@ bool db_easy_mesh_t::entry_exists_in_table(db_client_t& db_client, void *key)
 
     ctx = db_client.execute(query);
 
-    return search_db(db_client, ctx, key);
+    bool found = search_db(db_client, ctx, key);
+    if (found) {
+        /* search_db() returns immediately on a match.  Consume the remaining
+         * rows so next_result() releases MYSQL_RES and result_context_t. */
+        while (db_client.next_result(ctx)) {
+        }
+    }
+    return found;
 }
 
 void db_easy_mesh_t::delete_table(db_client_t& db_client)
diff --git a/src/dm/dm_device_list.cpp b/src/dm/dm_device_list.cpp
--- a/src/dm/dm_device_list.cpp
+++ b/src/dm/dm_device_list.cpp
@@ -366,6 +366,7 @@ bool dm_device_list_t::compare_db(db_client_t& db_client, const dm_device_t& sta)
         info.test_cap = static_cast<unsigned char> (db_client.get_number(ctx, 27));
 
         if (memcmp(static_cast<const void*>(&sta.m_device_info), static_cast<const void*>(&info), sizeof(em_device_info_t)) == 0) {
+            while (db_client.next_result(ctx)) {}
             return true;
         }
     }
diff --git a/src/dm/dm_sta_list.cpp b/src/dm/dm_sta_list.cpp
--- a/src/dm/dm_sta_list.cpp
+++ b/src/dm/dm_sta_list.cpp
@@ -398,6 +398,7 @@ bool dm_sta_list_t::compare_db(db_client_t& db_client, const dm_sta_t& sta)
         dm_easy_mesh_t::unhex(static_cast<unsigned int>(strlen(frame_body)), frame_body, EM_MAX_FRAME_BODY_LEN, info.frame_body);
 
         if (memcmp(static_cast<const void*>(&sta.m_sta_info), static_cast<const void*>(&info), sizeof(em_sta_info_t)) == 0) {
+            while (db_client.next_result(ctx)) {}
             return true;
         }
     }
