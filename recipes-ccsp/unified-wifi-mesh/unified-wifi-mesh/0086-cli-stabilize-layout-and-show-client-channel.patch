-void em_agent_t::handle_2s_tick()
+bool em_agent_t::publish_initial_operating_channels()
 {
+    wifi_bus_desc_t *desc = get_bus_descriptor();
+    if (desc == NULL) {
+        em_printfout("Cannot publish initial operating channels: bus descriptor is null");
+        return false;
+    }
+
+    unsigned int radio_nodes = 0;
+    em_t *em = static_cast<em_t *>(hash_map_get_first(m_em_map));
+    while (em != NULL) {
+        if (!em->is_al_interface_em() &&
+            em->get_service_type() == em_service_type_agent) {
+            radio_nodes++;
+            if (em->get_state() < em_state_agent_topo_synchronized) {
+                return false;
+            }
+        }
+        em = static_cast<em_t *>(hash_map_get_next(m_em_map, em));
+    }
 
+    if (radio_nodes == 0 || radio_nodes != m_data_model.get_num_radios()) {
+        return false;
+    }
+
+    for (unsigned int radio_index = 0;
+         radio_index < m_data_model.get_num_radios(); radio_index++) {
+        raw_data_t channel_data = {};
+        char channel_path[64];
+        snprintf(channel_path, sizeof(channel_path),
+            "Device.WiFi.Radio.%u.Channel", radio_index + 1);
+
+        bus_error_t result = desc->bus_data_get_fn(
+            &m_bus_hdl, channel_path, &channel_data);
+        if (result != bus_error_success) {
+            em_printfout("Cannot read live channel from %s: error %d",
+                channel_path, result);
+            return false;
+        }
+
+        unsigned int channel = 0;
+        switch (channel_data.data_type) {
+            case bus_data_type_uint8:
+                channel = channel_data.raw_data.u8;
+                break;
+            case bus_data_type_uint16:
+                channel = channel_data.raw_data.u16;
+                break;
+            case bus_data_type_uint32:
+                channel = channel_data.raw_data.u32;
+                break;
+            case bus_data_type_int8:
+                channel = static_cast<unsigned int>(channel_data.raw_data.i8);
+                break;
+            case bus_data_type_int16:
+                channel = static_cast<unsigned int>(channel_data.raw_data.i16);
+                break;
+            case bus_data_type_int32:
+                channel = static_cast<unsigned int>(channel_data.raw_data.i32);
+                break;
+            default:
+                break;
+        }
+        desc->bus_data_free_fn(&channel_data);
+
+        dm_radio_t *radio = m_data_model.get_radio(radio_index);
+        em_op_class_info_t *current = NULL;
+        for (unsigned int i = 0; i < m_data_model.get_num_op_class(); i++) {
+            em_op_class_info_t *candidate =
+                m_data_model.get_op_class_info(i);
+            if (candidate->id.type == em_op_class_type_current &&
+                memcmp(candidate->id.ruid, radio->get_radio_interface_mac(),
+                    sizeof(mac_address_t)) == 0) {
+                current = candidate;
+                break;
+            }
+        }
+        if (channel == 0 || current == NULL) {
+            em_printfout("Cannot reconcile initial channel for radio %s",
+                util::mac_to_string(radio->get_radio_interface_mac()).c_str());
+            return false;
+        }
+
+        if (current->channel != channel) {
+            em_printfout("Reconciled radio %s channel from %u to %u",
+                util::mac_to_string(radio->get_radio_interface_mac()).c_str(),
+                current->channel, channel);
+            current->channel = channel;
+        }
+    }
+
+    unsigned int reports_sent = 0;
+    em = static_cast<em_t *>(hash_map_get_first(m_em_map));
+    while (em != NULL) {
+        if (!em->is_al_interface_em() &&
+            em->get_service_type() == em_service_type_agent &&
+            em->send_operating_channel_report_msg() > 0) {
+            reports_sent++;
+        }
+        em = static_cast<em_t *>(hash_map_get_next(m_em_map, em));
+    }
+    em_printfout("Initial operating channel reports sent: %u/%u",
+        reports_sent, radio_nodes);
+    return reports_sent == radio_nodes;
+}
+
+void em_agent_t::handle_2s_tick()
+{
+    if (!m_initial_op_channel_report_sent) {
+        m_initial_op_channel_report_sent = publish_initial_operating_channels();
+    }
 }
 
