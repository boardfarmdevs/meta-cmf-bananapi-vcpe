From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <revogelaar@gmail.com>
Date: Tue, 18 Aug 2026 15:15:00 -0700
Subject: [PATCH] cli: expose and refresh reported client RCPI

The controller already persists RCPI from periodic AP Metrics Responses, but
get_network intentionally emits only topology STA fields.  The WebUI adapter
used that summary for /api/v1/clients, so every ClientMetrics object contained
a zero RSSI and Connected Clients rendered N/A.

Read metrics from the controller's detailed get_sta model, join them to the
live topology inventory by STA MAC, expose the standard's raw 0..220 value as
client_metrics.rcpi, and derive the existing rssi_dbm presentation value using
RCPI / 2 - 110.  Show both values under Signal.  Refresh /clients every two
seconds while Connected Clients is visible, with an in-flight guard so a slow
native query cannot create an overlapping request backlog.

Upstream-Status: Pending
Signed-off-by: Rob Vogelaar <revogelaar@gmail.com>

Its page hunks (src/rdkb-cli/static) moved to easymesh-medium's topology-ui,
which builds the page the controller image serves.
---
 src/rdkb-cli/main.go |   81 +++++++++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 79 insertions(+), 2 deletions(-)

diff --git a/src/rdkb-cli/main.go b/src/rdkb-cli/main.go
--- a/src/rdkb-cli/main.go
+++ b/src/rdkb-cli/main.go
@@ -196,6 +196,7 @@ type Client struct {
 }
 
 type ClientMetrics struct {
+        RCPI        int       `json:"rcpi"`
         RSSI        int       `json:"rssi_dbm"`
         SNR         int       `json:"snr_db"`
         TxRate      int       `json:"tx_rate_mbps"`
@@ -3151,6 +3152,82 @@ func buildLiveInventory() ([]Device, []Client, error) {
 	return inventoryDevices, inventoryClients, nil
 }
 
+// loadLiveClientMetrics uses the detailed STA command because the topology
+// form returned by get_network intentionally omits periodic metric fields.
+func loadLiveClientMetrics() (map[string]ClientMetrics, error) {
+	cmd := C.CString("get_sta OneWifiMesh")
+	defer C.free(unsafe.Pointer(cmd))
+
+	var tree *C.em_network_node_t
+	for attempt := 0; attempt < 3; attempt++ {
+		tree = execEMCommand(cmd, nil)
+		if tree != nil {
+			break
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	if tree == nil {
+		return nil, fmt.Errorf("controller returned no STA metrics data")
+	}
+	defer C.free_network_tree(tree)
+
+	observedAt := time.Now()
+	metricsByMAC := make(map[string]ClientMetrics)
+	directChild := func(node *C.em_network_node_t, key string) *C.em_network_node_t {
+		if node == nil {
+			return nil
+		}
+		for i := 0; i < int(node.num_children); i++ {
+			child := node.child[i]
+			if child != nil && C.GoString(&child.key[0]) == key {
+				return child
+			}
+		}
+		return nil
+	}
+	var walk func(*C.em_network_node_t)
+	walk = func(node *C.em_network_node_t) {
+		if node == nil {
+			return
+		}
+		macNode := directChild(node, "MACAddress")
+		rcpiNode := directChild(node, "RCPI")
+		if macNode != nil && rcpiNode != nil &&
+			C.get_node_type(macNode) == C.em_network_node_data_type_string &&
+			C.get_node_type(rcpiNode) == C.em_network_node_data_type_number {
+			mac := strings.ToLower(C.GoString(&macNode.value_str[0]))
+			rcpi := int(rcpiNode.value_int)
+			if mac != "" && rcpi > 0 && rcpi <= 220 {
+				metricsByMAC[mac] = ClientMetrics{
+					RCPI: rcpi, RSSI: rcpi/2 - 110, LastUpdated: observedAt,
+				}
+			}
+		}
+		for i := 0; i < int(node.num_children); i++ {
+			walk(node.child[i])
+		}
+	}
+	walk(tree)
+	return metricsByMAC, nil
+}
+
+func getLiveClientsWithMetrics() ([]Client, error) {
+	_, clientList, err := getLiveInventory()
+	if err != nil {
+		return nil, err
+	}
+	metricsByMAC, err := loadLiveClientMetrics()
+	if err != nil {
+		return nil, err
+	}
+	for i := range clientList {
+		if metrics, found := metricsByMAC[strings.ToLower(clientList[i].MAC)]; found {
+			clientList[i].ClientMetrics = metrics
+		}
+	}
+	return clientList, nil
+}
+
 // getLiveInventory falls back only to the last successful live snapshot.
 func getLiveInventory() ([]Device, []Client, error) {
 	inventoryDevices, inventoryClients, err := buildLiveInventory()
@@ -3248,7 +3325,7 @@ func getDeviceHandler(w http.ResponseWriter, r *http.Request) {
 
 func getClientsHandler(w http.ResponseWriter, r *http.Request) {
 	w.Header().Set("Content-Type", "application/json")
-	_, liveClientList, err := getLiveInventory()
+	liveClientList, err := getLiveClientsWithMetrics()
 	if err != nil {
 		http.Error(w, "Live EasyMesh inventory unavailable", http.StatusServiceUnavailable)
 		return
@@ -3274,7 +3351,7 @@ func getClientsHandler(w http.ResponseWriter, r *http.Request) {
 func getClientHandler(w http.ResponseWriter, r *http.Request) {
 	vars := mux.Vars(r)
 	mac := vars["mac"]
-	_, liveClientList, err := getLiveInventory()
+	liveClientList, err := getLiveClientsWithMetrics()
 	if err != nil {
 		http.Error(w, "Live EasyMesh inventory unavailable", http.StatusServiceUnavailable)
 		return
