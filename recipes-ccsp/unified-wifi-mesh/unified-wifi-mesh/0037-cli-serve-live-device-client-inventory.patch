+// buildLiveInventory maps the current controller tree to the dashboard models.
+// Fields absent from EasyMesh stay empty rather than inheriting demo values.
+func buildLiveInventory() ([]Device, []Client, error) {
+	cmd := C.CString("get_network OneWifiMesh")
+	defer C.free(unsafe.Pointer(cmd))
+
+	var tree *C.em_network_node_t
+	for attempt := 0; attempt < 3; attempt++ {
+		tree = execEMCommand(cmd, nil)
+		if tree != nil {
+			break
+		}
+		time.Sleep(200 * time.Millisecond)
+	}
+	if tree == nil {
+		return nil, nil, fmt.Errorf("controller returned no network data")
+	}
+	defer C.free_network_tree(tree)
+
+	root := getNetworkTreeByKey(tree, "Device")
+	if root == nil {
+		return nil, nil, fmt.Errorf("controller network tree has no Device root")
+	}
+
+	var inventoryDevices []Device
+	var inventoryClients []Client
+	agentCount, extenderCount := 1, 1
+	observedAt := time.Now()
+	seenClients := make(map[string]struct{})
+
+	var traverse func(*C.em_network_node_t, int)
+	traverse = func(deviceNode *C.em_network_node_t, depth int) {
+		if deviceNode == nil {
+			return
+		}
+		deviceID := getTreeValue(deviceNode, "ID")
+		backhaul := getNetworkTreeByKey(deviceNode, "Backhaul")
+		if deviceID == "" || backhaul == nil {
+			return
+		}
+		radios := parseRadioList(deviceNode.child[2])
+
+		role := "Controller"
+		if depth != 0 {
+			backhaulMAC := getTreeValue(backhaul, "MACAddress")
+			backhaulMedia := getTreeValue(backhaul, "MediaType")
+			if backhaulMAC == "00:00:00:00:00:00" || backhaulMedia == "Ethernet" {
+				role = fmt.Sprintf("Agent-%d", agentCount)
+				agentCount++
+			} else {
+				role = fmt.Sprintf("Extender-%d", extenderCount)
+				extenderCount++
+			}
+		}
+
+		bands := make([]string, 0, 3)
+		seenBands := make(map[string]struct{})
+		for _, radio := range radios {
+			band := ""
+			switch radio.Band {
+			case 0:
+				band = "2.4 GHz"
+			case 1:
+				band = "5 GHz"
+			case 3:
+				band = "6 GHz"
+			}
+			if _, found := seenBands[band]; band != "" && !found {
+				seenBands[band] = struct{}{}
+				bands = append(bands, band)
+			}
+		}
+
+		inventoryDevices = append(inventoryDevices, Device{
+			MAC: deviceID, Role: role, Vendor: "RDK-B", Model: "EasyMesh node",
+			Status: "Online", LastSeen: observedAt, Uptime: "Unknown",
+			Capabilities: Capability{SupportedBands: bands},
+		})
+
+		for _, radio := range radios {
+			for _, bss := range radio.BSSList {
+				if bss.HaulType == "Backhaul" || bss.SSID == "" {
+					continue
+				}
+				for _, sta := range bss.STAList {
+					if !sta.Associated || sta.MACAddress == "" {
+						continue
+					}
+					identity := sta.MACAddress + "_" + sta.MLDAddr
+					if _, found := seenClients[identity]; found {
+						continue
+					}
+					seenClients[identity] = struct{}{}
+					inventoryClients = append(inventoryClients, Client{
+						MAC: sta.MACAddress, Hostname: sta.MACAddress,
+						ConnectedAP: deviceID, ConnectedBSSID: bss.BSSID,
+						DeviceType: "Wi-Fi Client", LastActivity: observedAt,
+					})
+				}
+			}
+		}
+
+		children := getNetworkTreeByKey(backhaul, "Child")
+		if children == nil {
+			return
+		}
+		for i := 0; i < int(children.num_children); i++ {
+			traverse(children.child[i], depth+1)
+		}
+	}
+	traverse(root, 0)
+	if len(inventoryDevices) == 0 {
+		return nil, nil, fmt.Errorf("controller network tree contains no devices")
+	}
+	return inventoryDevices, inventoryClients, nil
+}
+
+// getLiveInventory falls back only to the last successful live snapshot.
+func getLiveInventory() ([]Device, []Client, error) {
+	inventoryDevices, inventoryClients, err := buildLiveInventory()
+	if err == nil {
+		liveInventoryMutex.Lock()
+		liveDevices = append([]Device(nil), inventoryDevices...)
+		liveClients = append([]Client(nil), inventoryClients...)
+		haveLiveInventory = true
+		liveInventoryMutex.Unlock()
+		return inventoryDevices, inventoryClients, nil
+	}
+
+	liveInventoryMutex.RLock()
+	defer liveInventoryMutex.RUnlock()
+	if haveLiveInventory {
+		return append([]Device(nil), liveDevices...), append([]Client(nil), liveClients...), nil
+	}
+	return nil, nil, err
+}
