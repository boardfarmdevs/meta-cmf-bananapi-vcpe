+// A routing drop for a BSS the sender's model lacks: the first per message type and sender is
+// logged at once, the next ones within a minute are counted, and the first line after the minute
+// carries that count.
+TEST(em_ctrl_routing_drop, the_first_is_logged_then_one_line_a_minute_with_the_count)
+{
+    std::map<std::string, em_ctrl_t::routing_drop_t> drops;
+    const auto t0 = std::chrono::steady_clock::now();
+    const std::string notif = "0001@02:72:f9:7f:07:85";
+    unsigned long since = 99;
+    bool overflow = true;
+
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, notif, t0, &since, &overflow));
+    EXPECT_EQ(since, 0UL);
+    EXPECT_FALSE(overflow);
+    EXPECT_FALSE(em_ctrl_t::routing_drop_due(drops, notif, t0 + std::chrono::seconds(10), &since, &overflow));
+    EXPECT_FALSE(em_ctrl_t::routing_drop_due(drops, notif, t0 + std::chrono::seconds(59), &since, &overflow));
+    // another message type, or another sender, is its own pair
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, "800c@02:72:f9:7f:07:85",
+        t0 + std::chrono::seconds(20), &since, &overflow));
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, "0001@02:c2:b8:31:3a:f8",
+        t0 + std::chrono::seconds(20), &since, &overflow));
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, notif, t0 + std::chrono::seconds(61), &since, &overflow));
+    EXPECT_EQ(since, 2UL);
+    EXPECT_FALSE(em_ctrl_t::routing_drop_due(drops, notif, t0 + std::chrono::seconds(62), &since, &overflow));
+    // after a quiet while, the next drop is logged at once with the one counted at 62 s
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, notif, t0 + std::chrono::seconds(200), &since, &overflow));
+    EXPECT_EQ(since, 1UL);
+    // and the next after another quiet while with none
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, notif, t0 + std::chrono::seconds(300), &since, &overflow));
+    EXPECT_EQ(since, 0UL);
+    EXPECT_FALSE(overflow);
+}
+
+// The pairs kept are capped: quiet ones go first, and while every kept pair is younger than 10
+// minutes, new pairs' drops are counted together under the one overflow entry, logged at most
+// once a minute.
+TEST(em_ctrl_routing_drop, the_pairs_are_capped_and_the_rest_counted_together)
+{
+    std::map<std::string, em_ctrl_t::routing_drop_t> drops;
+    const auto t0 = std::chrono::steady_clock::now();
+    const size_t cap = em_ctrl_t::routing_drop_pairs;
+    unsigned long since = 0;
+    bool overflow = false;
+
+    for (size_t i = 0; i < cap; i++) {
+        EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, "0001@sender-" + std::to_string(i), t0,
+            &since, &overflow));
+        EXPECT_FALSE(overflow);
+    }
+    EXPECT_EQ(drops.size(), cap);
+    // full of young pairs: a new pair is the overflow entry's, its first drop logged at once
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, "0001@late", t0 + std::chrono::minutes(5),
+        &since, &overflow));
+    EXPECT_TRUE(overflow);
+    EXPECT_EQ(since, 0UL);
+    EXPECT_EQ(drops.count("0001@late"), 0u);
+    EXPECT_EQ(drops.size(), cap + 1);
+    // the next new pairs within its minute are counted, and the line after it carries the count
+    EXPECT_FALSE(em_ctrl_t::routing_drop_due(drops, "0001@late-2",
+        t0 + std::chrono::minutes(5) + std::chrono::seconds(10), &since, &overflow));
+    EXPECT_FALSE(em_ctrl_t::routing_drop_due(drops, "800c@late-3",
+        t0 + std::chrono::minutes(5) + std::chrono::seconds(20), &since, &overflow));
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, "0001@late-4",
+        t0 + std::chrono::minutes(6) + std::chrono::seconds(1), &since, &overflow));
+    EXPECT_TRUE(overflow);
+    EXPECT_EQ(since, 2UL);
+    EXPECT_EQ(drops.size(), cap + 1);
+    // a kept pair is still its own
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, "0001@sender-0",
+        t0 + std::chrono::minutes(7), &since, &overflow));
+    EXPECT_FALSE(overflow);
+    // once pairs are quiet for 10 minutes they go, and a new pair is kept again
+    EXPECT_TRUE(em_ctrl_t::routing_drop_due(drops, "0001@later", t0 + std::chrono::minutes(11),
+        &since, &overflow));
+    EXPECT_FALSE(overflow);
+    EXPECT_EQ(drops.count("0001@later"), 1u);
+    EXPECT_EQ(drops.count("0001@sender-0"), 1u);
+    EXPECT_EQ(drops.count(em_ctrl_t::routing_drop_overflow), 1u);
+    EXPECT_EQ(drops.size(), 3u);
+}
