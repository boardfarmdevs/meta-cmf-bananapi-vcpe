+bool em_ctrl_t::routing_drop_due(std::map<std::string, routing_drop_t> &drops, const std::string &key,
+        std::chrono::steady_clock::time_point now, unsigned long *since, bool *overflow)
+{
+    *since = 0;
+    *overflow = false;
+    auto it = drops.find(key);
+    if (it == drops.end()) {
+        // bounded: pairs quiet for 10 minutes go first; while every kept pair is younger, a new
+        // pair's drops are counted together under the one overflow entry
+        if (drops.size() >= routing_drop_pairs) {
+            for (auto old = drops.begin(); old != drops.end();) {
+                if (now - old->second.logged > std::chrono::minutes(10)) {
+                    old = drops.erase(old);
+                } else {
+                    ++old;
+                }
+            }
+        }
+        if (drops.size() < routing_drop_pairs) {
+            drops[key] = {now, 0};
+            return true;
+        }
+        *overflow = true;
+        it = drops.find(routing_drop_overflow);
+        if (it == drops.end()) {
+            drops[routing_drop_overflow] = {now, 0};
+            return true;
+        }
+    }
+    if (now - it->second.logged < std::chrono::minutes(1)) {
+        it->second.dropped++;
+        return false;
+    }
+    *since = it->second.dropped;
+    it->second = {now, 0};
+    return true;
+}
+
+void em_ctrl_t::note_routing_drop(unsigned short msg_type, const unsigned char *src, const unsigned char *bssid)
+{
+    const std::string sender = util::mac_to_string(src);
+    char key[32];
+    unsigned long since = 0;
+    bool overflow = false;
+
+    snprintf(key, sizeof(key), "%04x@%s", msg_type, sender.c_str());
+    if (!routing_drop_due(m_routing_drops, key, std::chrono::steady_clock::now(), &since, &overflow)) {
+        return;
+    }
+    if (overflow) {
+        // a Topology Notification may be among the drops counted together
+        util::em_util_print(EM_LOG_LVL_ERROR, EM_STDOUT, __FILENAME__, __LINE__,
+                "msg 0x%04x from %s dropped: bss %s is not in its model; drops of more than %zu message type and sender pairs counted together (%lu more since the last line)",
+                msg_type, sender.c_str(), util::mac_to_string(bssid).c_str(), routing_drop_pairs, since);
+        return;
+    }
+    const easymesh_log_level_t level = (msg_type == em_msg_type_topo_notif) ?
+            EM_LOG_LVL_ERROR : EM_LOG_LVL_INFO;
+    if (since == 0) {
+        util::em_util_print(level, EM_STDOUT, __FILENAME__, __LINE__,
+                "msg 0x%04x from %s dropped: bss %s is not in its model",
+                msg_type, sender.c_str(), util::mac_to_string(bssid).c_str());
+    } else {
+        util::em_util_print(level, EM_STDOUT, __FILENAME__, __LINE__,
+                "msg 0x%04x from %s dropped: bss %s is not in its model (%lu more since the last line)",
+                msg_type, sender.c_str(), util::mac_to_string(bssid).c_str(), since);
+    }
+}
