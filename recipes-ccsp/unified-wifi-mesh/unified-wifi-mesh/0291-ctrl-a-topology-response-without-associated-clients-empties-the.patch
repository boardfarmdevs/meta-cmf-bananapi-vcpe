+/* The BSSIDs an AP Operational BSS TLV (17.2.4) lists, added to bssids: false when it is
+ * malformed. */
+bool em_configuration_t::operational_bssids(const unsigned char *value, unsigned int len,
+                                            std::set<std::string> &bssids)
+{
+    unsigned int off = 0;
+
+    if (len < 1) {
+        return false;
+    }
+    const unsigned int radios = value[off++];
+    for (unsigned int r = 0; r < radios; r++) {
+        if (len - off < sizeof(mac_address_t) + 1) {
+            return false;
+        }
+        off += sizeof(mac_address_t);
+        const unsigned int bss_count = value[off++];
+        for (unsigned int b = 0; b < bss_count; b++) {
+            if (len - off < sizeof(bssid_t) + 1) {
+                return false;
+            }
+            bssids.insert(util::mac_to_string(value + off));
+            off += sizeof(bssid_t);
+            const unsigned int ssid_len = value[off++];
+            if (len - off < ssid_len) {
+                return false;
+            }
+            off += ssid_len;
+        }
+    }
+    return off == len;
+}
