+// A Topology Notification's leave path, shared with a Topology Response without Associated
+// Clients: a station that is no MLD leaves as remove_non_mlo_sta_assoc removes it.
+TEST(em_configuration_t, a_leave_without_an_mld_removes_the_live_owner)
+{
+    dm_easy_mesh_t dm;
+    em_sta_info_t info = {};
+
+    dm.init();
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("02:00:00:00:6c:00"), info.id);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("72:00:00:00:6a:00"), info.bssid);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("02:00:00:00:6a:00"), info.radiomac);
+    info.associated = true;
+    dm.put_sta_info(&info, em_target_sta_map_consolidated);
+
+    EXPECT_TRUE(em_configuration_t::remove_sta_assoc(&dm, info));
+    EXPECT_EQ(dm.get_sta_info(info.id, info.bssid, info.radiomac,
+        em_target_sta_map_consolidated), nullptr);
+    em_sta_info_t *withdrawn = dm.get_sta_info(info.id, info.bssid, info.radiomac,
+        em_target_sta_map_disassoc);
+    ASSERT_NE(withdrawn, nullptr);
+    EXPECT_FALSE(withdrawn->associated);
+    EXPECT_TRUE(dm.db_cfg_type_is_set(db_cfg_type_sta_list_delete));
+    dm.deinit();
+}
+
+// An AP Operational BSS TLV: radios(1); per radio its RUID(6) and BSS count(1); per BSS its
+// BSSID(6), SSID length(1) and SSID.
+static std::vector<unsigned char> operational_bss_tlv()
+{
+    return {
+        2,
+        0x02, 0x00, 0x00, 0x00, 0x6a, 0x00, 2,
+        0x72, 0x00, 0x00, 0x00, 0x6a, 0x00, 4, 'h', 'o', 'm', 'e',
+        0x72, 0x00, 0x00, 0x00, 0x6a, 0x01, 0,
+        0x02, 0x00, 0x00, 0x00, 0x6b, 0x00, 1,
+        0x72, 0x00, 0x00, 0x00, 0x6b, 0x00, 3, 'b', 'h', '5',
+    };
+}
+
+TEST(em_configuration_t, operational_bssids_lists_every_bss_of_every_radio)
+{
+    std::vector<unsigned char> tlv = operational_bss_tlv();
+    std::set<std::string> bssids;
+
+    EXPECT_TRUE(em_configuration_t::operational_bssids(tlv.data(),
+        static_cast<unsigned int>(tlv.size()), bssids));
+    EXPECT_EQ(bssids, (std::set<std::string>{"72:00:00:00:6a:00", "72:00:00:00:6a:01",
+        "72:00:00:00:6b:00"}));
+
+    // a radio that operates no BSS is well formed
+    std::vector<unsigned char> idle = {1, 0x02, 0x00, 0x00, 0x00, 0x6c, 0x00, 0};
+    bssids.clear();
+    EXPECT_TRUE(em_configuration_t::operational_bssids(idle.data(),
+        static_cast<unsigned int>(idle.size()), bssids));
+    EXPECT_TRUE(bssids.empty());
+}
+
+TEST(em_configuration_t, operational_bssids_refuses_a_malformed_tlv)
+{
+    std::vector<unsigned char> tlv = operational_bss_tlv();
+    std::set<std::string> bssids;
+
+    // the last SSID cut short
+    EXPECT_FALSE(em_configuration_t::operational_bssids(tlv.data(),
+        static_cast<unsigned int>(tlv.size() - 1), bssids));
+    // a byte after the last BSS
+    tlv.push_back(0);
+    EXPECT_FALSE(em_configuration_t::operational_bssids(tlv.data(),
+        static_cast<unsigned int>(tlv.size()), bssids));
+    // no radio count
+    EXPECT_FALSE(em_configuration_t::operational_bssids(tlv.data(), 0, bssids));
+    // a radio cut inside its RUID
+    EXPECT_FALSE(em_configuration_t::operational_bssids(tlv.data(), 4, bssids));
+}
+
+// Only the associated stations on a listed BSS leave: a BSS the response does not list keeps
+// its stations, and a row already unassociated is no leave.
+TEST(em_configuration_t, listed_associations_takes_associated_stations_on_listed_bsss_only)
+{
+    dm_easy_mesh_t dm;
+    em_sta_info_t listed = {}, unlisted = {}, gone = {};
+
+    dm.init();
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("02:00:00:ee:ee:01"), listed.id);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("72:00:00:00:6a:00"), listed.bssid);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("02:00:00:00:6a:00"), listed.radiomac);
+    listed.associated = true;
+    unlisted = listed;
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("02:00:00:ee:ee:02"), unlisted.id);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("72:00:00:00:6b:00"), unlisted.bssid);
+    gone = listed;
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("02:00:00:ee:ee:03"), gone.id);
+    gone.associated = false;
+    dm.put_sta_info(&listed, em_target_sta_map_consolidated);
+    dm.put_sta_info(&unlisted, em_target_sta_map_consolidated);
+    dm.put_sta_info(&gone, em_target_sta_map_consolidated);
+
+    std::vector<em_sta_info_t> out;
+    em_configuration_t::listed_associations(&dm,
+        std::set<std::string>{"72:00:00:00:6a:00", "72:00:00:00:6a:01"}, out);
+    ASSERT_EQ(out.size(), 1u);
+    EXPECT_EQ(memcmp(out[0].id, listed.id, sizeof(mac_address_t)), 0);
+    EXPECT_EQ(memcmp(out[0].bssid, listed.bssid, sizeof(bssid_t)), 0);
+
+    out.clear();
+    em_configuration_t::listed_associations(&dm, std::set<std::string>{}, out);
+    EXPECT_TRUE(out.empty());
+    dm.deinit();
+}
