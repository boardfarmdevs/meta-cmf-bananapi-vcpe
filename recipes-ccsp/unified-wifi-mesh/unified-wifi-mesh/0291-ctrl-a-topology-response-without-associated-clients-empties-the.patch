+        const std::set<std::string> &bssids, std::vector<em_sta_info_t> &out)
+{
+    for (dm_sta_t *sta = static_cast<dm_sta_t *>(hash_map_get_first(dm->m_sta_map));
+            sta != NULL;
+            sta = static_cast<dm_sta_t *>(hash_map_get_next(dm->m_sta_map, sta))) {
+        if (sta->m_sta_info.associated &&
+                bssids.count(util::mac_to_string(sta->m_sta_info.bssid)) != 0) {
+            out.push_back(sta->m_sta_info);
+        }
+    }
+}
+
+/* A Topology Response without Associated Clients: each associated station on a BSS in bssids,
+ * in every model of the sender's agent, leaves through a Topology Notification's leave path (its
+ * rows out of the live and pending maps, then the association event with assoc_event 0). The
+ * summary line counts the agent's removals and its responses without the TLV since start, so an
+ * agent whose responses keep removing stations (one omitting the TLV with clients associated)
+ * shows as numbers. */
+unsigned int em_configuration_t::reconcile_listed_bss_without_clients(dm_easy_mesh_t *dm,
+        const std::set<std::string> &bssids)
+{
+    struct leave_t {
+        dm_easy_mesh_t *dm;
+        em_sta_info_t sta;
+    };
+    std::vector<leave_t> leaves;
+    std::set<std::string> emptied;
+
+    std::unique_lock<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+    for (dm_easy_mesh_t *owner_dm = get_mgr()->get_first_dm(); owner_dm != NULL;
+            owner_dm = get_mgr()->get_next_dm(owner_dm)) {
+        if (memcmp(owner_dm->get_agent_al_interface_mac(), dm->get_agent_al_interface_mac(),
+                   sizeof(mac_address_t)) != 0) {
+            continue;
+        }
+        std::vector<em_sta_info_t> listed;
+        listed_associations(owner_dm, bssids, listed);
+        for (const em_sta_info_t &sta : listed) {
+            leaves.push_back({owner_dm, sta});
+            emptied.insert(util::mac_to_string(sta.bssid));
+        }
+    }
+    /* the rows change only now: the maps are not walked while a leave removes from them */
+    for (const leave_t &leave : leaves) {
+        em_printfout("Topology Response without Associated Clients: leave sta=%s bssid=%s",
+                     util::mac_to_string(leave.sta.id).c_str(),
+                     util::mac_to_string(leave.sta.bssid).c_str());
+        remove_sta_assoc(leave.dm, leave.sta);
+    }
+    topology_lock.unlock();
+
+    /* every response reconciled here is counted, so a flap shows as removals in nearly every
+     * response; one that removed nothing logs nothing */
+    struct counts_t {
+        unsigned long removals;
+        unsigned long responses;
+    };
+    static std::mutex counts_mutex;
+    static std::map<std::string, counts_t> counts_by_al;
+    const std::string al = util::mac_to_string(dm->get_agent_al_interface_mac());
+    unsigned long removals, responses;
+    {
+        std::lock_guard<std::mutex> counts_lock(counts_mutex);
+        counts_t &counts = counts_by_al[al];
+        counts.removals += leaves.size();
+        counts.responses++;
+        removals = counts.removals;
+        responses = counts.responses;
+    }
+    if (leaves.empty()) {
+        return 0;
+    }
+    for (const leave_t &leave : leaves) {
+        em_bus_event_type_client_assoc_params_t raw = {};
+        memcpy(raw.dev, dm->get_agent_al_interface_mac(), sizeof(mac_address_t));
+        memcpy(raw.assoc.cli_mac_address, leave.sta.id, sizeof(mac_address_t));
+        memcpy(raw.assoc.bssid, leave.sta.bssid, sizeof(bssid_t));
+        raw.assoc.assoc_event = 0;
+        get_mgr()->io_process(em_bus_event_type_sta_assoc, reinterpret_cast<unsigned char *> (&raw),
+                              sizeof(em_bus_event_type_client_assoc_params_t));
+    }
+    em_printfout("Topology Response without Associated Clients from %s: removed %zu association(s) from %zu BSS(s); %lu removal(s) in %lu response(s) without the TLV since start",
+                 al.c_str(), leaves.size(), emptied.size(), removals, responses);
+    return static_cast<unsigned int>(leaves.size());
 }
 
