diff --git a/src/utils/timer.cpp b/src/utils/timer.cpp
index 59eaa8fc..5b4370a3 100644
--- a/src/utils/timer.cpp
+++ b/src/utils/timer.cpp
@@ -1,41 +1,82 @@
 #include "timer.h"
 
-ThreadedTimer::ThreadedTimer() : running(false) {}
+ThreadedTimer::ThreadedTimer() {}
 
 ThreadedTimer::~ThreadedTimer() {
     stop();
 }
 
+bool ThreadedTimer::wait(const std::shared_ptr<run_state> &state, std::chrono::milliseconds delay) {
+    std::unique_lock<std::mutex> guard(state->lock);
+    state->wake.wait_for(guard, delay, [&state] { return !state->alive; });
+    return state->alive;
+}
+
+// The thread's own handle stays with this timer; the previous one (stopped) is joined outside the
+// lock, or detached when the caller is that thread
+static void finish(std::unique_ptr<std::thread> thread) {
+    if (!thread || !thread->joinable()) {
+        return;
+    }
+    if (thread->get_id() == std::this_thread::get_id()) {
+        thread->detach();  // joining itself would throw and end the process
+    } else {
+        thread->join();
+    }
+}
+
+void ThreadedTimer::start(std::function<void(const std::shared_ptr<run_state> &)> body) {
+    auto next = std::make_shared<run_state>();
+    std::unique_ptr<std::thread> previous;
+    std::shared_ptr<run_state> previous_state;
+    {
+        std::lock_guard<std::mutex> guard(lock);
+        previous = std::move(timer_thread);
+        previous_state = std::move(state);
+        state = next;
+        timer_thread = std::make_unique<std::thread>([next, body]() { body(next); });
+    }
+    if (previous_state) {
+        std::lock_guard<std::mutex> guard(previous_state->lock);
+        previous_state->alive = false;
+        previous_state->wake.notify_all();
+    }
+    finish(std::move(previous));
+}
+
 void ThreadedTimer::execute_after(std::chrono::milliseconds delay, std::function<void()> callback) {
-    stop();
-    running = true;
-    timer_thread = std::make_unique<std::thread>([this, delay, callback]() {
-        std::this_thread::sleep_for(delay);
-        if (running.load()) {
+    start([delay, callback](const std::shared_ptr<run_state> &state) {
+        if (wait(state, delay)) {
             callback();
         }
     });
 }
 
 void ThreadedTimer::start_periodic(std::chrono::milliseconds interval, std::function<bool()> callback) {
-    stop();
-    running = true;
-    timer_thread = std::make_unique<std::thread>([this, interval, callback]() {
-        while (running.load()) {
-            std::this_thread::sleep_for(interval);
-            if (running.load()) {
-                if (!callback()) {
-                    stop();  // Stop if callback returns false
-                    break;
-                }
+    start([interval, callback](const std::shared_ptr<run_state> &state) {
+        while (wait(state, interval)) {
+            if (!callback()) {
+                // Stop if callback returns false: this thread only ends, it joins nothing
+                std::lock_guard<std::mutex> guard(state->lock);
+                state->alive = false;
+                break;
             }
         }
     });
 }
 
 void ThreadedTimer::stop() {
-    running = false;
-    if (timer_thread && timer_thread->joinable()) {
-        timer_thread->join();
+    std::unique_ptr<std::thread> thread;
+    std::shared_ptr<run_state> stopped;
+    {
+        std::lock_guard<std::mutex> guard(lock);
+        thread = std::move(timer_thread);
+        stopped = std::move(state);
+    }
+    if (stopped) {
+        std::lock_guard<std::mutex> guard(stopped->lock);
+        stopped->alive = false;
+        stopped->wake.notify_all();
     }
+    finish(std::move(thread));
 }
diff --git a/tests/test_l1_timer.cpp b/tests/test_l1_timer.cpp
index 097728e8..f816427b 100644
--- a/tests/test_l1_timer.cpp
+++ b/tests/test_l1_timer.cpp
@@ -202,3 +202,66 @@ TEST(ThreadedTimer, Stop_Only) {
     timer.stop();
     std::cout << "Exiting: ThreadedTimer_Stop_Only" << std::endl;
 }
+
+// A periodic callback that returns false stops its timer from the timer's own thread: the thread
+// ends, nothing joins itself (which throws and ends the process), and a later stop() returns.
+TEST(ThreadedTimer, StartPeriodic_CallbackStopsItsOwnTimer) {
+    ThreadedTimer timer{};
+    std::atomic<int> calls{0};
+    timer.start_periodic(10ms, [&calls]() {
+        calls++;
+        return false;
+    });
+    std::this_thread::sleep_for(200ms);
+    EXPECT_EQ(calls.load(), 1);
+    timer.stop();
+    EXPECT_EQ(calls.load(), 1);
+}
+
+// A one-shot whose callback holds the last reference to its own timer: the timer is destroyed on
+// its own thread when that thread ends (the enrollee's chirp wait did this), with no abort.
+TEST(ThreadedTimer, ExecuteAfter_TimerOwnedByItsCallback) {
+    std::atomic<bool> ran{false};
+    {
+        auto timer = std::make_shared<ThreadedTimer>();
+        timer->execute_after(10ms, [timer, &ran]() { ran = true; });
+    }
+    std::this_thread::sleep_for(200ms);
+    EXPECT_TRUE(ran.load());
+}
+
+// stop() wakes a sleeping timer thread at once, and its callback never runs.
+TEST(ThreadedTimer, Stop_WakesASleepingTimer) {
+    ThreadedTimer timer{};
+    std::atomic<bool> ran{false};
+    timer.execute_after(10s, [&ran]() { ran = true; });
+    auto started = std::chrono::steady_clock::now();
+    timer.stop();
+    EXPECT_LT(std::chrono::steady_clock::now() - started, 1s);
+    EXPECT_FALSE(ran.load());
+}
+
+// Starts and stops of one timer from two threads at once (the enrollee's search timer: restarted
+// by the chirp wait's thread, stopped by the 1905 thread): no handle is lost or joined twice.
+TEST(ThreadedTimer, StartAndStopFromTwoThreads) {
+    ThreadedTimer timer{};
+    std::atomic<int> calls{0};
+    std::atomic<bool> done{false};
+    std::thread starter([&]() {
+        for (int i = 0; i < 200; i++) {
+            timer.start_periodic(1ms, [&calls]() {
+                calls++;
+                return true;
+            });
+        }
+        done = true;
+    });
+    while (!done.load()) {
+        timer.stop();
+    }
+    starter.join();
+    timer.stop();
+    int after = calls.load();
+    std::this_thread::sleep_for(20ms);
+    EXPECT_EQ(calls.load(), after);
+}
