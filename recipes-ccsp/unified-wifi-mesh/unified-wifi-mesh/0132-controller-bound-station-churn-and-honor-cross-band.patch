+TEST(em_cmd_sta_assoc_t, stage_clones_are_lightweight_and_preserve_overrides) {
+    em_cmd_params_t param = {};
+    dm_easy_mesh_t dm;
+    em_orch_desc_t first = {};
+    em_orch_desc_t second = {};
+
+    param.u.args.num_args = 4;
+    first.op = dm_orch_type_sta_cap;
+    first.submit = true;
+    second.op = dm_orch_type_topo_publish;
+    second.submit = true;
+    snprintf(param.u.args.args[2], sizeof(param.u.args.args[2]),
+        "%s", "02:00:00:00:23:00");
+    em_cmd_sta_assoc_t command(param, dm);
+    command.override_op(0, &first);
+    command.override_op(1, &second);
+    command.m_num_orch_desc = 2;
+
+    EXPECT_EQ(command.get_data_model()->m_sta_map, nullptr);
+    em_cmd_t *clone = command.clone_for_next();
+    ASSERT_NE(clone, nullptr);
+    EXPECT_EQ(clone->get_orch_op(), dm_orch_type_topo_publish);
+    EXPECT_EQ(clone->get_data_model()->m_sta_map, nullptr);
+    EXPECT_EQ(clone->clone_for_next(), nullptr);
+    delete clone;
+}
