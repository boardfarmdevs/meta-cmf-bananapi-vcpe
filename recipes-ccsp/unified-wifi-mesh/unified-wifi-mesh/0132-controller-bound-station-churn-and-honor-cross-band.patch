+bool em_configuration_t::remove_non_mlo_sta_assoc(dm_easy_mesh_t *dm,
+    const em_sta_info_t& sta_info)
+{
+    if (dm == NULL) {
+        return false;
+    }
+
+    mac_addr_str_t sta_mac_str, bssid_str, radio_mac_str;
+    em_long_string_t key;
+    dm_easy_mesh_t::macbytes_to_string(
+        const_cast<unsigned char *>(sta_info.id), sta_mac_str);
+    dm_easy_mesh_t::macbytes_to_string(
+        const_cast<unsigned char *>(sta_info.bssid), bssid_str);
+    dm_easy_mesh_t::macbytes_to_string(
+        const_cast<unsigned char *>(sta_info.radiomac), radio_mac_str);
+    snprintf(key, sizeof(key), "%s@%s@%s", sta_mac_str, bssid_str,
+        radio_mac_str);
+
+    em_sta_info_t removed = sta_info;
+    dm_sta_t *live = static_cast<dm_sta_t *>(
+        hash_map_get(dm->m_sta_map, key));
+    if (live != NULL) {
+        removed = live->m_sta_info;
+    }
+    removed.associated = false;
+
+    dm_sta_t *pending_assoc = static_cast<dm_sta_t *>(
+        hash_map_remove(dm->m_sta_assoc_map, key));
+    delete pending_assoc;
+
+    dm_sta_t *pending_disassoc = static_cast<dm_sta_t *>(
+        hash_map_get(dm->m_sta_dassoc_map, key));
+    if (pending_disassoc != NULL) {
+        pending_disassoc->m_sta_info = removed;
+    } else {
+        hash_map_put(dm->m_sta_dassoc_map, strdup(key),
+            new dm_sta_t(&removed));
+    }
+
+    dm_sta_t *old = static_cast<dm_sta_t *>(
+        hash_map_remove(dm->m_sta_map, key));
+    delete old;
+    dm->set_db_cfg_param(db_cfg_type_sta_list_delete, "");
+    em_printfout("topo notification non-MLO disassoc applied key=%s", key);
+    return true;
+}
