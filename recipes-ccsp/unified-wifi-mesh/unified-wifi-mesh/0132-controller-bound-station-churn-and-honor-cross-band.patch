+TEST(em_configuration_t, non_mlo_disassociation_removes_live_owner)
+{
+    dm_easy_mesh_t dm;
+    em_sta_info_t info = {};
+
+    dm.init();
+    dm_easy_mesh_t::string_to_macbytes(
+        const_cast<char *>("02:00:00:00:23:00"), info.id);
+    dm_easy_mesh_t::string_to_macbytes(
+        const_cast<char *>("02:00:00:da:5c:65"), info.bssid);
+    dm_easy_mesh_t::string_to_macbytes(
+        const_cast<char *>("02:00:00:30:d3:8d"), info.radiomac);
+    info.associated = true;
+    dm.put_sta_info(&info, em_target_sta_map_consolidated);
+    dm.put_sta_info(&info, em_target_sta_map_assoc);
+
+    EXPECT_TRUE(em_configuration_t::remove_non_mlo_sta_assoc(&dm, info));
+    EXPECT_EQ(dm.get_sta_info(info.id, info.bssid, info.radiomac,
+        em_target_sta_map_consolidated), nullptr);
+    EXPECT_EQ(dm.get_sta_info(info.id, info.bssid, info.radiomac,
+        em_target_sta_map_assoc), nullptr);
+    em_sta_info_t *withdrawn = dm.get_sta_info(info.id, info.bssid,
+        info.radiomac, em_target_sta_map_disassoc);
+    ASSERT_NE(withdrawn, nullptr);
+    EXPECT_FALSE(withdrawn->associated);
+    EXPECT_TRUE(dm.db_cfg_type_is_set(db_cfg_type_sta_list_delete));
+    dm.deinit();
+}
