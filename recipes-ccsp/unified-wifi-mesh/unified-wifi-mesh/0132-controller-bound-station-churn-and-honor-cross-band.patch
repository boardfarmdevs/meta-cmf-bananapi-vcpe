     m_data_model.set_cmd_ctx(&ctx);
 }
 
+em_cmd_t *em_cmd_sta_assoc_t::clone_for_next()
+{
+    em_cmd_ctx_t ctx;
+
+    if (m_orch_op_idx == (m_num_orch_desc - 1)) {
+        return NULL;
+    }
+
+    em_cmd_sta_assoc_t *out = new em_cmd_sta_assoc_t(m_param, m_data_model);
+    out->m_num_orch_desc = m_num_orch_desc;
+    for (unsigned int i = 0; i < m_num_orch_desc; i++) {
+        out->m_orch_desc[i] = m_orch_desc[i];
+    }
+    out->set_orch_op_index(m_orch_op_idx + 1);
+
+    memset(&ctx, 0, sizeof(ctx));
+    ctx.type = out->get_orch_op();
+    out->m_data_model.set_cmd_ctx(&ctx);
+    return out;
+}
