@@ -0,0 +1,46 @@
+package main
+
+import (
+	"net"
+	"strings"
+)
+
+type candidateCompletion struct {
+	AgentAL     string `json:"agent_al"`
+	RUID        string `json:"ruid"`
+	ReceivedAt  uint64 `json:"received_at_ms"`
+	MessageID   int    `json:"message_id"`
+	MetricCount int    `json:"metric_count"`
+}
+
+func (completion candidateCompletion) matches(agent, radio string, mid int) bool {
+	return strings.EqualFold(completion.AgentAL, agent) &&
+		strings.EqualFold(completion.RUID, radio) && completion.MessageID == mid
+}
+
+func freshCandidateCompletion(completions []candidateCompletion, metrics []candidateLinkMetric,
+	agent string, baseline, submittedAt, now uint64) *candidateCompletion {
+	for _, completion := range completions {
+		if !strings.EqualFold(completion.AgentAL, agent) ||
+			!candidateErrorIsFresh(completion.ReceivedAt, baseline, now) ||
+			completion.ReceivedAt < submittedAt || completion.MessageID < 0 ||
+			completion.MessageID > 65535 || completion.MetricCount < 0 {
+			continue
+		}
+		radio, err := net.ParseMAC(completion.RUID)
+		if err != nil || len(radio) != 6 {
+			continue
+		}
+		count := 0
+		for _, metric := range metrics {
+			if completion.matches(metric.AgentAL, metric.RUID, metric.MessageID) &&
+				metric.ReceivedAt == completion.ReceivedAt {
+				count++
+			}
+		}
+		if count == completion.MetricCount {
+			return &completion
+		}
+	}
+	return nil
+}
