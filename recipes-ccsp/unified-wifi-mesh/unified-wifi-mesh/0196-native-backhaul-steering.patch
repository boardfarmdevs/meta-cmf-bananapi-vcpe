+#include "em_ctrl.h"
+#include "em_network_topo.h"
+#include "em_backhaul_wire.h"
+
+namespace {
+
+int64_t backhaul_now()
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count();
+}
+
+std::string backhaul_mac(const unsigned char *address)
+{
+    return std::string(reinterpret_cast<const char *>(address), 6);
+}
+
+bool backhaul_unicast(const std::string &address)
+{
+    return address.size() == 6 && (address[0] & 1) == 0 && address != std::string(6, '\0');
+}
+
+std::string backhaul_label(const std::string &address)
+{
+    if (address.size() != 6) return "unknown";
+    char label[18];
+    const auto *bytes = reinterpret_cast<const unsigned char *>(address.data());
+    snprintf(label, sizeof(label), "%02x:%02x:%02x:%02x:%02x:%02x",
+        bytes[0], bytes[1], bytes[2], bytes[3], bytes[4], bytes[5]);
+    return label;
+}
+
+}
+
+void em_ctrl_t::handle_native_backhaul_tick()
+{
+    em_backhaul::snapshot network;
+    std::string controller;
+    std::set<std::string> ambiguous_bssids;
+    em_t *transport = nullptr;
+    {
+        std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+        dm_network_t *native_network = m_data_model.get_first_network();
+        if (native_network == nullptr) return;
+        network.root = backhaul_mac(native_network->get_colocated_agent_interface_mac());
+        controller = backhaul_mac(native_network->get_controller_interface_mac());
+        if (!backhaul_unicast(network.root) || !backhaul_unicast(controller)) return;
+        transport = get_al_node();
+        if (transport == nullptr) return;
+        for (dm_easy_mesh_t *model = m_data_model.get_first_dm(); model != nullptr;
+             model = m_data_model.get_next_dm(model)) {
+            if (network.nodes.size() >= 32) return;
+            const std::string owner = backhaul_mac(model->get_agent_al_interface_mac());
+            if (!backhaul_unicast(owner) || owner == controller ||
+                backhaul_mac(model->get_ctrl_al_interface_mac()) != controller) continue;
+            em_backhaul::node station;
+            station.al = owner;
+            station.sta = backhaul_mac(model->get_device_info()->backhaul_sta);
+            station.parent_bssid = backhaul_mac(model->get_device_info()->backhaul_mac.mac);
+            if (!backhaul_unicast(station.sta)) station.sta.clear();
+            network.nodes[owner] = station;
+            for (unsigned int index = 0; index < model->m_num_bss; ++index) {
+                const em_bss_info_t *bss = model->get_bss_info(index);
+                if (!bss->enabled || bss->vap_mode != em_vap_mode_ap ||
+                    bss->id.haul_type != em_haul_type_backhaul) continue;
+                em_backhaul::access_point ap;
+                ap.al = owner;
+                ap.bssid = backhaul_mac(bss->bssid.mac);
+                for (unsigned int op_index = 0; op_index < model->m_num_opclass; ++op_index) {
+                    const em_op_class_info_t *op = model->m_op_class[op_index].get_op_class_info();
+                    if (op->id.type == em_op_class_type_current &&
+                        memcmp(op->id.ruid, bss->ruid.mac, 6) == 0) {
+                        ap.op_class = static_cast<unsigned char>(op->op_class);
+                        ap.channel = static_cast<unsigned char>(op->channel);
+                        break;
+                    }
+                }
+                if (ap.op_class == 0 || ap.channel == 0 || !backhaul_unicast(ap.bssid) ||
+                    ambiguous_bssids.count(ap.bssid)) continue;
+                const auto duplicate = network.aps.find(ap.bssid);
+                if (duplicate != network.aps.end() && duplicate->second.al != ap.al) {
+                    ambiguous_bssids.insert(ap.bssid);
+                    network.aps.erase(duplicate);
+                } else network.aps[ap.bssid] = ap;
+            }
+        }
+    }
+    const int64_t now = backhaul_now();
+    std::vector<std::vector<unsigned char>> outgoing;
+    {
+        std::lock_guard<std::mutex> lock(m_backhaul_mutex);
+        m_backhaul_controller = controller;
+        for (auto &entry : network.nodes) {
+            const auto old = m_backhaul_network.nodes.find(entry.first);
+            if (old != m_backhaul_network.nodes.end() &&
+                old->second.sta == entry.second.sta &&
+                old->second.parent_bssid == entry.second.parent_bssid)
+                entry.second.serving = old->second.serving;
+        }
+        for (const auto &entry : m_backhaul_network.candidates) {
+            if (entry.second.fresh(now) && network.aps.count(entry.first.second))
+                network.candidates.insert(entry);
+        }
+        for (auto iterator = m_backhaul_uncertain.begin(); iterator != m_backhaul_uncertain.end();) {
+            const auto current = network.nodes.find(iterator->first);
+            if (current != network.nodes.end() && current->second.parent_bssid == iterator->second.request.target &&
+                current->second.serving.fresh(now) && current->second.serving.observed >= iterator->second.sent) {
+                em_printfout("Native backhaul late outcome observed agent=%s target=%s elapsed_ms=%lld",
+                    backhaul_label(iterator->first).c_str(), backhaul_label(iterator->second.request.target).c_str(),
+                    static_cast<long long>(now - iterator->second.sent));
+                m_backhaul_policy.attempted(iterator->first, now, false);
+                iterator = m_backhaul_uncertain.erase(iterator);
+            } else ++iterator;
+        }
+        for (const auto &uncertain : m_backhaul_uncertain)
+            network.uncertain[uncertain.first] = uncertain.second.failures < 3 ? uncertain.second.request.target : "";
+        m_backhaul_network = network;
+        m_backhaul_policy.observe(network, now);
+        for (auto iterator = m_backhaul_queries.begin(); iterator != m_backhaul_queries.end();) {
+            if (now - iterator->second.sent > 15000) iterator = m_backhaul_queries.erase(iterator);
+            else ++iterator;
+        }
+        if (m_backhaul_steer.mid != 0) {
+            const auto current = network.nodes.find(m_backhaul_steer.request.al);
+            const bool verified = current != network.nodes.end() &&
+                current->second.parent_bssid == m_backhaul_steer.request.target &&
+                current->second.serving.fresh(now) &&
+                current->second.serving.observed >= m_backhaul_steer.sent;
+            if (verified || now - m_backhaul_steer.sent >= 15000) {
+                em_printfout("Native backhaul %s sta=%s previous=%s target=%s response=%d elapsed_ms=%lld",
+                    verified ? "verified" : "timeout", backhaul_label(m_backhaul_steer.request.sta).c_str(),
+                    backhaul_label(m_backhaul_steer.request.previous).c_str(),
+                    backhaul_label(m_backhaul_steer.request.target).c_str(),
+                    m_backhaul_steer.response, static_cast<long long>(now - m_backhaul_steer.sent));
+                m_backhaul_policy.attempted(m_backhaul_steer.request.al, now, !verified);
+                if (verified) m_backhaul_uncertain.erase(m_backhaul_steer.request.al);
+                else {
+                    ++m_backhaul_steer.failures;
+                    m_backhaul_uncertain[m_backhaul_steer.request.al] = m_backhaul_steer;
+                }
+                m_backhaul_steer = {};
+            } else if (!m_backhaul_steer.acknowledged && m_backhaul_steer.retries < 2 &&
+                now - m_backhaul_steer.last_sent >= 2000) {
+                const auto target = network.aps.find(m_backhaul_steer.request.target);
+                if (target != network.aps.end() && current != network.nodes.end() &&
+                    current->second.parent_bssid == m_backhaul_steer.request.previous && em_backhaul::root_path(network,
+                        target->second.al, m_backhaul_steer.request.al, now).valid) {
+                    std::vector<unsigned char> payload(m_backhaul_steer.request.sta.begin(),
+                        m_backhaul_steer.request.sta.end());
+                    payload.insert(payload.end(), m_backhaul_steer.request.target.begin(),
+                        m_backhaul_steer.request.target.end());
+                    payload.push_back(target->second.op_class);
+                    payload.push_back(target->second.channel);
+                    outgoing.push_back(em_backhaul::frame(m_backhaul_steer.request.al, controller,
+                        em_msg_type_bh_steering_req, m_backhaul_steer.mid, em_tlv_type_bh_steering_req, payload));
+                    m_backhaul_steer.last_sent = now;
+                    ++m_backhaul_steer.retries;
+                    em_printfout("Native backhaul retry mid=%u retry=%u", m_backhaul_steer.mid, m_backhaul_steer.retries);
+                }
+            }
+        }
+        for (const auto &uncertain : m_backhaul_uncertain)
+            network.uncertain[uncertain.first] = uncertain.second.failures < 3 ? uncertain.second.request.target : "";
+        m_backhaul_network.uncertain = network.uncertain;
+        if (m_backhaul_steer.mid == 0) {
+            const auto decisions = m_backhaul_policy.evaluate(network, now);
+            if (!decisions.empty()) {
+                const auto &choice = decisions.front();
+                const auto &ap = network.aps.at(choice.target);
+                const unsigned short mid = get_next_msg_id();
+                std::vector<unsigned char> payload(choice.sta.begin(), choice.sta.end());
+                payload.insert(payload.end(), choice.target.begin(), choice.target.end());
+                payload.push_back(ap.op_class);
+                payload.push_back(ap.channel);
+                outgoing.push_back(em_backhaul::frame(choice.al, controller, em_msg_type_bh_steering_req,
+                    mid, em_tlv_type_bh_steering_req, payload));
+                m_backhaul_steer = {choice, mid, now, false, false, now, 0};
+                const auto uncertain = m_backhaul_uncertain.find(choice.al);
+                if (uncertain != m_backhaul_uncertain.end()) m_backhaul_steer.failures = uncertain->second.failures;
+                m_backhaul_policy.attempted(choice.al, now, false);
+                em_printfout("Native backhaul request mid=%u sta=%s previous=%s target=%s serving_rcpi=%d candidate_rcpi=%d path_rcpi=%d",
+                    mid, backhaul_label(choice.sta).c_str(), backhaul_label(choice.previous).c_str(),
+                    backhaul_label(choice.target).c_str(), choice.serving_rcpi, choice.candidate_rcpi, choice.path_rcpi);
+            }
+        }
+        if (now - m_backhaul_last_query >= 4000) {
+            m_backhaul_last_query = now;
+            ++m_backhaul_round;
+            std::set<std::string> queried_parents;
+            for (const auto &entry : network.nodes) {
+                const auto &station = entry.second;
+                const auto parent = network.aps.find(station.parent_bssid);
+                if (station.al != network.root && !station.sta.empty()) {
+                    int strongest_rcpi = -1;
+                    std::string strongest;
+                    for (const auto &candidate : network.candidates) {
+                        if (candidate.first.first == station.sta && candidate.second.fresh(now) &&
+                            candidate.second.rcpi > strongest_rcpi) {
+                            strongest_rcpi = candidate.second.rcpi;
+                            strongest = candidate.first.second;
+                        }
+                    }
+                    em_printfout("Native backhaul observation agent=%s parent=%s serving_rcpi=%d age_ms=%lld candidate=%s candidate_rcpi=%d",
+                        backhaul_label(station.al).c_str(), backhaul_label(station.parent_bssid).c_str(),
+                        station.serving.rcpi, static_cast<long long>(station.serving.observed ? now - station.serving.observed : -1),
+                        backhaul_label(strongest).c_str(), strongest_rcpi);
+                }
+                if (station.al == network.root || station.sta.empty() || parent == network.aps.end() ||
+                    !queried_parents.insert(station.parent_bssid).second) continue;
+                const unsigned short mid = get_next_msg_id();
+                backhaul_query_t serving_query{true, parent->second, {}, now, m_backhaul_round};
+                for (const auto &peer : network.nodes) {
+                    if (!peer.second.sta.empty() && peer.second.parent_bssid == station.parent_bssid)
+                        serving_query.stations[peer.second.sta] = peer.second.parent_bssid;
+                }
+                m_backhaul_queries[mid] = serving_query;
+                std::vector<unsigned char> payload{1};
+                payload.insert(payload.end(), station.parent_bssid.begin(), station.parent_bssid.end());
+                outgoing.push_back(em_backhaul::frame(parent->second.al, controller,
+                    em_msg_type_ap_metrics_query, mid, em_tlv_type_ap_metrics_query, payload));
+            }
+            for (const auto &entry : network.aps) {
+                const auto &ap = entry.second;
+                backhaul_query_t query;
+                query.ap = ap;
+                query.sent = now;
+                query.round = m_backhaul_round;
+                std::vector<unsigned char> payload{ap.op_class, 1, ap.channel, 0};
+                for (const auto &candidate : network.nodes) {
+                    const auto &station = candidate.second;
+                    const auto parent = network.aps.find(station.parent_bssid);
+                    if (station.al == network.root || station.al == ap.al || station.sta.empty() ||
+                        parent == network.aps.end() || parent->second.al == ap.al ||
+                        parent->second.channel != ap.channel || parent->second.op_class != ap.op_class ||
+                        !station.serving.fresh(now) || station.serving.rcpi >= 100) continue;
+                    const auto route = em_backhaul::root_path(network, ap.al, station.al, now);
+                    if (!route.valid) continue;
+                    query.stations[station.sta] = station.parent_bssid;
+                    payload.insert(payload.end(), station.sta.begin(), station.sta.end());
+                }
+                if (query.stations.empty()) continue;
+                payload[3] = static_cast<unsigned char>(query.stations.size());
+                const unsigned short mid = get_next_msg_id();
+                m_backhaul_queries[mid] = query;
+                outgoing.push_back(em_backhaul::frame(ap.al, controller, em_msg_type_unassoc_sta_link_metrics_query,
+                    mid, em_tlv_type_unassoc_sta_link_metric_query, payload));
+            }
+        }
+    }
+    for (auto &packet : outgoing) {
+        if (transport->send_native_backhaul_frame(packet.data(), static_cast<unsigned int>(packet.size())) < 0)
+            em_printfout("Native backhaul send failed mid=%u", em_backhaul::read16(packet.data() + 18));
+    }
+}
+
+bool em_ctrl_t::handle_native_backhaul_frame(unsigned char *data, unsigned int len, em_t *al_em)
+{
+    if (data == nullptr || len < 25) return false;
+    const unsigned int type = em_backhaul::read16(data + 16);
+    if (type != em_msg_type_ap_metrics_rsp &&
+        type != em_msg_type_unassoc_sta_link_metrics_rsp && type != em_msg_type_1905_ack &&
+        type != em_msg_type_bh_steering_rsp) return false;
+    const unsigned short mid = static_cast<unsigned short>(em_backhaul::read16(data + 18));
+    const std::string source = backhaul_mac(data + 6);
+    const int64_t now = backhaul_now();
+    std::lock_guard<std::mutex> lock(m_backhaul_mutex);
+    if (backhaul_mac(data) != m_backhaul_controller) return false;
+    const auto found = m_backhaul_queries.find(mid);
+    const bool owned_query = found != m_backhaul_queries.end() && found->second.ap.al == source;
+    const bool owned_steer = m_backhaul_steer.mid != 0 && m_backhaul_steer.mid == mid &&
+        m_backhaul_steer.request.al == source;
+    std::vector<em_backhaul::wire_tlv> tlvs;
+    if (!em_backhaul::parse_frame(data, len, tlvs)) return owned_query || owned_steer;
+    if (owned_steer && type == em_msg_type_1905_ack) m_backhaul_steer.acknowledged = true;
+    for (const auto &tlv : tlvs) {
+        if (tlv.type == em_tlv_type_assoc_sta_link_metric && type == em_msg_type_ap_metrics_rsp &&
+            owned_query && found->second.associated && now - found->second.sent <= 6000) {
+            if (tlv.size < 7 || tlv.size != 7 + static_cast<size_t>(tlv.value[6]) * sizeof(em_assoc_link_metrics_t)) continue;
+            const std::string station = backhaul_mac(tlv.value);
+            const auto expected = found->second.stations.find(station);
+            if (expected == found->second.stations.end()) continue;
+            for (auto &entry : m_backhaul_network.nodes) {
+                if (entry.second.sta != station || entry.second.parent_bssid != expected->second ||
+                    entry.second.parent_bssid != found->second.ap.bssid) continue;
+                const auto parent = m_backhaul_network.aps.find(entry.second.parent_bssid);
+                if (parent == m_backhaul_network.aps.end() || parent->second.al != source) continue;
+                for (unsigned int index = 0; index < tlv.value[6]; ++index) {
+                    const unsigned char *metric = tlv.value + 7 + index * sizeof(em_assoc_link_metrics_t);
+                    const unsigned int age = em_backhaul::read32(metric + 6);
+                    const int rcpi = metric[sizeof(em_assoc_link_metrics_t) - 1];
+                    if (backhaul_mac(metric) == entry.second.parent_bssid && age <= 6000 && rcpi <= 220) {
+                        const em_backhaul::sample sample{rcpi, found->second.sent - age, 0};
+                        if (sample.observed >= entry.second.serving.observed) entry.second.serving = sample;
+                    }
+                }
+            }
+        }
+        if (type == em_msg_type_unassoc_sta_link_metrics_rsp && owned_query &&
+            !found->second.associated && tlv.type == em_tlv_type_unassoc_sta_link_metric_rsp) {
+            const auto &query = found->second;
+            if (now - query.sent > 6000 || tlv.size < 2 || tlv.value[0] != query.ap.op_class ||
+                tlv.size != 2 + static_cast<size_t>(tlv.value[1]) * sizeof(em_unassoc_sta_metric_t)) continue;
+            for (const auto &expected : query.stations) {
+                const auto cached = m_backhaul_network.candidates.find({expected.first, query.ap.bssid});
+                if (cached != m_backhaul_network.candidates.end() && cached->second.round <= query.round)
+                    m_backhaul_network.candidates.erase(cached);
+            }
+            for (unsigned int index = 0; index < tlv.value[1]; ++index) {
+                const unsigned char *metric = tlv.value + 2 + index * sizeof(em_unassoc_sta_metric_t);
+                const std::string station = backhaul_mac(metric);
+                const auto expected = query.stations.find(station);
+                const unsigned int age = em_backhaul::read32(metric + 7);
+                if (expected == query.stations.end() || metric[6] != query.ap.channel ||
+                    age > 6000 || metric[11] > 220 || now - age < query.sent) continue;
+                for (const auto &entry : m_backhaul_network.nodes) {
+                    if (entry.second.sta != station || entry.second.parent_bssid != expected->second) continue;
+                    auto &sample = m_backhaul_network.candidates[{station, query.ap.bssid}];
+                    if (now - age >= sample.observed && query.round >= sample.round)
+                        sample = {metric[11], now - age, query.round};
+                }
+            }
+        }
+        if (type == em_msg_type_bh_steering_rsp && owned_steer && tlv.type == em_tlv_type_bh_steering_rsp &&
+            tlv.size == sizeof(em_bh_steering_resp_t) &&
+            backhaul_mac(tlv.value) == m_backhaul_steer.request.sta &&
+            backhaul_mac(tlv.value + 6) == m_backhaul_steer.request.target) {
+            m_backhaul_steer.response = tlv.value[12] == 0;
+            m_backhaul_steer.acknowledged = true;
+            em_printfout("Native backhaul response mid=%u result=%u sta=%s", mid, tlv.value[12],
+                backhaul_label(m_backhaul_steer.request.sta).c_str());
+            if (tlv.value[12] != 0) {
+                m_backhaul_policy.attempted(m_backhaul_steer.request.al, now, true);
+                ++m_backhaul_steer.failures;
+                m_backhaul_uncertain[m_backhaul_steer.request.al] = m_backhaul_steer;
+                em_printfout("Native backhaul unresolved agent=%s target=%s failures=%u; excluding unsafe ancestry",
+                    backhaul_label(m_backhaul_steer.request.al).c_str(),
+                    backhaul_label(m_backhaul_steer.request.target).c_str(), m_backhaul_steer.failures);
+                m_backhaul_steer = {};
+            }
+        }
+    }
+    if (owned_query && ((type == em_msg_type_ap_metrics_rsp && found->second.associated) ||
+        (type == em_msg_type_unassoc_sta_link_metrics_rsp && !found->second.associated)))
+        m_backhaul_queries.erase(found);
+    return (owned_query && (type == em_msg_type_unassoc_sta_link_metrics_rsp || type == em_msg_type_1905_ack)) ||
+        (owned_steer && (type == em_msg_type_bh_steering_rsp || type == em_msg_type_1905_ack));
+}
