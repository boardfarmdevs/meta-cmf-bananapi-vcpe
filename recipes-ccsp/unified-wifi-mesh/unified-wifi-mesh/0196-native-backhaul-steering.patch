+#ifndef EM_AP_REPORT_SNAPSHOT_H
+#define EM_AP_REPORT_SNAPSHOT_H
+
+#include <cstdint>
+#include <cstring>
+#include <cjson/cJSON.h>
+
+inline bool em_ap_report_mac(const cJSON *object, const char *name, unsigned char *address)
+{
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(object, name);
+    if (!cJSON_IsString(value) || value->valuestring == nullptr ||
+        strlen(value->valuestring) != 17) return false;
+    bool nonzero = false;
+    for (unsigned int index = 0; index < 6; ++index) {
+        if (index != 5 && value->valuestring[index * 3 + 2] != ':') return false;
+        unsigned int octet = 0;
+        for (unsigned int digit_index = 0; digit_index < 2; ++digit_index) {
+            const char digit = value->valuestring[index * 3 + digit_index];
+            unsigned int decoded;
+            if (digit >= '0' && digit <= '9') decoded = static_cast<unsigned int>(digit - '0');
+            else if (digit >= 'a' && digit <= 'f') decoded = static_cast<unsigned int>(digit - 'a' + 10);
+            else if (digit >= 'A' && digit <= 'F') decoded = static_cast<unsigned int>(digit - 'A' + 10);
+            else return false;
+            octet = octet * 16 + decoded;
+        }
+        address[index] = static_cast<unsigned char>(octet);
+        nonzero = nonzero || octet != 0;
+    }
+    return nonzero && (address[0] & 1) == 0;
+}
+
+inline bool em_ap_report_uint(const cJSON *object, const char *name, unsigned int &result)
+{
+    const cJSON *value = cJSON_GetObjectItemCaseSensitive(object, name);
+    if (!cJSON_IsNumber(value) ||
+        !(value->valuedouble >= 0 && value->valuedouble <= UINT32_MAX) ||
+        value->valuedouble != static_cast<double>(static_cast<unsigned int>(value->valuedouble)))
+        return false;
+    result = static_cast<unsigned int>(value->valuedouble);
+    return true;
+}
+
+inline bool em_collect_ap_report_backhaul(cJSON *reports, dm_easy_mesh_t &model,
+    em_cmd_ap_metrics_rprt_params_t &params)
+{
+    params.report_backhaul_bss_count = 0;
+    params.report_backhaul_sta_count = 0;
+    if (!cJSON_IsArray(reports) || params.num_radios < 0 ||
+        params.num_radios > EM_MAX_RADIO_PER_AGENT ||
+        cJSON_GetArraySize(reports) != params.num_radios) return false;
+    const size_t capacity = sizeof(params.report_backhaul_sta) / sizeof(params.report_backhaul_sta[0]);
+    for (int radio_slot = 0; radio_slot < params.num_radios; ++radio_slot) {
+        cJSON *radio_report = cJSON_GetArrayItem(reports, radio_slot);
+        cJSON *vaps = cJSON_GetObjectItemCaseSensitive(radio_report, "Vap Info");
+        if (!cJSON_IsArray(vaps) || cJSON_GetArraySize(vaps) > EM_MAX_BSSS) return false;
+        cJSON *vap = nullptr;
+        cJSON_ArrayForEach(vap, vaps) {
+            cJSON *ap_metrics = cJSON_GetObjectItemCaseSensitive(vap, "AP Metrics");
+            mac_address_t bssid;
+            if (!em_ap_report_mac(ap_metrics, "BSSID", bssid)) return false;
+            bool backhaul = false;
+            for (unsigned int bss_index = 0; bss_index < model.get_num_bss(); ++bss_index) {
+                const em_bss_info_t *bss = model.get_bss_info(bss_index);
+                if (bss != nullptr && bss->vap_mode == em_vap_mode_ap &&
+                    bss->id.haul_type == em_haul_type_backhaul &&
+                    memcmp(bss->bssid.mac, bssid, 6) == 0 &&
+                    memcmp(bss->ruid.mac, params.ruid[radio_slot], 6) == 0) {
+                    backhaul = true;
+                    break;
+                }
+            }
+            if (!backhaul) continue;
+            for (int seen = 0; seen < params.report_backhaul_bss_count; ++seen)
+                if (memcmp(params.report_backhaul_bssids[seen], bssid, 6) == 0) return false;
+            if (params.report_backhaul_bss_count >= EM_MAX_BSSS) return false;
+            memcpy(params.report_backhaul_bssids[params.report_backhaul_bss_count++], bssid, 6);
+            cJSON *stations = cJSON_GetObjectItemCaseSensitive(vap, "Associated STA Link Metrics Report");
+            if (stations == nullptr) continue;
+            if (!cJSON_IsArray(stations) || static_cast<size_t>(cJSON_GetArraySize(stations)) > capacity)
+                return false;
+            cJSON *station = nullptr;
+            cJSON_ArrayForEach(station, stations) {
+                mac_address_t station_mac;
+                if (!em_ap_report_mac(station, "STA MAC", station_mac)) return false;
+                cJSON *link = cJSON_GetObjectItemCaseSensitive(station, "Associated STA Link Metrics");
+                if (link == nullptr) continue;
+                cJSON *links = cJSON_GetObjectItemCaseSensitive(link, "Per BSSID Metrics");
+                unsigned int link_count;
+                if (!em_ap_report_uint(link, "Number of BSSIDs", link_count) ||
+                    !cJSON_IsArray(links) || link_count != static_cast<unsigned int>(cJSON_GetArraySize(links)) ||
+                    link_count > EM_MAX_BSSS) return false;
+                cJSON *metric = nullptr;
+                cJSON_ArrayForEach(metric, links) {
+                    mac_address_t metric_bssid;
+                    if (!em_ap_report_mac(metric, "BSSID", metric_bssid) || memcmp(bssid, metric_bssid, 6) != 0)
+                        return false;
+                    unsigned int delta_ms, downlink, uplink, rcpi;
+                    if (!em_ap_report_uint(metric, "Time Delta", delta_ms) ||
+                        !em_ap_report_uint(metric, "Estimated Mac Rate Down", downlink) ||
+                        !em_ap_report_uint(metric, "Estimated Mac Rate Up", uplink) ||
+                        !em_ap_report_uint(metric, "RCPI", rcpi) || rcpi > 220) continue;
+                    for (unsigned int seen = 0; seen < params.report_backhaul_sta_count; ++seen) {
+                        const auto &previous = params.report_backhaul_sta[seen];
+                        if (memcmp(previous.sta_mac, station_mac, 6) == 0 &&
+                            memcmp(previous.bssid, bssid, 6) == 0) return false;
+                    }
+                    if (params.report_backhaul_sta_count >= capacity) return false;
+                    auto &sample = params.report_backhaul_sta[params.report_backhaul_sta_count++];
+                    memcpy(sample.sta_mac, station_mac, 6);
+                    memcpy(sample.bssid, bssid, 6);
+                    memcpy(sample.ruid, params.ruid[radio_slot], 6);
+                    sample.delta_ms = delta_ms;
+                    sample.est_dl_rate = downlink;
+                    sample.est_ul_rate = uplink;
+                    sample.rcpi = static_cast<unsigned char>(rcpi);
+                }
+            }
+        }
+    }
+    return true;
+}
+
+#endif
