+            if (response.num_entries >= EM_MAX_UNASSOC_STA) break;
+            auto &entry = response.entry[response.num_entries++];
+            entry.op_class = static_cast<unsigned char>(metric.key[0]);
+            entry.channel = static_cast<unsigned char>(metric.key[1]);
+            memcpy(entry.sta_mac, metric.key.data() + 2, 6);
+            entry.rcpi = metric.rcpi;
+            entry.time_delta = static_cast<unsigned int>(now - metric.observed);
+        }
+        send_unassoc_sta_link_metrics_response(&response, reply.mid, reply.op_classes);
+    }
+    rsp->num_entries = 0;
+    set_state(em_state_agent_configured);
+}
