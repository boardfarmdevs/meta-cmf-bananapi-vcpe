+bool em_agent_t::handle_native_backhaul_frame(unsigned char *data, unsigned int len,
+    em_t *al_em)
+{
+    (void)al_em;
+    if (!em_native_backhaul::is_request(data, len)) return false;
+    if (!is_data_model_initialized()) return true;
+    em_native_backhaul::request command{};
+    if (!em_native_backhaul::decode_request(data, len, command)) {
+        em_printfout("Native backhaul request rejected: malformed frame");
+        return true;
+    }
+    em_event_t *event = static_cast<em_event_t *>(calloc(1, sizeof(em_event_t)));
+    if (event == nullptr) return true;
+    event->type = em_event_type_frame;
+    event->u.fevt.frame = static_cast<unsigned char *>(malloc(len));
+    if (event->u.fevt.frame == nullptr) {
+        free(event);
+        return true;
+    }
+    memcpy(event->u.fevt.frame, data, len);
+    event->u.fevt.frame_len = len;
+    push_to_queue(event);
+    return true;
+}
+
+bool em_agent_t::send_native_backhaul_reply(const em_native_backhaul::request &command,
+    bool acknowledgement, unsigned char error)
+{
+    static_assert(em_msg_type_bh_steering_req == em_native_backhaul::request_type,
+        "Backhaul request message type differs from wire codec");
+    static_assert(em_msg_type_bh_steering_rsp == em_native_backhaul::response_type,
+        "Backhaul response message type differs from wire codec");
+    static_assert(sizeof(em_bh_steering_req_t) == 14 && sizeof(em_bh_steering_resp_t) == 13,
+        "Backhaul TLV layout differs from wire codec");
+    static_assert(em_tlv_type_bh_steering_req == 0x9e &&
+        em_tlv_type_bh_steering_rsp == 0x9f && em_tlv_type_error_code == 0xa3,
+        "Backhaul TLV identifiers differ from wire codec");
+    em_t *node = get_al_node();
+    if (node == nullptr) return false;
+    std::vector<unsigned char> frame = em_native_backhaul::reply(command, acknowledgement, error);
+    return node->send_native_backhaul_frame(frame.data(), static_cast<unsigned int>(frame.size())) >= 0;
+}
+
+bool em_agent_t::native_backhaul_station_matches(unsigned int radio_instance,
+    const em_native_backhaul::mac_address &station)
+{
+    wifi_bus_desc_t *descriptor = get_bus_descriptor();
+    if (descriptor == nullptr || radio_instance == 0 ||
+        radio_instance > m_data_model.get_num_radios()) return false;
+    char path[80];
+    snprintf(path, sizeof(path), "Device.WiFi.STA.%u.InterfaceName", radio_instance);
+    raw_data_t value{};
+    bool matches = false;
+    if (descriptor->bus_data_get_fn(&m_bus_hdl, path, &value) == bus_error_success &&
+        value.data_type == bus_data_type_string && value.raw_data.bytes != nullptr &&
+        value.raw_data_len > 1 && value.raw_data_len <= IFNAMSIZ &&
+        memchr(value.raw_data.bytes, '\0', value.raw_data_len) != nullptr) {
+        mac_address_t actual{};
+        if (dm_easy_mesh_t::mac_address_from_name(
+                reinterpret_cast<const char *>(value.raw_data.bytes), actual) == 0) {
+            matches = memcmp(actual, station.data(), sizeof(actual)) == 0;
+        }
+    }
+    free(value.raw_data.bytes);
+    return matches;
+}
+
+bool em_agent_t::read_native_backhaul_link(unsigned int radio_instance,
+    em_native_backhaul::mac_address &parent, bool &connected)
+{
+    connected = false;
+    parent.fill(0);
+    wifi_bus_desc_t *descriptor = get_bus_descriptor();
+    if (descriptor == nullptr || radio_instance == 0 ||
+        radio_instance > m_data_model.get_num_radios()) return false;
+    char path[80];
+    snprintf(path, sizeof(path), "Device.WiFi.STA.%u.Connection.Status", radio_instance);
+    raw_data_t value{};
+    bool valid = false;
+    if (descriptor->bus_data_get_fn(&m_bus_hdl, path, &value) == bus_error_success &&
+        value.data_type == bus_data_type_bytes && value.raw_data.bytes != nullptr &&
+        value.raw_data_len == sizeof(wifi_connection_status_t) + parent.size()) {
+        wifi_connection_status_t status;
+        memcpy(&status, value.raw_data.bytes, sizeof(status));
+        const unsigned char *bytes = reinterpret_cast<const unsigned char *>(value.raw_data.bytes);
+        std::copy_n(bytes + sizeof(status), parent.size(), parent.begin());
+        connected = status == wifi_connection_status_connected;
+        valid = !connected || em_native_backhaul::valid_mac(parent);
+    }
+    free(value.raw_data.bytes);
+    return valid;
+}
+
+void em_agent_t::complete_native_backhaul_request(em_native_backhaul::transaction &transaction,
+    unsigned char error)
+{
+    m_native_backhaul_transactions.complete(transaction, error, em_native_backhaul::clock::now());
+    const bool sent = send_native_backhaul_reply(transaction.command, false, error);
+    em_printfout("Native backhaul response mid=%u station=%s target=%s result=%s error=%u sent=%u",
+        transaction.command.message_id,
+        util::mac_to_string(transaction.command.station.data()).c_str(),
+        util::mac_to_string(transaction.command.target.data()).c_str(),
+        error == 0 ? "connected" : "failed", error, sent);
+}
+
+void em_agent_t::process_native_backhaul_request(const unsigned char *frame, size_t length)
+{
+    em_native_backhaul::request command{};
+    if (!em_native_backhaul::decode_request(frame, length, command)) return;
+    if (memcmp(command.controller.data(), m_data_model.get_ctrl_al_interface_mac(), 6) != 0 ||
+        memcmp(command.agent.data(), m_data_model.get_agent_al_interface_mac(), 6) != 0 ||
+        command.agent == command.controller || m_data_model.get_colocated()) {
+        em_printfout("Native backhaul request rejected: wrong controller or destination");
+        return;
+    }
+    const auto now = em_native_backhaul::clock::now();
+    m_native_backhaul_transactions.prune(now);
+    auto *previous = m_native_backhaul_transactions.find(command);
+    if (previous != nullptr && !(previous->command == command)) {
+        em_printfout("Native backhaul request rejected: MID reused with a different payload");
+        return;
+    }
+    if (!send_native_backhaul_reply(command, true)) return;
+    if (previous != nullptr) {
+        if (previous->completed) send_native_backhaul_reply(command, false, previous->error);
+        return;
+    }
+    if (m_native_backhaul_transactions.pending() != nullptr) {
+        m_native_backhaul_transactions.remember_rejection(command,
+            em_native_backhaul::association_failed, now);
+        send_native_backhaul_reply(command, false, em_native_backhaul::association_failed);
+        em_printfout("Native backhaul request rejected: another handover is pending");
+        return;
+    }
+    auto *transaction = m_native_backhaul_transactions.insert(command, 0, now);
+    if (transaction == nullptr) return;
+    em_bss_info_t *station = nullptr;
+    for (unsigned int index = 0; index < m_data_model.get_num_bss(); ++index) {
+        em_bss_info_t *bss = m_data_model.get_bss_info(index);
+        if (bss == nullptr) continue;
+        if (bss->vap_mode == em_vap_mode_ap &&
+            memcmp(bss->bssid.mac, command.target.data(), 6) == 0) {
+            complete_native_backhaul_request(*transaction, em_native_backhaul::target_not_suitable);
+            return;
+        }
+        if (bss->vap_mode == em_vap_mode_sta && bss->id.haul_type == em_haul_type_backhaul &&
+            memcmp(bss->sta_mac, command.station.data(), 6) == 0) {
+            if (station != nullptr) {
+                complete_native_backhaul_request(*transaction, em_native_backhaul::association_failed);
+                return;
+            }
+            station = bss;
+        }
+    }
+    if (station == nullptr || command.station == command.target) {
+        complete_native_backhaul_request(*transaction, em_native_backhaul::target_not_suitable);
+        return;
+    }
+    bool current_channel = false;
+    for (unsigned int index = 0; index < m_data_model.get_num_op_class(); ++index) {
+        em_op_class_info_t *operating = m_data_model.get_op_class_info(index);
+        if (operating != nullptr && operating->id.type == em_op_class_type_current &&
+            memcmp(operating->id.ruid, station->ruid.mac, 6) == 0 &&
+            operating->op_class == command.operating_class && operating->channel == command.channel &&
+            command.operating_class != 0 && command.channel != 0) current_channel = true;
+    }
+    if (!current_channel) {
+        complete_native_backhaul_request(*transaction, em_native_backhaul::cannot_operate_on_channel);
+        return;
+    }
+    for (unsigned int index = 0; index < m_data_model.get_num_radios(); ++index) {
+        if (native_backhaul_station_matches(index + 1, command.station)) {
+            transaction->radio_instance = index + 1;
+            break;
+        }
+    }
+    em_native_backhaul::mac_address parent{};
+    bool connected = false;
+    if (transaction->radio_instance == 0 ||
+        !read_native_backhaul_link(transaction->radio_instance, parent, connected) || !connected) {
+        complete_native_backhaul_request(*transaction, em_native_backhaul::association_failed);
+        return;
+    }
+    if (parent == command.target) {
+        complete_native_backhaul_request(*transaction, 0);
+        return;
+    }
+    wifi_bus_desc_t *descriptor = get_bus_descriptor();
+    char path[80];
+    snprintf(path, sizeof(path), "Device.WiFi.STA.%u.Bssid", transaction->radio_instance);
+    raw_data_t value{};
+    value.data_type = bus_data_type_bytes;
+    value.raw_data.bytes = command.target.data();
+    value.raw_data_len = command.target.size();
+    if (descriptor == nullptr || descriptor->bus_set_fn(&m_bus_hdl, path, &value) != bus_error_success) {
+        complete_native_backhaul_request(*transaction, em_native_backhaul::association_failed);
+        return;
+    }
+    em_printfout("Native backhaul accepted mid=%u station=%s old_parent=%s target=%s radio=%u",
+        command.message_id, util::mac_to_string(command.station.data()).c_str(),
+        util::mac_to_string(parent.data()).c_str(), util::mac_to_string(command.target.data()).c_str(),
+        transaction->radio_instance);
+}
+
+void em_agent_t::poll_native_backhaul_request()
+{
+    const auto now = em_native_backhaul::clock::now();
+    m_native_backhaul_transactions.prune(now);
+    auto *transaction = m_native_backhaul_transactions.pending();
+    if (transaction == nullptr) return;
+    if (memcmp(transaction->command.controller.data(), m_data_model.get_ctrl_al_interface_mac(), 6) != 0) {
+        complete_native_backhaul_request(*transaction, em_native_backhaul::association_failed);
+        return;
+    }
+    if (now >= transaction->deadline) {
+        complete_native_backhaul_request(*transaction, em_native_backhaul::target_not_suitable);
+        return;
+    }
+    em_native_backhaul::mac_address parent{};
+    bool connected = false;
+    if (native_backhaul_station_matches(transaction->radio_instance, transaction->command.station) &&
+        read_native_backhaul_link(transaction->radio_instance, parent, connected) && connected &&
+        parent == transaction->command.target) complete_native_backhaul_request(*transaction, 0);
+}
+
+void em_agent_t::observe_native_backhaul_callback(em_bus_event_t *event)
+{
+    const auto *transaction = m_native_backhaul_transactions.pending();
+    if (transaction == nullptr || event == nullptr || event->data_len == 0 ||
+        event->data_len > EM_MAX_EVENT_DATA_LEN) return;
+    const std::string encoded(reinterpret_cast<const char *>(event->u.raw_buff), event->data_len);
+    cJSON *document = cJSON_Parse(encoded.c_str());
+    if (document == nullptr) return;
+    cJSON *vaps = cJSON_GetObjectItemCaseSensitive(document, "WifiVapConfig");
+    cJSON *vap = nullptr;
+    bool matched = false;
+    cJSON_ArrayForEach(vap, vaps) {
+        cJSON *radio = cJSON_GetObjectItemCaseSensitive(vap, "RadioIndex");
+        cJSON *station = cJSON_GetObjectItemCaseSensitive(vap, "MAC");
+        cJSON *parent = cJSON_GetObjectItemCaseSensitive(vap, "BSSID");
+        cJSON *connected = cJSON_GetObjectItemCaseSensitive(vap, "ConnectStatus");
+        if (cJSON_IsNumber(radio) && radio->valuedouble == transaction->radio_instance - 1 &&
+            cJSON_IsString(station) && cJSON_IsString(parent) && cJSON_IsTrue(connected) &&
+            strcasecmp(station->valuestring,
+                util::mac_to_string(transaction->command.station.data()).c_str()) == 0 &&
+            strcasecmp(parent->valuestring,
+                util::mac_to_string(transaction->command.target.data()).c_str()) == 0) {
+            matched = true;
+            break;
+        }
+    }
+    cJSON_Delete(document);
+    if (matched) poll_native_backhaul_request();
+}
