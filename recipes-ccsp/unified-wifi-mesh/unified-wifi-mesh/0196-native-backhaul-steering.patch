+#ifndef EM_BACKHAUL_POLICY_H
+#define EM_BACKHAUL_POLICY_H
+
+#include <algorithm>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <tuple>
+#include <vector>
+
+namespace em_backhaul {
+
+struct sample {
+    int rcpi = -1;
+    int64_t observed = 0;
+    uint64_t round = 0;
+    bool fresh(int64_t now) const
+    {
+        return rcpi >= 0 && rcpi <= 220 && observed > 0 &&
+            observed <= now && now - observed <= 6000;
+    }
+};
+
+struct node {
+    std::string al;
+    std::string sta;
+    std::string parent_bssid;
+    sample serving;
+};
+
+struct access_point {
+    std::string al;
+    std::string bssid;
+    unsigned char op_class = 0;
+    unsigned char channel = 0;
+};
+
+struct snapshot {
+    std::string root;
+    std::map<std::string, node> nodes;
+    std::map<std::string, access_point> aps;
+    std::map<std::pair<std::string, std::string>, sample> candidates;
+    std::map<std::string, std::string> uncertain;
+};
+
+struct path {
+    bool valid = false;
+    int bottleneck = 220;
+    unsigned int hops = 0;
+};
+
+inline path root_path(const snapshot &network, std::string parent,
+                      const std::string &forbidden, int64_t now)
+{
+    path result;
+    std::set<std::string> seen;
+    while (parent != network.root) {
+        if (parent == forbidden || network.uncertain.count(parent) ||
+            !seen.insert(parent).second || seen.size() > 32) return result;
+        const auto found = network.nodes.find(parent);
+        if (found == network.nodes.end() || !found->second.serving.fresh(now)) return result;
+        const auto upstream = network.aps.find(found->second.parent_bssid);
+        if (upstream == network.aps.end()) return result;
+        result.bottleneck = std::min(result.bottleneck, found->second.serving.rcpi);
+        ++result.hops;
+        parent = upstream->second.al;
+    }
+    result.valid = !network.root.empty() && parent != forbidden;
+    return result;
+}
+
+struct decision {
+    std::string al;
+    std::string sta;
+    std::string previous;
+    std::string target;
+    int serving_rcpi = -1;
+    int candidate_rcpi = -1;
+    int path_rcpi = -1;
+};
+
+class policy {
+    struct history {
+        std::string parent;
+        std::string candidate;
+        int64_t changed = 0;
+        int64_t cooldown = 0;
+        uint64_t round = 0;
+        unsigned int confirmations = 0;
+    };
+    std::map<std::string, history> m_history;
+
+public:
+    void observe(const snapshot &network, int64_t now)
+    {
+        for (auto iterator = m_history.begin(); iterator != m_history.end();) {
+            if (network.nodes.count(iterator->first) == 0) iterator = m_history.erase(iterator);
+            else ++iterator;
+        }
+        for (const auto &entry : network.nodes) {
+            auto &state = m_history[entry.first];
+            if (state.parent != entry.second.parent_bssid || state.changed == 0) {
+                state.parent = entry.second.parent_bssid;
+                state.changed = now;
+                state.candidate.clear();
+                state.confirmations = 0;
+                state.round = 0;
+            }
+        }
+    }
+
+    void attempted(const std::string &al, int64_t now, bool failed)
+    {
+        auto &state = m_history[al];
+        state.cooldown = now + (failed ? 20000 : 10000);
+        state.confirmations = 0;
+        state.candidate.clear();
+    }
+
+    std::vector<decision> evaluate(const snapshot &network, int64_t now)
+    {
+        observe(network, now);
+        std::vector<decision> decisions;
+        for (const auto &entry : network.nodes) {
+            const node &station = entry.second;
+            auto &state = m_history[entry.first];
+            const auto current = network.aps.find(station.parent_bssid);
+            if (station.al == network.root || station.sta.empty() ||
+                !station.serving.fresh(now) || station.serving.observed < state.changed ||
+                current == network.aps.end() || now < state.cooldown || now - state.changed < 10000) {
+                state.confirmations = 0;
+                state.candidate.clear();
+                continue;
+            }
+            const path old_path = root_path(network, current->second.al, station.al, now);
+            if (!old_path.valid) continue;
+            const int old_bottleneck = std::min(station.serving.rcpi, old_path.bottleneck);
+            decision best;
+            std::tuple<int, int, int> best_score(-1, -1, -100);
+            uint64_t best_round = 0;
+            for (const auto &candidate : network.aps) {
+                const access_point &ap = candidate.second;
+                const auto uncertainty = network.uncertain.find(station.al);
+                if (uncertainty != network.uncertain.end() && uncertainty->second != candidate.first) continue;
+                if (candidate.first == station.parent_bssid || ap.al == station.al ||
+                    ap.channel != current->second.channel || ap.op_class != current->second.op_class) continue;
+                const auto measurement = network.candidates.find({station.sta, candidate.first});
+                if (measurement == network.candidates.end()) continue;
+                const sample &metric = measurement->second;
+                if (!metric.fresh(now) || metric.observed < state.changed ||
+                    metric.rcpi < 50 || metric.rcpi - station.serving.rcpi < 12) continue;
+                const path route = root_path(network, ap.al, station.al, now);
+                if (!route.valid) continue;
+                const int bottleneck = std::min(metric.rcpi, route.bottleneck);
+                if (bottleneck < old_bottleneck ||
+                    (route.hops > old_path.hops && bottleneck <= old_bottleneck)) continue;
+                const auto score = std::make_tuple(bottleneck, metric.rcpi, -static_cast<int>(route.hops));
+                if (score > best_score) {
+                    best_score = score;
+                    best = {station.al, station.sta, station.parent_bssid, candidate.first,
+                        station.serving.rcpi, metric.rcpi, bottleneck};
+                    best_round = metric.round;
+                }
+            }
+            if (best.target.empty()) {
+                state.candidate.clear();
+                state.confirmations = 0;
+                state.round = 0;
+                continue;
+            }
+            if (state.candidate != best.target) {
+                state.candidate = best.target;
+                state.confirmations = 0;
+                state.round = 0;
+            }
+            if (best_round != 0 && best_round != state.round) {
+                state.round = best_round;
+                ++state.confirmations;
+            }
+            if (state.confirmations >= 2) decisions.push_back(best);
+        }
+        return decisions;
+    }
+};
+
+}
+
+#endif
