+#ifndef EM_NATIVE_BACKHAUL_AGENT_H
+#define EM_NATIVE_BACKHAUL_AGENT_H
+
+#include <algorithm>
+#include <array>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <deque>
+#include <vector>
+
+namespace em_native_backhaul {
+
+using mac_address = std::array<unsigned char, 6>;
+using clock = std::chrono::steady_clock;
+
+constexpr unsigned short request_type = 0x8019;
+constexpr unsigned short response_type = 0x801a;
+constexpr unsigned char cannot_operate_on_channel = 4;
+constexpr unsigned char target_not_suitable = 5;
+constexpr unsigned char association_failed = 6;
+constexpr size_t frame_limit = 1024;
+constexpr size_t replay_limit = 16;
+
+struct request {
+    mac_address controller{};
+    mac_address agent{};
+    mac_address station{};
+    mac_address target{};
+    unsigned short message_id = 0;
+    unsigned char operating_class = 0;
+    unsigned char channel = 0;
+
+    bool same_identity(const request &other) const
+    {
+        return controller == other.controller && message_id == other.message_id;
+    }
+
+    bool operator==(const request &other) const
+    {
+        return same_identity(other) && agent == other.agent &&
+            station == other.station && target == other.target &&
+            operating_class == other.operating_class && channel == other.channel;
+    }
+};
+
+inline bool valid_mac(const mac_address &address)
+{
+    return (address[0] & 1) == 0 &&
+        std::any_of(address.begin(), address.end(), [](unsigned char octet) { return octet != 0; });
+}
+
+inline bool is_request(const unsigned char *frame, size_t length)
+{
+    return frame != nullptr && length >= 22 && frame[12] == 0x89 &&
+        frame[13] == 0x3a && frame[16] == 0x80 && frame[17] == 0x19;
+}
+
+inline bool decode_request(const unsigned char *frame, size_t length, request &decoded)
+{
+    if (!is_request(frame, length) || length > frame_limit || frame[14] != 0 ||
+        frame[15] != 0 || frame[20] != 0 || frame[21] != 0x80) return false;
+    request parsed{};
+    std::copy_n(frame, 6, parsed.agent.begin());
+    std::copy_n(frame + 6, 6, parsed.controller.begin());
+    parsed.message_id = static_cast<unsigned short>((frame[18] << 8) | frame[19]);
+    bool found = false;
+    size_t offset = 22;
+    while (offset + 3 <= length) {
+        const unsigned char type = frame[offset];
+        const size_t value_length = (frame[offset + 1] << 8) | frame[offset + 2];
+        offset += 3;
+        if (value_length > length - offset) return false;
+        if (type == 0) {
+            if (value_length != 0 || !found || !valid_mac(parsed.controller) ||
+                !valid_mac(parsed.agent) || !valid_mac(parsed.station) ||
+                !valid_mac(parsed.target)) return false;
+            if (!std::all_of(frame + offset, frame + length,
+                    [](unsigned char octet) { return octet == 0; })) return false;
+            decoded = parsed;
+            return true;
+        }
+        if (type == 0x9e) {
+            if (found || value_length != 14) return false;
+            found = true;
+            std::copy_n(frame + offset, 6, parsed.station.begin());
+            std::copy_n(frame + offset + 6, 6, parsed.target.begin());
+            parsed.operating_class = frame[offset + 12];
+            parsed.channel = frame[offset + 13];
+        }
+        offset += value_length;
+    }
+    return false;
+}
+
+inline std::vector<unsigned char> reply(const request &command, bool acknowledgement,
+    unsigned char error = 0)
+{
+    std::vector<unsigned char> frame(22, 0);
+    std::copy(command.controller.begin(), command.controller.end(), frame.begin());
+    std::copy(command.agent.begin(), command.agent.end(), frame.begin() + 6);
+    frame[12] = 0x89;
+    frame[13] = 0x3a;
+    frame[16] = 0x80;
+    frame[17] = acknowledgement ? 0 : 0x1a;
+    frame[18] = static_cast<unsigned char>(command.message_id >> 8);
+    frame[19] = static_cast<unsigned char>(command.message_id);
+    frame[21] = 0x80;
+    if (!acknowledgement) {
+        frame.insert(frame.end(), {0x9f, 0, 13});
+        frame.insert(frame.end(), command.station.begin(), command.station.end());
+        frame.insert(frame.end(), command.target.begin(), command.target.end());
+        frame.push_back(error == 0 ? 0 : 1);
+        if (error != 0) {
+            frame.insert(frame.end(), {0xa3, 0, 7, error});
+            frame.insert(frame.end(), command.station.begin(), command.station.end());
+        }
+    }
+    frame.insert(frame.end(), {0, 0, 0});
+    return frame;
+}
+
+struct transaction {
+    request command{};
+    unsigned int radio_instance = 0;
+    clock::time_point deadline{};
+    clock::time_point expires{};
+    bool completed = false;
+    unsigned char error = 0;
+};
+
+class transactions {
+    std::deque<transaction> history;
+
+    bool make_room()
+    {
+        while (history.size() >= replay_limit) {
+            const auto oldest = std::find_if(history.begin(), history.end(),
+                [](const transaction &entry) { return entry.completed; });
+            if (oldest == history.end()) return false;
+            history.erase(oldest);
+        }
+        return true;
+    }
+
+public:
+    void prune(clock::time_point now)
+    {
+        history.erase(std::remove_if(history.begin(), history.end(),
+            [now](const transaction &entry) {
+                return entry.completed && now >= entry.expires;
+            }), history.end());
+    }
+
+    transaction *find(const request &command)
+    {
+        for (auto &entry : history) {
+            if (entry.command.same_identity(command)) return &entry;
+        }
+        return nullptr;
+    }
+
+    transaction *pending()
+    {
+        for (auto &entry : history) {
+            if (!entry.completed) return &entry;
+        }
+        return nullptr;
+    }
+
+    transaction *insert(const request &command, unsigned int radio_instance,
+        clock::time_point now)
+    {
+        if (find(command) != nullptr || pending() != nullptr) return nullptr;
+        prune(now);
+        if (!make_room()) return nullptr;
+        history.emplace_back();
+        transaction &entry = history.back();
+        entry.command = command;
+        entry.radio_instance = radio_instance;
+        entry.deadline = now + std::chrono::seconds(10);
+        return &entry;
+    }
+
+    void complete(transaction &entry, unsigned char error, clock::time_point now)
+    {
+        entry.completed = true;
+        entry.error = error;
+        entry.expires = now + std::chrono::seconds(60);
+    }
+
+    void remember_rejection(const request &command, unsigned char error, clock::time_point now)
+    {
+        if (find(command) != nullptr) return;
+        prune(now);
+        if (!make_room()) return;
+        history.emplace_back();
+        history.back().command = command;
+        complete(history.back(), error, now);
+    }
+
+    size_t size() const { return history.size(); }
+};
+
+}
+
+#endif
