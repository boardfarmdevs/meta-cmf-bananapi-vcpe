+#ifndef EM_BACKHAUL_WIRE_H
+#define EM_BACKHAUL_WIRE_H
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace em_backhaul {
+
+struct wire_tlv {
+    unsigned char type;
+    const unsigned char *value;
+    size_t size;
+};
+
+inline unsigned int read16(const unsigned char *bytes)
+{
+    return static_cast<unsigned int>(bytes[0]) * 256U + bytes[1];
+}
+
+inline uint32_t read32(const unsigned char *bytes)
+{
+    return (static_cast<uint32_t>(read16(bytes)) << 16) | read16(bytes + 2);
+}
+
+inline bool parse_frame(const unsigned char *data, size_t size, std::vector<wire_tlv> &tlvs)
+{
+    tlvs.clear();
+    if (!data || size < 25 || data[12] != 0x89 || data[13] != 0x3a ||
+        data[14] != 0 || data[15] != 0 || data[20] != 0 || data[21] != 0x80) return false;
+    size_t offset = 22;
+    while (offset + 3 <= size) {
+        const unsigned int length = read16(data + offset + 1);
+        if (length > size - offset - 3) return false;
+        if (data[offset] == 0) return length == 0 && std::all_of(data + offset + 3, data + size,
+            [](unsigned char octet) { return octet == 0; });
+        tlvs.push_back({data[offset], data + offset + 3, length});
+        offset += 3 + length;
+    }
+    return false;
+}
+
+inline std::vector<unsigned char> frame(const std::string &destination,
+    const std::string &source, unsigned int type, unsigned int mid,
+    unsigned char tlv, const std::vector<unsigned char> &payload)
+{
+    if (destination.size() != 6 || source.size() != 6 || payload.size() > 4096) return {};
+    std::vector<unsigned char> result(28 + payload.size(), 0);
+    std::copy(destination.begin(), destination.end(), result.begin());
+    std::copy(source.begin(), source.end(), result.begin() + 6);
+    result[12] = 0x89;
+    result[13] = 0x3a;
+    result[16] = static_cast<unsigned char>(type >> 8);
+    result[17] = static_cast<unsigned char>(type);
+    result[18] = static_cast<unsigned char>(mid >> 8);
+    result[19] = static_cast<unsigned char>(mid);
+    result[21] = 0x80;
+    result[22] = tlv;
+    result[23] = static_cast<unsigned char>(payload.size() >> 8);
+    result[24] = static_cast<unsigned char>(payload.size());
+    std::copy(payload.begin(), payload.end(), result.begin() + 25);
+    return result;
+}
+
+}
+
+#endif
