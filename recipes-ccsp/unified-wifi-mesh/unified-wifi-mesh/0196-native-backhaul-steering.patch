+#ifndef EM_UNASSOC_QUERY_TRACKER_H
+#define EM_UNASSOC_QUERY_TRACKER_H
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <vector>
+
+class em_unassoc_query_tracker {
+public:
+    struct measurement {
+        std::string key;
+        unsigned char rcpi = 255;
+        int64_t observed = 0;
+    };
+    struct response {
+        unsigned short mid;
+        std::vector<measurement> metrics;
+        std::set<unsigned char> op_classes;
+    };
+
+private:
+    struct request {
+        int64_t sent = 0;
+        std::set<std::string> expected;
+    };
+    std::mutex m_mutex;
+    std::map<unsigned short, request> m_requests;
+
+    void expire(int64_t now)
+    {
+        for (auto iterator = m_requests.begin(); iterator != m_requests.end();) {
+            if (now - iterator->second.sent > 30000) iterator = m_requests.erase(iterator);
+            else ++iterator;
+        }
+    }
+
+public:
+    bool insert(unsigned short mid, const std::set<std::string> &expected, int64_t now)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        expire(now);
+        if (expected.empty() || expected.size() > 256 || m_requests.size() >= 64) return false;
+        const auto existing = m_requests.find(mid);
+        if (existing != m_requests.end()) return existing->second.expected == expected;
+        m_requests[mid] = {now, expected};
+        return true;
+    }
+
+    bool contains(unsigned short mid, int64_t now)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        expire(now);
+        return m_requests.count(mid) != 0;
+    }
+
+    std::vector<response> accept(unsigned short mid, const std::vector<measurement> &metrics, int64_t now)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        expire(now);
+        std::vector<response> result;
+        auto iterator = m_requests.find(mid);
+        if (iterator != m_requests.end()) {
+            auto &query = iterator->second;
+            response reply{iterator->first, {}, {}};
+            std::map<std::string, measurement> received;
+            for (const auto &key : query.expected) {
+                if (!key.empty()) reply.op_classes.insert(static_cast<unsigned char>(key[0]));
+            }
+            for (const auto &metric : metrics) {
+                if (query.expected.count(metric.key) == 0 || metric.observed < query.sent ||
+                    metric.observed > now || now - metric.observed > 6000) continue;
+                auto &saved = received[metric.key];
+                if (metric.observed >= saved.observed) saved = metric;
+            }
+            for (const auto &metric : received) reply.metrics.push_back(metric.second);
+            result.push_back(reply);
+            m_requests.erase(iterator);
+        }
+        return result;
+    }
+};
+
+#endif
