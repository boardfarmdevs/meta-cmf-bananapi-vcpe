 {
     auto command_lock = lock_commands();
     em_cmd_t *pcmd;
@@ -212,6 +212,13 @@
         if (pcmd == nullptr || pcmd->m_type != type) {
             continue;
         }
+        bool owned = (owner == nullptr);
+        for (unsigned int j = 0; !owned && j < queue_count(pcmd->m_em_candidates); j++) {
+            owned = queue_peek(pcmd->m_em_candidates, j) == owner;
+        }
+        if (!owned) {
