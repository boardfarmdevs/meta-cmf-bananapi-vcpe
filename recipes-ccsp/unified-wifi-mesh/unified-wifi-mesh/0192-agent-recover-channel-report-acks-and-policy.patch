+bool em_channel_t::operating_channel_report_peer_matches()
+{
+    if (m_pending_operating_channel_report.empty()) {
+        return false;
+    }
+    dm_easy_mesh_t *dm = get_data_model();
+    const auto *report = reinterpret_cast<const em_raw_hdr_t *>(
+        m_pending_operating_channel_report.data());
+    if (dm == NULL || memcmp(report->dst, dm->get_ctl_mac(), sizeof(mac_address_t)) != 0 ||
+            memcmp(report->src, dm->get_agent_al_interface_mac(), sizeof(mac_address_t)) != 0) {
+        m_pending_operating_channel_report.clear();
+        return false;
+    }
+    return true;
+}
+
+bool em_channel_t::acknowledge_operating_channel_report(unsigned char *buff, unsigned int len)
+{
+    if (buff == NULL || len < sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t)) {
+        return false;
+    }
+    std::lock_guard<std::mutex> report_lock(m_operating_channel_report_mutex);
+    if (!operating_channel_report_peer_matches()) {
+        return false;
+    }
+    em_raw_hdr_t *ack = reinterpret_cast<em_raw_hdr_t *>(buff);
+    em_cmdu_t *ack_cmdu = reinterpret_cast<em_cmdu_t *>(buff + sizeof(em_raw_hdr_t));
+    em_raw_hdr_t *report = reinterpret_cast<em_raw_hdr_t *>(m_pending_operating_channel_report.data());
+    em_cmdu_t *report_cmdu = reinterpret_cast<em_cmdu_t *>(
+        m_pending_operating_channel_report.data() + sizeof(em_raw_hdr_t));
+    if (ack_cmdu->type != htons(em_msg_type_1905_ack) ||
+            ack_cmdu->id != report_cmdu->id ||
+            memcmp(ack->src, report->dst, sizeof(mac_address_t)) != 0 ||
+            memcmp(ack->dst, report->src, sizeof(mac_address_t)) != 0) {
+        return false;
+    }
+    m_pending_operating_channel_report.clear();
+    em_printfout("Operating channel report acknowledged: MID %u", ntohs(ack_cmdu->id));
+    return true;
+}
+
+void em_channel_t::retry_operating_channel_report()
+{
+    std::lock_guard<std::mutex> report_lock(m_operating_channel_report_mutex);
+    if (!operating_channel_report_peer_matches() ||
+            std::chrono::steady_clock::now() < m_operating_channel_retry_due) {
+        return;
+    }
+    m_operating_channel_retry_interval = std::min(30U, m_operating_channel_retry_interval * 2);
+    send_frame(m_pending_operating_channel_report.data(),
+        static_cast<unsigned int>(m_pending_operating_channel_report.size()));
+    m_operating_channel_retry_due = std::chrono::steady_clock::now() +
+        std::chrono::seconds(m_operating_channel_retry_interval);
+}
