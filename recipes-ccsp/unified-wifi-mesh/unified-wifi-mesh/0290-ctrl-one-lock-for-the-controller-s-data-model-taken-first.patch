+{
+    static bool ready = false;
+    em_ctrl_t *ctrl = em_ctrl_t::get_em_ctrl_instance();
+    if (ready == false) {
+        ctrl->init("/tmp/test_config.db");
+        ctrl->get_dm_ctrl()->test_data_model_list().init(ctrl);
+        ready = true;
+    }
+    return ctrl;
+}
