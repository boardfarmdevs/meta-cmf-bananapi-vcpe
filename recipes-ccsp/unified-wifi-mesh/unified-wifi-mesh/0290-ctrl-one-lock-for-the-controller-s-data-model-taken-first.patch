+void em_mgr_t::run_locked_step(const char *what, const std::function<void()> &step)
+{
+    using steady_clock = std::chrono::steady_clock;
+    {
+        std::unique_lock<std::recursive_mutex> data_model_lock = lock_data_model();
+        const auto start = steady_clock::now();
+        m_in_locked_step = data_model_lock.owns_lock();
+        step();
+        m_in_locked_step = false;
+        const long held_ms = static_cast<long>(
+            std::chrono::duration_cast<std::chrono::milliseconds>(steady_clock::now() - start).count());
+        if (data_model_lock.owns_lock() == true && held_ms >= EM_LOCKED_STEP_LOG_MS) {
+            em_printfout("Main-loop step (%s) held the data model's lock %ld ms", what, held_ms);
+        }
+    }
+    free_deferred_nodes();
+}
