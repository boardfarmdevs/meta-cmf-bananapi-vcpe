+/* 0290: a main-loop step holds the controller's one lock. A node with a frame queued waits for it;
+ * deleted in the step (a Reset's delete_nodes), it neither stalls the step nor runs the frame:
+ * freeing it there would wait EM_NODE_JOIN_MS for a thread that cannot end while the step holds
+ * the lock, then keep it. Told to stop in the step, still readable in it (ASan), it skips the
+ * frame once it has the lock and is freed after the step. */
+TEST_F(em_ctrl_t_Test, locked_step_frees_the_nodes_it_deleted_after_the_lock)
+{
+    using steady_clock = std::chrono::steady_clock;
+    dm_easy_mesh_t dm;
+    em_interface_t ruid = {};
+    const unsigned char mac[6] = {0x02, 0x00, 0x00, 0x29, 0x00, 0x01};
+
+    setup_interface(ruid, "step", mac);
+    ruid.media = em_media_type_ieee80211ac_5;
+    em_t *em = ctrl.create_node(&ruid, em_freq_band_5, &dm, false, em_profile_type_3, em_service_type_agent);
+    ASSERT_NE(em, nullptr);
+    ASSERT_TRUE(ctrl.lock_data_model().owns_lock());
+
+    bool readable = false;
+    const auto start = steady_clock::now();
+    ctrl.run_locked_step("test", [&]() {
+        em_event_t *evt = static_cast<em_event_t *>(calloc(1, sizeof(em_event_t)));
+        ASSERT_NE(evt, nullptr);
+        evt->type = em_event_type_frame;
+        evt->u.fevt.frame = static_cast<unsigned char *>(calloc(1, 64));
+        evt->u.fevt.frame_len = 64;
+        em->push_to_queue(evt);
+        /* the node's thread takes the frame and waits for the lock */
+        std::this_thread::sleep_for(std::chrono::milliseconds(200));
+        ctrl.delete_nodes();
+        EXPECT_TRUE(ctrl.get_nodes().empty());
+        readable = em->is_thread_running();
+    });
+    const long step_ms = static_cast<long>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(steady_clock::now() - start).count());
+    EXPECT_TRUE(readable);
+    EXPECT_LT(step_ms, 1500);
+    EXPECT_TRUE(ctrl.get_nodes().empty());
+}
