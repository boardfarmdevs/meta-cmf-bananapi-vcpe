+    ASSERT_TRUE(held.owns_lock());
+    std::thread bus([&methods]() {
+        const bus_error_t refused[] = {
+            em_ctrl_t::cmd_setssid("x", nullptr, nullptr, nullptr),
+            em_ctrl_t::cmd_unassocstalinkmetricsquery("x", nullptr, nullptr, nullptr),
+            em_ctrl_t::cmd_steerwifibh("x", nullptr, nullptr, nullptr),
+            em_ctrl_t::cmd_channelscan("x", nullptr, nullptr, nullptr),
+            em_ctrl_t::cmd_channelselect("x", nullptr, nullptr, nullptr),
+            em_ctrl_t::cmd_clientsteer("x", nullptr, nullptr, nullptr),
+            em_ctrl_t::cmd_disassociate("x", nullptr, nullptr, nullptr),
+        };
+        for (bus_error_t rc : refused) {
+            if (rc != bus_error_success) {
+                methods++;
+            }
+        }
+    });
+    std::thread listener([ctrl, &routed]() {
+        unsigned char frame[64] = {};
+        ctrl->proto_process(frame, sizeof(frame), nullptr);
+        routed = true;
+    });
+    std::this_thread::sleep_for(std::chrono::milliseconds(300));
+    EXPECT_EQ(methods.load(), 0);
+    EXPECT_FALSE(routed.load());
+    held.unlock();
+    bus.join();
+    listener.join();
+    EXPECT_EQ(methods.load(), 7);
+    EXPECT_TRUE(routed.load());
+    __lsan_enable();
+}
+
+/* 0290: an agent's station rows change while the bus reads the topology and the listener routes
+ * the agent's frames, as the database pass, a DataElements poll and a Topology Response meet in
+ * the field. The main thread's steps put and remove the rows (the list's put_sta and remove_sta,
+ * the database pass's), a bus thread encodes the network topology with each BSS's station list
+ * (tr_181_t::get_network_topology, which walks every model's station map), and the listener
+ * routes the agent's Topology Responses (its model and radios read). Under the one lock: no row
+ * read after it was freed (ASan) and no data race (the suite's TSan run). */
+TEST(em_ctrl_t, station_rows_change_while_the_bus_and_the_listener_read)
+{
+    __lsan_disable();
+    em_ctrl_t *ctrl = ready_instance();
+    const unsigned char ctrl_mac[6] = {0x02, 0x00, 0x00, 0x29, 0x01, 0x00};
+    const unsigned char agent_mac[6] = {0x02, 0x00, 0x00, 0x29, 0x01, 0x10};
+    const unsigned char ruid[6] = {0x02, 0x00, 0x00, 0x29, 0x01, 0x11};
+    const unsigned char bssid[6] = {0x02, 0x00, 0x00, 0x29, 0x01, 0x12};
+    em_interface_t ctrl_intf = {}, agent_intf = {};
+    strncpy(ctrl_intf.name, "eth0", sizeof(ctrl_intf.name) - 1);
+    memcpy(ctrl_intf.mac, ctrl_mac, sizeof(ctrl_intf.mac));
+    strncpy(agent_intf.name, "eth1", sizeof(agent_intf.name) - 1);
+    memcpy(agent_intf.mac, agent_mac, sizeof(agent_intf.mac));
+
+    dm_easy_mesh_t *dm = nullptr;
+    {
+        std::unique_lock<std::recursive_mutex> data_model_lock = ctrl->lock_data_model();
+        ASSERT_NE(ctrl->create_data_model(GLOBAL_NET_ID, &ctrl_intf), nullptr);
+        ctrl->init_network_topology();
+        ASSERT_NE(g_network_topology, nullptr);
+        /* an agent with one radio and its AP BSS, in the topology (by hand, as in the RemoveDevice
+         * test: the models made here are all the controller's) */
+        dm = ctrl->create_data_model(GLOBAL_NET_ID, &agent_intf);
+        ASSERT_NE(dm, nullptr);
+        dm->m_num_radios = 1;
+        memcpy(dm->m_radio[0].m_radio_info.intf.mac, ruid, sizeof(mac_address_t));
+        memcpy(dm->m_radio[0].m_radio_info.id.ruid, ruid, sizeof(mac_address_t));
+        dm->m_num_bss = 1;
+        memcpy(dm->m_bss[0].m_bss_info.id.ruid, ruid, sizeof(mac_address_t));
+        memcpy(dm->m_bss[0].m_bss_info.bssid.mac, bssid, sizeof(mac_address_t));
+        dm->m_bss[0].m_bss_info.vap_mode = em_vap_mode_ap;
+        std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+        g_network_topology->add(dm);
+        ASSERT_NE(g_network_topology->find_topology(dm), nullptr);
+    }
+
+    const unsigned int rows = 8;
+    std::vector<std::string> keys;
+    std::vector<dm_sta_t> stations(rows);
+    for (unsigned int i = 0; i < rows; i++) {
+        const unsigned char sta_mac[6] = {0x02, 0x00, 0x00, 0x29, 0x02, static_cast<unsigned char>(i)};
+        memcpy(stations[i].m_sta_info.id, sta_mac, sizeof(mac_address_t));
+        memcpy(stations[i].m_sta_info.bssid, bssid, sizeof(mac_address_t));
+        memcpy(stations[i].m_sta_info.radiomac, ruid, sizeof(mac_address_t));
+        keys.push_back(util::mac_to_string(sta_mac) + "@" + util::mac_to_string(bssid) + "@" +
+            util::mac_to_string(ruid));
+    }
+
+    std::atomic<bool> done(false);
+    std::atomic<unsigned long> encoded(0), routed(0);
+    std::thread bus([&done, &encoded]() {
+        while (done.load() == false) {
+            raw_data_t raw = {};
+            if (tr_181_t::get_network_topology(nullptr, &raw, nullptr) == bus_error_success) {
+                free(raw.raw_data.bytes);
+                encoded++;
+            }
+        }
+    });
+    std::thread listener([ctrl, &done, &routed, &agent_mac, &ctrl_mac]() {
+        unsigned char frame[sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t) + 8] = {};
+        em_raw_hdr_t *hdr = reinterpret_cast<em_raw_hdr_t *>(frame);
+        em_cmdu_t *cmdu = reinterpret_cast<em_cmdu_t *>(frame + sizeof(em_raw_hdr_t));
+        memcpy(hdr->dst, ctrl_mac, sizeof(mac_address_t));
+        memcpy(hdr->src, agent_mac, sizeof(mac_address_t));
+        hdr->type = htons(ETH_P_1905);
+        cmdu->type = htons(em_msg_type_topo_resp);
+        while (done.load() == false && routed.load() < 200) {
+            ctrl->proto_process(frame, sizeof(frame), nullptr);
+            routed++;
+            std::this_thread::sleep_for(std::chrono::milliseconds(2));
+        }
+    });
+    /* 400 rounds, and at least 300 ms, so the three overlap for a while */
+    const auto until = std::chrono::steady_clock::now() + std::chrono::milliseconds(300);
+    for (unsigned int round = 0; round < 400 || std::chrono::steady_clock::now() < until; round++) {
+        ctrl->run_locked_step("test", [&]() {
+            for (unsigned int i = 0; i < rows; i++) {
+                if (round % 2 == 0) {
+                    ctrl->get_dm_ctrl()->test_data_model_list().put_sta(keys[i].c_str(), &stations[i]);
+                } else {
+                    ctrl->get_dm_ctrl()->test_data_model_list().remove_sta(keys[i].c_str());
+                }
+            }
+        });
+    }
+    done = true;
+    bus.join();
+    listener.join();
+    EXPECT_GT(encoded.load(), 0UL);
+    EXPECT_GT(routed.load(), 0UL);
+    {
+        std::unique_lock<std::recursive_mutex> data_model_lock = ctrl->lock_data_model();
+        std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+        g_network_topology->remove(dm);
+    }
+    __lsan_enable();
+}
