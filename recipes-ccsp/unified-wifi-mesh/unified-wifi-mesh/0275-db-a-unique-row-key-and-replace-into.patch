+
+bool db_easy_mesh_t::query_fits(int len, const char *what)
+{
+    /* vsnprintf cuts a statement silently at the buffer's end: a cut statement is not run */
+    if (len < 0 || static_cast<size_t>(len) >= sizeof(db_query_t)) {
+        em_printfout("%s statement for %s needs %d bytes, more than %zu: not executed", what, m_table_name,
+            len, sizeof(db_query_t) - 1);
+        return false;
+    }
+    if (len > m_longest_query) {
+        m_longest_query = len;
+        if (static_cast<size_t>(len) > sizeof(db_query_t) / 4) {
+            em_printfout("Longest %s statement for %s so far: %d of %zu bytes", what, m_table_name, len,
+                sizeof(db_query_t));
+        }
+    }
+    return true;
+}
