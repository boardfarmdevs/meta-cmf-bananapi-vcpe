+bool db_easy_mesh_t::has_row_key(db_client_t& db_client)
+{
+    db_query_t query;
+    bool present = false;
+    void *ctx;
+
+    snprintf(query, sizeof(db_query_t), "show index from %s where Key_name = 'uk_row'", m_table_name);
+    ctx = db_client.execute(query);
+    while (db_client.next_result(ctx) == true) {
+        present = true;
+    }
+    return present;
+}
