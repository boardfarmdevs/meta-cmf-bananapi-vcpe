+// A table's row key. A UNIQUE key on the columns that identify a row (created with the
+// table, or added at load once duplicate rows are removed), rows written with REPLACE INTO, and
+// a statement that would be cut at the 2048-byte buffer not run. On scratch tables in the
+// controller's database; run with em_ctrl stopped.
+#include <string>
+#include "db_easy_mesh.h"
+#include "dm_sta_list.h"
+
+namespace {
+void drain(db_client_t &client, const char *sql)
+{
+    void *ctx = client.execute(sql);
+    while (client.next_result(ctx) == true);
+}
+
+int number(db_client_t &client, const char *sql)
+{
+    int n = -1;
+    void *ctx = client.execute(sql);
+    while (client.next_result(ctx) == true) {
+        n = client.get_number(ctx, 1);
+    }
+    return n;
+}
+
+class ut_key_table_t : public db_easy_mesh_t {
+public:
+    void init_table() override { snprintf(m_table_name, sizeof(m_table_name), "%s", "UtKeyList"); }
+    void init_columns() override
+    {
+        m_num_cols = 0;
+        set_row_key("ID");
+        m_columns[m_num_cols++] = db_column_t("ID", db_data_type_char, 64);
+        m_columns[m_num_cols++] = db_column_t("Val", db_data_type_char, 32);
+    }
+    int sync_db(db_client_t&, void *) override { return 0; }
+    int update_db(db_client_t&, dm_orch_type_t, void *) override { return 0; }
+    bool search_db(db_client_t&, void *, void *) override { return false; }
+    bool operator == (const db_easy_mesh_t&) override { return false; }
+    int set_config(db_client_t&, const cJSON *, void *) override { return 0; }
+    int get_config(cJSON *, void *, bool) override { return 0; }
+};
+
