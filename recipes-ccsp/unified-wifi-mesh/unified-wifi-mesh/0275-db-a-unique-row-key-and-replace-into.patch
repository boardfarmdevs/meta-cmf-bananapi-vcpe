+int db_easy_mesh_t::heal_row_key(db_client_t& db_client)
+{
+    /* A table made before its key: rows written twice (a device's row, 0270's rejoin after a
+     * retirement whose delete missed) are reduced to one, then the key is added, so a board
+     * that has them heals at its next start. In the ID tables such rows are identical, so which
+     * one stays does not matter. In STAList rows with the same key can differ in their other
+     * columns: one of them stays (the first the server finds), and the station's next live
+     * write replaces it with what the agent reports. */
+    if (m_row_key[0] == 0 || has_row_key(db_client) == true) {
+        return 0;
+    }
+
+    std::vector<std::string> cols;
+    std::string spec(m_row_key);
+    size_t start = 0;
+    while (start <= spec.size()) {
+        size_t end = spec.find(',', start);
+        std::string col = spec.substr(start, (end == std::string::npos) ? std::string::npos : end - start);
+        col.erase(0, col.find_first_not_of(' '));
+        col.erase(col.find_last_not_of(' ') + 1);
+        if (col.empty() == false) {
+            cols.push_back(col);
+        }
+        if (end == std::string::npos) {
+            break;
+        }
+        start = end + 1;
+    }
+
+    db_query_t query;
+    db_result_t value;
+    void *ctx;
+    struct duplicate_t {
+        std::string where{};
+        int count = 0;
+    };
+    std::vector<duplicate_t> duplicates;
+
+    /* a value from the database inside quotes: its ' and \ escaped (net_id is configurable) */
+    auto quoted = [](const char *v) {
+        std::string s("'");
+        for (const char *c = v; *c != 0; c++) {
+            if (*c == '\'' || *c == '\\') {
+                s += '\\';
+            }
+            s += *c;
+        }
+        return s + "'";
+    };
+
+    snprintf(query, sizeof(db_query_t), "select %s, count(*) from %s group by %s having count(*) > 1",
+        m_row_key, m_table_name, m_row_key);
+    ctx = db_client.execute(query);
+    while (db_client.next_result(ctx) == true) {
+        duplicate_t d;
+        for (unsigned int i = 0; i < cols.size(); i++) {
+            memset(value, 0, sizeof(value));
+            d.where += (i == 0) ? "" : " and ";
+            if (db_client.get_string(ctx, value, i + 1) == NULL) {
+                d.where += cols[i] + " is null";
+            } else {
+                d.where += cols[i] + " = " + quoted(value);
+            }
+        }
+        d.count = db_client.get_number(ctx, static_cast<unsigned int>(cols.size()) + 1);
+        duplicates.push_back(d);
+    }
+    for (auto &d : duplicates) {
+        if (d.count < 2) {
+            continue;
+        }
+        snprintf(query, sizeof(db_query_t), "delete from %s where %s limit %d", m_table_name, d.where.c_str(),
+            d.count - 1);
+        ctx = db_client.execute(query);
+        while (db_client.next_result(ctx) == true);
+        em_printfout("%s: %d identical rows where %s, %d removed", m_table_name, d.count, d.where.c_str(),
+            d.count - 1);
+    }
+
+    snprintf(query, sizeof(db_query_t), "alter table %s add unique key uk_row (%s)", m_table_name, m_row_key);
+    ctx = db_client.execute(query);
+    while (db_client.next_result(ctx) == true);
+    /* the client cannot tell a failed statement from one without results: read the key back */
+    bool added = has_row_key(db_client);
+    em_printfout("%s: UNIQUE key on (%s) %s", m_table_name, m_row_key,
+        added ? "added" : "not added, its rows written as before");
+    return added ? 0 : -1;
+}
