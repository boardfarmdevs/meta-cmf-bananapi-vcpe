+TEST_F(db_row_key_Test, DuplicatesRemovedAndTheKeyAddedOnATableMadeWithoutIt)
+{
+    drain(client, "create table UtKeyList (ID char(64), Val char(32))");
+    drain(client, "insert into UtKeyList values ('a','1'),('a','1'),('a','1'),('b','2'),('b','2'),('c','3'),"
+        "('d''q','4'),('d''q','4')");
+    EXPECT_FALSE(table.has_row_key(client));
+    EXPECT_EQ(table.heal_row_key(client), 0);
+    EXPECT_TRUE(table.has_row_key(client));
+    EXPECT_EQ(number(client, "select count(*) from UtKeyList"), 4);
+    // a value with a quote, escaped in the delete's WHERE
+    EXPECT_EQ(number(client, "select count(*) from UtKeyList where ID = 'd''q'"), 1);
+    // healed once: a second pass finds the key and does nothing
+    EXPECT_EQ(table.heal_row_key(client), 0);
+    EXPECT_EQ(number(client, "select count(*) from UtKeyList"), 4);
+}
+
