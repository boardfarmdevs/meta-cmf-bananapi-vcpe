+    auto command_lock = orch->lock_commands();
     em_tlv_t *tlv, *tlv_start;
     size_t tmp_len, base_len;
     mac_address_t 	sta_mac;
@@ -384,7 +389,9 @@
         tlv = reinterpret_cast<em_tlv_t *> (reinterpret_cast<unsigned char *> (tlv) + sizeof(em_tlv_t) + htons(tlv->len));
