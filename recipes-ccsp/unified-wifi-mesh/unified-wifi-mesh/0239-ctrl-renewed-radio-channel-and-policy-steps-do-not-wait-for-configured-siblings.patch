+                em_t *policy_em = NULL;
+                for (auto &em : em_radios) {
+                    if ((em != NULL) && (em->get_state() == em_state_ctrl_set_policy_pending)) {
+                        policy_em = em;
+                        break;
+                    }
+                }
+                if (policy_em == this)
                 {
