+unsigned int dm_easy_mesh_t::note_reported_radios(const mac_address_t *reported, unsigned int num_reported)
+{
+    unsigned int stale = 0;
+    for (unsigned int i = 0; i < m_num_radios; i++) {
+        const unsigned char *ruid = m_radio[i].m_radio_info.intf.mac;
+        bool listed = false;
+        for (unsigned int r = 0; r < num_reported && !listed; r++) {
+            listed = memcmp(reported[r], ruid, sizeof(mac_address_t)) == 0;
+        }
+        unsigned int slot = m_num_unreported_radio;
+        for (unsigned int u = 0; u < m_num_unreported_radio; u++) {
+            if (memcmp(m_unreported_radio[u].ruid, ruid, sizeof(mac_address_t)) == 0) {
+                slot = u;
+                break;
+            }
+        }
+        if (listed) {
+            if (slot < m_num_unreported_radio) {
+                m_unreported_radio[slot] = m_unreported_radio[--m_num_unreported_radio];
+            }
+            continue;
+        }
+        if (slot == m_num_unreported_radio) {
+            if (m_num_unreported_radio >= EM_MAX_BANDS) {
+                continue;
+            }
+            memcpy(m_unreported_radio[slot].ruid, ruid, sizeof(mac_address_t));
+            m_unreported_radio[slot].responses = 0;
+            m_num_unreported_radio++;
+        }
+        if (++m_unreported_radio[slot].responses == EM_RADIO_UNREPORTED_RESPONSES &&
+                m_num_stale_radio < EM_MAX_BANDS) {
+            memcpy(m_stale_radio[m_num_stale_radio++], ruid, sizeof(mac_address_t));
+            stale++;
+        }
+    }
+    return stale;
+}
+
+bool dm_easy_mesh_t::take_stale_radio(mac_address_t ruid)
+{
+    if (m_num_stale_radio == 0) {
+        return false;
+    }
+    memcpy(ruid, m_stale_radio[--m_num_stale_radio], sizeof(mac_address_t));
+    return true;
+}
+
+void dm_easy_mesh_t::retire_radio(const unsigned char *ruid)
+{
+    for (int i = static_cast<int>(m_num_bss) - 1; i >= 0; i--) {
+        em_bss_info_t *bss = &m_bss[i].m_bss_info;
+        if (memcmp(bss->ruid.mac, ruid, sizeof(mac_address_t)) == 0) {
+            remember_removed_bss(bss);
+            remove_bss_by_index(static_cast<unsigned int>(i));
+        }
+    }
+    for (int i = static_cast<int>(m_num_opclass) - 1; i >= 0; i--) {
+        if (memcmp(m_op_class[i].m_op_class_info.id.ruid, ruid, sizeof(mac_address_t)) == 0) {
+            for (unsigned int k = static_cast<unsigned int>(i); k + 1 < m_num_opclass; k++) {
+                m_op_class[k] = m_op_class[k + 1];
+            }
+            m_num_opclass--;
+        }
+    }
+    for (unsigned int i = 0; i < m_num_radios; i++) {
+        if (memcmp(m_radio[i].m_radio_info.intf.mac, ruid, sizeof(mac_address_t)) != 0) {
+            continue;
+        }
+        /* the capabilities are the radios' by index */
+        for (unsigned int k = i; k + 1 < m_num_radios; k++) {
+            m_radio[k] = m_radio[k + 1];
+            m_radio_cap[k] = m_radio_cap[k + 1];
+        }
+        m_num_radios--;
+        break;
+    }
+    for (unsigned int u = 0; u < m_num_unreported_radio; u++) {
+        if (memcmp(m_unreported_radio[u].ruid, ruid, sizeof(mac_address_t)) == 0) {
+            m_unreported_radio[u] = m_unreported_radio[--m_num_unreported_radio];
+            break;
+        }
+    }
+}
