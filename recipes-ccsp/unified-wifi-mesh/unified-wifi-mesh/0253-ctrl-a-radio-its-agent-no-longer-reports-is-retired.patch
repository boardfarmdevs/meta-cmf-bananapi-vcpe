+void em_ctrl_t::retire_stale_radios()
+{
+	for (dm_easy_mesh_t *dm = m_data_model.get_first_dm(); dm != NULL; dm = m_data_model.get_next_dm(dm)) {
+		mac_address_t ruid;
+		while (dm->take_stale_radio(ruid)) {
+			// commands first, then the map, then the model: no command or lookup meets a
+			// radio half removed, and the retired em's thread is told to exit before it
+			m_orch->remove_em_from_commands(ruid);
+			em_t *em = retire_node(ruid);
+			m_data_model.retire_radio(dm, ruid);
+			em_printfout("Radio %s retired: agent %s no longer reports it (%s)",
+				util::mac_to_string(ruid).c_str(),
+				util::mac_to_string(dm->get_agent_al_interface_mac()).c_str(),
+				em != NULL ? "its em stopped" : "it had no em");
+		}
+	}
+}
