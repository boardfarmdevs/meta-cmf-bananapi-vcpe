+void dm_easy_mesh_ctrl_t::retire_radio(dm_easy_mesh_t *dm, const unsigned char *ruid)
+{
+    dm_radio_t *radio = dm->get_radio(ruid);
+
+    for (unsigned int i = 0; i < dm->get_num_op_class(); i++) {
+        dm_op_class_t *op_class = dm->get_op_class(i);
+        if (memcmp(op_class->m_op_class_info.id.ruid, ruid, sizeof(mac_address_t)) != 0) {
+            continue;
+        }
+        dm_op_class_list_t::update_db(m_db_client, dm_orch_type_db_delete, op_class->get_op_class_info());
+        dm_op_class_list_t::update_list(*op_class, dm_orch_type_db_delete);
+    }
+    if (radio != NULL) {
+        dm_radio_list_t::update_db(m_db_client, dm_orch_type_db_delete, radio->get_radio_info());
+        dm_radio_list_t::update_list(*radio, dm_orch_type_db_delete);
+    }
+    dm->retire_radio(ruid);
+    dm->set_db_cfg_param(db_cfg_type_bss_list_update, "");
+}
