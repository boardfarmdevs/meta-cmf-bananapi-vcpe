index 00000000..f3bd2531
--- /dev/null
+++ b/tests/test_l1_em_cmd_agent_reply.cpp
@@ -0,0 +1,91 @@
+/*
+ * The agent's command socket: each client is answered once, and only by the event it sent.
+ */
+#include <gtest/gtest.h>
+#include <fcntl.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#include "em_cmd_agent.h"
+
+namespace {
+
+struct client_pair {
+    int peer = -1;   // the client's end
+    int agent = -1;  // the agent's end, as accept gives it
+    client_pair() {
+        int sv[2];
+        if (socketpair(AF_UNIX, SOCK_STREAM, 0, sv) == 0) {
+            peer = sv[0];
+            agent = sv[1];
+        }
+    }
+    ~client_pair() {
+        if (peer >= 0) close(peer);
+    }
+    // what the client receives: the reply's size, 0 at a close, -1 when nothing is there yet
+    ssize_t receive() const {
+        em_status_string_t reply;
+        return recv(peer, reply, sizeof(reply), MSG_DONTWAIT);
+    }
+};
+
+bool is_open(int fd) { return fcntl(fd, F_GETFD) != -1; }
+
+}  // namespace
+
+TEST(EmCmdAgentReply, AClientsEventAnswersItOnceAndClosesIt) {
+    em_cmd_agent_t cmd;
+    client_pair client;
+    char queued = 0;
+    em_cmd_agent_t::queuing_client(client.agent);
+    cmd.attach(&queued);
+    cmd.begin_reply(&queued);
+    cmd.send_result(em_cmd_out_status_success);
+    EXPECT_EQ(client.receive(), static_cast<ssize_t>(sizeof(em_status_string_t)));
+    EXPECT_EQ(client.receive(), 0);  // closed after its one reply
+    cmd.send_result(em_cmd_out_status_no_change);  // a second answer goes nowhere
+    cmd.end_reply();
+}
+
+TEST(EmCmdAgentReply, AnEventNoClientSentAnswersNoOne) {
+    em_cmd_agent_t cmd;
+    client_pair other;  // another thread's descriptor, open
+    char from_bus = 0;
+    cmd.begin_reply(&from_bus);
+    EXPECT_EQ(cmd.send_result(em_cmd_out_status_prev_cmd_in_progress), 0);
+    cmd.end_reply();
+    EXPECT_TRUE(is_open(other.agent));
+    EXPECT_EQ(other.receive(), -1);
+    close(other.agent);
+}
+
+TEST(EmCmdAgentReply, TwoClientsEachGetTheirOwnReply) {
+    em_cmd_agent_t cmd;
+    client_pair first, second;
+    char first_event = 0, second_event = 0;
+    em_cmd_agent_t::queuing_client(first.agent);
+    cmd.attach(&first_event);
+    em_cmd_agent_t::queuing_client(second.agent);
+    cmd.attach(&second_event);
+    cmd.begin_reply(&second_event);
+    cmd.send_result(em_cmd_out_status_success);
+    cmd.end_reply();
+    EXPECT_EQ(second.receive(), static_cast<ssize_t>(sizeof(em_status_string_t)));
+    EXPECT_TRUE(is_open(first.agent));
+    EXPECT_EQ(first.receive(), -1);  // nothing for the first yet
+    cmd.begin_reply(&first_event);
+    cmd.send_result(em_cmd_out_status_success);
+    cmd.end_reply();
+    EXPECT_EQ(first.receive(), static_cast<ssize_t>(sizeof(em_status_string_t)));
+}
+
+TEST(EmCmdAgentReply, AClientLeftUnansweredIsClosed) {
+    em_cmd_agent_t cmd;
+    client_pair client;
+    char queued = 0;
+    em_cmd_agent_t::queuing_client(client.agent);
+    cmd.attach(&queued);
+    cmd.begin_reply(&queued);
+    cmd.end_reply();  // its handler sent nothing
+    EXPECT_EQ(client.receive(), 0);
+}
