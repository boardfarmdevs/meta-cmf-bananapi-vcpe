+thread_local int em_cmd_agent_t::s_queuing_fd = -1;
+
+void em_cmd_agent_t::attach(const void *queued)
+{
+    if (s_queuing_fd < 0) {
+        return;
+    }
+    std::lock_guard<std::mutex> guard(m_reply_lock);
+    m_replies[queued] = s_queuing_fd;
+    s_queuing_fd = -1;
+}
+
+void em_cmd_agent_t::begin_reply(const void *evt)
+{
+    end_reply();
+    std::lock_guard<std::mutex> guard(m_reply_lock);
+    auto client = m_replies.find(evt);
+    if (client != m_replies.end()) {
+        m_reply_fd = client->second;
+        m_replies.erase(client);
+    }
+}
+
+void em_cmd_agent_t::end_reply()
+{
+    if (m_reply_fd >= 0) {
+        close(m_reply_fd);
+        m_reply_fd = -1;
+    }
+}
