+/* em_config sends the Multi-AP Policy Config only after the channel preference
+ * exchange, which an agent may never complete (an RDK agent drops the query in
+ * this lab), and never to a known agent onboarding again (its em_agent or
+ * OneWifi restarted: its radios are configured already, so the steps are
+ * skipped). Such an agent reports no associated STA link metrics until a posted
+ * policy changes. Every onboarding reaches topology sync: its Metric Reporting
+ * Policy goes out there, alone as a posted metrics change would (the full policy
+ * this early made the gateway's agent reconfigure a radio in the middle of its
+ * WSC exchange), once per agent and onboarding (each of its radios runs
+ * em_config); nothing waits for the ACK. */
+static bool policy_resend_due(const mac_address_t al_mac)
+{
+    static std::map<std::string, time_t> last_sent;
+    const time_t now = time(NULL);
+    std::string key = util::mac_to_string(al_mac);
+    auto it = last_sent.find(key);
+    if (it != last_sent.end() && now - it->second < EM_MAX_CMD_GEN_TTL + EM_MAX_CMD_EXT_TTL) {
+        return false;
+    }
+    last_sent[key] = now;
+    return true;
+}
