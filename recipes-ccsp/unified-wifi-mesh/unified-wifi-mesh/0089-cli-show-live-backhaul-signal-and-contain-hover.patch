 type Device struct {
@@ -3254,6 +3263,40 @@ func loadLiveRadioInventory() (map[string][]Radio, error) {
     return inventory, nil
 }
 
+// collectBackhaulLinkMetrics joins the parent AP's associated-STA metrics to
+// the child device's Backhaul.STAAddress. Invalid RCPI 255 is deliberately
+// excluded; the topology must never turn absence into a made-up signal.
+func collectBackhaulLinkMetrics(inventory map[string][]Radio) map[string]BackhaulLinkMetric {
+	metrics := make(map[string]BackhaulLinkMetric)
+	for _, radios := range inventory {
+		for _, radio := range radios {
+			for _, bss := range radio.BSSList {
+				if !strings.EqualFold(bss.HaulType, "Backhaul") || bss.VapMode != 0 {
+					continue
+				}
+				for _, sta := range bss.STAList {
+					if !sta.Associated || sta.MACAddress == "" {
+						continue
+					}
+					rcpi := sta.RCPI
+					rssi := sta.SignalStrength
+					if rcpi > 0 && rcpi <= 220 {
+						rssi = rcpi/2 - 110
+					} else if rssi >= -110 && rssi < 0 {
+						rcpi = (rssi + 110) * 2
+					} else {
+						continue
+					}
+					metrics[strings.ToLower(sta.MACAddress)] = BackhaulLinkMetric{
+						RCPI: rcpi, RSSI: rssi, ObservedAt: sta.TimeStamp,
+					}
+				}
+			}
+		}
+	}
+	return metrics
+}
+
 // buildLiveInventory maps the current controller tree to the dashboard models.
 // Fields absent from EasyMesh stay empty rather than inheriting demo values.
 func buildLiveInventory() ([]Device, []Client, error) {
@@ -4781,6 +4824,7 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
         return
     }
     localRadioChannels := loadLocalRadioChannels()
+    backhaulMetrics := collectBackhaulLinkMetrics(radioInventory)
 
     // Helper to create STA list with circular layout
     createSTAList := func(deviceX, deviceY float32, radioList []Radio) []map[string]interface{} {
@@ -4898,6 +4942,10 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
                 upstreamBSSID = strings.ToLower(getTreeValue(childBackhaul, "MACAddress"))
                 mediaType = getTreeValue(childBackhaul, "MediaType")
             }
+			backhaulSTA := ""
+			if childBackhaul != nil {
+				backhaulSTA = strings.ToLower(getTreeValue(childBackhaul, "STAAddress"))
+			}
 
             // The topology hierarchy says which device is the parent.  Match
             // the child's reported upstream BSSID against that parent's BSS
@@ -4913,14 +4961,23 @@ func loadTopologyFromDeviceTree(w  http.ResponseWriter) {
             channel = resolveTopologyBackhaulChannel(deviceName == "Agent-1",
                 band, channel, localRadioChannels)
 
-           edges = append(edges, map[string]interface{}{
+			edge := map[string]interface{}{
                 "from":          deviceID,
                 "to":            childID,
                 "band":          band,
                 "channel":       channel,
                 "upstreamBSSID": upstreamBSSID,
+				"backhaulSTA":   backhaulSTA,
                 "mediaType":     mediaType,
-            })
+			}
+			if metric, found := backhaulMetrics[backhaulSTA]; found {
+				edge["rcpi"] = metric.RCPI
+				edge["rssi"] = metric.RSSI
+				if metric.ObservedAt != "" {
+					edge["signalObservedAt"] = metric.ObservedAt
+				}
+			}
+			edges = append(edges, edge)
             traverse(child, x, y, childAngle, depth+1)
         }
     }
@@ -5346,6 +5403,9 @@ func parseSTA(node *C.em_network_node_t) STA {
         ClientType: getTreeValue(node, "ClientType"),
         SSID:       getTreeValue(node, "SSID"),
         Associated: associated,
+		SignalStrength: getKeyIntValue(node, "SignalStrength"),
+		RCPI:        getKeyIntValue(node, "RCPI"),
+		TimeStamp:   getTreeValue(node, "TimeStamp"),
     }
 }
 
