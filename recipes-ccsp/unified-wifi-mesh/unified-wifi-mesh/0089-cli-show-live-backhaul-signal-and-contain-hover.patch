 src/rdkb-cli/main.go              | 59 +++++++++++++++++++++++++++++--
 src/rdkb-cli/static/index.html    |  2 +-
 src/rdkb-cli/static/script.js     | 62 +++++++++++++++++++-------------
 4 files changed, 97 insertions(+), 28 deletions(-)

