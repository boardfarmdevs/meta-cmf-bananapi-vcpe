+static bool merge_associated_client_capabilities(dm_easy_mesh_t *dm, em_sta_info_t& reported)
+{
+    if (reported.frame_body_len > sizeof(reported.frame_body)) {
+        return false;
+    }
+    mac_addr_str_t station_mac, bssid, radio_mac;
+    em_long_string_t key;
+    dm_easy_mesh_t::macbytes_to_string(reported.id, station_mac);
+    dm_easy_mesh_t::macbytes_to_string(reported.bssid, bssid);
+    dm_easy_mesh_t::macbytes_to_string(reported.radiomac, radio_mac);
+    snprintf(key, sizeof(key), "%s@%s@%s", station_mac, bssid, radio_mac);
+    auto *pending = static_cast<dm_sta_t *>(hash_map_get(dm->m_sta_assoc_map, key));
+    auto *current = pending != nullptr ? pending :
+        static_cast<dm_sta_t *>(hash_map_get(dm->m_sta_map, key));
+    if (current == nullptr || !current->m_sta_info.associated) {
+        return false;
+    }
+    em_sta_info_t updated = current->m_sta_info;
+    updated.frame_body_len = reported.frame_body_len;
+    memcpy(updated.frame_body, reported.frame_body, reported.frame_body_len);
+    if (pending == nullptr) {
+        hash_map_put(dm->m_sta_assoc_map, strdup(key), new dm_sta_t(&updated));
+    } else {
+        pending->m_sta_info = updated;
+    }
+    return true;
+}
