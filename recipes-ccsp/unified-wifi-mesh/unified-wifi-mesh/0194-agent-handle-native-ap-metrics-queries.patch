+    request.Body = http.MaxBytesReader(writer, request.Body, 8192)
+    var query struct {
+        AlMac string
+        BSSIDs []string
+    }
+    if err := json.NewDecoder(request.Body).Decode(&query); err != nil ||
+        len(query.BSSIDs) == 0 || len(query.BSSIDs) > 24 {
+        http.Error(writer, "AlMac and 1..24 BSSIDs required", http.StatusBadRequest)
+        return
+    }
+    for index, value := range append([]string{query.AlMac}, query.BSSIDs...) {
+        address, err := net.ParseMAC(value)
+        if err != nil || len(address) != 6 || address[0]&1 != 0 {
+            http.Error(writer, "Invalid unicast MAC address", http.StatusBadRequest)
+            return
+        }
+        if index == 0 {
+            query.AlMac = address.String()
+        } else {
+            query.BSSIDs[index - 1] = address.String()
+        }
+    }
+    encoded, _ := json.Marshal(query)
+    payload := C.CString(string(encoded))
+    defer C.free(unsafe.Pointer(payload))
+    node := C.get_network_tree(payload)
+    if node == nil {
+        http.Error(writer, "Cannot encode query", http.StatusInternalServerError)
+        return
+    }
+    defer C.free_network_tree(node)
+    command := C.CString("ap_metrics_query OneWifiMesh")
+    defer C.free(unsafe.Pointer(command))
+    result := execEMCommand(command, node)
+    if result == nil {
+        http.Error(writer, "Native query unavailable", http.StatusServiceUnavailable)
+        return
+    }
+    defer C.free_network_tree(result)
+    if status := getTreeValue(result, "Status"); status != "Success" {
+        http.Error(writer, "Native query rejected: " + status, http.StatusServiceUnavailable)
+        return
+    }
+    writer.Header().Set("Content-Type", "application/json")
+    writer.WriteHeader(http.StatusAccepted)
+    _ = json.NewEncoder(writer).Encode(map[string]interface{}{
+        "success": true, "state": "submitted", "message": "Collection completes asynchronously in native AP Metrics responses",
+    })
+}
