+int em_metrics_t::handle_ap_metrics_query(unsigned char *buff, unsigned int len)
+{
+    em_cmd_ap_metrics_rprt_params_t params = {};
+    if (!em_decode_ap_metrics_query(buff, len, params) ||
+        memcmp(params.query_source, get_data_model()->get_ctl_mac(), 6) != 0 ||
+        len > 2048) return -1;
+    const char digits[] = "0123456789abcdef";
+    std::vector<char> encoded(len * 2 + 1, 0);
+    for (unsigned int index = 0; index < len; ++index) {
+        encoded[index * 2] = digits[buff[index] >> 4];
+        encoded[index * 2 + 1] = digits[buff[index] & 15];
+    }
+    get_mgr()->io_process(em_bus_event_type_ap_metrics_query,
+        reinterpret_cast<unsigned char *>(encoded.data()),
+        static_cast<unsigned int>(encoded.size()));
+    return 0;
+}
