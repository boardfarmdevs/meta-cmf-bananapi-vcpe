+
+inline bool em_decode_ap_metrics_query(const unsigned char *frame, size_t length,
+    em_cmd_ap_metrics_rprt_params_t &params)
+{
+    if (length < 25 || frame[12] != 0x89 || frame[13] != 0x3a ||
+        frame[14] != 0 || frame[16] != 0x80 || frame[17] != 0x0b ||
+        frame[20] != 0 || (frame[21] & 0x80) == 0) return false;
+    params.query = true;
+    params.query_id = static_cast<unsigned short>((frame[18] << 8) | frame[19]);
+    memcpy(params.query_source, frame + 6, 6);
+    params.query_bss_count = 0;
+    params.query_radio_count = 0;
+    bool found = false;
+    size_t offset = 22;
+    while (offset + 3 <= length) {
+        const unsigned char tag = frame[offset];
+        const size_t size = (frame[offset + 1] << 8) | frame[offset + 2];
+        offset += 3;
+        if (size > length - offset) return false;
+        if (tag == 0) return size == 0 && found &&
+            (params.query_bss_count != 0 || params.query_radio_count != 0);
+        if (tag == 0x93) {
+            if (found || size < 1 || frame[offset] > EM_MAX_BSSS ||
+                size != 1U + 6U * frame[offset]) return false;
+            found = true;
+            params.query_bss_count = frame[offset];
+            memcpy(params.query_bssids, frame + offset + 1, size - 1);
+        } else if (tag == 0x82) {
+            if (size != 6 || params.query_radio_count >= EM_MAX_RADIO_PER_AGENT) return false;
+            memcpy(params.query_radios[params.query_radio_count++], frame + offset, 6);
+        }
+        offset += size;
+    }
+    return false;
+}
+
+inline bool em_decode_ap_metrics_query_hex(const char *encoded, size_t length,
+    em_cmd_ap_metrics_rprt_params_t &params)
+{
+    if (length < 50 || length > 4096 || length % 2 != 0) return false;
+    unsigned char frame[2048];
+    const char digits[] = "0123456789abcdef";
+    for (size_t index = 0; index < length; ++index) {
+        const char *digit = strchr(digits, encoded[index]);
+        if (digit == nullptr || encoded[index] == 0) return false;
+        const unsigned char value = static_cast<unsigned char>(digit - digits);
+        if (index % 2 == 0) frame[index / 2] = value << 4;
+        else frame[index / 2] |= value;
+    }
+    return em_decode_ap_metrics_query(frame, length / 2, params);
+}
+
+inline bool em_ap_metrics_query_contains(const unsigned char addresses[][6], int count,
+    const unsigned char *address)
+{
+    for (int index = 0; index < count; ++index) {
+        if (memcmp(addresses[index], address, 6) == 0) return true;
+    }
+    return false;
+}
+
+#endif
