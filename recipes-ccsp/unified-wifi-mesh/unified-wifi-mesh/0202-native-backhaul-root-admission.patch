+bool em_agent_t::read_native_root_context(em_rooted_admission::link_context &context,
+    unsigned int &radio_instance, std::array<unsigned char, 22> &state)
+{
+    if (!is_data_model_initialized() || m_data_model.get_colocated()) return false;
+    wifi_bus_desc_t *descriptor = get_bus_descriptor();
+    if (descriptor == nullptr) return false;
+    bool found = false;
+    for (unsigned int index = 0; index < m_data_model.get_num_radios(); ++index) {
+        char path[80];
+        snprintf(path, sizeof(path), "Device.WiFi.STA.%u.X_RDK_BackhaulRoot", index + 1);
+        raw_data_t value{};
+        const bool valid = descriptor->bus_data_get_fn(&m_bus_hdl, path, &value) == bus_error_success &&
+            value.data_type == bus_data_type_bytes && value.raw_data.bytes != nullptr &&
+            value.raw_data_len == state.size();
+        if (valid) {
+            if (found) {
+                free(value.raw_data.bytes);
+                return false;
+            }
+            memcpy(state.data(), value.raw_data.bytes, state.size());
+            radio_instance = index + 1;
+            found = true;
+        }
+        free(value.raw_data.bytes);
+    }
+    if (!found || state[20] > 1 || state[21] > 1) return false;
+    context = {};
+    std::copy_n(m_data_model.get_agent_al_interface_mac(), 6, context.agent.begin());
+    std::copy_n(m_data_model.get_ctrl_al_interface_mac(), 6, context.controller.begin());
+    std::copy_n(state.data() + 8, 6, context.station.begin());
+    std::copy_n(state.data() + 14, 6, context.parent.begin());
+    for (unsigned int index = 0; index < 8; ++index)
+        context.generation = (context.generation << 8) | state[index];
+    context.connected = state[20] != 0;
+    return context.generation != 0;
+}
+
+void em_agent_t::poll_native_root_admission()
+{
+    em_rooted_admission::link_context context{};
+    unsigned int radio_instance = 0;
+    std::array<unsigned char, 22> state{};
+    const auto now = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+    if (!read_native_root_context(context, radio_instance, state) || !context.connected || state[21]) {
+        m_root_admission.cancel();
+        return;
+    }
+    if (m_root_admission.observe(context, now)) return;
+    em_t *transport = get_al_node();
+    if (transport == nullptr) return;
+    em_rooted_admission::nonce_value nonce{};
+    if (getrandom(nonce.data(), nonce.size(), 0) != static_cast<ssize_t>(nonce.size())) return;
+    em_rooted_admission::wire_frame frame{};
+    if (m_root_admission.begin(context, get_next_msg_id(), nonce, now, frame) &&
+        transport->send_native_backhaul_frame(frame.data(), frame.size()) < 0) m_root_admission.cancel();
+}
+
+void em_agent_t::process_native_root_reply(const unsigned char *frame, size_t length)
+{
+    em_rooted_admission::link_context context{};
+    unsigned int radio_instance = 0;
+    std::array<unsigned char, 22> state{};
+    const auto now = static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::milliseconds>(
+        std::chrono::steady_clock::now().time_since_epoch()).count());
+    if (!read_native_root_context(context, radio_instance, state) ||
+        !m_root_admission.accept(frame, length, context, now)) return;
+    wifi_bus_desc_t *descriptor = get_bus_descriptor();
+    if (descriptor == nullptr) return;
+    char path[80];
+    snprintf(path, sizeof(path), "Device.WiFi.STA.%u.X_RDK_BackhaulRoot", radio_instance);
+    raw_data_t value{};
+    value.data_type = bus_data_type_bytes;
+    value.raw_data.bytes = state.data();
+    value.raw_data_len = state.size();
+    const bool queued = descriptor->bus_set_fn(&m_bus_hdl, path, &value) == bus_error_success;
+    em_printfout("Native rooted admission proof radio=%u parent=%s queued=%u generation=%llu",
+        radio_instance, util::mac_to_string(context.parent.data()).c_str(), queued,
+        static_cast<unsigned long long>(context.generation));
+}
