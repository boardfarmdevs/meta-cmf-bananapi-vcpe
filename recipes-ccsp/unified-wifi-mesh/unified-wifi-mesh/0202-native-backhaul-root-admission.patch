+#ifndef EM_ROOTED_ADMISSION_PROBE_H
+#define EM_ROOTED_ADMISSION_PROBE_H
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdint>
+
+namespace em_rooted_admission {
+
+using mac_address = std::array<unsigned char, 6>;
+using nonce_value = std::array<unsigned char, 16>;
+
+constexpr std::uint16_t message_type = 0x0004;
+constexpr unsigned char vendor_tlv_type = 0x0b;
+constexpr std::array<unsigned char, 3> vendor_oui{{0xd8, 0x9c, 0x8e}};
+constexpr std::uint16_t protocol_subtype = 0x5250;
+constexpr unsigned char protocol_version = 1;
+constexpr std::size_t vendor_payload_size = 43;
+constexpr std::size_t frame_size = 71;
+constexpr std::uint64_t proof_window_ms = 2000;
+
+using wire_frame = std::array<unsigned char, frame_size>;
+
+enum class operation : unsigned char {
+    request = 1,
+    reply = 2
+};
+
+struct message {
+    operation opcode = operation::request;
+    mac_address agent{};
+    mac_address controller{};
+    mac_address station{};
+    mac_address parent{};
+    nonce_value nonce{};
+    std::uint64_t generation = 0;
+    std::uint16_t mid = 0;
+};
+
+struct link_context {
+    mac_address agent{};
+    mac_address controller{};
+    mac_address station{};
+    mac_address parent{};
+    std::uint64_t generation = 0;
+    bool connected = false;
+};
+
+inline bool valid_mac(const mac_address &address)
+{
+    return (address[0] & 1) == 0 && std::any_of(address.begin(), address.end(),
+        [](unsigned char octet) { return octet != 0; });
+}
+
+inline bool valid_nonce(const nonce_value &nonce)
+{
+    return std::any_of(nonce.begin(), nonce.end(),
+        [](unsigned char octet) { return octet != 0; });
+}
+
+inline bool valid_message(const message &value)
+{
+    return (value.opcode == operation::request || value.opcode == operation::reply) &&
+        valid_mac(value.agent) && valid_mac(value.controller) &&
+        valid_mac(value.station) && valid_mac(value.parent) &&
+        value.agent != value.controller && value.station != value.parent &&
+        valid_nonce(value.nonce);
+}
+
+inline bool same_link(const message &value, const link_context &current)
+{
+    return current.connected && value.agent == current.agent &&
+        value.controller == current.controller && value.station == current.station &&
+        value.parent == current.parent && value.generation == current.generation;
+}
+
+inline std::uint16_t read_u16(const unsigned char *bytes)
+{
+    return static_cast<std::uint16_t>((static_cast<std::uint16_t>(bytes[0]) << 8) |
+        bytes[1]);
+}
+
+inline void write_u16(unsigned char *bytes, std::uint16_t value)
+{
+    bytes[0] = static_cast<unsigned char>(value >> 8);
+    bytes[1] = static_cast<unsigned char>(value);
+}
+
+inline bool encode(const message &value, wire_frame &output)
+{
+    if (!valid_message(value)) return false;
+    wire_frame frame{};
+    const auto &destination = value.opcode == operation::request ? value.controller : value.agent;
+    const auto &source = value.opcode == operation::request ? value.agent : value.controller;
+    std::copy(destination.begin(), destination.end(), frame.begin());
+    std::copy(source.begin(), source.end(), frame.begin() + 6);
+    write_u16(frame.data() + 12, 0x893a);
+    write_u16(frame.data() + 16, message_type);
+    write_u16(frame.data() + 18, value.mid);
+    frame[21] = 0x80;
+    frame[22] = vendor_tlv_type;
+    write_u16(frame.data() + 23, static_cast<std::uint16_t>(vendor_payload_size));
+    std::copy(vendor_oui.begin(), vendor_oui.end(), frame.begin() + 25);
+    write_u16(frame.data() + 28, protocol_subtype);
+    frame[30] = protocol_version;
+    frame[31] = static_cast<unsigned char>(value.opcode);
+    std::copy(value.nonce.begin(), value.nonce.end(), frame.begin() + 32);
+    std::copy(value.station.begin(), value.station.end(), frame.begin() + 48);
+    std::copy(value.parent.begin(), value.parent.end(), frame.begin() + 54);
+    for (std::size_t index = 0; index < 8; ++index) {
+        frame[60 + index] = static_cast<unsigned char>(value.generation >> (56 - 8 * index));
+    }
+    output = frame;
+    return true;
+}
+
+inline bool decode(const unsigned char *frame, std::size_t length, message &output)
+{
+    if (frame == nullptr || length != frame_size || read_u16(frame + 12) != 0x893a ||
+        frame[14] != 0 || frame[15] != 0 || read_u16(frame + 16) != message_type ||
+        frame[20] != 0 || frame[21] != 0x80 || frame[22] != vendor_tlv_type ||
+        read_u16(frame + 23) != vendor_payload_size ||
+        !std::equal(vendor_oui.begin(), vendor_oui.end(), frame + 25) ||
+        read_u16(frame + 28) != protocol_subtype || frame[30] != protocol_version ||
+        (frame[31] != static_cast<unsigned char>(operation::request) &&
+            frame[31] != static_cast<unsigned char>(operation::reply)) ||
+        frame[68] != 0 || frame[69] != 0 || frame[70] != 0) return false;
+    message parsed{};
+    parsed.opcode = static_cast<operation>(frame[31]);
+    const bool request = parsed.opcode == operation::request;
+    std::copy_n(frame + (request ? 6 : 0), 6, parsed.agent.begin());
+    std::copy_n(frame + (request ? 0 : 6), 6, parsed.controller.begin());
+    std::copy_n(frame + 32, 16, parsed.nonce.begin());
+    std::copy_n(frame + 48, 6, parsed.station.begin());
+    std::copy_n(frame + 54, 6, parsed.parent.begin());
+    for (std::size_t index = 0; index < 8; ++index) {
+        parsed.generation = (parsed.generation << 8) | frame[60 + index];
+    }
+    parsed.mid = read_u16(frame + 18);
+    if (!valid_message(parsed)) return false;
+    output = parsed;
+    return true;
+}
+
+inline bool controller_reply(const unsigned char *frame, std::size_t length,
+    const mac_address &local_controller, wire_frame &output)
+{
+    message request{};
+    if (!valid_mac(local_controller) || !decode(frame, length, request) ||
+        request.opcode != operation::request || request.controller != local_controller) return false;
+    request.opcode = operation::reply;
+    return encode(request, output);
+}
+
+class transaction_matcher {
+    message m_pending{};
+    nonce_value m_last_nonce{};
+    std::uint64_t m_sent_ms = 0;
+    bool m_active = false;
+    bool m_have_last_nonce = false;
+
+public:
+    bool pending() const { return m_active; }
+
+    const message *pending_message() const { return m_active ? &m_pending : nullptr; }
+
+    void cancel() { m_active = false; }
+
+    bool begin(const link_context &current, std::uint16_t mid, const nonce_value &nonce,
+        std::uint64_t now_ms, wire_frame &output)
+    {
+        if (m_active || !current.connected || (m_have_last_nonce && nonce == m_last_nonce)) return false;
+        message request{};
+        request.agent = current.agent;
+        request.controller = current.controller;
+        request.station = current.station;
+        request.parent = current.parent;
+        request.generation = current.generation;
+        request.mid = mid;
+        request.nonce = nonce;
+        if (!encode(request, output)) return false;
+        m_pending = request;
+        m_last_nonce = nonce;
+        m_have_last_nonce = true;
+        m_sent_ms = now_ms;
+        m_active = true;
+        return true;
+    }
+
+    bool observe(const link_context &current, std::uint64_t now_ms)
+    {
+        if (m_active && (!same_link(m_pending, current) || now_ms < m_sent_ms ||
+            now_ms - m_sent_ms > proof_window_ms)) cancel();
+        return m_active;
+    }
+
+    bool accept(const unsigned char *frame, std::size_t length,
+        const link_context &current, std::uint64_t now_ms)
+    {
+        if (!observe(current, now_ms)) return false;
+        message response{};
+        if (!decode(frame, length, response) || response.opcode != operation::reply ||
+            !same_link(response, current) || response.mid != m_pending.mid ||
+            response.nonce != m_pending.nonce) return false;
+        cancel();
+        return true;
+    }
+};
+
+}
+
+#endif
