+// "aa:bb:cc:dd:ee:ff" exactly, and not the null MAC
+static bool renew_request_mac(const cJSON *item, mac_address_t mac)
+{
+    const char *str;
+    unsigned int b[6];
+    unsigned int i;
+    mac_address_t null_mac = {0};
+
+    if (!cJSON_IsString(item) || ((str = item->valuestring) == NULL) || (strlen(str) != 17)) {
+        return false;
+    }
+    for (i = 0; i < 17; i++) {
+        if ((i % 3) == 2 ? (str[i] != ':') : (isxdigit(static_cast<unsigned char>(str[i])) == 0)) {
+            return false;
+        }
+    }
+    if (sscanf(str, "%2x:%2x:%2x:%2x:%2x:%2x", &b[0], &b[1], &b[2], &b[3], &b[4], &b[5]) != 6) {
+        return false;
+    }
+    for (i = 0; i < 6; i++) {
+        mac[i] = static_cast<unsigned char>(b[i]);
+    }
+    return memcmp(mac, null_mac, sizeof(mac_address_t)) != 0;
+}
+
+// A renew request from the CLI (em_bus_event_type_cfg_renew_subdoc): a wfa-dataelements:Renew
+// object (CfgRenew.json's form) whose DeviceList names agents by their AL MAC ("ID") and, in each
+// RadioList entry, one radio by its current operating class (CurrentOperatingClasses, one
+// Class). Each radio is renewed with its own cfg_renew command, as the controller's raw renew of
+// one radio. The whole request is checked first: one that is not such an object, an agent the
+// controller does not know, or a class that matches no current class of the agent's radios (or
+// more than one) refuses the request, logged, and renews nothing.
+int dm_easy_mesh_ctrl_t::analyze_config_renew_subdoc(em_bus_event_t *evt, em_cmd_t *pcmd[])
+{
+    cJSON *obj, *renew, *devices, *device, *radios, *radio, *classes, *cls;
+    mac_address_t al_mac, ruids[EM_MAX_CMD];
+    mac_addr_str_t al_str, radio_str;
+    unsigned int num_ruids = 0, i, j, matches;
+    em_op_class_info_t *op_class, *found;
+    dm_easy_mesh_t *agent_dm;
+    em_cmd_params_t params;
+    dm_easy_mesh_t dm;
+    bool refused = false;
+    int num = 0, class_num;
+
+    if (evt == NULL) {
+        return -1;
+    }
+    if ((evt->data_len == 0) || (evt->data_len > EM_MAX_EVENT_DATA_LEN - sizeof(em_subdoc_name_space_t))) {
+        em_printfout("Renew request refused: %u bytes", evt->data_len);
+        return -1;
+    }
+    if ((obj = cJSON_ParseWithLength(evt->u.subdoc.buff, evt->data_len)) == NULL) {
+        em_printfout("Renew request refused: not JSON");
+        return -1;
+    }
+    renew = cJSON_GetObjectItem(obj, "wfa-dataelements:Renew");
+    devices = cJSON_IsObject(renew) ? cJSON_GetObjectItem(renew, "DeviceList") : NULL;
+    if (!cJSON_IsArray(devices) || (cJSON_GetArraySize(devices) == 0)) {
+        em_printfout("Renew request refused: no wfa-dataelements:Renew with a DeviceList");
+        cJSON_Delete(obj);
+        return -1;
+    }
+
+    cJSON_ArrayForEach(device, devices) {
+        if (!renew_request_mac(cJSON_GetObjectItem(device, "ID"), al_mac)) {
+            em_printfout("Renew request refused: a DeviceList entry without an AL MAC ID");
+            refused = true;
+            break;
+        }
+        dm_easy_mesh_t::macbytes_to_string(al_mac, al_str);
+        for (agent_dm = get_first_dm(); agent_dm != NULL; agent_dm = get_next_dm(agent_dm)) {
+            if (memcmp(agent_dm->get_agent_al_interface_mac(), al_mac, sizeof(mac_address_t)) == 0) {
+                break;
+            }
+        }
+        if (agent_dm == NULL) {
+            em_printfout("Renew request refused: agent %s not known", al_str);
+            refused = true;
+            break;
+        }
+        radios = cJSON_GetObjectItem(device, "RadioList");
+        if (!cJSON_IsArray(radios) || (cJSON_GetArraySize(radios) == 0)) {
+            em_printfout("Renew request refused: agent %s without a RadioList", al_str);
+            refused = true;
+            break;
+        }
+        cJSON_ArrayForEach(radio, radios) {
+            classes = cJSON_GetObjectItem(radio, "CurrentOperatingClasses");
+            cls = (cJSON_IsArray(classes) && (cJSON_GetArraySize(classes) == 1)) ?
+                cJSON_GetObjectItem(cJSON_GetArrayItem(classes, 0), "Class") : NULL;
+            if (!cJSON_IsNumber(cls) || (cls->valuedouble != static_cast<double>(cls->valueint)) ||
+                    (cls->valueint < 1) || (cls->valueint > 255)) {
+                em_printfout("Renew request refused: agent %s, a radio without one current Class", al_str);
+                refused = true;
+                break;
+            }
+            class_num = cls->valueint;
+            // the agent's radio on that current operating class
+            found = NULL;
+            matches = 0;
+            for (i = 0; i < agent_dm->get_num_op_class(); i++) {
+                op_class = agent_dm->get_op_class_info(i);
+                if ((op_class->id.type != em_op_class_type_current) ||
+                        (op_class->op_class != static_cast<unsigned int>(class_num)) ||
+                        (agent_dm->get_radio(op_class->id.ruid) == NULL)) {
+                    continue;
+                }
+                if (found == NULL) {
+                    found = op_class;
+                    matches = 1;
+                } else if (memcmp(found->id.ruid, op_class->id.ruid, sizeof(mac_address_t)) != 0) {
+                    matches = 2;    // another radio on the same class: ambiguous
+                }
+            }
+            if (matches != 1) {
+                em_printfout("Renew request refused: agent %s has %s radio on current class %d",
+                    al_str, (matches == 0) ? "no" : "more than one", class_num);
+                refused = true;
+                break;
+            }
+            for (j = 0; j < num_ruids; j++) {
+                if (memcmp(ruids[j], found->id.ruid, sizeof(mac_address_t)) == 0) {
+                    break;
+                }
+            }
+            if (j < num_ruids) {
+                continue;
+            }
+            if (num_ruids == EM_MAX_CMD) {
+                em_printfout("Renew request refused: more than %d radios", EM_MAX_CMD);
+                refused = true;
+                break;
+            }
+            memcpy(ruids[num_ruids++], found->id.ruid, sizeof(mac_address_t));
+            dm_easy_mesh_t::macbytes_to_string(found->id.ruid, radio_str);
+            em_printfout("Renew request: agent %s radio %s (current class %d)", al_str, radio_str, class_num);
+        }
+        if (refused == true) {
+            break;
+        }
+    }
+    cJSON_Delete(obj);
+    if (refused == true) {
+        return -1;
+    }
+
+    for (i = 0; i < num_ruids; i++) {
+        memcpy(&params, &evt->params, sizeof(em_cmd_params_t));
+        params.u.args.num_args = 1;
+        dm_easy_mesh_t::macbytes_to_string(ruids[i], radio_str);
+        snprintf(params.u.args.args[0], sizeof(params.u.args.args[0]), "%s", radio_str);
+        pcmd[num++] = new em_cmd_cfg_renew_t(em_service_type_ctrl, params, dm);
+    }
+
+    return num;
+}
