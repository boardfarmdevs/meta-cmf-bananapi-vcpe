+void em_ctrl_t::handle_config_renew_subdoc(em_bus_event_t *evt)
+{
+    em_cmd_t *pcmd[EM_MAX_CMD] = {NULL};
+    int num;
+
+    // No is_cmd_type_in_progress(): for a renew it reads the event as a raw radio. The
+    // orchestrator takes each radio's renew in turn.
+    if ((num = m_data_model.analyze_config_renew_subdoc(evt, pcmd)) <= 0) {
+        m_ctrl_cmd->send_result(status_for_noncmd(num));
+    } else if (m_orch->submit_commands(pcmd, static_cast<unsigned int> (num)) > 0) {
+        m_ctrl_cmd->send_result(em_cmd_out_status_success);
+    } else {
+        m_ctrl_cmd->send_result(em_cmd_out_status_not_ready);
+    }
+}
