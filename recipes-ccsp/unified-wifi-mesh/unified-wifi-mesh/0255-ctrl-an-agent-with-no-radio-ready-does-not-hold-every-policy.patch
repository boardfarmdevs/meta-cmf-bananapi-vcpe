 		case em_cmd_type_set_policy:
             if (em->get_state() == em_state_ctrl_configured) {
-                // Commit policies from the command DM to the live data model and DB
-                dm_easy_mesh_t *cmd_dm = pcmd->get_data_model();
-                dm_easy_mesh_t *live_dm = em->get_data_model();
-                if (cmd_dm != NULL && live_dm != NULL) {
-                    for (unsigned int p = 0; p < cmd_dm->get_num_policy(); p++) {
-                        live_dm->set_policy(cmd_dm->m_policy[p]);
-                    }
-                    // Trigger DB write
-                    cmd_dm->set_db_cfg_param(db_cfg_type_policy_list_update, "");
-                    m_mgr->update_tables(cmd_dm);
-                }
+                commit_set_policy(pcmd, em);
                 return true;
             }
 			break;
@@ -344,6 +334,21 @@ bool em_orch_ctrl_t::is_em_ready_for_orch_fini(em_cmd_t *pcmd, em_t *em)
     return false;
 }
 
+void em_orch_ctrl_t::commit_set_policy(em_cmd_t *pcmd, em_t *em)
+{
+    // Commit policies from the command DM to the live data model and DB
+    dm_easy_mesh_t *cmd_dm = pcmd->get_data_model();
+    dm_easy_mesh_t *live_dm = em->get_data_model();
+    if (cmd_dm != NULL && live_dm != NULL) {
+        for (unsigned int p = 0; p < cmd_dm->get_num_policy(); p++) {
+            live_dm->set_policy(cmd_dm->m_policy[p]);
+        }
+        // Trigger DB write
+        cmd_dm->set_db_cfg_param(db_cfg_type_policy_list_update, "");
+        m_mgr->update_tables(cmd_dm);
+    }
+}
+
 bool em_orch_ctrl_t::is_em_ready_for_orch_exec(em_cmd_t *pcmd, em_t *em)
 {
     switch (pcmd->m_type) {
@@ -688,13 +693,40 @@ unsigned int em_orch_ctrl_t::build_candidates(em_cmd_t *pcmd)
         std::vector<em_t *> em_radios;
         m_mgr->get_all_em_for_al_mac(dm->get_agent_al_interface_mac(), em_radios);
         if (!em_radios.empty()) {
-            auto selected = em_radios.front();
+            // a radio ready for a policy and idle, else one ready but busy with another command
+            // (the policy waits for it)
+            em_t *selected = NULL, *busy = NULL;
             for (auto radio : em_radios) {
-                if (radio && radio->get_orch_state() != em_orch_state_progress &&
-                    is_em_ready_for_orch_exec(pcmd, radio)) {
+                if (radio == NULL || !is_em_ready_for_orch_exec(pcmd, radio)) {
+                    continue;
+                }
+                if (radio->get_orch_state() != em_orch_state_progress) {
                     selected = radio;
                     break;
                 }
+                if (busy == NULL) {
+                    busy = radio;
+                }
+            }
+            if (selected == NULL) {
+                selected = busy;
+            }
+            if (selected == NULL) {
+                // No radio of the agent is in a state for a policy (it has not onboarded again,
+                // after a controller restart): a command on one would wait out its time limit,
+                // and be pushed and cancelled again, with every other policy behind it,
+                // set_policy running one at a time. The policy goes to the live model as a
+                // completed command's does: the agent gets it in its onboarding's policy step
+                // (from the live model), its metric reporting part again at each topology sync.
+                for (auto radio : em_radios) {
+                    if (radio != NULL) {
+                        commit_set_policy(pcmd, radio);    // the agent's model: any of its radios'
+                        break;
+                    }
+                }
+                em_printfout("Set Policy: agent %s has no radio ready; its policy committed, sent when it onboards",
+                    util::mac_to_string(dm->get_agent_al_interface_mac()).c_str());
+                return count;
             }
             em_printfout("Set Policy: %s pushed to queue", util::mac_to_string(selected->get_radio_interface_mac()).c_str());
             queue_push(pcmd->m_em_candidates, selected);
