 int em_steering_t::handle_ack_msg(unsigned char *buff, unsigned int len)
 {
+    em_cmdu_t *cmdu = reinterpret_cast<em_cmdu_t *> (buff + sizeof(em_raw_hdr_t));
+    unsigned short response_msg_id = ntohs(cmdu->id);
+
+    if (get_state() == em_state_agent_steer_btm_res_pending) {
+        if (response_msg_id != m_btm_report_msg_id) {
+            printf("%s:%d: ignoring BTM report ACK MID %u; expected %u\n", __func__, __LINE__,
+                response_msg_id, m_btm_report_msg_id);
+            return -1;
+        }
+        m_btm_report_msg_id = 0;
+        set_state(em_state_agent_configured);
+        return 0;
+    }
+
     m_client_steering_req_msg_id = 0;
     set_state(em_state_ctrl_steer_btm_req_ack_rcvd);
     return 0;
@@ -647,6 +668,7 @@
 {
     m_client_steering_req_tx_cnt = 0;
     m_client_steering_req_msg_id = 0;
+    m_btm_report_msg_id = 0;
     m_client_steering_prev_state = em_state_ctrl_unconfigured;
     m_client_assoc_ctrl_req_tx_cnt = 0;
 }
