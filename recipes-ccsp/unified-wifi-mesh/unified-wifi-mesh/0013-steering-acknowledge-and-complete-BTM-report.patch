--- a/src/agent/em_agent.cpp
+++ b/src/agent/em_agent.cpp
@@ -2163,7 +2163,6 @@
         case em_msg_type_autoconf_search:
         case em_msg_type_topo_resp:
         case em_msg_type_channel_pref_rprt:
-        case em_msg_type_1905_ack:
         case em_msg_type_map_policy_config_req:
             em = static_cast<em_t *>(hash_map_get_first(m_em_map));
             while (em != NULL) {
@@ -2174,6 +2173,32 @@
             }
             break;
 
+        case em_msg_type_1905_ack:
+        {
+            std::vector<em_t *> em_radios;
+            unsigned short response_msg_id = ntohs(cmdu->id);
+
+            get_all_em_for_al_mac(hdr->dst, em_radios);
+            for (auto &radio_em : em_radios) {
+                if ((radio_em->get_state() == em_state_agent_steer_btm_res_pending) &&
+                    (radio_em->get_btm_report_msg_id() == response_msg_id)) {
+                    em = radio_em;
+                    break;
+                }
+            }
+
+            if (em == NULL) {
+                /* No radio has a BTM report outstanding for this ACK's MID, so
+                 * the ACK is not for a steering BTM report. Do NOT misroute it to
+                 * an arbitrary (first non-AL) radio -- that arbitrary fallback was
+                 * the very defect this patch fixes. Leaving em == NULL makes the
+                 * caller drop the frame; a genuine non-steering ACK has no
+                 * per-radio BTM-report state to advance here, so dropping is the
+                 * correct behaviour. */
+            }
+            break;
+        }
+
 		case em_msg_type_channel_scan_rprt:
         case em_msg_type_beacon_metrics_rsp:
         case em_msg_type_ap_mld_config_resp:
