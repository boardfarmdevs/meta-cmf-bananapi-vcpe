From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <revogelaar@gmail.com>
Date: Tue, 18 Aug 2026 13:50:00 -0700
Subject: [PATCH] metrics: complete policy activation and report persistence

Metrics policy was exposed by the WebUI but could not become active. Route
policy ACKs by their outstanding MID, retain and persist the peer profile,
persist the BSS and radio values decoded from AP Metrics Responses, and give
automatically created per-radio policies the owning device identity.

The current upstream source already contains the bounded AP, AP Extended and
Radio Metrics TLV decoders from the original local patch. Keep only the
remaining policy, profile, identity and persistence fixes.

Upstream-Status: Pending
Signed-off-by: Rob Vogelaar <revogelaar@gmail.com>
---
 src/ctrl/em_ctrl.cpp          | 22 +++++++++++++++++-----
 src/dm/dm_easy_mesh_list.cpp  |  7 +++++--
 src/em/metrics/em_metrics.cpp |  2 ++
 3 files changed, 24 insertions(+), 7 deletions(-)

diff --git a/src/ctrl/em_ctrl.cpp b/src/ctrl/em_ctrl.cpp
index d6680c3..bb164f1 100644
--- a/src/ctrl/em_ctrl.cpp
+++ b/src/ctrl/em_ctrl.cpp
@@ -1033,15 +1033,18 @@ em_t *em_ctrl_t::find_em_for_msg_type(unsigned char *data, unsigned int len, em_
                 }
             }
 
+            if (em_msg_t(data + (sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t)),
+                    len - static_cast<unsigned int> (sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t))).get_profile(&profile) == false) {
+                profile = em_profile_type_1;
+            }
+
             if ((dm = get_data_model(GLOBAL_NET_ID, const_cast<const unsigned char *> (intf.mac))) == NULL) {
-                if (em_msg_t(data + (sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t)), len - static_cast<unsigned int> (sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t))).get_profile(&profile) == false) {
-                    profile = em_profile_type_1;
-                }
                 //dm = create_data_model(GLOBAL_NET_ID, const_cast<const em_interface_t *> (&intf), profile);
                 memcpy(dm_commit.mac, intf.mac, sizeof(mac_addr_t));
                 strncpy(dm_commit.net_id, GLOBAL_NET_ID, sizeof(dm_commit.net_id));
                 dm_commit.is_emplus_agent = is_emplus;
                 io_process(em_bus_event_type_dm_commit, reinterpret_cast<unsigned char *> (&dm_commit), sizeof(em_commit_info_t));
+                dm = get_data_model(GLOBAL_NET_ID, const_cast<const unsigned char *> (intf.mac));
                 em_printfout("[%s] Creating data model for mac: %s net: %s emplus: %d\n", __func__, mac_str1, GLOBAL_NET_ID, is_emplus);
             } else {
                 dm->get_device_info()->is_emplus_agent = is_emplus;
@@ -1049,6 +1052,10 @@ em_t *em_ctrl_t::find_em_for_msg_type(unsigned char *data, unsigned int len, em_
                 dm_easy_mesh_t::macbytes_to_string(dm->get_agent_al_interface_mac(), mac_str1);
                 em_printfout("[%s] Found existing data model for mac: %s net: %s emplus: %d\n", __func__, mac_str1, GLOBAL_NET_ID, is_emplus);
             }
+            if (dm != NULL && dm->get_device()->m_device_info.profile != profile) {
+                dm->get_device()->m_device_info.profile = profile;
+                dm->set_db_cfg_param(db_cfg_type_device_list_update, "");
+            }
             em = al_em;
             break;
 
@@ -1255,11 +1262,16 @@ em_t *em_ctrl_t::find_em_for_msg_type(unsigned char *data, unsigned int len, em_
                     em = radio_em;
                     break;
                 }
+                if ((radio_em->get_state() == em_state_ctrl_set_policy_pending) &&
+                    (radio_em->m_policy_req_msg_id == response_msg_id)) {
+                    em = radio_em;
+                    break;
+                }
             }
 
             if (em == NULL) {
-                /* No radio has a steering op outstanding for this ACK's MID, so
-                 * the ACK is not for steering. Do NOT misroute it to an arbitrary
+                /* No radio has a steering or policy op outstanding for this ACK's
+                 * MID. Do NOT misroute it to an arbitrary
                  * (first non-AL) radio -- that arbitrary fallback was the very
                  * defect this patch fixes. Leaving em == NULL makes the caller
                  * drop the frame; a genuine non-steering ACK has no per-radio
diff --git a/src/dm/dm_easy_mesh_list.cpp b/src/dm/dm_easy_mesh_list.cpp
index 4b4d4e0..00755bd 100644
--- a/src/dm/dm_easy_mesh_list.cpp
+++ b/src/dm/dm_easy_mesh_list.cpp
@@ -383,7 +383,8 @@ void dm_easy_mesh_list_t::put_radio(const char *key, const dm_radio_t *radio)
         }
         if (!has_radio_metrics) {
             em_policy_t rm_default = {};
-            strncpy(rm_default.id.net_id, "OneWifiMesh", sizeof(rm_default.id.net_id) - 1);
+            strncpy(rm_default.id.net_id, pradio->m_radio_info.id.net_id, sizeof(rm_default.id.net_id) - 1);
+            memcpy(rm_default.id.dev_mac, pradio->m_radio_info.id.dev_mac, sizeof(mac_address_t));
             rm_default.id.type = em_policy_id_type_radio_metrics_rep;
             rm_default.policy = em_steering_policy_type_disallowed;
             rm_default.util_threshold = 60;
@@ -397,7 +398,8 @@ void dm_easy_mesh_list_t::put_radio(const char *key, const dm_radio_t *radio)
         }
         if (!has_steering_param) {
             em_policy_t sp_default = {};
-            strncpy(sp_default.id.net_id, "OneWifiMesh", sizeof(sp_default.id.net_id) - 1);
+            strncpy(sp_default.id.net_id, pradio->m_radio_info.id.net_id, sizeof(sp_default.id.net_id) - 1);
+            memcpy(sp_default.id.dev_mac, pradio->m_radio_info.id.dev_mac, sizeof(mac_address_t));
             sp_default.id.type = em_policy_id_type_steering_param;
             sp_default.policy = em_steering_policy_type_rcpi_allowed;
             sp_default.util_threshold = 60;
@@ -406,6 +408,7 @@ void dm_easy_mesh_list_t::put_radio(const char *key, const dm_radio_t *radio)
             memcpy(sp.m_policy.id.radio_mac, pradio->m_radio_info.intf.mac, sizeof(mac_address_t));
             dm->set_policy(sp);
         }
+        dm->set_db_cfg_param(db_cfg_type_policy_list_update, "");
     }
 
     em_printfout("Radio dev_id is:%s", util::mac_to_string(pradio->m_radio_info.id.dev_mac).c_str());
diff --git a/src/em/metrics/em_metrics.cpp b/src/em/metrics/em_metrics.cpp
index 606c617..91460c3 100644
--- a/src/em/metrics/em_metrics.cpp
+++ b/src/em/metrics/em_metrics.cpp
@@ -764,6 +764,8 @@ int em_metrics_t::handle_ap_metrics_response(unsigned char *buff, unsigned int l
     }
 
     dm->set_db_cfg_param(db_cfg_type_sta_metrics_update, "");
+    dm->set_db_cfg_param(db_cfg_type_radio_list_update, "");
+    dm->set_db_cfg_param(db_cfg_type_bss_list_update, "");
 
     return 0;
 }
