+int em_metrics_t::handle_ap_ext_metrics_tlv(unsigned char *buff, unsigned int tlv_len)
+{
+    em_ap_ext_metric_t *metrics;
+    em_bss_info_t *bss;
+    uint32_t bytes;
+
+    if (buff == NULL || tlv_len < sizeof(em_ap_ext_metric_t)) {
+        return -1;
+    }
+
+    metrics = reinterpret_cast<em_ap_ext_metric_t *> (buff);
+    bss = get_data_model()->get_bss_info_with_mac(metrics->bssid);
+    if (bss == NULL) {
+        em_printfout("AP Extended Metrics BSS not found: %s",
+            util::mac_to_string(metrics->bssid).c_str());
+        return -1;
+    }
+
+    memcpy(&bytes, metrics->uni_bytes_sent, sizeof(bytes));
+    bss->unicast_bytes_sent = ntohl(bytes);
+    memcpy(&bytes, metrics->uni_bytes_recv, sizeof(bytes));
+    bss->unicast_bytes_rcvd = ntohl(bytes);
+    memcpy(&bytes, metrics->multi_bytes_sent, sizeof(bytes));
+    bss->multicast_bytes_sent = ntohl(bytes);
+    memcpy(&bytes, metrics->multi_bytes_recv, sizeof(bytes));
+    bss->multicast_bytes_rcvd = ntohl(bytes);
+    memcpy(&bytes, metrics->bcast_bytes_sent, sizeof(bytes));
+    bss->broadcast_bytes_sent = ntohl(bytes);
+    memcpy(&bytes, metrics->bcast_bytes_recv, sizeof(bytes));
+    bss->broadcast_bytes_rcvd = ntohl(bytes);
+    return 0;
+}
+
+int em_metrics_t::handle_radio_metrics_tlv(unsigned char *buff, unsigned int tlv_len)
+{
+    em_radio_metric_t *metrics;
+    dm_radio_t *radio;
+
+    if (buff == NULL || tlv_len < sizeof(em_radio_metric_t)) {
+        return -1;
+    }
+
+    metrics = reinterpret_cast<em_radio_metric_t *> (buff);
+    radio = get_data_model()->get_radio(metrics->ruid);
+    if (radio == NULL) {
+        em_printfout("Radio Metrics RUID not found: %s",
+            util::mac_to_string(metrics->ruid).c_str());
+        return -1;
+    }
+
+    radio->m_radio_info.noise = metrics->noise;
+    radio->m_radio_info.transmit = metrics->transmit;
+    radio->m_radio_info.receive_self = metrics->rece_self;
+    radio->m_radio_info.receive_other = metrics->rece_other;
+    return 0;
+}
