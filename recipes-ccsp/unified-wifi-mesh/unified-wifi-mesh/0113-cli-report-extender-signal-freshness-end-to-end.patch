+*/
+
+package main
+
+import (
+	"testing"
+	"time"
+)
+
+func TestBackhaulSignalFreshStaleAndUnknown(t *testing.T) {
+	now := time.Date(2026, 8, 23, 12, 0, 20, 0, time.UTC)
+
+	freshMetric, ok := parseBackhaulLinkMetric(138, "2026-08-23T12:00:15Z")
+	if !ok {
+		t.Fatal("valid fresh RCPI was rejected")
+	}
+	fresh := classifyBackhaulSignal(&freshMetric, now)
+	if fresh.Status != backhaulSignalFresh || fresh.RCPI == nil || *fresh.RCPI != 138 ||
+		fresh.RSSI == nil || *fresh.RSSI != -41 || fresh.AgeSeconds == nil || *fresh.AgeSeconds != 5 {
+		t.Fatalf("unexpected fresh signal: %+v", fresh)
+	}
+
+	weakestMetric, ok := parseBackhaulLinkMetric(0, "2026-08-23T12:00:15Z")
+	if !ok {
+		t.Fatal("timestamped RCPI 0 must remain a real observation")
+	}
+	weakest := classifyBackhaulSignal(&weakestMetric, now)
+	if weakest.Status != backhaulSignalFresh || weakest.RSSI == nil || *weakest.RSSI != -110 {
+		t.Fatalf("unexpected RCPI-0 signal: %+v", weakest)
+	}
+
+	staleMetric, ok := parseBackhaulLinkMetric(100, "2026-08-23T11:59:50Z")
+	if !ok {
+		t.Fatal("valid stale measurement was rejected")
+	}
+	stale := classifyBackhaulSignal(&staleMetric, now)
+	if stale.Status != backhaulSignalStale || stale.RSSI == nil || *stale.RSSI != -60 ||
+		stale.AgeSeconds == nil || *stale.AgeSeconds != 30 {
+		t.Fatalf("unexpected stale signal: %+v", stale)
+	}
+
+	for _, invalid := range []struct {
+		rcpi      int
+		timestamp string
+	}{{221, "2026-08-23T12:00:15Z"}, {255, "2026-08-23T12:00:15Z"},
+		{138, ""}, {138, "not-a-time"}} {
+		if _, ok := parseBackhaulLinkMetric(invalid.rcpi, invalid.timestamp); ok {
+			t.Fatalf("accepted invalid metric: %+v", invalid)
+		}
+	}
+	unknown := classifyBackhaulSignal(nil, now)
+	if unknown.Status != backhaulSignalUnknown || unknown.RCPI != nil || unknown.RSSI != nil {
+		t.Fatalf("absence became a numeric signal: %+v", unknown)
+	}
+
+	future := BackhaulLinkMetric{RCPI: 138, ObservedAt: now.Add(6 * time.Second)}
+	if signal := classifyBackhaulSignal(&future, now); signal.Status != backhaulSignalUnknown {
+		t.Fatalf("future timestamp was treated as current: %+v", signal)
+	}
+
+	selected := make(map[string]BackhaulLinkMetric)
+	retainNewerBackhaulLinkMetric(selected, "sta@bssid", staleMetric)
+	retainNewerBackhaulLinkMetric(selected, "sta@bssid", freshMetric)
+	retainNewerBackhaulLinkMetric(selected, "sta@bssid", staleMetric)
+	if selected["sta@bssid"].ObservedAt != freshMetric.ObservedAt {
+		t.Fatalf("duplicate link rows did not select the newest observation: %+v", selected)
+	}
+	equalTimeWeak := BackhaulLinkMetric{RCPI: 120, ObservedAt: freshMetric.ObservedAt}
+	equalTimeStrong := BackhaulLinkMetric{RCPI: 140, ObservedAt: freshMetric.ObservedAt}
+	retainNewerBackhaulLinkMetric(selected, "sta@bssid", equalTimeWeak)
+	retainNewerBackhaulLinkMetric(selected, "sta@bssid", equalTimeStrong)
+	retainNewerBackhaulLinkMetric(selected, "sta@bssid", equalTimeWeak)
+	if selected["sta@bssid"].RCPI != 140 {
+		t.Fatalf("equal-time duplicate selection depended on traversal order: %+v", selected)
+	}
+}
