+
+TEST_F(EmMetricsTest, AssociatedLinkMetricObservedAtHonorsWireDelta) {
+    char observed_at[64] = {0};
+    const time_t received_at = static_cast<time_t>(1700000000);
+
+    ASSERT_TRUE(em_format_link_metric_observed_at(
+        observed_at, sizeof(observed_at), received_at, 0));
+    EXPECT_STREQ(observed_at, "2023-11-14T22:13:20Z");
+
+    /* A 5.5-second delta rounds upward: never make a sample look younger. */
+    ASSERT_TRUE(em_format_link_metric_observed_at(
+        observed_at, sizeof(observed_at), received_at, 5500));
+    EXPECT_STREQ(observed_at, "2023-11-14T22:13:14Z");
+
+    EXPECT_FALSE(em_format_link_metric_observed_at(
+        nullptr, sizeof(observed_at), received_at, 1000));
+    EXPECT_FALSE(em_format_link_metric_observed_at(
+        observed_at, 0, received_at, 1000));
+}
