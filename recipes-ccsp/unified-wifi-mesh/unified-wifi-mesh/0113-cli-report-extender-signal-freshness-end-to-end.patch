+  Unless required by applicable law or agreed to in writing, software
+  distributed under the License is distributed on an "AS IS" BASIS,
+  WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+  See the License for the specific language governing permissions and
+  limitations under the License.
+*/
+
+package main
+
+import "time"
+
+const (
+	backhaulSignalFresh           = "fresh"
+	backhaulSignalStale           = "stale"
+	backhaulSignalUnknown         = "unknown"
+	backhaulSignalMaxAge          = 20 * time.Second
+	backhaulSignalFutureTolerance = 5 * time.Second
+	backhaulSignalSource          = "ieee1905-associated-sta-link-metrics"
+)
+
+// BackhaulLinkMetric is a validated Associated STA Link Metrics observation.
+// ObservedAt is the measurement time reconstructed by the Controller from the
+// report receipt time and the standard time-delta field.
+type BackhaulLinkMetric struct {
+	RCPI       int
+	ObservedAt time.Time
+}
+
+// BackhaulSignal is emitted for every wireless extender edge. Unknown has no
+// numeric fields; stale retains the last measurement while clearly marking it
+// as unsuitable for a current-link decision.
+type BackhaulSignal struct {
+	Status     string `json:"status"`
+	Source     string `json:"source,omitempty"`
+	RCPI       *int   `json:"rcpi,omitempty"`
+	RSSI       *int   `json:"rssi_dbm,omitempty"`
+	ObservedAt string `json:"observed_at,omitempty"`
+	AgeSeconds *int64 `json:"age_seconds,omitempty"`
+}
+
+func parseBackhaulLinkMetric(rcpi int, timestamp string) (BackhaulLinkMetric, bool) {
+	// RCPI 0 is a real standards value (at or below -110 dBm). It is only
+	// distinguishable from an uninitialized model row when a metric timestamp
+	// was recorded, so both fields are required.
+	if rcpi < 0 || rcpi > 220 || timestamp == "" {
+		return BackhaulLinkMetric{}, false
+	}
+	observedAt, err := time.Parse(time.RFC3339Nano, timestamp)
+	if err != nil || observedAt.IsZero() {
+		return BackhaulLinkMetric{}, false
+	}
+	return BackhaulLinkMetric{RCPI: rcpi, ObservedAt: observedAt.UTC()}, true
+}
+
+func retainNewerBackhaulLinkMetric(metrics map[string]BackhaulLinkMetric,
+	key string, candidate BackhaulLinkMetric) {
+	previous, found := metrics[key]
+	if !found || candidate.ObservedAt.After(previous.ObservedAt) ||
+		(candidate.ObservedAt.Equal(previous.ObservedAt) && candidate.RCPI > previous.RCPI) {
+		metrics[key] = candidate
+	}
+}
+
+func classifyBackhaulSignal(metric *BackhaulLinkMetric, now time.Time) BackhaulSignal {
+	if metric == nil || metric.ObservedAt.IsZero() ||
+		metric.ObservedAt.After(now.Add(backhaulSignalFutureTolerance)) {
+		return BackhaulSignal{Status: backhaulSignalUnknown}
+	}
+
+	age := now.Sub(metric.ObservedAt)
+	if age < 0 {
+		age = 0
+	}
+	ageSeconds := int64(age / time.Second)
+	rcpi := metric.RCPI
+	rssi := rcpi/2 - 110
+	status := backhaulSignalFresh
+	if age > backhaulSignalMaxAge {
+		status = backhaulSignalStale
+	}
+	return BackhaulSignal{
+		Status: status, Source: backhaulSignalSource,
+		RCPI: &rcpi, RSSI: &rssi,
+		ObservedAt: metric.ObservedAt.Format(time.RFC3339Nano),
+		AgeSeconds: &ageSeconds,
+	}
+}
