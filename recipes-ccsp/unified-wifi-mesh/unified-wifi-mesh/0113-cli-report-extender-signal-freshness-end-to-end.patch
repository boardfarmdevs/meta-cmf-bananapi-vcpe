+#ifndef EM_METRICS_TIME_H
+#define EM_METRICS_TIME_H
+
+#include <stddef.h>
+#include <time.h>
+
+/** Format an Associated STA Link Metrics measurement time as RFC3339 UTC. */
+static inline bool em_format_link_metric_observed_at(char *out, size_t out_len,
+                                                      time_t received_at,
+                                                      unsigned int delta_ms)
+{
+    if (out == NULL || out_len == 0 || received_at == (time_t)-1) {
+        return false;
+    }
+    out[0] = '\0';
+
+    /* The model stores second-resolution RFC3339. Round the wire age upward,
+     * never downward, so freshness consumers cannot see a younger sample. */
+    time_t delta_seconds = static_cast<time_t>(
+        (static_cast<unsigned long long>(delta_ms) + 999ULL) / 1000ULL);
+    if (received_at < 0 || delta_seconds > received_at) {
+        return false;
+    }
+    time_t observed_at = received_at - delta_seconds;
+    struct tm utc;
+    if (gmtime_r(&observed_at, &utc) == NULL) {
+        return false;
+    }
+    return strftime(out, out_len, "%Y-%m-%dT%H:%M:%SZ", &utc) != 0;
+}
+
+#endif
