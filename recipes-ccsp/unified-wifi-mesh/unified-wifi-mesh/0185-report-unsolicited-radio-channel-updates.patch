Subject: [PATCH] agent: publish operating channels after local radio updates

OneWifi radio callbacks also occur outside a controller channel-selection
transaction. Admit configured radio nodes for these unsolicited reports,
match every radio present in the decoded subdoc, and commit each radio
before reporting it. Reject failed or empty decodes instead of producing a
command for an uninitialized radio. Onboarding state gates remain intact.

Upstream-Status: Pending

--- a/src/agent/dm_easy_mesh_agent.cpp
+++ b/src/agent/dm_easy_mesh_agent.cpp
@@ -495,7 +495,6 @@
     webconfig_subdoc_type_t type;
     int num = 0;
     mac_addr_str_t  mac_str;
-    unsigned int index = 0;
     dm_easy_mesh_agent_t  dm;
     em_cmd_t *tmp;
     em_commit_target_t cm_config;
@@ -518,12 +517,18 @@
         em_printfout("Radio subdoc decode success");
     } else {
         em_printfout("Radio subdoc decode fail");
+        return 0;
     }
 
-	dm_easy_mesh_t::macbytes_to_string(dm.get_radio(index)->get_radio_info()->intf.mac, mac_str);
-	cm_config.type = em_commit_target_radio;
-	snprintf(reinterpret_cast<char *> (cm_config.params), sizeof(cm_config.params), "%s", mac_str);
-	commit_config(dm, cm_config);
+    if (dm.get_num_radios() == 0) {
+        return 0;
+    }
+    for (unsigned int radio_index = 0; radio_index < dm.get_num_radios(); radio_index++) {
+        dm_easy_mesh_t::macbytes_to_string(dm.get_radio(radio_index)->get_radio_info()->intf.mac, mac_str);
+        cm_config.type = em_commit_target_radio;
+        snprintf(reinterpret_cast<char *> (cm_config.params), sizeof(cm_config.params), "%s", mac_str);
+        commit_config(dm, cm_config);
+    }
 	pcmd[num] = new em_cmd_op_channel_report_t(evt->params, dm);
 	tmp = pcmd[num];
 	num++;
