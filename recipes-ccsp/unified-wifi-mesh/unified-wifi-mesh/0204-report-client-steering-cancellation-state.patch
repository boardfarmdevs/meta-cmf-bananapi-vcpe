+                em_t::state_2_str(em->get_state()), em_t::state_2_str(previous),
+                static_cast<unsigned int>(em->get_orch_state()),
+                em->get_client_steering_req_tx_count(), em->get_client_steering_req_msg_id(),
+                em->get_current_cmd() == nullptr ? "none" : em->get_current_cmd()->get_cmd_name());
             em->set_client_steering_req_tx_count(0);
             em->set_client_steering_req_msg_id(0);
             if ((previous == em_state_ctrl_configured) ||
