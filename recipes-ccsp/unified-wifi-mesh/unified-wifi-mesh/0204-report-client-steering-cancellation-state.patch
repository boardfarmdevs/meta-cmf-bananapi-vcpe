Subject: [PATCH] Report native client steering cancellation state and command owner

--- a/src/orch/em_orch_ctrl.cpp
+++ b/src/orch/em_orch_ctrl.cpp
@@ -451,6 +451,14 @@
         case em_cmd_type_sta_steer:
         {
             em_state_t previous = em->get_client_steering_prev_state();
+            mac_addr_str_t radio;
+            dm_easy_mesh_t::macbytes_to_string(em->get_radio_interface_mac(), radio);
+            em_printfout("Client steering cancelled radio=%s state=%s previous=%s orch=%u tx=%u mid=%u owner=%s",
