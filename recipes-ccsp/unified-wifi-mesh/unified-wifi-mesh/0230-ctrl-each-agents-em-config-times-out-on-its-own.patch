Subject: [PATCH] ctrl: each agent's em_config times out on its own

Every agent runs its own em_config, several at once, and since the channel
preference exchange completes (0223) each runs all its steps. The timeout
read the type's time, the longest any em_config took since the type was
last idle: after a controller restart it passed 40 s while agents were
still onboarding, and every agent then reaching topology sync was cancelled
and renewed at once (four nodes with no BSS; the lab needed an extra round
of agent restarts). The other steps' timeout cancelled every agent's
em_config the same way.

Time each agent's command from its own start, and cancel only it.

Upstream-Status: Pending

--- a/src/orch/em_orch_ctrl.cpp
+++ b/src/orch/em_orch_ctrl.cpp
@@ -63,6 +63,16 @@
             dm_easy_mesh_t *dm = em->get_data_model();
             std::vector<em_t *> all_em_radios;
             em->get_mgr()->get_all_em_for_al_mac(dm->get_agent_al_interface_mac(), all_em_radios);
+            /* Each agent runs its own em_config, several at once (and since the
+             * channel preference exchange completes, 0223, each runs all its
+             * steps). The type's time is the longest any of them took since the
+             * type was last idle: after a controller restart it passed 40 s
+             * while agents were still onboarding, and every agent then reaching
+             * topology sync was cancelled and renewed at once. Time each agent's
+             * command from its own start. */
+            struct timeval now;
+            gettimeofday(&now, NULL);
+            const unsigned int elapsed = static_cast<unsigned int>(now.tv_sec - pcmd->m_start_time.tv_sec);
             // Special handling for Topology Sync command.
             if (pcmd->get_orch_op() == dm_orch_type_topo_sync && em->get_state() == em_state_ctrl_topo_sync_pending) {
                 if (all_em_radios.empty()) return;
@@ -74,7 +84,7 @@
                 });
 
                 // Cancel command if time exceeded and no ssid mismatch
-                if (stats->time > base_time && !ssid_mismatch_present) {
+                if (elapsed > base_time && !ssid_mismatch_present) {
                     em_printfout("Canceling cmd: %s because time limit exceeded.",pcmd->get_cmd_name());
                     // Reset the mismatch and topo_query_last sent values before sending topo query
                     dm->set_ssid_mismatch_check_time(0);
@@ -144,12 +154,12 @@
                         dm->set_last_topo_query_sent_time(stats->time);
                     }
                 }
-            } else if (stats->time > (EM_MAX_CMD_GEN_TTL + EM_MAX_CMD_EXT_TTL)) {
+            } else if (elapsed > (EM_MAX_CMD_GEN_TTL + EM_MAX_CMD_EXT_TTL)) {
                 em_printfout("Canceling cmd: %s because time limit exceeded",pcmd->get_cmd_name());
                 // Reset the mismatch and topo_query_last sent values before canceling
                 dm->set_ssid_mismatch_check_time(0);
                 dm->set_last_topo_query_sent_time(0);
-                cancel_command(pcmd->get_type());
+                cancel_command(pcmd);
             }
             break;
         }
