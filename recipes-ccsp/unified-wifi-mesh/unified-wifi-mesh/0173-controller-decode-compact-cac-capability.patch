Subject: [PATCH] capability: decode compact CAC reports with bounds checks

A fresh appliance reboot faulted in handle_ap_cap_report while copying a
fixed-size em_cac_cap_radio_t from the compact CAC wire payload. Decode the
variable radio/method/op-class/channel lists and network-order duration
before publishing the model. Reject truncated counts and payloads, and
bound the enclosing TLV walk before accessing its value.

Upstream-Status: Pending

--- a/src/em/capability/em_capability.cpp
+++ b/src/em/capability/em_capability.cpp
@@ -1361,8 +1361,64 @@
     return variant;
 }
 
+static bool decode_cac_capability(const unsigned char *value, size_t length, em_cac_cap_t &decoded)
+{
+    if (length < 3) {
+        return false;
+    }
+    memcpy(&decoded.country_code, value, 2);
+    decoded.radios_num = value[2];
+    if (decoded.radios_num > EM_MAX_RADIO_PER_AGENT) {
+        return false;
+    }
+    size_t offset = 3;
+    for (unsigned int radio_index = 0; radio_index < decoded.radios_num; radio_index++) {
+        em_cac_cap_radio_t &radio = decoded.radios[radio_index];
+        if (length - offset < sizeof(mac_address_t) + 1) {
+            return false;
+        }
+        memcpy(radio.ruid, value + offset, sizeof(mac_address_t));
+        offset += sizeof(mac_address_t);
+        radio.cac_methods_num = value[offset++];
+        if (radio.cac_methods_num > EM_MAX_CAC_METHODS) {
+            return false;
+        }
+        for (unsigned int method_index = 0; method_index < radio.cac_methods_num; method_index++) {
+            if (length - offset < 5) {
+                return false;
+            }
+            em_cac_cap_method_t &method = radio.cac_methods[method_index];
+            method.cac_method = value[offset++];
+            method.cac_duration = (static_cast<unsigned int>(value[offset]) << 16)
+                | (static_cast<unsigned int>(value[offset + 1]) << 8) | value[offset + 2];
+            offset += 3;
+            method.op_classes_num = value[offset++];
+            if (method.op_classes_num > sizeof(method.op_classes) / sizeof(method.op_classes[0])) {
+                return false;
+            }
+            for (unsigned int class_index = 0; class_index < method.op_classes_num; class_index++) {
+                if (length - offset < 2) {
+                    return false;
+                }
+                em_cac_op_class_t &op_class = method.op_classes[class_index];
+                op_class.op_class = value[offset++];
+                op_class.num = value[offset++];
+                if (op_class.num > sizeof(op_class.channels) || length - offset < op_class.num) {
+                    return false;
+                }
+                memcpy(op_class.channels, value + offset, op_class.num);
+                offset += op_class.num;
+            }
+        }
+    }
+    return offset == length;
+}
