Subject: [PATCH] ctrl: bound the AP Radio Basic Capabilities TLV's walk

handle_ap_radio_basic_cap() walked the TLV's op class entries by their own channel counts
without checking them against the TLV's length or the 64-channel list it copies them into: a
malformed entry (an agent's op class 1 with 129 channels, from the hole 0260 removes) overran
op_class_info on the stack ("stack smashing detected"; the controller aborted on the agent's WSC
M1), and any device sending a WSC M1 could do it. An entry must now lie within the TLV with at
most EM_MAX_CHANNELS_IN_LIST channels, the TLV must hold its fixed part, and a new op class must
fit the data model's list (EM_MAX_OPCLASS); the rest of a malformed TLV is ignored, logged.

Platform-independent.

Upstream-Status: Pending

diff --git a/src/em/config/em_configuration.cpp b/src/em/config/em_configuration.cpp
index e109fa1..10d1718 100644
--- a/src/em/config/em_configuration.cpp
+++ b/src/em/config/em_configuration.cpp
@@ -6662,6 +6662,10 @@ int em_configuration_t::handle_ap_radio_basic_cap(unsigned char *buff, unsigned
 
 	dm_easy_mesh_t *dm = get_data_model();
 
+	if (len < sizeof(em_ap_radio_basic_cap_t)) {
+		em_printfout("AP Radio Basic Capabilities TLV too short: %u bytes", len);
+		return -1;
+	}
 	memcpy(ruid, radio_basic_cap->ruid, sizeof(mac_address_t));
 	dm_easy_mesh_t::macbytes_to_string(ruid, mac_str);
 	for (i = 0; i < dm->get_num_radios(); i++) {
@@ -6691,6 +6695,16 @@ int em_configuration_t::handle_ap_radio_basic_cap(unsigned char *buff, unsigned
 	basic_cap_op_class = radio_basic_cap->op_classes;
 	if (basic_cap_op_class != NULL) {
 		for (i = 0; i < radio_basic_cap->op_class_num; i++) {
+			// an entry and its channels lie within the TLV, and the channels fit the list: a malformed TLV (an agent's
+			// op class entry with 129 channels and none after it) overran op_class_info on the stack
+			unsigned char *entry = reinterpret_cast<unsigned char *> (basic_cap_op_class);
+			if ((entry + sizeof(em_op_class_t) > buff + len) ||
+			    (entry + sizeof(em_op_class_t) + basic_cap_op_class->num > buff + len) ||
+			    (basic_cap_op_class->num > EM_MAX_CHANNELS_IN_LIST)) {
+				em_printfout("Radio %s: op class entry %u of %u malformed (TLV %u bytes): ignoring the rest",
+					mac_str, i, radio_basic_cap->op_class_num, len);
+				break;
+			}
 			memset(&op_class_info, 0, sizeof(em_op_class_info_t));
 			memcpy(op_class_info.id.ruid, ruid, sizeof(mac_address_t));
 			op_class_info.id.type = em_op_class_type_capability;
@@ -6716,6 +6730,10 @@ int em_configuration_t::handle_ap_radio_basic_cap(unsigned char *buff, unsigned
 			if (op_class_exists == true) {
 				op_class_exists = false;
 			} else {
+				if (dm->get_num_op_class() >= EM_MAX_OPCLASS) {
+					em_printfout("Radio %s: op class list full (%u): ignoring the rest", mac_str, dm->get_num_op_class());
+					break;
+				}
 				op_class_obj = &dm->m_op_class[dm->get_num_op_class()];
 				dm->set_num_op_class(dm->get_num_op_class() + 1);
 			}
