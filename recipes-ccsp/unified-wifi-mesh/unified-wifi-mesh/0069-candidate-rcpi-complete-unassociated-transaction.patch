 	router.Use(corsMiddleware)
@@ -4173,6 +4186,82 @@ func WifiResetHandler(w http.ResponseWriter, r *http.Request) {
  * Handles POST /unassoc_sta_query requests.
  * Parses payload and triggers Unassociated STA Link Metrics Query.
  */
+func candidateMetricKey(sta string, opclass, channel int) string {
+    return fmt.Sprintf("%s/%d/%d", strings.ToLower(sta), opclass, channel)
+}
+
+func loadCandidateLinkMetrics() ([]candidateLinkMetric, error) {
+    cmd := C.CString("get_sta OneWifiMesh")
+    defer C.free(unsafe.Pointer(cmd))
+    tree := execEMCommand(cmd, nil)
+    if tree == nil {
+        return nil, fmt.Errorf("controller returned no candidate metrics data")
+    }
+    defer C.free_network_tree(tree)
+
+    deviceList := getNetworkTreeByKey(tree, "DeviceList")
+    if deviceList == nil {
+        return nil, fmt.Errorf("controller STA tree has no DeviceList")
+    }
+    metrics := make([]candidateLinkMetric, 0)
+    for deviceIndex := 0; deviceIndex < int(deviceList.num_children); deviceIndex++ {
+        device := deviceList.child[deviceIndex]
+        if device == nil {
+            continue
+        }
+        agentAL := strings.ToLower(getTreeValue(device, "ID"))
+        candidateList := getNetworkTreeByKey(device, "UnassociatedSTAMetrics")
+        if agentAL == "" || candidateList == nil {
+            continue
+        }
+        for metricIndex := 0; metricIndex < int(candidateList.num_children); metricIndex++ {
+            item := candidateList.child[metricIndex]
+            if item == nil {
+                continue
+            }
+            receivedAt, err := strconv.ParseUint(getTreeValue(item, "ReceivedAtMS"), 10, 64)
+            if err != nil {
+                continue
+            }
+            metrics = append(metrics, candidateLinkMetric{
+                AgentAL: agentAL,
+                RUID: strings.ToLower(getTreeValue(item, "RUID")),
+                STA: strings.ToLower(getTreeValue(item, "STA")),
+                Channel: getKeyIntValue(item, "Channel"),
+                OpClass: getKeyIntValue(item, "OpClass"),
+                RCPI: getKeyIntValue(item, "RCPI"),
+                TimeDelta: getKeyIntValue(item, "TimeDelta"),
+                ReceivedAt: receivedAt,
+                MessageID: getKeyIntValue(item, "MessageID"),
+            })
+        }
+    }
+    sort.Slice(metrics, func(i, j int) bool {
+        if metrics[i].AgentAL != metrics[j].AgentAL {
+            return metrics[i].AgentAL < metrics[j].AgentAL
+        }
+        return candidateMetricKey(metrics[i].STA, metrics[i].OpClass,
+            metrics[i].Channel) < candidateMetricKey(metrics[j].STA,
+            metrics[j].OpClass, metrics[j].Channel)
+    })
+    return metrics, nil
+}
+
+func unassocStaMetricsHandler(w http.ResponseWriter, r *http.Request) {
+    metrics, err := loadCandidateLinkMetrics()
+    if err != nil {
+        http.Error(w, err.Error(), http.StatusServiceUnavailable)
+        return
+    }
+    w.Header().Set("Content-Type", "application/json")
+    _ = json.NewEncoder(w).Encode(map[string]interface{}{
+        "metrics": metrics,
+        "total": len(metrics),
+        "provider": "hwsim-wmediumd-read-only",
+        "simulated": true,
+    })
+}
