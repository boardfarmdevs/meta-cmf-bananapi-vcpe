From f22bd737414057a960bcdcdfa2d415401be3a91f Mon Sep 17 00:00:00 2001
From: Codex <codex@openai.com>
Date: Mon, 17 Aug 2026 02:43:00 -0700
Subject: [PATCH] controller: release generated JSON output

Controller JSON producers leaked both the string returned by cJSON_Print()
and, in two paths, every child of the generated tree. cJSON_free(parent)
only releases the root allocation; cJSON_Delete(parent) is required to walk
and release an owned cJSON tree.

The live Network response path is exercised by every WebUI topology refresh.
Its orphaned tree and print buffer grow em_ctrl RSS by about 82 KiB per
request. The same ownership errors exist in device-test and topology/event
publication paths.

Release print buffers after their synchronous consumers finish and delete
the complete owned trees.

Upstream-Status: Pending
---
 src/ctrl/dm_easy_mesh_ctrl.cpp | 3 ++-
 src/ctrl/em_ctrl.cpp           | 3 +++
 src/ctrl/em_dev_test_ctrl.cpp  | 3 ++-
 3 files changed, 7 insertions(+), 2 deletions(-)

diff --git a/src/ctrl/dm_easy_mesh_ctrl.cpp b/src/ctrl/dm_easy_mesh_ctrl.cpp
--- a/src/ctrl/dm_easy_mesh_ctrl.cpp
+++ b/src/ctrl/dm_easy_mesh_ctrl.cpp
@@ -3987,7 +3987,8 @@ void dm_easy_mesh_ctrl_t::get_config(em_long_string_t net_id, em_subdoc_info_t
     tmp = cJSON_Print(parent);
     em_printfout("Subdoc: %s", tmp);
     strncpy(subdoc->buff, tmp, strlen(tmp) + 1);
-    cJSON_free(parent);
+    cJSON_free(tmp);
+    cJSON_Delete(parent);
 }
 
 int dm_easy_mesh_ctrl_t::copy_config(dm_easy_mesh_t *dm, em_long_string_t net_id)
diff --git a/src/ctrl/em_ctrl.cpp b/src/ctrl/em_ctrl.cpp
--- a/src/ctrl/em_ctrl.cpp
+++ b/src/ctrl/em_ctrl.cpp
@@ -495,6 +495,7 @@ void em_ctrl_t::publish_sta_link_metrics()
         em_printfout("Link Stats Alarm publish fail");
     }
 
+    cJSON_free(str);
     cJSON_Delete(parent);
 }
 
@@ -720,6 +721,8 @@ void em_ctrl_t::publish_network_topology()
         printf("%s:%d Topology publish fail\n",__func__, __LINE__);
     }
 
+    cJSON_free(str);
+    cJSON_Delete(parent);
 #if 0
     //Test code here
     // if (desc->bus_event_subs_fn(&m_bus_hdl, DEVICE_WIFI_DATAELEMENTS_NETWORK_NODE_CFG_POLICY, (void *)&em_agent_t::onewifi_cb, NULL, 0) != 0) {
diff --git a/src/ctrl/em_dev_test_ctrl.cpp b/src/ctrl/em_dev_test_ctrl.cpp
--- a/src/ctrl/em_dev_test_ctrl.cpp
+++ b/src/ctrl/em_dev_test_ctrl.cpp
@@ -131,7 +131,8 @@ void em_dev_test_t::encode(em_subdoc_info_t *subdoc, hash_map_t *m_em_map, bool
 	tmp = cJSON_Print(parent);
 	//printf("%s:%d: Subdoc: %s\n", __func__, __LINE__, tmp);
 	strncpy(subdoc->buff, tmp, strlen(tmp) + 1);
-	cJSON_free(parent);
+	cJSON_free(tmp);
+	cJSON_Delete(parent);
 }
 
 void em_dev_test_t:: decode(em_subdoc_info_t *subdoc, hash_map_t *m_em_map, const char *str)
