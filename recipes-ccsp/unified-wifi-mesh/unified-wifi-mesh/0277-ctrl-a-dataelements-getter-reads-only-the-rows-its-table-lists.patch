+/* The DataElements getters' rows: each table index resolved against the rows its table lists,
+ * an error for 0, past the last row or an alias with no match, nothing read unless found. Models
+ * made in the controller's list without the database: agent A with two radios and, on its first,
+ * two BSSs around a row without a BSSID; agent Z with one radio and no BSS; the controller's own
+ * model, made first: the list puts a new model at its head, so an agent's model is its first. */
+class em_ctrl_t_de_getters : public ::testing::Test {
+protected:
+    typedef bus_error_t (*getter_t)(char *, raw_data_t *, bus_user_data_t *);
+    dm_easy_mesh_ctrl_t *dm_ctrl = nullptr;
+    dm_easy_mesh_t *a = nullptr, *z = nullptr, *c = nullptr;
+    mac_address_t a_al = {0x02, 0xde, 0x00, 0x00, 0x00, 0x0a};
+    mac_address_t z_al = {0x02, 0xde, 0x00, 0x00, 0x00, 0x0b};
+    mac_address_t c_al = {0x02, 0xde, 0x00, 0x00, 0x00, 0x0c};
+    mac_address_t r1 = {0x02, 0xde, 0x00, 0x00, 0x01, 0x01};
+    mac_address_t r2 = {0x02, 0xde, 0x00, 0x00, 0x01, 0x02};
+    mac_address_t r3 = {0x02, 0xde, 0x00, 0x00, 0x01, 0x03};
+    mac_address_t b1 = {0x02, 0xde, 0x00, 0x00, 0x02, 0x01};
+    mac_address_t b2 = {0x02, 0xde, 0x00, 0x00, 0x02, 0x02};
+
+    dm_easy_mesh_t *make(const mac_address_t al) {
+        em_interface_t intf = {};
+        memcpy(intf.mac, al, sizeof(mac_address_t));
+        dm_easy_mesh_t *dm = dm_ctrl->test_data_model_list().create_data_model(GLOBAL_NET_ID, &intf, em_profile_type_3);
+        memcpy(dm->get_device()->get_device_info()->id.dev_mac, al, sizeof(mac_address_t));
+        return dm;
+    }
+    static void radio(dm_easy_mesh_t *dm, unsigned int i, const mac_address_t ruid) {
+        memcpy(dm->get_radio(i)->get_radio_info()->id.ruid, ruid, sizeof(mac_address_t));
+    }
+    static void bss(dm_easy_mesh_t *dm, unsigned int i, const mac_address_t ruid, const unsigned char *bssid, const char *ssid) {
+        em_bss_info_t *bi = dm->get_bss(i)->get_bss_info();
+        memset(bi, 0, sizeof(*bi));
+        memcpy(bi->ruid.mac, ruid, sizeof(mac_address_t));
+        if (bssid != nullptr) {
+            memcpy(bi->bssid.mac, bssid, sizeof(mac_address_t));
+        }
+        snprintf(bi->ssid, sizeof(bi->ssid), "%s", ssid);
+    }
+    void SetUp() override {
+        dm_ctrl = em_ctrl_t::get_em_ctrl_instance()->get_dm_ctrl();
+        static bool list_made = false;
+        if (!list_made) {
+            dm_ctrl->test_data_model_list().init(nullptr);
+            list_made = true;
+        }
+        c = make(c_al);
+        c->set_controller(true);
+        c->set_controller_id(c_al);
+        c->set_num_network_ssid(1);
+        snprintf(c->get_network_ssid(0)->get_network_ssid_info()->ssid, sizeof(ssid_t), "%s", "c-net");
+        a = make(a_al);
+        a->set_num_radios(2);
+        radio(a, 0, r1);
+        radio(a, 1, r2);
+        bss(a, 0, r1, b1, "a-one");
+        bss(a, 1, r1, nullptr, "a-no-bssid");
+        bss(a, 2, r1, b2, "a-two");
+        a->set_num_bss(3);
+        z = make(z_al);
+        z->set_num_radios(1);
+        radio(z, 0, r3);
+        z->set_num_bss(0);
+        // the list's first: an agent's model
+        ASSERT_EQ(dm_ctrl->get_first_dm(), z);
+    }
+    void TearDown() override {
+        dm_ctrl->test_data_model_list().delete_data_model(GLOBAL_NET_ID, a_al);
+        dm_ctrl->test_data_model_list().delete_data_model(GLOBAL_NET_ID, z_al);
+        dm_ctrl->test_data_model_list().delete_data_model(GLOBAL_NET_ID, c_al);
+    }
+    std::string dev(dm_easy_mesh_t *dm) { return "Device.WiFi.DataElements.Network.Device." + std::to_string(dm->get_id()) + "."; }
+    /* the getter's value as a string ("" for a type not read here), or its error */
+    static bus_error_t get(getter_t fn, const std::string &path, std::string *value) {
+        std::vector<char> name(path.begin(), path.end());
+        name.push_back('\0');
+        raw_data_t raw;
+        memset(&raw, 0, sizeof(raw));
+        bus_error_t rc = fn(name.data(), &raw, nullptr);
+        value->clear();
+        if (rc != bus_error_success) {
+            return rc;
+        }
+        if (raw.data_type == bus_data_type_string && raw.raw_data.bytes != nullptr) {
+            *value = static_cast<char *>(raw.raw_data.bytes);
+            free(raw.raw_data.bytes);
+        } else if (raw.data_type == bus_data_type_uint16) {
+            *value = std::to_string(raw.raw_data.u16);
+        } else if (raw.data_type == bus_data_type_uint8) {
+            *value = std::to_string(raw.raw_data.u8);
+        } else if (raw.data_type == bus_data_type_uint32) {
+            *value = std::to_string(raw.raw_data.u32);
+        }
+        return rc;
+    }
+};
+
+TEST_F(em_ctrl_t_de_getters, BssOfARadioWithoutBssIsAnError) {
+    std::string v;
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(z) + "Radio.1.BSS.1.SSID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.2.BSS.1.SSID", &v), bus_error_success);
+}
+
+TEST_F(em_ctrl_t_de_getters, BssRowsAreTheTablesRows) {
+    std::string v;
+    // the table lists the radio's BSSs with a BSSID: a-one, a-two
+    ASSERT_EQ(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.1.BSS.1.SSID", &v), bus_error_success);
+    EXPECT_EQ(v, "a-one");
+    ASSERT_EQ(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.1.BSS.2.SSID", &v), bus_error_success);
+    EXPECT_EQ(v, "a-two");
+    ASSERT_EQ(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.1.BSS.[02:de:00:00:02:02].SSID", &v), bus_error_success);
+    EXPECT_EQ(v, "a-two");
+}
+
+TEST_F(em_ctrl_t_de_getters, BssPastTheLastZeroOrUnknownIsAnError) {
+    std::string v;
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.1.BSS.3.SSID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.1.BSS.0.SSID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.1.BSS.[02:de:00:00:02:09].SSID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::sta_get_inner, dev(a) + "Radio.1.BSS.3.STA.1.MACAddress", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::sta_get_inner, dev(z) + "Radio.1.BSS.1.STA.1.MACAddress", &v), bus_error_success);
+}
+
+TEST_F(em_ctrl_t_de_getters, RadioPastTheLastZeroOrUnknownIsAnError) {
+    std::string v;
+    ASSERT_EQ(get(dm_easy_mesh_ctrl_t::radio_get_inner, dev(a) + "Radio.2.ID", &v), bus_error_success);
+    EXPECT_EQ(v, "At4AAAEC");  // the radio's ID in base64
+    // A has two radios; the model's array has a third slot
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::radio_get_inner, dev(a) + "Radio.3.ID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::radio_get_inner, dev(a) + "Radio.0.ID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::radio_get_inner, dev(a) + "Radio.[02:de:00:00:01:09].ID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::bss_get_inner, dev(a) + "Radio.3.BSS.1.SSID", &v), bus_error_success);
+    EXPECT_EQ(dm_ctrl->get_dm_radio(a, const_cast<char *>("02:de:00:00:01:09"), false), nullptr);
+}
+
+TEST_F(em_ctrl_t_de_getters, DeviceRowsAreTheTablesRows) {
+    std::string v;
+    ASSERT_EQ(get(dm_easy_mesh_ctrl_t::device_get_inner, dev(a) + "ID", &v), bus_error_success);
+    EXPECT_EQ(v, "02:de:00:00:00:0a");
+    // the controller's own model is no Device row, by number or by its AL MAC
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::device_get_inner, dev(c) + "ID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::device_get_inner, "Device.WiFi.DataElements.Network.Device.[02:de:00:00:00:0c].ID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::device_get_inner, "Device.WiFi.DataElements.Network.Device.0.ID", &v), bus_error_success);
+}
+
+TEST_F(em_ctrl_t_de_getters, NetworkAndItsSsidsAreTheControllersModel) {
+    std::string v;
+    // Z, the list's first model, has no controller ID and no network SSID
+    ASSERT_EQ(get(dm_easy_mesh_ctrl_t::network_get_inner, "Device.WiFi.DataElements.Network.ControllerID", &v), bus_error_success);
+    EXPECT_EQ(v, "02:de:00:00:00:0c");
+    ASSERT_EQ(get(dm_easy_mesh_ctrl_t::ssid_get_inner, "Device.WiFi.DataElements.Network.SSID.1.SSID", &v), bus_error_success);
+    EXPECT_EQ(v, "c-net");
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::ssid_get_inner, "Device.WiFi.DataElements.Network.SSID.2.SSID", &v), bus_error_success);
+    EXPECT_NE(get(dm_easy_mesh_ctrl_t::ssid_get_inner, "Device.WiFi.DataElements.Network.SSID.0.SSID", &v), bus_error_success);
+}
