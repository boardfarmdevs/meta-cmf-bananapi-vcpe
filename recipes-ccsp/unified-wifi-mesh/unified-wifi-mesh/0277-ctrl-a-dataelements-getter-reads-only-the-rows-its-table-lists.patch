+    memcpy(a->m_assoc_sta_mld[1].get_assoc_sta_mld_info()->ap_mld_mac_addr, ap1, sizeof(mac_address_t));
+    memcpy(a->m_assoc_sta_mld[1].get_assoc_sta_mld_info()->mac_addr, s1, sizeof(mac_address_t));
