 // EMOSA adapter names itself "OpenSync via EMOSA"; the UI draws its kind apart.
 // The controller's own record takes the last M1 it processed, so the root
 // (depth 0) is always the controller and never classified by it.
+// wiredAgentName names an agent attached over Ethernet. The gateway's co-located
+// agent (the network's CollocatedAgentID) is an Agent; any other native agent on a
+// wired backhaul is an extender like its Wi-Fi peers. Without a known co-located
+// agent every wired agent stays an Agent, as before.
+func wiredAgentRole(deviceID, collocated string) string {
+	if collocated == "" || collocated == "00:00:00:00:00:00" || strings.EqualFold(deviceID, collocated) {
+		return "Agent"
+	}
+	return "Extender"
+}
