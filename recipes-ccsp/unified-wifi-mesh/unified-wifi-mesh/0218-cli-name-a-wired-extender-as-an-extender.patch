+package main
+
+import "testing"
+
+func TestWiredAgentRole(t *testing.T) {
+	const gateway = "00:60:2f:da:68:e4"
+	cases := []struct {
+		device, collocated, want string
+	}{
+		{gateway, gateway, "Agent"},                    // the gateway's co-located agent
+		{"00:60:2F:DA:68:E4", gateway, "Agent"},        // IDs compare without case
+		{"02:00:00:00:6f:20", gateway, "Extender"},     // a native extender on a wired backhaul
+		{"02:00:00:00:6f:20", "", "Agent"},             // no co-located agent known: as before
+		{"02:00:00:00:6f:20", "00:00:00:00:00:00", "Agent"},
+	}
+	for _, c := range cases {
+		if got := wiredAgentRole(c.device, c.collocated); got != c.want {
+			t.Errorf("wiredAgentRole(%q, %q) = %q, want %q", c.device, c.collocated, got, c.want)
+		}
+	}
+}
