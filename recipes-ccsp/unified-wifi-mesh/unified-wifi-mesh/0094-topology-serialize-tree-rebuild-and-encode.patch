From 0000000000000000000000000000000000000094 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Sun, 23 Aug 2026 02:20:00 -0700
Subject: [PATCH] topology: serialize tree rebuild and encode

The controller rebuilds its pointer-based topology tree on the protocol thread
while a service thread can encode the same tree for RBUS publication.  Moving
several backhaul stations made this race reproducible: encode followed a node
while update_network_topology removed and deleted it, and the controller
crashed in em_network_topo_t::encode with SIGSEGV.

Protect both traversal and mutation with one recursive mutex.  encode is
recursive, hence the recursive mutex; calls that rebuild then print the tree
can safely retain the same lock for the complete operation.

Upstream-Status: Pending
---
 inc/em_network_topo.h             | 3 +++
 src/ctrl/dm_easy_mesh_ctrl.cpp   | 2 ++
 src/ctrl/em_network_topo.cpp     | 3 +++
 3 files changed, 8 insertions(+)

diff --git a/inc/em_network_topo.h b/inc/em_network_topo.h
index 1111111..2222222 100644
--- a/inc/em_network_topo.h
+++ b/inc/em_network_topo.h
@@ -20,8 +20,11 @@
 #define EM_NETWORK_TOPO_H
 
 #include "em_base.h"
+#include <mutex>
 #include "dm_easy_mesh.h"
 
+extern std::recursive_mutex g_network_topology_mutex;
+
 class em_network_topo_t {
 
 	dm_easy_mesh_t	*m_data_model;
diff --git a/src/ctrl/dm_easy_mesh_ctrl.cpp b/src/ctrl/dm_easy_mesh_ctrl.cpp
index 3333333..4444444 100644
--- a/src/ctrl/dm_easy_mesh_ctrl.cpp
+++ b/src/ctrl/dm_easy_mesh_ctrl.cpp
@@ -8361,6 +8361,8 @@ void dm_easy_mesh_ctrl_t::update_network_topology()
 {
     dm_easy_mesh_t *dm;
 
+    std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+
     assert(g_network_topology != NULL);
     em_printfout("-----Updating network topology <start>-------");
     dm = get_first_dm();
diff --git a/src/ctrl/em_network_topo.cpp b/src/ctrl/em_network_topo.cpp
index 4444444..5555555 100644
--- a/src/ctrl/em_network_topo.cpp
+++ b/src/ctrl/em_network_topo.cpp
@@ -28,10 +28,13 @@
 
 extern em_network_topo_t *g_network_topology;
 
+std::recursive_mutex g_network_topology_mutex;
+
 void em_network_topo_t::encode(cJSON *parent)
 {
 	cJSON *dev_obj, *child_obj, *radio_list_obj, *radio_obj, *bss_list_obj, *bss_obj, *bh_obj, *sta_list_obj;
 	unsigned int i, j;
+    std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
 
 	if (m_data_model == NULL) {
 		em_printfout("Data model is NULL, cannot encode topology");
