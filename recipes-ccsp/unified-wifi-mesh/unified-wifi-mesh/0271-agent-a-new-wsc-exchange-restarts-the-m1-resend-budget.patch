+// 0271: a radio's M1 re-sends for a lost M2, run as the agent runs them. The radio re-sends its
+// M1 from its own protocol tick (em_t::proto_timeout, once a second on its thread): 8 in a round,
+// every third tick, then a new round after 30 ticks, doubling to 120. The orchestrator ticks
+// alongside it (handle_timeout, once a second). A command on the radio that starts or ends, its
+// own or another one, neither ends the rounds nor adds an M1.
+#include <arpa/inet.h>
+#include <algorithm>
+#include <memory>
+
+namespace {
+
+// an agent radio whose 1905 frames are counted, none sent on a network
+class wsc_radio_t : public em_t {
+public:
+    unsigned int m1s = 0;
+    unsigned int frames = 0;    // every 1905 frame, M1s too
+
+    wsc_radio_t(em_interface_t *ruid, dm_easy_mesh_t *dm, em_mgr_t *mgr) :
+        em_t(ruid, em_freq_band_5, dm, mgr, em_profile_type_3, em_service_type_agent) {}
+
+    int send_frame(unsigned char *buff, unsigned int len, bool multicast = false) override
+    {
+        (void)multicast;
+        frames++;
+        if (len >= sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t)) {
+            const em_cmdu_t *cmdu = reinterpret_cast<const em_cmdu_t *>(buff + sizeof(em_raw_hdr_t));
+            if (ntohs(cmdu->type) == em_msg_type_autoconf_wsc) {
+                m1s++;
+            }
+        }
+        return static_cast<int>(len);
+    }
+};
+
+struct wsc_rig_t {
+    em_orch_agent_t *orch;
+    std::unique_ptr<dm_easy_mesh_t> dm{new dm_easy_mesh_t()};
+    em_interface_t ruid{};
+    std::unique_ptr<wsc_radio_t> radio;
+    std::vector<unsigned int> sends;    // the ticks on which the radio sent an M1
+
+    wsc_rig_t(em_mgr_t *mgr, em_orch_agent_t *o) : orch(o)
+    {
+        dm_easy_mesh_t::string_to_macbytes(const_cast<char *>("02:00:00:21:76:0e"), ruid.mac);
+        radio.reset(new wsc_radio_t(&ruid, dm.get(), mgr));
+    }
+
+    // a test stopped early leaves its command queued, which the fixture's queue_destroy would
+    // free() although it was made with new: destroyed as the orchestrator destroys commands
+    ~wsc_rig_t()
+    {
+        for (queue_t *queue : {orch->m_pending, orch->m_active}) {
+            while (queue_count(queue) != 0) {
+                em_cmd_t *cmd = static_cast<em_cmd_t *>(queue_remove(queue, 0));
+                orch->pop_stats(cmd);
+                orch->destroy_command(cmd);
+            }
+        }
+    }
+
+    // ticks first..last, the orchestrator's then the radio's: at most one M1 a tick
+    void run(unsigned int first, unsigned int last)
+    {
+        for (unsigned int tick = first; tick <= last; tick++) {
+            unsigned int before = radio->m1s;
+            orch->handle_timeout();
+            radio->test_proto_timeout();
+            EXPECT_LE(radio->m1s - before, 1u) << "tick " << tick;
+            if (radio->m1s != before) {
+                sends.push_back(tick);
+            }
+        }
+    }
+};
+
+// a command on the radio, queued as submit_command queues it once build_candidates picked it
+em_cmd_t *queue_on_radio(em_orch_agent_t *orch, em_cmd_type_t type, em_t *radio)
+{
+    em_cmd_params_t param{};
+    std::unique_ptr<dm_easy_mesh_t> dm(new dm_easy_mesh_t());
+    em_cmd_t *cmd = new em_cmd_t(type, param, *dm);
+    queue_push(cmd->m_em_candidates, radio);
+    queue_push(orch->m_pending, cmd);
+    orch->push_stats(cmd);
+    return cmd;
+}
+
+// the command's time limit passed (EM_MAX_CMD_GEN_TTL from when it became active)
+void age_past_time_limit(em_cmd_t *cmd)
+{
+    cmd->m_start_time.tv_sec -= EM_MAX_CMD_GEN_TTL + 1;
+}
+
+// the ticks up to last of a radio's re-sends when its exchange started on tick `start`: rounds
+// of 8 every third tick, the next round 30, 60, 120, 120 ... ticks after a round's last M1
+std::vector<unsigned int> expected_resends(unsigned int start, unsigned int last)
+{
+    std::vector<unsigned int> ticks;
+    unsigned int wait = 30, next = start + 3;
+    while (next <= last) {
+        for (unsigned int i = 0; i < 8 && next <= last; i++, next += 3) {
+            ticks.push_back(next);
+        }
+        next = ticks.back() + wait;
+        wait = std::min(wait * 2, 120u);
+    }
+    return ticks;
+}
