+void em_configuration_t::reset_wsc_m2_recovery()
+{
+    m_wsc_m2_wait_ticks = 0;
+    m_wsc_m1_resends = 0;
+    m_wsc_m2_rescue_ticks = 0;
+    m_wsc_m2_rescue_wait = 0;
