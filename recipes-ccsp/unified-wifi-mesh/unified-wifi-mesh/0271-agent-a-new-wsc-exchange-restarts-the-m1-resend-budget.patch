+
+bool em_configuration_t::wsc_m2_recovery_tick(unsigned int &wait_ticks, unsigned int &resends,
+    unsigned int &rescue_ticks, unsigned int &rescue_wait, unsigned int &rescue_rounds, unsigned int *waited)
+{
+    *waited = 0;
+    if (resends >= EM_AGENT_M2_MAX_RESENDS) {
+        // A round spent with no M2 (the controller restarted, or busy): after a wait, a new
+        // round. Each M1 is a new WSC exchange (fresh nonce and keys, the caller's), which a
+        // controller answers with an M2 whatever it held before.
+        if (rescue_wait == 0) {
+            rescue_wait = EM_AGENT_M2_RESCUE_FIRST_TICKS;
+        }
+        if (++rescue_ticks < rescue_wait) {
+            return false;
+        }
+        rescue_ticks = 0;
+        rescue_rounds++;
+        *waited = rescue_wait;
+        rescue_wait = (rescue_wait * 2 > EM_AGENT_M2_RESCUE_MAX_TICKS) ? EM_AGENT_M2_RESCUE_MAX_TICKS : rescue_wait * 2;
+        resends = 0;
+        // the round's first M1 on this tick
+        wait_ticks = EM_AGENT_M2_RESEND_TICKS - 1;
+    }
+    if (++wait_ticks < EM_AGENT_M2_RESEND_TICKS) {
+        return false;
+    }
+    wait_ticks = 0;
+    return true;
+}
 
