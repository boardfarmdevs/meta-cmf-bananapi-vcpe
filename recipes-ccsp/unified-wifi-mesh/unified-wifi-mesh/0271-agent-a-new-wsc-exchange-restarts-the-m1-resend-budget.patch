+// 0271: the agent's M2-loss recovery. A radio in wsc_m2_pending re-sends its M1 every
+// third tick, 8 times; then, instead of stopping for good, it waits 30 ticks, doubling to 120,
+// and starts a new round, whose first M1 goes on the tick that starts it.
+#include <vector>
+#include "em_configuration.h"
+
+namespace {
+struct m2_recovery_run_t {
+    std::vector<unsigned int> sends;
+    std::vector<unsigned int> round_starts;
+    std::vector<unsigned int> waits;
+};
+
+/* ticks 1..last; sent(tick) says whether an M1 due on that tick was sent (counted in resends) */
+m2_recovery_run_t run_m2_recovery(unsigned int last, bool (*sent)(unsigned int))
+{
+    unsigned int wait_ticks = 0, resends = 0, rescue_ticks = 0, rescue_wait = 0, rounds = 0;
+    m2_recovery_run_t run;
+    for (unsigned int tick = 1; tick <= last; tick++) {
+        unsigned int waited = 0;
+        bool due = em_configuration_t::wsc_m2_recovery_tick(wait_ticks, resends, rescue_ticks, rescue_wait,
+            rounds, &waited);
+        if (waited != 0) {
+            run.round_starts.push_back(tick);
+            run.waits.push_back(waited);
+            EXPECT_EQ(rounds, run.round_starts.size());
+        }
+        if (due && sent(tick)) {
+            run.sends.push_back(tick);
+            resends++;
+        }
+    }
+    return run;
+}
+
+bool always_sent(unsigned int) { return true; }
+bool fails_before_ten(unsigned int tick) { return tick >= 10; }
+}
+
+TEST(em_configuration_t_wsc_m2_recovery, RoundsOfEightThenWaitsDoublingToTwoMinutes)
+{
+    m2_recovery_run_t run = run_m2_recovery(1000, always_sent);
+    // the first round: 8 re-sends, every third tick
+    ASSERT_GE(run.sends.size(), 8u);
+    for (unsigned int i = 0; i < 8; i++) {
+        EXPECT_EQ(run.sends[i], 3u * (i + 1));
+    }
+    // then rounds after 30, 60, 120 and 120 ticks: never stopped for good
+    ASSERT_GE(run.waits.size(), 4u);
+    EXPECT_EQ(run.waits[0], 30u);
+    EXPECT_EQ(run.waits[1], 60u);
+    EXPECT_EQ(run.waits[2], 120u);
+    EXPECT_EQ(run.waits[3], 120u);
+    // round 1 starts 30 ticks after the 8th re-send, its first M1 on that tick
+    EXPECT_EQ(run.round_starts[0], 24u + 30u);
+    EXPECT_EQ(run.sends[8], run.round_starts[0]);
+    // each round re-sends 8 M1s: 8 per round started, plus the first round's
+    unsigned int before_last_round = 0;
+    for (unsigned int s : run.sends) {
+        before_last_round += (s < run.round_starts.back()) ? 1 : 0;
+    }
+    EXPECT_EQ(before_last_round, 8u * run.round_starts.size());
+}
+
+TEST(em_configuration_t_wsc_m2_recovery, UnsentM1DoesNotSpendTheBudget)
+{
+    // an M1 that could not be sent (crypto or send failure) is not counted: the next attempt
+    // comes on the next due tick, and the round still holds 8 sent M1s
+    m2_recovery_run_t run = run_m2_recovery(200, fails_before_ten);
+    ASSERT_GE(run.sends.size(), 8u);
+    EXPECT_EQ(run.sends[0], 12u);
+    EXPECT_EQ(run.sends[7], 33u);
+    ASSERT_FALSE(run.round_starts.empty());
+    EXPECT_EQ(run.round_starts[0], 33u + 30u);
+}
+
+TEST(em_configuration_t_wsc_m2_recovery, ResetCountsStartAfresh)
+{
+    // after two spent rounds (the wait at 120), the counts reset by a new exchange or a handled
+    // M2 (reset_wsc_m2_recovery zeroes all five): the first re-send three ticks on, no wait
+    unsigned int wait_ticks = 1, resends = 8, rescue_ticks = 17, rescue_wait = 120, rounds = 2;
+    wait_ticks = resends = rescue_ticks = rescue_wait = rounds = 0;
+    unsigned int waited = 0, first = 0;
+    for (unsigned int tick = 1; tick <= 10 && first == 0; tick++) {
+        if (em_configuration_t::wsc_m2_recovery_tick(wait_ticks, resends, rescue_ticks, rescue_wait, rounds,
+                &waited)) {
+            first = tick;
+        }
+        EXPECT_EQ(waited, 0u);
+    }
+    EXPECT_EQ(first, 3u);
+}
