From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Mon, 24 Aug 2026 10:00:00 -0700
Subject: [PATCH] cli: report backhaul signal on mesh devices

The topology endpoint already publishes the authoritative timestamped
Associated STA Link Metrics observation for each wireless extender edge, but
the devices endpoint leaves Device.Signal unset. Consequently the Mesh Devices
page says that every extender signal is not reported even while the topology
shows a fresh value.

Join each device's exact backhaul STA and upstream BSSID to the same metrics
snapshot and publish the same fresh, stale, or unknown contract as
backhaul_signal. Retain the legacy numeric signal only while the observation
is fresh. Render the structured value on each device card and refresh the
visible Mesh Devices tab every two seconds without overlapping native queries.

diff --git a/src/rdkb-cli/backhaul_signal.go b/src/rdkb-cli/backhaul_signal.go
index a0700c3823449f65bc9ac2ea8ed5c78ce069abc6..769c94ef0246c488f87e1c427811cdbef17b34ef 100644
--- a/src/rdkb-cli/backhaul_signal.go
+++ b/src/rdkb-cli/backhaul_signal.go
@@ -16,7 +16,10 @@
 
 package main
 
-import "time"
+import (
+	"strings"
+	"time"
+)
 
 const (
 	backhaulSignalFresh           = "fresh"
@@ -94,3 +97,29 @@ func classifyBackhaulSignal(metric *BackhaulLinkMetric, now time.Time) BackhaulS
 		AgeSeconds: &ageSeconds,
 	}
 }
+
+// classifyDeviceBackhaulSignal applies the same exact bSTA/upstream-BSSID
+// join and freshness contract used by the topology endpoint. The legacy RSSI
+// pointer is populated only while the standard observation is fresh.
+func classifyDeviceBackhaulSignal(metrics map[string]BackhaulLinkMetric,
+	backhaulSTA, upstreamBSSID, mediaType string, now time.Time) (*BackhaulSignal, *int) {
+	backhaulSTA = strings.ToLower(strings.TrimSpace(backhaulSTA))
+	upstreamBSSID = strings.ToLower(strings.TrimSpace(upstreamBSSID))
+	if strings.EqualFold(strings.TrimSpace(mediaType), "Ethernet") ||
+		backhaulSTA == "" || upstreamBSSID == "" ||
+		upstreamBSSID == "00:00:00:00:00:00" {
+		return nil, nil
+	}
+
+	metric, found := metrics[backhaulSTA+"@"+upstreamBSSID]
+	var metricPtr *BackhaulLinkMetric
+	if found {
+		metricPtr = &metric
+	}
+	signal := classifyBackhaulSignal(metricPtr, now)
+	if signal.Status != backhaulSignalFresh || signal.RSSI == nil {
+		return &signal, nil
+	}
+	legacyRSSI := *signal.RSSI
+	return &signal, &legacyRSSI
+}
