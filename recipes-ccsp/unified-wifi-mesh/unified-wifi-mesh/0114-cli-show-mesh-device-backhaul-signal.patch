 	Metrics         DeviceMetrics  `json:"metrics"`
@@ -3336,6 +3337,7 @@ func buildLiveInventory() ([]Device, []Client, error) {
     if err != nil {
         return nil, nil, err
     }
+	backhaulMetrics := collectBackhaulLinkMetrics(radioInventory)
 	var inventoryDevices []Device
 	var inventoryClients []Client
 	agentCount, extenderCount := 1, 1
@@ -3394,9 +3396,13 @@ func buildLiveInventory() ([]Device, []Client, error) {
 		if uptimeSeconds > 0 {
 			uptimeText = formatUptimeSeconds(uptimeSeconds)
 		}
+		deviceSignal, legacySignal := classifyDeviceBackhaulSignal(
+			backhaulMetrics, getTreeValue(backhaul, "STAAddress"),
+			getTreeValue(backhaul, "MACAddress"), backhaulMedia, observedAt.UTC())
 		inventoryDevices = append(inventoryDevices, Device{
 			MAC: deviceID, Role: role, Vendor: "RDK-B", Model: "EasyMesh node",
 			Status: "Online", LastSeen: observedAt, Uptime: uptimeText,
+			Signal: legacySignal, BackhaulSignal: deviceSignal,
 			BackhaulType: backhaulMedia,
 			Capabilities: Capability{SupportedBands: bands},
 			Metrics: DeviceMetrics{Uptime: uptimeSeconds, LastUpdated: observedAt},
