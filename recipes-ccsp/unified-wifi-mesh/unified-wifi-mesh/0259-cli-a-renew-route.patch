+++ b/src/rdkb-cli/main.go
@@ -3171,6 +3171,9 @@ func main() {
 	api.HandleFunc("/unassoc_sta_query", unassocStaQueryHandler).Methods("POST")
 	api.HandleFunc("/unassoc_sta_metrics", unassocStaMetricsHandler).Methods("GET")
 
