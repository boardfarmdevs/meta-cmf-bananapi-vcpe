+	api.HandleFunc("/renew", renewHandler).Methods("POST")
+
 	// Enable CORS
 	router.Use(corsMiddleware)
 
@@ -4563,6 +4566,26 @@ func submitCandidateQuery(jsonBytes []byte) error {
     return nil
 }
 
+// submitRenewSubdoc sends a wfa-dataelements:Renew subdoc to the controller (cfg_renew with the
+// caller's tree, series 0258) and returns the controller's status.
+func submitRenewSubdoc(subdoc []byte) (string, error) {
+    cJsonStr := C.CString(string(subdoc))
+    defer C.free(unsafe.Pointer(cJsonStr))
+    node := C.get_network_tree(cJsonStr)
+    if node == nil {
+        return "", fmt.Errorf("failed to create the renew request tree")
+    }
+    defer C.free_network_tree(node)
+    cmd := C.CString("cfg_renew OneWifiMesh")
+    defer C.free(unsafe.Pointer(cmd))
+    result := execEMCommand(cmd, node)
+    if result == nil {
+        return "", fmt.Errorf("renew command execution failed")
+    }
+    defer C.free_network_tree(result)
+    return getTreeValue(result, "Status"), nil
+}
+
