+bool em_orch_t::is_model_in_commands(const dm_easy_mesh_t *dm)
+{
+    auto command_lock = lock_commands();
+    queue_t *queues[] = {m_pending, m_active};
+
+    for (queue_t *q : queues) {
+        for (unsigned int i = 0; i < queue_count(q); i++) {
+            em_cmd_t *pcmd = static_cast<em_cmd_t *>(queue_peek(q, i));
+            for (unsigned int j = 0; j < queue_count(pcmd->m_em_candidates); j++) {
+                em_t *em = static_cast<em_t *>(queue_peek(pcmd->m_em_candidates, j));
+                if (em->get_data_model() == dm) {
+                    return true;
+                }
+            }
+        }
+    }
+    return false;
+}
