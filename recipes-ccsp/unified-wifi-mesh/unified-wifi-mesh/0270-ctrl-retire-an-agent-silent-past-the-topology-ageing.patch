--- a/src/ctrl/dm_easy_mesh_ctrl.cpp
+++ b/src/ctrl/dm_easy_mesh_ctrl.cpp
@@ -4988,6 +4988,45 @@ void dm_easy_mesh_ctrl_t::retire_radio(dm_easy_mesh_t *dm, const unsigned char *
     dm->set_db_cfg_param(db_cfg_type_bss_list_update, "");
 }
 
+int dm_easy_mesh_ctrl_t::retire_agent(dm_easy_mesh_t *dm)
+{
+    if (dm == NULL || dm->get_num_radios() != 0) {
+        return -1;
+    }
+
+    /* its stations' rows: the model's station map goes with the model */
+    int stations = 0;
+    if (dm->m_sta_map != NULL) {
+        for (dm_sta_t *sta = static_cast<dm_sta_t *>(hash_map_get_first(dm->m_sta_map)); sta != NULL;
+                sta = static_cast<dm_sta_t *>(hash_map_get_next(dm->m_sta_map, sta))) {
+            if (dm_sta_list_t::update_db(m_db_client, dm_orch_type_db_delete, sta->get_sta_info()) == 0) {
+                stations++;
+            }
+        }
+    }
+
+    /* the device's row */
+    em_device_info_t info = *dm->get_device()->get_device_info();
+    dm_device_list_t::update_db(m_db_client, dm_orch_type_db_delete, &info);
+
+    /* its node in the network topology, then the model out of the list, both under the topology
+     * lock: the topology holds the model's address and every update walks all its nodes. The
+     * model is not freed here: not every reader of the list takes that lock (the bus's method
+     * handlers, the ems' handlers, the nodes listener), so the caller frees it later. */
+    mac_address_t al;
+    memcpy(al, dm->get_agent_al_interface_mac(), sizeof(mac_address_t));
+    std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+    if (g_network_topology != NULL) {
+        g_network_topology->remove(dm);
+    }
+    if (m_data_model_list.get_data_model(info.id.net_id, al) != dm) {
+        return -1;
+    }
+    m_data_model_list.unlink_data_model(info.id.net_id, al);
+
+    return stations;
+}
