diff --git a/inc/em_ctrl.h b/inc/em_ctrl.h
index ec1dfaa..1c53a0e 100644
--- a/inc/em_ctrl.h
+++ b/inc/em_ctrl.h
@@ -59,6 +59,50 @@ class em_ctrl_t : public em_mgr_t {
     std::mutex m_autoconfig_mutex;
     std::map<std::string, agent_liveness_t> m_agent_liveness;
 
+    /* An agent gone silent past the topology ageing is retired, in two passes: its radios
+     * queued (retire_stale_radios), then once they are gone its stations, device and model. Its
+     * identity is kept: heard again (any 1905 frame from its AL MAC, a Topology Discovery too) it
+     * is rejoined without having to reboot: its model again if it was removed, then a targeted
+     * AP-Autoconfiguration Renew per band of its radios, so its M1s rebuild them. */
+    struct retired_agent_t {
+        std::chrono::steady_clock::time_point since;    /* its radios queued */
+        bool removed = false;                           /* its model, device and rows gone */
+        em_profile_type_t profile = em_profile_type_1;
+        uint8_t is_emplus = 0;
+        unsigned int bands = 0;                         /* 1 << em_freq_band_t of its radios */
+        bool heard = false;                             /* a frame from it since */
+        bool remade = false;                            /* its removed model made again */
+        std::chrono::steady_clock::time_point heard_at;
+        unsigned int renews = 0;
+        std::chrono::steady_clock::time_point next_renew;
+        /* after renews that brought no M1, a Topology Discovery alone (an agent whose own side is
+         * down still sends it) starts no rejoin until then; any other frame does */
+        std::chrono::steady_clock::time_point quiet_until;
+    };
+    const std::chrono::steady_clock::time_point m_ctrl_start = std::chrono::steady_clock::now();
+    std::map<std::string, retired_agent_t> m_retired_agents;    /* under m_liveness_mutex */
