+unsigned int dm_easy_mesh_t::queue_all_radios_stale()
+{
+    unsigned int queued = 0;
+
+    for (unsigned int i = 0; i < m_num_radios && m_num_stale_radio < EM_MAX_BANDS; i++) {
+        const unsigned char *ruid = m_radio[i].m_radio_info.intf.mac;
+        bool queued_already = false;
