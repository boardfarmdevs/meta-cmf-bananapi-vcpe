+dm_easy_mesh_t *dm_easy_mesh_list_t::unlink_data_model(const char *net_id, const unsigned char *al_mac)
+{
+    std::lock_guard<std::recursive_mutex> topology_lock(g_network_topology_mutex);
+    mac_addr_str_t mac_str;
+    em_long_string_t	key;
+
+    dm_easy_mesh_t::macbytes_to_string(const_cast<unsigned char *> (al_mac), mac_str);
+    snprintf(key, sizeof(em_short_string_t), "%s@%s", net_id, mac_str);
+
+    dm_easy_mesh_t *dm = static_cast<dm_easy_mesh_t *> (hash_map_get(m_list, key));
+    if (dm == NULL) {
+        return NULL;
+    }
+    /* the hash map keeps one cursor for every walker of the list: moved past this model first,
+     * so the element hash_map_remove frees is not the cursor (a walker whose last model was this
+     * one then finds it gone and ends its walk) */
+    hash_map_get_next(m_list, dm);
+    hash_map_remove(m_list, key);
+    return dm;
+}
