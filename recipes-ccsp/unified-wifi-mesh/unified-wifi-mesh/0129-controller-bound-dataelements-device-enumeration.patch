From: RDK-B EasyMesh lab maintainers
Subject: [PATCH] controller: bound DataElements device enumeration

The 50-client carousel drives the controller from about 26 MiB to more than
600 MiB PSS while Device.WiFi.DataElements requests time out.  The controller
data model is counted as a device, but device_tget_inner() enumerates positive
agent IDs starting at one.  Once it has returned every agent, its count still
includes the controller and the loop advances through nonexistent IDs
forever.  Repeated WebUI/RBUS requests then accumulate blocked getters and
large anonymous mappings.

Backport the upstream fix: exclude the controller from the agent table, track
the largest valid ID, and bound sparse-ID enumeration by it.  Increment the
completed count only after a valid non-controller device has been appended.

Upstream-Status: Backport [8f2b8292c6fa2320b6d6d17827ab3dcf45c79e0c]
---
 src/ctrl/dm_easy_mesh_ctrl.cpp | 23 +++++++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/src/ctrl/dm_easy_mesh_ctrl.cpp b/src/ctrl/dm_easy_mesh_ctrl.cpp
--- a/src/ctrl/dm_easy_mesh_ctrl.cpp
+++ b/src/ctrl/dm_easy_mesh_ctrl.cpp
@@ -4936,6 +4936,10 @@ bus_error_t dm_easy_mesh_ctrl_t::network_get_inner(char *event_name, raw_data_t
         unsigned int dev_cnt = 0;
         dm_easy_mesh_t *dm = dm_ctrl->get_first_dm();
         while (dm != NULL) {
+            if (dm->is_controller()) {
+                dm = dm_ctrl->get_next_dm(dm);
+                continue;
+            }
             dm_device_t *dev = dm->get_device();
             if (dev != NULL) {
                 em_device_info_t *di = dev->get_device_info();
@@ -5171,7 +5175,12 @@ bus_error_t dm_easy_mesh_ctrl_t::device_tget_inner(char *event_name, raw_data_t
 
     /* Calculate device count */
     unsigned int device_cnt = 0;
+    int max_id = 0;
     while (dm != NULL) {
+        if (dm->is_controller()) {
+            dm = dm_ctrl->get_next_dm(dm);
+            continue;
+        }
         if (dm->get_id() < 0) {
             dm = dm_ctrl->get_next_dm(dm);
             continue;
@@ -5186,12 +5195,15 @@ bus_error_t dm_easy_mesh_ctrl_t::device_tget_inner(char *event_name, raw_data_t
             dm = dm_ctrl->get_next_dm(dm);
             continue;
         }
+        if (dm->get_id() > max_id) {
+            max_id = dm->get_id();
+        }
         ++device_cnt;
         dm = dm_ctrl->get_next_dm(dm);
     }
 
     /* Iterate according to dm id */
-    for (unsigned int idx = 1, cnt = 0; cnt < device_cnt; idx++) {
+    for (unsigned int idx = 1, cnt = 0; cnt < device_cnt && idx <= static_cast<unsigned int>(max_id); idx++) {
         dm = dm_ctrl->get_first_dm();
         do {
             if (dm && (dm->get_id() == static_cast<int>(idx))) {
@@ -5202,15 +5214,22 @@ bus_error_t dm_easy_mesh_ctrl_t::device_tget_inner(char *event_name, raw_data_t
         if (dm == NULL) {
             continue;
         }
-        ++cnt;
+
+        if (dm->is_controller()) {
+            continue;
+        }
+
         dm_device_t *dev = dm->get_device();
         if (dev == NULL) {
             continue;
         }
+
         em_device_info_t *di = dev->get_device_info();
         if (memcmp(di->id.dev_mac, ZERO_MAC_ADDR, sizeof(di->id.dev_mac)) == 0) {
             continue;
         }
+        ++cnt;
+
         em_ieee_1905_security_cap_t *sec_cap = dm->get_ieee_1905_security_cap();
 
         dm_ctrl->property_append_tail(&property, root, idx, "ID", di->id.dev_mac);
