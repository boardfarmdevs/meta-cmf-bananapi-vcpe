From 0000000000000000000000000000000000000106 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Sun, 23 Aug 2026 15:10:00 -0700
Subject: [PATCH] controller: serialize autoconfiguration model creation

Band-specific Autoconfiguration Search and WSC messages for one multi-radio
agent can enter the controller concurrently. Serialize only controller node
selection and model mutation for those message types; ordinary per-radio
message handling remains concurrent.

The fresh upstream message helpers already initialize, length-check and
bounds-check Profile TLVs through parse_profile_tlv(), so the duplicate parser
hunks from the original local patch are no longer needed.

Upstream-Status: Pending
---
 inc/em_ctrl.h        |  1 +
 src/ctrl/em_ctrl.cpp | 10 +++++++++-
 2 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/inc/em_ctrl.h b/inc/em_ctrl.h
index 6a1e783..737bdaf 100644
--- a/inc/em_ctrl.h
+++ b/inc/em_ctrl.h
@@ -54,6 +54,7 @@ class em_ctrl_t : public em_mgr_t {
         bool reachable = true;
     };
     std::mutex m_liveness_mutex;
+    std::mutex m_autoconfig_mutex;
     std::map<std::string, agent_liveness_t> m_agent_liveness;
 
 	/**!
diff --git a/src/ctrl/em_ctrl.cpp b/src/ctrl/em_ctrl.cpp
index 88b67b9..fca04bd 100644
--- a/src/ctrl/em_ctrl.cpp
+++ b/src/ctrl/em_ctrl.cpp
@@ -1122,6 +1122,7 @@ em_t *em_ctrl_t::find_em_for_msg_type(unsigned char *data, unsigned int len, em_
     mac_address_t fallback_ruid = {0};
     em_supported_service_t svc = {};
     uint8_t is_emplus;
+    unsigned short msg_type;
 
     assert(len > ((sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t))));
     if (len < ((sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t)))) {
@@ -1136,7 +1137,14 @@ em_t *em_ctrl_t::find_em_for_msg_type(unsigned char *data, unsigned int len, em_
     
     cmdu = reinterpret_cast<em_cmdu_t *> (data + sizeof(em_raw_hdr_t));
 
-    switch (htons(cmdu->type)) {
+    msg_type = htons(cmdu->type);
+    std::unique_lock<std::mutex> autoconfig_lock(m_autoconfig_mutex, std::defer_lock);
+    if (msg_type == em_msg_type_autoconf_search ||
+            msg_type == em_msg_type_autoconf_wsc) {
+        autoconfig_lock.lock();
+    }
+
+    switch (msg_type) {
         case em_msg_type_autoconf_search:
             if (em_msg_t(data + (sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t)), len - static_cast<unsigned int> (sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t))).get_freq_band(&band) == false) {
                 return NULL;
