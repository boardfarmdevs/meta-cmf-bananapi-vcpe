From 0000000000000000000000000000000000000135 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Mon, 31 Aug 2026 12:05:00 -0700
Subject: [PATCH] agent: reconcile before topology notification

A sta_list event is expanded into two independent command objects.  The first
object emits the Topology Notification and the second updates the agent's
consolidated station model.  Full-snapshot reconciliation previously ran only
on the second object.  It therefore discovered and locally removed an absent
station after the already-queued notification had been constructed without a
withdrawal.  The controller retained the old owner until a later explicit
disassociation event, which made immediate post-roam candidate queries time
out.

Reconcile authoritative full snapshots on the notification object while the
last-advertised ownership still exists.  The emitted snapshot now contains the
explicit disassociation delta; unchanged full snapshots are suppressed after
refreshing metrics.  The aggregate clone continues to commit new associations
to the local model.  Add a regression proving the notification snapshot owns
the withdrawal before the aggregate clone runs.

Upstream-Status: Pending
---
 src/orch/em_orch_agent.cpp      | 34 ++++++++++++++++++++++
 tests/test_l1_em_orch_agent.cpp | 50 +++++++++++++++++++++++++++++++++
 2 files changed, 84 insertions(+)

--- a/src/orch/em_orch_agent.cpp
+++ b/src/orch/em_orch_agent.cpp
@@ -444,6 +444,40 @@ bool em_orch_agent_t::pre_process_orch_op(em_cmd_t *pcmd)
             break;
         case dm_orch_type_em_update:
             break;
+        case dm_orch_type_ctrl_notify:
+            /* sta_list commands are constructed as two independent command
+             * objects: the notification first and the local aggregate clone
+             * second.  Reconciliation in the aggregate clone is too late to
+             * affect the already-queued notification snapshot.  Reduce a full
+             * snapshot to association/withdrawal deltas on the notification
+             * command itself, while the last-advertised local ownership still
+             * exists. */
+            if (pcmd->get_type() != em_cmd_type_sta_list) {
+                break;
+            }
+
+            full_sta_snapshot =
+                pcmd->m_param.u.args.num_args > 1 &&
+                strcmp(pcmd->m_param.u.args.args[1], "full") == 0;
+            if (!full_sta_snapshot) {
+                break;
+            }
+
+            intf = resolve_sta_snapshot_interface(pcmd);
+            if (intf == NULL) {
+                em_printfout("Rejecting STA notification with missing, invalid, or unknown reporting RUID");
+                return false;
+            }
+            if ((dm = m_mgr->get_data_model(GLOBAL_NET_ID, intf->mac)) == NULL) {
+                dm = m_mgr->create_data_model(GLOBAL_NET_ID, intf);
+            }
+            if (retain_full_sta_snapshot_deltas(dm,
+                    pcmd->get_data_model(), intf->mac) == 0) {
+                /* No ownership delta means there is no Topology Notification
+                 * to send.  Metrics were still refreshed in the local model. */
+                return false;
+            }
+            break;
         case dm_orch_type_sta_aggregate:
             /* clone_for_next() resets the operation context, including
              * arr_index.  A station-list command already carries its
--- a/tests/test_l1_em_orch_agent.cpp
+++ b/tests/test_l1_em_orch_agent.cpp
@@ -269,6 +269,56 @@ TEST(em_orch_agent_snapshot_delta_TEST, RejectsUnknownReportingRadio)
     snapshot.deinit();
 }
 
+TEST(em_orch_agent_snapshot_delta_TEST,
+    NotificationSnapshotCarriesWithdrawalBeforeAggregate)
+{
+    const char *radio = "02:00:00:20:00:01";
+    const char *sta = "02:00:00:00:03:00";
+    const char *bssid = "02:00:00:10:00:01";
+    em_cmd_params_t params{};
+    dm_easy_mesh_t current{};
+    dm_easy_mesh_t snapshot{};
+
+    ASSERT_EQ(current.init(), 0);
+    ASSERT_EQ(snapshot.init(), 0);
+    snapshot.m_num_radios = 1;
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(radio),
+        snapshot.m_radio[0].m_radio_info.intf.mac);
+
+    em_sta_info_t old = make_associated_sta(sta, bssid, radio);
+    current.put_sta_info(&old, em_target_sta_map_consolidated);
+
+    params.u.args.num_args = 2;
+    snprintf(params.u.args.args[0], sizeof(params.u.args.args[0]), "%s",
+        radio);
+    snprintf(params.u.args.args[1], sizeof(params.u.args.args[1]), "full");
+    em_cmd_sta_list_t notify(params, snapshot);
+
+    /* The first command is the object which will actually emit the Topology
+     * Notification.  Its snapshot must contain the withdrawal before the
+     * independent sta_aggregate clone runs. */
+    ASSERT_EQ(notify.get_orch_op(), dm_orch_type_ctrl_notify);
+    em_interface_t *reporting =
+        em_orch_agent_t::resolve_sta_snapshot_interface(&notify);
+    ASSERT_NE(reporting, nullptr);
+    EXPECT_EQ(em_orch_agent_t::retain_full_sta_snapshot_deltas(
+        &current, notify.get_data_model(), reporting->mac), 1u);
+    EXPECT_EQ(hash_map_count(current.m_sta_map), 0u);
+    EXPECT_EQ(hash_map_count(
+        notify.get_data_model()->m_sta_dassoc_map), 1u);
+
+    mac_address_t sta_mac, bss_mac, radio_mac;
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(sta), sta_mac);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(bssid), bss_mac);
+    dm_easy_mesh_t::string_to_macbytes(const_cast<char *>(radio), radio_mac);
+    EXPECT_NE(notify.get_data_model()->get_sta_info(sta_mac, bss_mac,
+        radio_mac, em_target_sta_map_disassoc), nullptr);
+
+    notify.deinit();
+    snapshot.deinit();
+    current.deinit();
+}
+
 
 
