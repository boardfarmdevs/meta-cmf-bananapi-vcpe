 }
+
+// Deleting a model that is already gone (a RemoveDevice for a device retired meanwhile)
+// returns instead of dereferencing the NULL hash_map_remove gives back.
+TEST_F(dm_easy_mesh_list_tTEST, delete_data_model_absent_model_returns) {
+    unsigned char absent[6] = {0x02, 0x00, 0x00, 0x00, 0x00, 0x99};
+    list.delete_data_model("Network1", absent);
+    list.delete_data_model("NoSuchNetwork", mac1);
+    EXPECT_NE(list.get_data_model("Network1", mac1), nullptr);
+}
