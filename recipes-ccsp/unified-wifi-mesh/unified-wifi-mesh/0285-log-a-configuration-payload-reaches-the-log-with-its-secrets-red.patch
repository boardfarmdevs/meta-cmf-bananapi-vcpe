+// A SetSSID payload as the bus or the WebUI hands it: the passphrases never reach a log, the rest does.
+TEST(UtilTest, loggable_payload_redacts_passphrases) {
+    const char *payload = R"({"Network":{"ID":"OneWifiMesh","NetworkSSIDList":[)"
+                          R"({"SSID":"home","PassPhrase":"secret-home-1","Band":["2.4","5"]},)"
+                          R"({"SSID":"bh","PassPhrase":"secret-bh-2","HaulType":["Backhaul"]}]}})";
+    std::string logged = util::loggable_payload(payload);
+    EXPECT_EQ(logged.find("secret-home-1"), std::string::npos);
+    EXPECT_EQ(logged.find("secret-bh-2"), std::string::npos);
+    EXPECT_NE(logged.find("\"PassPhrase\":\"<redacted>\""), std::string::npos);
+    EXPECT_NE(logged.find("\"SSID\":\"home\""), std::string::npos);
+    EXPECT_NE(logged.find("OneWifiMesh"), std::string::npos);
+}
+
+// Keys and passwords under any name and at any depth, a whole secret object included.
+TEST(UtilTest, loggable_payload_redacts_every_secret_bearing_key) {
+    const char *payload = R"({"a":{"Key":"k1","PreSharedKey":"k2","password":"k3","b":[{"ClientSecret":"k4"}]},)"
+                          R"("Credentials":{"user":"u","token":"k5"},"Channel":36})";
+    std::string logged = util::loggable_payload(payload);
+    for (const char *secret : {"k1", "k2", "k3", "k4", "k5", "\"user\""}) {
+        EXPECT_EQ(logged.find(secret), std::string::npos) << secret << " in " << logged;
+    }
+    EXPECT_NE(logged.find("\"Channel\":36"), std::string::npos);
+}
+
+// What does not parse is logged by its length only: it can't be told what it holds.
+TEST(UtilTest, loggable_payload_logs_a_non_json_buffer_by_its_length) {
+    EXPECT_EQ(util::loggable_payload("{\"PassPhrase\":\"secret\""), "<22 bytes, not JSON>");
+    EXPECT_EQ(util::loggable_payload(""), "<0 bytes, not JSON>");
+    EXPECT_EQ(util::loggable_payload(NULL), "<none>");
+}
