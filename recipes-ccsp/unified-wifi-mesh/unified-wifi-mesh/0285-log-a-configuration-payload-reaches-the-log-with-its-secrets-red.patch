+
+/* a JSON key whose value may be a secret: "pass", "key", "psk", "secret" or "credential" in its name */
+static bool secret_bearing(const char *name)
+{
+    if (name == NULL) {
+        return false;
+    }
+    std::string lower(name);
+    std::transform(lower.begin(), lower.end(), lower.begin(), [](unsigned char c) { return std::tolower(c); });
+    for (const char *word : {"pass", "key", "psk", "secret", "credential"}) {
+        if (lower.find(word) != std::string::npos) {
+            return true;
+        }
+    }
+    return false;
+}
+
+static void redact_secrets(cJSON *node)
+{
+    cJSON *child = node ? node->child : NULL;
+    while (child != NULL) {
+        cJSON *next = child->next;
+        if (cJSON_IsObject(node) && secret_bearing(child->string)) {
+            // by name, so the replacement keeps the key (a replacement by pointer has none)
+            cJSON_ReplaceItemInObjectCaseSensitive(node, child->string, cJSON_CreateString("<redacted>"));
+        } else {
+            redact_secrets(child);
+        }
+        child = next;
+    }
+}
+
+std::string util::loggable_payload(const char *payload)
+{
+    if (payload == NULL) {
+        return "<none>";
+    }
+    cJSON *json = cJSON_Parse(payload);
+    if (json == NULL) {
+        return "<" + std::to_string(strlen(payload)) + " bytes, not JSON>";
+    }
+    redact_secrets(json);
+    char *text = cJSON_PrintUnformatted(json);
+    cJSON_Delete(json);
+    if (text == NULL) {
+        return "<" + std::to_string(strlen(payload)) + " bytes>";
+    }
+    std::string out(text);
+    cJSON_free(text);
+    return out;
+}
