+int em_configuration_t::create_associated_clients_tlv(unsigned char *buff,
+                                                       unsigned int capacity)
+{
+    dm_easy_mesh_t *dm = get_data_model();
+    em_tlv_t *tlv = reinterpret_cast<em_tlv_t *>(buff);
+    unsigned char *value = tlv->value;
+    unsigned char *tmp = value + 1;
+    unsigned int payload_len = 1;
+    unsigned int bss_count = 0;
+
+    if (dm == NULL || capacity < sizeof(em_tlv_t) + payload_len) {
+        return 0;
+    }
+
+    // Bound the optional data independently as well as by the actual space
+    // left in the response.  If the complete current set cannot be reported,
+    // omit the TLV rather than send a misleading partial association set.
+    const unsigned int max_payload = std::min(
+            static_cast<unsigned int>(MAX_EM_BUFF_SZ),
+            capacity - static_cast<unsigned int>(sizeof(em_tlv_t)));
+
+    for (unsigned int i = 0; i < dm->get_num_bss(); i++) {
+        em_bss_info_t *bss = dm->get_bss_info(i);
+        unsigned int sta_count = 0;
+        dm_sta_t *sta;
+
+        if (bss == NULL || bss->vap_mode != em_vap_mode_ap || !bss->enabled) {
+            continue;
+        }
+
+        sta = static_cast<dm_sta_t *>(hash_map_get_first(dm->m_sta_map));
+        while (sta != NULL) {
+            if (sta->m_sta_info.associated &&
+                    memcmp(sta->m_sta_info.bssid, bss->bssid.mac,
+                           sizeof(bssid_t)) == 0) {
+                sta_count++;
+            }
+            sta = static_cast<dm_sta_t *>(hash_map_get_next(dm->m_sta_map, sta));
+        }
+
+        if (sta_count == 0) {
+            continue;
+        }
+
+        const unsigned int bss_len = sizeof(bssid_t) + sizeof(uint16_t) +
+                sta_count * (sizeof(mac_address_t) + sizeof(uint16_t));
+        if (payload_len + bss_len > max_payload || bss_count >= 255) {
+            em_printfout("Associated Clients TLV exceeds bounded payload; omitting TLV");
+            return 0;
+        }
+
+        memcpy(tmp, bss->bssid.mac, sizeof(bssid_t));
+        tmp += sizeof(bssid_t);
+        uint16_t count_be = htons(static_cast<uint16_t>(sta_count));
+        memcpy(tmp, &count_be, sizeof(count_be));
+        tmp += sizeof(count_be);
+
+        sta = static_cast<dm_sta_t *>(hash_map_get_first(dm->m_sta_map));
+        while (sta != NULL) {
+            if (sta->m_sta_info.associated &&
+                    memcmp(sta->m_sta_info.bssid, bss->bssid.mac,
+                           sizeof(bssid_t)) == 0) {
+                memcpy(tmp, sta->m_sta_info.id, sizeof(mac_address_t));
+                tmp += sizeof(mac_address_t);
+                uint16_t assoc_time_be = 0;
+                memcpy(tmp, &assoc_time_be, sizeof(assoc_time_be));
+                tmp += sizeof(assoc_time_be);
+            }
+            sta = static_cast<dm_sta_t *>(hash_map_get_next(dm->m_sta_map, sta));
+        }
+
+        payload_len += bss_len;
+        bss_count++;
+    }
+
+    if (bss_count == 0) {
+        return 0;
+    }
+
+    value[0] = static_cast<unsigned char>(bss_count);
+    tlv->type = em_tlv_type_associated_clients;
+    tlv->len = htons(static_cast<uint16_t>(payload_len));
+    em_printfout("Created Associated Clients TLV: bss=%u bytes=%u",
+                 bss_count, payload_len);
+    return static_cast<int>(sizeof(em_tlv_t) + payload_len);
+}
