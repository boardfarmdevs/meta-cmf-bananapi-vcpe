 void em_ctrl_t::handle_5s_tick()
 {
-	//handle_client_metrics_req();
+	// A Topology Notification is multicast and has no acknowledgement.  Poll
+	// each synchronized agent every 15 seconds so an Associated Clients TLV can
+	// repair a notification lost anywhere on the controller receive path.
+	static unsigned int reconciliation_tick = 0;
+	if (++reconciliation_tick % 3 != 0) {
+		return;
+	}
+
+	std::set<std::string> queried_agents;
+	dm_easy_mesh_t *dm = m_data_model.get_first_dm();
+	while (dm != NULL) {
+		const std::string al_mac = util::mac_to_string(
+				dm->get_agent_al_interface_mac());
+		if (queried_agents.insert(al_mac).second) {
+			std::vector<em_t *> radios;
+			get_all_em_for_al_mac(dm->get_agent_al_interface_mac(), radios);
+			auto query_radio = std::find_if(radios.begin(), radios.end(),
+					[](em_t *radio) {
+						return radio->get_service_type() == em_service_type_ctrl &&
+							radio->get_state() >= em_state_ctrl_topo_synchronized;
+					});
+			if (query_radio != radios.end()) {
+				static_cast<em_configuration_t *>(*query_radio)->send_topology_query_msg();
+			}
+		}
+		dm = m_data_model.get_next_dm(dm);
+	}
 }
 
