+int em_configuration_t::handle_topology_response_clients(unsigned char *buff,
+                                                          unsigned int len)
+{
+    const unsigned int header_len = sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t);
+    dm_easy_mesh_t *dm = get_data_model();
+    unsigned int added = 0;
+
+    if (dm == NULL || len < header_len + sizeof(em_tlv_t)) {
+        return -1;
+    }
+
+    unsigned char *cursor = buff + header_len;
+    unsigned int remaining = len - header_len;
+    while (remaining >= sizeof(em_tlv_t)) {
+        em_tlv_t *tlv = reinterpret_cast<em_tlv_t *>(cursor);
+        unsigned int value_len = ntohs(tlv->len);
+        unsigned int total_len = sizeof(em_tlv_t) + value_len;
+
+        if (total_len > remaining) {
+            em_printfout("Malformed Topology Response TLV while reconciling clients");
+            return -1;
+        }
+        if (tlv->type == em_tlv_type_eom) {
+            break;
+        }
+        if (tlv->type != em_tlv_type_associated_clients) {
+            cursor += total_len;
+            remaining -= total_len;
+            continue;
+        }
+        if (value_len < 1) {
+            return -1;
+        }
+
+        unsigned char *value = tlv->value;
+        unsigned int value_remaining = value_len - 1;
+        unsigned int bss_count = value[0];
+        value++;
+        for (unsigned int b = 0; b < bss_count; b++) {
+            if (value_remaining < sizeof(bssid_t) + sizeof(uint16_t)) {
+                return -1;
+            }
+
+            bssid_t bssid;
+            memcpy(bssid, value, sizeof(bssid));
+            value += sizeof(bssid);
+            uint16_t sta_count_be;
+            memcpy(&sta_count_be, value, sizeof(sta_count_be));
+            value += sizeof(sta_count_be);
+            value_remaining -= sizeof(bssid_t) + sizeof(uint16_t);
+            unsigned int sta_count = ntohs(sta_count_be);
+
+            em_bss_info_t *bss_info = dm->get_bss_info_with_mac(bssid);
+            for (unsigned int s = 0; s < sta_count; s++) {
+                if (value_remaining < sizeof(mac_address_t) + sizeof(uint16_t)) {
+                    return -1;
+                }
+
+                em_sta_info_t sta_info = {};
+                memcpy(sta_info.id, value, sizeof(mac_address_t));
+                value += sizeof(mac_address_t) + sizeof(uint16_t);
+                value_remaining -= sizeof(mac_address_t) + sizeof(uint16_t);
+                if (bss_info == NULL) {
+                    continue;
+                }
+
+                memcpy(sta_info.bssid, bssid, sizeof(bssid_t));
+                memcpy(sta_info.radiomac, bss_info->ruid.mac, sizeof(mac_address_t));
+                sta_info.associated = true;
+                if (dm->get_sta_info(sta_info.id, sta_info.bssid, sta_info.radiomac,
+                                     em_target_sta_map_consolidated) != NULL) {
+                    continue;
+                }
+
+                mac_addr_str_t sta_str, bss_str, radio_str;
+                em_2xlong_string_t key;
+                dm_easy_mesh_t::macbytes_to_string(sta_info.id, sta_str);
+                dm_easy_mesh_t::macbytes_to_string(sta_info.bssid, bss_str);
+                dm_easy_mesh_t::macbytes_to_string(sta_info.radiomac, radio_str);
+                snprintf(key, sizeof(key), "%s@%s@%s", sta_str, bss_str, radio_str);
+                if (hash_map_get(dm->m_sta_assoc_map, key) == NULL) {
+                    hash_map_put(dm->m_sta_assoc_map, strdup(key), new dm_sta_t(&sta_info));
+                    added++;
+                }
+            }
+        }
+
+        if (value_remaining != 0) {
+            em_printfout("Malformed Associated Clients TLV trailing bytes=%u",
+                         value_remaining);
+            return -1;
+        }
+        if (added != 0) {
+            dm->set_db_cfg_param(db_cfg_type_sta_list_update, "");
+            em_printfout("Topology Response reconciled %u client association(s)", added);
+        }
+        return static_cast<int>(added);
+    }
+    return 0;
+}
