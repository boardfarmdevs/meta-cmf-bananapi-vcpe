+bool em_t::join(unsigned int timeout_ms)
+{
+    struct timespec deadline;
+
+    if (m_thread_started == false) {
+        return true;
+    }
+    if (m_thread_joinable == false) {
+        return false;
+    }
+    clock_gettime(CLOCK_REALTIME, &deadline);
+    deadline.tv_sec += static_cast<time_t>(timeout_ms / 1000);
+    deadline.tv_nsec += static_cast<long>(timeout_ms % 1000) * 1000000L;
+    if (deadline.tv_nsec >= 1000000000L) {
+        deadline.tv_sec++;
+        deadline.tv_nsec -= 1000000000L;
+    }
+    if (pthread_timedjoin_np(m_tid, NULL, &deadline) == 0) {
+        m_thread_joinable = false;
+        m_thread_started = false;
+        return true;
+    }
+    detach();
+    return false;
+}
+
+void em_t::detach()
+{
+    if (m_thread_joinable == true) {
+        pthread_detach(m_tid);
+        m_thread_joinable = false;
+    }
