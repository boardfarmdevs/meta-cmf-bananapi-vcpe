+/* 0280: delete_node while the node's thread still handles what was queued to it: delete_node
+ * returns once the thread ended and the node is freed, so nothing touches it after (ASan). Fifty
+ * rounds of two hundred queued frames. */
+TEST_F(em_ctrl_t_Test, delete_node_while_its_thread_is_busy)
+{
+    dm_easy_mesh_t dm;
+    const size_t frame_len = sizeof(em_raw_hdr_t) + sizeof(em_cmdu_t);
+
+    for (unsigned int round = 0; round < 50; round++) {
+        em_interface_t ruid = {};
+        const unsigned char mac[6] = {0x02, 0x00, 0x00, 0x28, 0x00, static_cast<unsigned char>(round)};
+        mac_addr_str_t mac_str;
+
+        setup_interface(ruid, "busy", mac);
+        ruid.media = em_media_type_ieee80211ac_5;
+        em_t *node = ctrl.create_node(&ruid, em_freq_band_5, &dm, false, em_profile_type_3, em_service_type_agent);
+        ASSERT_NE(node, nullptr);
+        for (unsigned int i = 0; i < 200; i++) {
+            em_event_t *evt = static_cast<em_event_t *>(calloc(1, sizeof(em_event_t)));
+            ASSERT_NE(evt, nullptr);
+            evt->type = em_event_type_frame;
+            evt->u.fevt.frame = static_cast<unsigned char *>(calloc(1, frame_len));
+            ASSERT_NE(evt->u.fevt.frame, nullptr);
+            // a message type no handler takes: the thread frees the frame and goes on
+            reinterpret_cast<em_cmdu_t *>(evt->u.fevt.frame + sizeof(em_raw_hdr_t))->type = htons(0x7fff);
+            evt->u.fevt.frame_len = static_cast<unsigned int>(frame_len);
+            node->push_to_queue(evt);
+        }
+        ctrl.delete_node(&ruid);
+        dm_easy_mesh_t::macbytes_to_string(ruid.mac, mac_str);
+        EXPECT_EQ(hash_map_get(ctrl.m_em_map, mac_str), nullptr);
+    }
+}
+
+/* 0280: with the nodes listener running, delete_node frees the node only after the listener's
+ * next pass (the listener may hold a node it found in the map before the node left it); with no
+ * listener it waits for none. */
+TEST_F(em_ctrl_t_Test, delete_node_waits_for_a_listener_pass)
+{
+    using steady_clock = std::chrono::steady_clock;
+    dm_easy_mesh_t dm;
+    em_interface_t ruid = {};
+    const unsigned char mac[6] = {0x02, 0x00, 0x00, 0x28, 0x01, 0x01};
+    mac_addr_str_t mac_str;
+
+    setup_interface(ruid, "pass", mac);
+    ruid.media = em_media_type_ieee80211ac_5;
+    dm_easy_mesh_t::macbytes_to_string(ruid.mac, mac_str);
+
+    ASSERT_NE(ctrl.create_node(&ruid, em_freq_band_5, &dm, false, em_profile_type_3, em_service_type_agent), nullptr);
+    ctrl.set_nodes_listening(true);
+    std::thread listener([this]() {
+        std::this_thread::sleep_for(std::chrono::milliseconds(300));
+        ctrl.note_listener_pass();
+    });
+    auto start = steady_clock::now();
+    ctrl.delete_node(&ruid);
+    const long waited_ms = static_cast<long>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(steady_clock::now() - start).count());
+    listener.join();
+    ctrl.set_nodes_listening(false);
+    EXPECT_GE(waited_ms, 250);
+    EXPECT_LT(waited_ms, EM_NODE_JOIN_MS);
+    EXPECT_EQ(hash_map_get(ctrl.m_em_map, mac_str), nullptr);
+
+    ASSERT_NE(ctrl.create_node(&ruid, em_freq_band_5, &dm, false, em_profile_type_3, em_service_type_agent), nullptr);
+    start = steady_clock::now();
+    ctrl.delete_node(&ruid);
+    EXPECT_LT(static_cast<long>(
+        std::chrono::duration_cast<std::chrono::milliseconds>(steady_clock::now() - start).count()), 1000);
+    EXPECT_EQ(hash_map_get(ctrl.m_em_map, mac_str), nullptr);
+}
+
+/* 0280: the main thread deletes and recreates nodes while another thread walks and looks up the
+ * map through the manager's helpers, as the nodes listener and the nodes' threads do: no read of
+ * a map element the main thread freed (ASan). A hundred rounds of four nodes. */
+TEST_F(em_ctrl_t_Test, map_read_by_another_thread_while_nodes_come_and_go)
+{
+    dm_easy_mesh_t dm;
+    std::atomic<bool> done(false);
+    std::atomic<unsigned long> reads(0);
+    unsigned int failed = 0;
+
+    std::thread reader([this, &done, &reads]() {
+        mac_address_t al = {0x02, 0x00, 0x00, 0x28, 0x02, 0x00};
+        em_freq_band_t band = em_freq_band_5;
+        while (done.load() == false) {
+            std::vector<em_t *> radios;
+            ctrl.get_all_em_for_al_mac(al, radios);
+            (void)ctrl.get_node_by_freq_band(&band);
+            (void)ctrl.get_al_node();
+            (void)ctrl.find_node("02:00:00:28:02:03");
+            (void)ctrl.get_nodes();
+            reads++;
+        }
+    });
+    for (unsigned int round = 0; round < 100; round++) {
+        em_interface_t ruid[4] = {};
+        for (unsigned int i = 0; i < 4; i++) {
+            const unsigned char mac[6] = {0x02, 0x00, 0x00, 0x28, 0x02, static_cast<unsigned char>(i)};
+            setup_interface(ruid[i], "churn", mac);
+            ruid[i].media = em_media_type_ieee80211ac_5;
+            if (ctrl.create_node(&ruid[i], em_freq_band_5, &dm, false, em_profile_type_3, em_service_type_agent) == nullptr) {
+                failed++;
+            }
+        }
+        for (unsigned int i = 0; i < 4; i++) {
+            ctrl.delete_node(&ruid[i]);
+        }
+    }
+    done = true;
+    reader.join();
+    EXPECT_EQ(failed, 0U);
+    EXPECT_GT(reads.load(), 0UL);
+    EXPECT_TRUE(ctrl.get_nodes().empty());
+}
