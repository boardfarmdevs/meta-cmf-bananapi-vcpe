 #include <stdio.h>
 #include <string>
 #include <vector>
+#include <chrono>
+#include <thread>
 #include "em_ctrl.h"
 
 class em_ctrl_t_Test : public ::testing::Test {
@@ -4253,3 +4255,76 @@ TEST_F(em_ctrl_t_de_getters, StaMldRowsAreThoseOfTheirApMld) {
     a->m_num_assoc_sta_mld = 0;
