+void em_mgr_t::free_nodes(std::vector<em_t *> &ems)
+{
+    using steady_clock = std::chrono::steady_clock;
+    const auto deadline = steady_clock::now() + std::chrono::milliseconds(EM_NODE_JOIN_MS);
+    std::vector<em_t *> ended;
+    bool passed = true;
 
+    for (em_t *em : ems) {
+        em->stop();
+    }
+    // a thread ends once it handled what was queued to it: one deadline for them all
+    for (em_t *em : ems) {
+        const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - steady_clock::now());
+        if (em->join(left.count() > 0 ? static_cast<unsigned int>(left.count()) : 0) == true) {
+            ended.push_back(em);
+        } else {
+            em_printfout("Node %s: its thread did not end in %d ms; kept, not freed",
+                util::mac_to_string(em->get_radio_interface_mac()).c_str(), EM_NODE_JOIN_MS);
+        }
+    }
+    if (ended.empty()) {
+        return;
+    }
+    // the nodes listener may hold one of them, found in the map before it was unlinked: free them
+    // after its next pass
+    pthread_mutex_lock(&m_listen_lock);
+    if (m_nodes_listening == true) {
+        const unsigned long start = m_listen_passes;
+        while (m_nodes_listening == true && m_listen_passes == start) {
+            struct timespec until;
+            const auto left = std::chrono::duration_cast<std::chrono::milliseconds>(deadline - steady_clock::now());
+            if (left.count() <= 0) {
+                passed = false;
+                break;
+            }
+            clock_gettime(CLOCK_REALTIME, &until);
+            util::add_milliseconds(&until, static_cast<long>(left.count()));
+            pthread_cond_timedwait(&m_listen_cond, &m_listen_lock, &until);
+        }
+    }
+    pthread_mutex_unlock(&m_listen_lock);
+    if (passed == false) {
+        em_printfout("%zu nodes: no pass of the nodes listener in %d ms; kept, not freed", ended.size(),
+            EM_NODE_JOIN_MS);
+        return;
+    }
+    // each other node's thread may hold one of them too: free them after each of those threads
+    // passed once (woken, an idle thread passes at once)
+    std::vector<std::pair<em_t *, unsigned long>> others;
+    for (em_t *em : get_nodes()) {
+        if (em->is_thread_running() == true) {
+            others.emplace_back(em, em->get_passes());
+            em->wake();
+        }
+    }
+    while (true) {
+        others.erase(std::remove_if(others.begin(), others.end(),
+            [](const std::pair<em_t *, unsigned long> &other) { return other.first->get_passes() != other.second; }),
+            others.end());
+        if (others.empty() == true) {
+            break;
+        }
+        if (steady_clock::now() >= deadline) {
+            em_printfout("%zu nodes: %zu other nodes' threads made no pass in %d ms; kept, not freed", ended.size(),
+                others.size(), EM_NODE_JOIN_MS);
+            return;
+        }
+        std::this_thread::sleep_for(std::chrono::milliseconds(5));
+    }
+    for (em_t *em : ended) {
+        em->deinit();
+        delete em;
+    }
+}
