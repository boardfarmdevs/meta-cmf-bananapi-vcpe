+
+func TestResolveTopologyWirelessParentsFromUniqueAPBSSID(t *testing.T) {
+	edges := []map[string]interface{}{
+		{"from": "agent", "to": "extender-1", "mediaType": "Wireless LAN",
+			"upstreamBSSID": "02:00:00:00:00:10", "band": -1, "channel": 0},
+		{"from": "agent", "to": "extender-2", "mediaType": "Wireless LAN",
+			"upstreamBSSID": "02:00:00:00:00:20", "band": 1, "channel": 0},
+		{"from": "controller", "to": "agent", "mediaType": "Ethernet",
+			"upstreamBSSID": "00:00:00:00:00:00", "band": -1, "channel": 0},
+	}
+	owners := []topologyAPOwner{
+		{DeviceID: "AGENT", BSSID: "02:00:00:00:00:10", Band: 1, Channel: 36},
+		{DeviceID: "EXTENDER-1", BSSID: "02:00:00:00:00:20", Band: 3, Channel: 1},
+		// A backhaul STA row must never be supplied by the inventory adapter;
+		// this synthetic duplicate proves the resolver itself remains bounded
+		// if an ambiguous owner reaches it.
+		{DeviceID: "extender-3", BSSID: "02:00:00:00:00:30", Band: 1, Channel: 36},
+		{DeviceID: "extender-4", BSSID: "02:00:00:00:00:30", Band: 1, Channel: 36},
+	}
+
+	if got := resolveTopologyWirelessParents(edges, owners); got != 2 {
+		t.Fatalf("resolved %d edges, want 2", got)
+	}
+	if edges[0]["from"] != "agent" || edges[0]["band"] != 1 || edges[0]["channel"] != 36 {
+		t.Fatalf("direct extender edge was not resolved to agent AP: %+v", edges[0])
+	}
+	if edges[1]["from"] != "extender-1" || edges[1]["band"] != 3 || edges[1]["channel"] != 1 {
+		t.Fatalf("multihop edge was not resolved to extender AP: %+v", edges[1])
+	}
+	if edges[2]["from"] != "controller" {
+		t.Fatalf("Ethernet edge was rewritten: %+v", edges[2])
+	}
+
+	ambiguous := []map[string]interface{}{{
+		"from": "agent", "to": "extender-5", "mediaType": "Wireless LAN",
+		"upstreamBSSID": "02:00:00:00:00:30", "band": 1, "channel": 36,
+	}}
+	if got := resolveTopologyWirelessParents(ambiguous, owners); got != 0 ||
+		ambiguous[0]["from"] != "agent" {
+		t.Fatalf("ambiguous BSSID invented a parent: %+v", ambiguous[0])
+	}
+}
