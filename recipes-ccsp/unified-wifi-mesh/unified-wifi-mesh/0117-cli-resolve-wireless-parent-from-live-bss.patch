 src/rdkb-cli/backhaul_signal_test.go | 42 +++++++++++++++++++++
 src/rdkb-cli/main.go                 | 24 ++++++++++++
 3 files changed, 122 insertions(+)

diff --git a/src/rdkb-cli/backhaul_signal.go b/src/rdkb-cli/backhaul_signal.go
--- a/src/rdkb-cli/backhaul_signal.go
+++ b/src/rdkb-cli/backhaul_signal.go
@@ -50,6 +50,62 @@ type BackhaulSignal struct {
 	AgeSeconds *int64 `json:"age_seconds,omitempty"`
 }
 
+// topologyAPOwner is the minimal live BSS inventory needed to turn a
+// wireless edge's upstream BSSID into its actual data-plane parent.  The
+// controller transport tree can remain a star in the container lab because
+// IEEE 1905 also has a shared sideband L2 path.
+type topologyAPOwner struct {
+	DeviceID string
+	BSSID    string
+	Band     int
+	Channel  int
+}
+
+// resolveTopologyWirelessParents rewrites only uniquely owned wireless
+// edges. Missing, self-owned and ambiguous BSSIDs retain the controller's
+// original edge, so an incomplete inventory cannot invent a topology.
+func resolveTopologyWirelessParents(edges []map[string]interface{}, candidates []topologyAPOwner) int {
+	owners := make(map[string]topologyAPOwner)
+	ambiguous := make(map[string]bool)
+	for _, candidate := range candidates {
+		candidate.DeviceID = strings.ToLower(strings.TrimSpace(candidate.DeviceID))
+		candidate.BSSID = strings.ToLower(strings.TrimSpace(candidate.BSSID))
+		if candidate.DeviceID == "" || candidate.BSSID == "" ||
+			candidate.BSSID == "00:00:00:00:00:00" {
+			continue
+		}
+		if previous, found := owners[candidate.BSSID]; found &&
+			previous.DeviceID != candidate.DeviceID {
+			ambiguous[candidate.BSSID] = true
+			continue
+		}
+		owners[candidate.BSSID] = candidate
+	}
+
+	resolved := 0
+	for _, edge := range edges {
+		mediaType, _ := edge["mediaType"].(string)
+		if strings.EqualFold(strings.TrimSpace(mediaType), "Ethernet") {
+			continue
+		}
+		upstreamBSSID, _ := edge["upstreamBSSID"].(string)
+		upstreamBSSID = strings.ToLower(strings.TrimSpace(upstreamBSSID))
+		owner, found := owners[upstreamBSSID]
+		if !found || ambiguous[upstreamBSSID] {
+			continue
+		}
+		childID, _ := edge["to"].(string)
+		if owner.DeviceID == strings.ToLower(strings.TrimSpace(childID)) {
+			continue
+		}
+		edge["from"] = owner.DeviceID
+		edge["band"] = owner.Band
+		edge["channel"] = owner.Channel
+		resolved++
+	}
+	return resolved
+}
