     }
 
     traverse(topoDeviceTree, 0, 0, 0, 0)
+	resolveTopologyWirelessParents(edges, topologyAPOwnersFromInventory(radioInventory))
     overlayLiveTopologyClients(nodes)
 
     // Send the response to frontend
@@ -5278,6 +5279,29 @@ func getBandAndChannelForBSSID(radios []Radio, bssid string) (int, int) {
     return -1, 0
 }
 
+// topologyAPOwnersFromInventory deliberately accepts AP BSS rows only.
+// Backhaul STA rows repeat their upstream BSSID in each child and therefore
+// cannot identify the owner of that BSSID.
+func topologyAPOwnersFromInventory(inventory map[string][]Radio) []topologyAPOwner {
+	owners := make([]topologyAPOwner, 0)
+	for deviceID, radios := range inventory {
+		for _, radio := range radios {
+			for _, bss := range radio.BSSList {
+				if bss.VapMode != 0 {
+					continue
+				}
+				owners = append(owners, topologyAPOwner{
+					DeviceID: deviceID,
+					BSSID:    bss.BSSID,
+					Band:     radio.Band,
+					Channel:  radio.Channel,
+				})
+			}
+		}
+	}
+	return owners
+}
+
 // loadLocalRadioChannels reads the colocated Agent's actual kernel radio
 // state. EasyMesh Operating Channel Reports remain the primary source; this
 // bounded cache fills the startup gap before the Controller has received one.
