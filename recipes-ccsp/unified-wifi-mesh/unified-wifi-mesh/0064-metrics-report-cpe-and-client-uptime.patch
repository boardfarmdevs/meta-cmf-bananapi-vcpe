+short em_metrics_t::create_device_uptime_tlv(unsigned char *buff)
+{
+    em_vendor_specific_t *vendor_metrics = reinterpret_cast<em_vendor_specific_t *>(buff);
+    em_vendor_data_t *vendor_data = vendor_metrics->data;
+    em_device_uptime_t *uptime = reinterpret_cast<em_device_uptime_t *>(vendor_data->vendor_data);
+    struct timespec now = {};
+    if (clock_gettime(CLOCK_BOOTTIME, &now) != 0 || now.tv_sec < 0) {
+        return -1;
+    }
+
+    FILE *stat_file = fopen("/proc/1/stat", "r");
+    if (stat_file == nullptr) {
+        return -1;
+    }
+    char line[2048] = {};
+    if (fgets(line, sizeof(line), stat_file) == nullptr) {
+        fclose(stat_file);
+        return -1;
+    }
+    fclose(stat_file);
+
+    /* The command name is parenthesized and may contain spaces.  Field 22,
+     * starttime, is token 19 after the final closing parenthesis. */
+    char *close_paren = strrchr(line, ')');
+    if (close_paren == nullptr) {
+        return -1;
+    }
+    char *saveptr = nullptr;
+    char *token = strtok_r(close_paren + 1, " \n", &saveptr);
+    unsigned int field = 3;
+    uint64_t start_ticks = 0;
+    while (token != nullptr) {
+        if (field == 22) {
+            char *end = nullptr;
+            start_ticks = strtoull(token, &end, 10);
+            if (end == token) {
+                return -1;
+            }
+            break;
+        }
+        field++;
+        token = strtok_r(nullptr, " \n", &saveptr);
+    }
+
+    const long ticks_per_second = sysconf(_SC_CLK_TCK);
+    if (start_ticks == 0 || ticks_per_second <= 0) {
+        return -1;
+    }
+    const uint64_t now_ticks = static_cast<uint64_t>(now.tv_sec) *
+        static_cast<uint64_t>(ticks_per_second) +
+        (static_cast<uint64_t>(now.tv_nsec) * static_cast<uint64_t>(ticks_per_second)) /
+            1000000000ULL;
+    if (now_ticks < start_ticks) {
+        return -1;
+    }
+    uint64_t seconds = (now_ticks - start_ticks) /
+        static_cast<uint64_t>(ticks_per_second);
+    if (seconds > 0xffffffffULL) {
