+int em_metrics_t::handle_device_uptime_tlv(unsigned char *buff, unsigned int len)
+{
+    em_vendor_specific_t *vendor_metrics = reinterpret_cast<em_vendor_specific_t *>(buff);
+    em_vendor_data_t *vendor_data = vendor_metrics->data;
+    em_device_uptime_t *uptime = reinterpret_cast<em_device_uptime_t *>(vendor_data->vendor_data);
+    const size_t required = sizeof(em_vendor_specific_t) + sizeof(em_vendor_data_t) +
+        sizeof(em_device_uptime_t);
+
+    if (len < required) {
+        return -1;
+    }
+
+    const uint64_t reported_uptime = ntohl(uptime->uptime_seconds);
+    const time_t now = time(NULL);
+    if (reported_uptime == 0 || now <= 0 || reported_uptime > static_cast<uint64_t>(now)) {
+        return -1;
+    }
+
+    dm_easy_mesh_t *dm = get_data_model();
+    const uint64_t candidate = static_cast<uint64_t>(now) - reported_uptime;
+    const uint64_t current = dm->m_device.m_device_info.boot_time_epoch;
+    const uint64_t difference = (candidate > current) ? candidate - current : current - candidate;
+
+    /* Report transit and integer rounding can move the estimate by a second.
+     * Persist only the first estimate or an actual reboot-sized change. */
+    if (current == 0 || difference > 10) {
+        dm->m_device.m_device_info.boot_time_epoch = candidate;
+        dm->set_db_cfg_param(db_cfg_type_device_list_update, "");
+    }
+
+    return 0;
+}
+
+int em_metrics_t::handle_metrics_vendor_tlv(unsigned char *buff, unsigned int len)
+{
+    const size_t header_len = sizeof(em_vendor_specific_t) + sizeof(em_vendor_data_t);
+    if (buff == NULL || len < header_len) {
+        return -1;
+    }
+
+    em_vendor_specific_t *vendor_metrics = reinterpret_cast<em_vendor_specific_t *>(buff);
+    if (memcmp(vendor_metrics->vendor_oui, em_vendor_oui, sizeof(em_vendor_oui)) != 0 ||
+            vendor_metrics->num != 1) {
+        return 0;
+    }
+
+    switch (vendor_metrics->data->attr_id) {
+        case vendor_ext_attr_id_client_type:
+            return handle_assoc_sta_vendor_link_metrics_tlv(buff, len);
+        case vendor_ext_attr_id_device_uptime:
+            return handle_device_uptime_tlv(buff, len);
+        default:
+            return 0;
+    }
+}
