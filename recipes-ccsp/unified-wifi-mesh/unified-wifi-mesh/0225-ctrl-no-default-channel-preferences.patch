+// An anticipated channel preference earlier builds stored for every device
+// (the removed defaults of dm_easy_mesh_list_t::create_data_model)
+static bool is_former_default_preference(const em_op_class_info_t& info)
+{
+    static const unsigned int defaults[][2] = {{83, 6}, {128, 42}, {135, 7}};
+
+    if ((info.id.type != em_op_class_type_anticipated) || (info.num_channels != 1) ||
+            (info.channel_pref[0] != 0xe0)) {
+        return false;
+    }
+    for (const auto &preference : defaults) {
+        if ((info.op_class == preference[0]) && (info.channels[0] == preference[1])) {
+            return true;
+        }
+    }
+    return false;
+}
+
