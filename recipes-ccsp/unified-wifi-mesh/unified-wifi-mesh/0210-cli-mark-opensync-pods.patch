 			Status: "Online", LastSeen: observedAt, Uptime: uptimeText,
 			Signal: legacySignal, BackhaulSignal: deviceSignal,
 			BackhaulType: backhaulMedia,
@@ -5290,9 +5294,13 @@
             y = parentY + float32(currentLength)*float32(math.Sin(theta))
         }
 
+        manufacturer, model, kind := deviceIdentity(deviceNode, depth)
         nodes = append(nodes, map[string]interface{}{
             "id":     deviceID,
             "name":   deviceName,
+            "manufacturer": manufacturer,
+            "model":  model,
+            "kind":   kind,
             "haulTypes":  haulTypes,
             "x":      x,
             "y":      y,
@@ -7387,6 +7395,24 @@
  * Description: helper function to get value for respective key
  * Return: value of key in String format.
  */
+// deviceIdentity is who an agent says it is in its M1 (the controller's
+// Manufacturer and ManufacturerModel). An OpenSync pod onboarded through the
+// EMOSA adapter names itself "OpenSync via EMOSA"; the UI draws its kind apart.
+// The controller's own record takes the last M1 it processed, so the root
+// (depth 0) is always the controller and never classified by it.
+func deviceIdentity(deviceNode *C.em_network_node_t, depth int) (manufacturer, model, kind string) {
+    if depth == 0 {
+        return "", "", "controller"
+    }
+    manufacturer = getTreeValue(deviceNode, "Manufacturer")
+    model = getTreeValue(deviceNode, "ManufacturerModel")
+    kind = "easymesh"
+    if strings.HasPrefix(manufacturer, "OpenSync") {
+        kind = "opensync-pod"
+    }
+    return manufacturer, model, kind
+}
+
