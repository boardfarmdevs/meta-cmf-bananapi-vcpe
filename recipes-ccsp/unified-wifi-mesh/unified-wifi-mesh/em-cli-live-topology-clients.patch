+// overlayLiveTopologyClients makes the topology graph and /clients consume the
+// same authoritative ownership snapshot. The older topology traversal performs
+// a separate libemcli tree walk and can omit stations from some device nodes
+// even while the controller STAList and /clients contain them. Keep the graph's
+// device/radio/haul layout, but replace every node's station list atomically
+// from the live client result. On a transient controller read failure, use the
+// last successful live snapshot rather than reintroducing a partial graph.
+func overlayLiveTopologyClients(nodes []map[string]interface{}) {
+	_, liveClients, err := buildLiveDevicesClients()
+	if err != nil {
+		liveCacheMu.Lock()
+		if haveLiveCache {
+			liveClients = append([]Client(nil), cachedClients...)
+		}
+		haveCache := haveLiveCache
+		liveCacheMu.Unlock()
+		if !haveCache {
+			log.Printf("topology client overlay: live fetch failed: %v", err)
+			return
+		}
+		log.Printf("topology client overlay: live fetch failed (%v), using last-known-good", err)
+	}
+
+	clientsByDevice := make(map[string][]map[string]interface{})
+	for _, client := range liveClients {
+		clientsByDevice[client.ConnectedAP] = append(
+			clientsByDevice[client.ConnectedAP],
+			map[string]interface{}{
+				"staMAC":     client.MAC,
+				"clientType": client.DeviceType,
+				"MLDAddr":    client.TopologyMLDAddr,
+				"band":       client.TopologyBand,
+				"ssid":       client.TopologySSID,
+			},
+		)
+	}
+
+	for _, node := range nodes {
+		deviceID, _ := node["id"].(string)
+		staList := clientsByDevice[deviceID]
+		if staList == nil {
+			staList = []map[string]interface{}{}
+		}
+		node["STAList"] = staList
+	}
+}
