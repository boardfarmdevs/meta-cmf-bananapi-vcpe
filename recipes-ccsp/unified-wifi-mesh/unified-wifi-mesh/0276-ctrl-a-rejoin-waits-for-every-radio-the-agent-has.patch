+bool em_ctrl_t::counts_as_agent_activity(unsigned short msg_type, bool neighbor_only)
+{
+	/* A neighbor-only Topology Notification (no BSS: a 1905 neighbor gone or come) names the
+	 * agent whose neighbors changed; the controller's own 1905 neighbor ageing raises one for a
+	 * departed agent some 60 s after its last frame (a hardware bench, 21 October: one for each
+	 * extender, and one for an extender whose frames ebtables dropped). It is not a frame of
+	 * that agent's own: counted, it reset the departed agent's silence and its retirement came
+	 * some 240 s after its last frame, not 180 s. handle_topology_change answers it with a
+	 * Topology Query, whose response, if the agent is there, is its activity. */
+	return !(msg_type == em_msg_type_topo_notif && neighbor_only);
+}
+
+em_ctrl_t::radio_set_t em_ctrl_t::rejoin_missing_radios(const radio_set_t &snapshot, bool listed_known,
+	const std::vector<std::string> &listed, const radio_set_t &model,
+	const std::function<bool(const std::string &)> &wsc_done)
+{
+	/* expected: the radios at its retirement and those it lists now. One of the former is left
+	 * out only when the last response no longer lists it at all: a radio listed with no BSS
+	 * (redoing WSC, its configuration failed) is still waited for, and the slow retry bounds the
+	 * wait for one really gone. */
+	radio_set_t expected;
+	auto is_listed = [&](const std::string &ruid) {
+		for (auto &l : listed) {
+			if (l == ruid) {
+				return true;
+			}
+		}
+		return false;
+	};
+	for (auto &snap : snapshot) {
+		if (!listed_known || is_listed(snap.first)) {
+			expected.push_back(snap);
+		}
+	}
+	for (auto &ruid : listed) {
+		bool in = false;
+		for (auto &e : expected) {
+			in = in || e.first == ruid;
+		}
+		if (in) {
+			continue;
+		}
+		/* a radio it did not have at its retirement: its band from the model if it has it (else
+		 * unknown: the default bands are renewed for it) */
+		unsigned int band = em_freq_band_unknown;
+		for (auto &m : model) {
+			if (m.first == ruid) {
+				band = m.second;
+			}
+		}
+		expected.emplace_back(ruid, band);
+	}
+	/* missing: expected and not back, by RUID */
+	radio_set_t missing;
+	for (auto &e : expected) {
+		bool have = false;
+		for (auto &m : model) {
+			have = have || m.first == e.first;
+		}
+		if (!have || !wsc_done(e.first)) {
+			missing.push_back(e);
+		}
+	}
+	return missing;
+}
+
+unsigned int em_ctrl_t::rejoin_plan_renew(retired_agent_t &r, unsigned int missing_bands,
+	std::chrono::steady_clock::time_point now, bool *slow_log)
+{
+	/* The bands to renew now. A Renew names one band (its SupportedFreqBand TLV): an RDK agent
+	 * sends that band's radio's M1 only, a Multi-AP 7.1 agent every radio's. So one Renew first,
+	 * and EM_AGENT_REJOIN_SETTLE later: every radio back, done (the caller); that band's alone,
+	 * the other missing bands' Renews at once; none, every missing band's. Then per band up to
+	 * EM_AGENT_REJOIN_RENEWS, with the back-off; then, a live agent never given up on, a Renew per
+	 * missing band every EM_AGENT_REJOIN_SLOW, logged the first and every sixth time. The caller
+	 * counts the renews sent (r.renewed, r.renews). A Renew can also go unanswered for a while: a
+	 * vendor extender (a hardware bench, 21 October, 3 radios) ignored the one that came in the same
+	 * second as its own AP-Autoconfiguration Search and answered the next, 60 s later; the per
+	 * band attempts and their back-off carry it. */
+	unsigned int mask = 0;
+	*slow_log = false;
+	if (r.renews == 0) {
+		unsigned int first = em_freq_band_24;
+		while (first < em_freq_band_unknown && missing_bands != 0 && (missing_bands & (1u << first)) == 0) {
+			first++;
+		}
+		r.first_band = first;
+		mask = (missing_bands != 0) ? (1u << first) : 0;
+		r.adaptive = true;
+		r.next_renew = now + EM_AGENT_REJOIN_SETTLE;
+		return mask;
+	}
+	if (r.adaptive) {
+		r.adaptive = false;
+		r.next_renew = now + EM_AGENT_REJOIN_BACKOFF;
+		return missing_bands;
+	}
+	unsigned int most = 0;
+	for (unsigned int b = em_freq_band_24; b < em_freq_band_unknown; b++) {
+		if ((missing_bands & (1u << b)) != 0 && r.renewed[b] < EM_AGENT_REJOIN_RENEWS) {
+			mask |= 1u << b;
+		}
+		most = (r.renewed[b] > most) ? r.renewed[b] : most;
+	}
+	if (mask == 0 && missing_bands == 0 && r.renewed[em_freq_band_24] < EM_AGENT_REJOIN_RENEWS) {
+		/* no radio known for it (it had none at its retirement): the default bands */
+		r.next_renew = now + EM_AGENT_REJOIN_BACKOFF * (1u << (most < 4 ? most : 4));
+		return 0;
+	}
+	if (mask == 0) {
+		r.slow_retries++;
+		*slow_log = r.slow_retries == 1 || r.slow_retries % EM_AGENT_REJOIN_SLOW_LOG_EVERY == 0;
+		r.next_renew = now + EM_AGENT_REJOIN_SLOW;
+		return missing_bands;
+	}
+	r.next_renew = now + EM_AGENT_REJOIN_BACKOFF * (1u << (most < 4 ? most : 4));
+	return mask;
+}
