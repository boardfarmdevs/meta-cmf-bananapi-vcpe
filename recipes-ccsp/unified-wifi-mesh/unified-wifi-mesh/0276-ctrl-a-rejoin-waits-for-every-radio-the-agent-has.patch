+// 0270's rejoin: the radios a retired agent's rejoin waits for, and its renews.
+namespace {
+const std::string R1 = "02:00:00:00:00:01", R2 = "02:00:00:00:00:02", R3 = "02:00:00:00:00:03";
+const std::string R5A = "02:00:00:00:05:0a", R5B = "02:00:00:00:05:0b", R4 = "02:00:00:00:00:04";
+bool all_done(const std::string &) { return true; }
+
+/* the caller's part of a pass: the bands sent counted (the default bands when the mask is 0) */
+unsigned int plan_pass(em_ctrl_t::retired_agent_t &r, unsigned int missing_bands,
+    std::chrono::steady_clock::time_point now, bool *slow_log)
+{
+    unsigned int mask = em_ctrl_t::rejoin_plan_renew(r, missing_bands, now, slow_log);
+    unsigned int sent = (mask != 0) ? mask : ((1u << em_freq_band_24) | (1u << em_freq_band_5));
+    for (unsigned int b = em_freq_band_24; b < em_freq_band_unknown; b++) {
+        if ((sent & (1u << b)) != 0) {
+            r.renewed[b]++;
+        }
+    }
+    r.renews++;
+    return mask;
+}
+}
+
+TEST(em_ctrl_t_rejoin, MissingBeforeAnyListIsTheSnapshotLessTheRadiosBack) {
+    em_ctrl_t::radio_set_t snapshot = {{R1, em_freq_band_24}, {R2, em_freq_band_5}, {R3, em_freq_band_6}};
+    em_ctrl_t::radio_set_t model = {{R1, em_freq_band_24}};
+    auto missing = em_ctrl_t::rejoin_missing_radios(snapshot, false, {}, model, all_done);
+    ASSERT_EQ(missing.size(), 2u);
+    EXPECT_EQ(missing[0].first, R2);
+    EXPECT_EQ(missing[1].first, R3);
+    EXPECT_EQ(missing[1].second, static_cast<unsigned int>(em_freq_band_6));
+}
+
+TEST(em_ctrl_t_rejoin, RadioInTheModelWithoutItsWscIsStillMissing) {
+    // an AP Capability Report puts every radio in the model by its RUID, without an M1
+    em_ctrl_t::radio_set_t snapshot = {{R1, em_freq_band_24}, {R2, em_freq_band_5}, {R3, em_freq_band_6}};
+    auto missing = em_ctrl_t::rejoin_missing_radios(snapshot, false, {}, snapshot,
+        [](const std::string &ruid) { return ruid == R1; });
+    ASSERT_EQ(missing.size(), 2u);
+    EXPECT_EQ(missing[0].first, R2);
+    EXPECT_EQ(missing[1].first, R3);
+}
+
+TEST(em_ctrl_t_rejoin, RadioListedWithoutBssIsStillWaitedFor) {
+    // listed (with or without a BSS up): still expected, so missing while not back
+    em_ctrl_t::radio_set_t snapshot = {{R1, em_freq_band_24}, {R2, em_freq_band_5}, {R3, em_freq_band_6}};
+    em_ctrl_t::radio_set_t model = {{R1, em_freq_band_24}};
+    auto missing = em_ctrl_t::rejoin_missing_radios(snapshot, true, {R1, R2, R3}, model, all_done);
+    ASSERT_EQ(missing.size(), 2u);
+}
+
+TEST(em_ctrl_t_rejoin, SnapshotRadioNoLongerListedIsLeftOut) {
+    em_ctrl_t::radio_set_t snapshot = {{R1, em_freq_band_24}, {R2, em_freq_band_5}, {R3, em_freq_band_6}};
+    em_ctrl_t::radio_set_t model = {{R1, em_freq_band_24}, {R2, em_freq_band_5}};
+    auto missing = em_ctrl_t::rejoin_missing_radios(snapshot, true, {R1, R2}, model, all_done);
+    EXPECT_TRUE(missing.empty());
+}
+
+TEST(em_ctrl_t_rejoin, NewListedRadioIsExpectedWithItsModelBand) {
+    em_ctrl_t::radio_set_t snapshot = {{R1, em_freq_band_24}};
+    em_ctrl_t::radio_set_t model = {{R1, em_freq_band_24}, {R4, em_freq_band_5}};
+    auto missing = em_ctrl_t::rejoin_missing_radios(snapshot, true, {R1, R4}, model,
+        [](const std::string &ruid) { return ruid == R1; });
+    ASSERT_EQ(missing.size(), 1u);
+    EXPECT_EQ(missing[0].first, R4);
+    EXPECT_EQ(missing[0].second, static_cast<unsigned int>(em_freq_band_5));
+}
+
+TEST(em_ctrl_t_rejoin, TwoRadiosOnOneBandAreMatchedByRuid) {
+    // a tri-band unit's low and high 5 GHz radios: one back does not satisfy both
+    em_ctrl_t::radio_set_t snapshot = {{R5A, em_freq_band_5}, {R5B, em_freq_band_5}};
+    em_ctrl_t::radio_set_t model = {{R5A, em_freq_band_5}};
+    auto missing = em_ctrl_t::rejoin_missing_radios(snapshot, false, {}, model, all_done);
+    ASSERT_EQ(missing.size(), 1u);
+    EXPECT_EQ(missing[0].first, R5B);
+}
+
+TEST(em_ctrl_t_rejoin, OneRenewFirstThenTheOtherMissingBandsAtOnce) {
+    em_ctrl_t::retired_agent_t r;
+    auto now = std::chrono::steady_clock::now();
+    bool slow = false;
+    unsigned int all = (1u << em_freq_band_24) | (1u << em_freq_band_5) | (1u << em_freq_band_6);
+    EXPECT_EQ(plan_pass(r, all, now, &slow), 1u << em_freq_band_24);
+    EXPECT_TRUE(r.adaptive);
+    EXPECT_EQ(r.next_renew, now + std::chrono::seconds(5));
+    // the settle: band 0's radio back alone, so bands 1 and 3 at once
+    unsigned int rest = (1u << em_freq_band_5) | (1u << em_freq_band_6);
+    EXPECT_EQ(plan_pass(r, rest, now, &slow), rest);
+    EXPECT_FALSE(r.adaptive);
+    EXPECT_EQ(r.next_renew, now + std::chrono::seconds(60));
+    EXPECT_FALSE(slow);
+}
+
+TEST(em_ctrl_t_rejoin, PerBandRenewsThenASlowRetryLoggedFirstAndEverySixth) {
+    em_ctrl_t::retired_agent_t r;
+    auto now = std::chrono::steady_clock::now();
+    bool slow = false;
+    unsigned int band5 = 1u << em_freq_band_5;
+    plan_pass(r, band5, now, &slow);    // the first Renew
+    plan_pass(r, band5, now, &slow);    // after the settle
+    plan_pass(r, band5, now, &slow);    // the third for band 1
+    EXPECT_EQ(r.renewed[em_freq_band_5], 3u);
+    std::vector<unsigned int> logged;
+    for (unsigned int i = 1; i <= 12; i++) {
+        EXPECT_EQ(plan_pass(r, band5, now, &slow), band5);
+        EXPECT_EQ(r.next_renew, now + std::chrono::seconds(600));
+        if (slow) {
+            logged.push_back(r.slow_retries);
+        }
+    }
+    ASSERT_EQ(logged.size(), 3u);
+    EXPECT_EQ(logged[0], 1u);
+    EXPECT_EQ(logged[1], 6u);
+    EXPECT_EQ(logged[2], 12u);
+}
+
+TEST(em_ctrl_t_rejoin, NoKnownRadioRenewsTheDefaultBands) {
+    em_ctrl_t::retired_agent_t r;
+    auto now = std::chrono::steady_clock::now();
+    bool slow = false;
+    EXPECT_EQ(plan_pass(r, 0, now, &slow), 0u);
+    EXPECT_EQ(plan_pass(r, 0, now, &slow), 0u);
+    EXPECT_EQ(plan_pass(r, 0, now, &slow), 0u);
+    EXPECT_EQ(r.renewed[em_freq_band_24], 3u);
+    EXPECT_EQ(plan_pass(r, 0, now, &slow), 0u);
+    EXPECT_TRUE(slow);
+}
