+TEST(em_ctrl_t_rejoin, NeighborOnlyTopologyNotificationIsNotItsSendersActivity) {
+    // about an agent (its 1905 neighbors changed), not from it: no liveness, no rejoin start
+    EXPECT_FALSE(em_ctrl_t::counts_as_agent_activity(em_msg_type_topo_notif, true));
+    // a notification with a BSS (a client's association) and every other frame count
+    EXPECT_TRUE(em_ctrl_t::counts_as_agent_activity(em_msg_type_topo_notif, false));
+    EXPECT_TRUE(em_ctrl_t::counts_as_agent_activity(em_msg_type_topo_resp, false));
+    EXPECT_TRUE(em_ctrl_t::counts_as_agent_activity(em_msg_type_topo_disc, false));
+}
