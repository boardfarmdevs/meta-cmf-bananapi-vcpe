+/* OneWifi reports association changes as deltas. For the non-MLO station
+ * records used here, a new Associated=1 record displaces every attribution
+ * for the same station on a different BSS. Run this before update_list():
+ * put_sta() makes the new map state visible, and enforcing afterward loses
+ * the stale objects needed to delete their persistent rows. */
+void dm_sta_list_t::enforce_single_assoc(db_client_t& db_client, dm_sta_t& sta)
+{
+    /* MLO safety gate (review P2 #7): an MLO station legitimately holds
+     * simultaneous associations on multiple links (different BSSIDs under one
+     * MLD MAC), which are NOT stale. The blanket "same STA id, different BSSID
+     * => delete" rule below is only correct for non-MLO records; under MLO it
+     * would delete valid affiliated-link associations. This is deliberately
+     * non-MLO only: an MLO build defines EM_MLO_SUPPORT, which compiles the
+     * enforcement out and MUST replace it with per-MLD/per-link handling
+     * (compare MLD MAC + link, not just STA id + BSSID). */
+#if defined(EM_MLO_SUPPORT)
+    (void)db_client; (void)sta;
+    return;
+#endif
+    dm_sta_t *psta, *stale[32];
+    unsigned int num_stale = 0, i;
+
+    if (sta.m_sta_info.associated == false) {
+        return;
+    }
+
+    psta = get_first_sta();
+    while (psta != NULL) {
+        if ((memcmp(psta->m_sta_info.id, sta.m_sta_info.id, sizeof(mac_address_t)) == 0) &&
+                (memcmp(psta->m_sta_info.bssid, sta.m_sta_info.bssid, sizeof(mac_address_t)) != 0) &&
+                (num_stale < (sizeof(stale)/sizeof(stale[0])))) {
+            stale[num_stale++] = psta;
+        }
+        psta = get_next_sta(psta);
+    }
+
+    for (i = 0; i < num_stale; i++) {
+        dm_sta_t old = *stale[i];
+        update_db(db_client, dm_orch_type_db_delete, old.get_sta_info());
+        update_list(old, dm_orch_type_db_delete);
+    }
+}
