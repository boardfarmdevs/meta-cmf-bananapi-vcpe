+// A radio that is administratively disabled never runs through OneWifi's VAP
+// configuration, so its em_t stays at em_state_agent_unconfigured forever.
+// Callers that wait for "all radios" must skip these or they wait forever.
+static bool is_radio_disabled(em_t *em)
+{
+    dm_easy_mesh_t *dm;
+    dm_radio_t *radio;
+
+    if (em == NULL) {
+        return false;
+    }
+
+    dm = em->get_data_model();
+    if (dm == NULL) {
+        return false;
+    }
+
+    radio = dm->get_radio(em->get_radio_interface_mac());
+    if (radio == NULL) {
+        return false;
+    }
+
+    return (radio->m_radio_info.enabled == false);
+}
