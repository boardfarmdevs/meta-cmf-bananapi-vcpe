+static long unassoc_query_elapsed_ms(const struct timespec &since)
+{
+    struct timespec now;
+    clock_gettime(CLOCK_MONOTONIC, &now);
+    return static_cast<long>(now.tv_sec - since.tv_sec) * 1000L +
+        static_cast<long>(now.tv_nsec - since.tv_nsec) / 1000000L;
+}
+
+/* The resends of an unanswered query, after its first send: a lost query is answered within the
+ * CLI's 8 s candidate wait, before the command's 10 s time limit. */
+static bool unassoc_query_resend_due(long elapsed_ms, unsigned int resends)
+{
+    static const long due_ms[] = {2000, 4500};
+    return resends < sizeof(due_ms) / sizeof(due_ms[0]) && elapsed_ms >= due_ms[resends];
+}
+
+void em_metrics_t::resend_unassoc_sta_query_if_due()
+{
+    em_t *em = static_cast<em_t *>(this);
+
+    if (m_unassoc_sta_query_msg_id == 0 || m_unassoc_sta_query_frame.empty() ||
+        em->get_state() != em_state_ctrl_unassoc_sta_link_metrics_pending) {
+        return;
+    }
+    const long elapsed = unassoc_query_elapsed_ms(m_unassoc_sta_query_sent);
+    if (!unassoc_query_resend_due(elapsed, m_unassoc_sta_query_resends)) {
+        return;
+    }
+    dm_easy_mesh_t *dm = get_data_model();
+    /* send_frame copies the payload: the kept frame stays as sent */
+    std::vector<unsigned char> frame(m_unassoc_sta_query_frame);
+    if (send_frame(frame.data(), static_cast<unsigned int>(frame.size())) < 0) {
+        em_printfout("Candidate query resend failed MID %u errno=%d", m_unassoc_sta_query_msg_id, errno);
+        return;
+    }
+    m_unassoc_sta_query_resends++;
+    em_printfout("Candidate query resend %u MID %u agent %s radio %s after %ld ms",
+        m_unassoc_sta_query_resends, m_unassoc_sta_query_msg_id,
+        dm == NULL ? "?" : util::mac_to_string(dm->get_agent_al_interface_mac()).c_str(),
+        util::mac_to_string(em->get_radio_interface_mac()).c_str(), elapsed);
+}
+
+void em_metrics_t::log_unassoc_sta_query_end(const char *how)
+{
+    em_t *em = static_cast<em_t *>(this);
+    dm_easy_mesh_t *dm = get_data_model();
+
+    if (m_unassoc_sta_query_msg_id == 0) {
+        return;
+    }
+    em_printfout("Candidate query %s MID %u agent %s radio %s resends %u after %ld ms", how,
+        m_unassoc_sta_query_msg_id,
+        dm == NULL ? "?" : util::mac_to_string(dm->get_agent_al_interface_mac()).c_str(),
+        util::mac_to_string(em->get_radio_interface_mac()).c_str(), m_unassoc_sta_query_resends,
+        unassoc_query_elapsed_ms(m_unassoc_sta_query_sent));
+}
+
