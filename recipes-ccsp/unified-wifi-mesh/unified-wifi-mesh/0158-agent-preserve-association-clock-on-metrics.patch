+TEST(em_orch_agent_snapshot_delta_TEST, MetricsRetainAuthoritativeAssociationClock)
+{
+    em_sta_info_t current = make_associated_sta("02:00:00:00:0a:00",
+        "02:00:00:ff:40:84", "02:00:00:00:08:00");
+    current.last_conn_time = 42;
+    current.assoc_start_boottime_sec = 1000;
+    em_sta_info_t sample = current;
+    sample.last_conn_time = 0;
+    sample.assoc_start_boottime_sec = 0;
+    sample.associated = false;
+    sample.rcpi = 132;
+    sample.est_dl_rate = 7200;
+
+    for (unsigned int repeat = 0; repeat < 3; repeat++) {
+        em_orch_agent_t::update_sta_link_metrics(current, sample);
+        EXPECT_TRUE(current.associated);
+        EXPECT_EQ(current.last_conn_time, 42u);
+        EXPECT_EQ(current.assoc_start_boottime_sec, 1000u);
+        EXPECT_EQ(current.rcpi, 132);
+        EXPECT_EQ(current.est_dl_rate, 7200u);
+    }
+
+    current.associated = false;
+    current.last_conn_time = 0;
+    current.assoc_start_boottime_sec = 0;
+    sample.associated = true;
+    sample.last_conn_time = 42;
+    sample.assoc_start_boottime_sec = 1000;
+    em_orch_agent_t::update_sta_link_metrics(current, sample);
+    EXPECT_FALSE(current.associated);
+    EXPECT_EQ(current.last_conn_time, 0u);
+    EXPECT_EQ(current.assoc_start_boottime_sec, 0u);
+}
