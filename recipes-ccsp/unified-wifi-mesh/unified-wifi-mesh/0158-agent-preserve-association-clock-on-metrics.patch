+void em_orch_agent_t::update_sta_link_metrics(em_sta_info_t &current,
+                                             const em_sta_info_t &sample)
+{
+    const bool associated = current.associated;
+    const unsigned int association_age = current.last_conn_time;
+    const uint64_t association_start = current.assoc_start_boottime_sec;
+    current = sample;
+    current.associated = associated;
+    current.last_conn_time = association_age;
+    current.assoc_start_boottime_sec = association_start;
+}
