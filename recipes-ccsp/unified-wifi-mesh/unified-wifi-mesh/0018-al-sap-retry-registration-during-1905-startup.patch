Subject: [PATCH] al-sap: retry registration during 1905 startup

The em_ctrl service waits for the ieee1905 Unix socket pathname, but a
pathname can outlive its listener and ieee1905's forking service can report
started before it accepts connections. AlServiceAccessPoint then throws
ConnectionFailed from its constructor and startup fails.

Retry the complete registration transaction for a bounded 90 seconds in both
controller and agent. Treat unsuccessful registration responses and both
known and generic exceptions as retryable. Delete each partial SAP between
attempts, close the control descriptor when data-socket construction fails,
and return a normal startup error if the dependency never becomes ready.

The current controller source already catches registration exceptions once;
this patch preserves that upstream protection while adding bounded retry and
bringing the agent path to the same behavior.

Upstream-Status: Pending
---
diff --git a/src/agent/em_agent.cpp b/src/agent/em_agent.cpp
index 04dde49..ed521bf 100644
--- a/src/agent/em_agent.cpp
+++ b/src/agent/em_agent.cpp
@@ -2445,26 +2445,46 @@ em_agent_t::~em_agent_t()
 #ifdef AL_SAP
 AlServiceAccessPoint* em_agent_t::al_sap_register(const std::string& data_socket_path, const std::string& control_socket_path)
 {
-    AlServiceAccessPoint* sap = new AlServiceAccessPoint(data_socket_path.c_str(), control_socket_path.c_str());
+    constexpr unsigned int max_attempts = 90;
 
-    AlServiceRegistrationRequest registrationRequest(SAPActivation::SAP_ENABLE, ServiceType::EmAgent);
-    sap->serviceAccessPointRegistrationRequest(registrationRequest);
+    for (unsigned int attempt = 1; attempt <= max_attempts; attempt++) {
+        AlServiceAccessPoint* sap = nullptr;
+        try {
+            sap = new AlServiceAccessPoint(data_socket_path.c_str(), control_socket_path.c_str());
 
-    AlServiceRegistrationResponse registrationResponse = sap->serviceAccessPointRegistrationResponse();
+            AlServiceRegistrationRequest registrationRequest(SAPActivation::SAP_ENABLE, ServiceType::EmAgent);
+            sap->serviceAccessPointRegistrationRequest(registrationRequest);
 
-    RegistrationResult result = registrationResponse.getResult();
-    if (result == RegistrationResult::SUCCESS) {
-        g_al_mac_sap = registrationResponse.getAlMacAddressLocal();
-        std::cout << "Registration completed with MAC Address: ";
-        for (auto byte : g_al_mac_sap) {
-            std::cout << std::hex << static_cast<int>(byte) << " ";
+            AlServiceRegistrationResponse registrationResponse = sap->serviceAccessPointRegistrationResponse();
+
+            RegistrationResult result = registrationResponse.getResult();
+            if (result == RegistrationResult::SUCCESS) {
+                g_al_mac_sap = registrationResponse.getAlMacAddressLocal();
+                std::cout << "Registration completed with MAC Address: ";
+                for (auto byte : g_al_mac_sap) {
+                    std::cout << std::hex << static_cast<int>(byte) << " ";
+                }
+                std::cout << std::dec << std::endl;
+                return sap;
+            }
+
+            printf("AL SAP registration attempt %u/%u failed with result %d\n",
+                attempt, max_attempts, static_cast<int>(result));
+        } catch (const AlServiceException& e) {
+            printf("AL SAP registration attempt %u/%u failed: %s\n",
+                attempt, max_attempts, e.what());
+        } catch (const std::exception& e) {
+            printf("AL SAP registration attempt %u/%u failed with unknown exception: %s\n",
+                attempt, max_attempts, e.what());
+        }
+
+        delete sap;
+        if (attempt < max_attempts) {
+            sleep(1);
         }
-        std::cout << std::dec << std::endl;
-    } else {
-        std::cout << "Registration failed with error: " << static_cast<int>(result) << std::endl;
     }
 
-    return sap;
+    return nullptr;
 }
 #endif
 #ifndef UNIT_TEST
@@ -2526,6 +2546,10 @@ int main(int argc, const char *argv[])
     if (g_agent.init(data_model_path.empty() ? NULL : data_model_path.c_str()) == 0) {
 #ifdef AL_SAP
     g_sap = g_agent.al_sap_register();
+    if (g_sap == nullptr) {
+        printf("AL SAP registration did not become ready\n");
+        return 1;
+    }
 #endif
         g_agent.start();
     }
diff --git a/src/al-sap/al_service_access_point.cpp b/src/al-sap/al_service_access_point.cpp
index 131e5c7..2fb3118 100644
--- a/src/al-sap/al_service_access_point.cpp
+++ b/src/al-sap/al_service_access_point.cpp
@@ -23,12 +23,14 @@ AlServiceAccessPoint::AlServiceAccessPoint(const std::string &dataSocketPath, co
     alDataSocketDescriptor = socket(AF_UNIX, SOCK_STREAM, 0);
     if (alDataSocketDescriptor == -1)
     {
+        close(alControlSocketDescriptor);
         throw AlServiceException("Failed to create Unix socket for data", PrimitiveError::SocketCreationFailed);
     }
     struct sockaddr_un dataAddr = createUnixSocketAddress(dataSocketPath);
     if (connect(alDataSocketDescriptor, (struct sockaddr *)&dataAddr, sizeof(dataAddr)) == -1)
     {
         close(alDataSocketDescriptor);
+        close(alControlSocketDescriptor);
         throw AlServiceException("Failed to connect to Unix socket for data", PrimitiveError::ConnectionFailed);
     }
 #ifdef DEBUG_MODE
@@ -268,4 +270,3 @@ AlServiceDataUnit AlServiceAccessPoint::serviceAccessPointDataIndication() {
     return message;
 }
 
-
diff --git a/src/ctrl/em_ctrl.cpp b/src/ctrl/em_ctrl.cpp
