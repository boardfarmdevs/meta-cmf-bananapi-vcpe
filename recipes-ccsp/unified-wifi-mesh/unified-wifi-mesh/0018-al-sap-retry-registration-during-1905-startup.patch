-        delete sap;
-        return nullptr;
-    }
-    catch (const std::exception& e) {
-        em_printfout("Unknown exception: %s during AL SAP registration, data socket: %s, control socket: %s",
-                     e.what(), data_socket_path.c_str(), control_socket_path.c_str());
+
