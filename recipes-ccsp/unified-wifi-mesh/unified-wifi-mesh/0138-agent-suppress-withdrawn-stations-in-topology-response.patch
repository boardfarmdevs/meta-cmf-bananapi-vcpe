                            sizeof(bssid_t)) == 0) {
                 memcpy(tmp, sta->m_sta_info.id, sizeof(mac_address_t));
--- a/tests/test_l1_em_orch_agent.cpp
+++ b/tests/test_l1_em_orch_agent.cpp
@@ -25,6 +25,7 @@
 #include "em_orch_agent.h"
 #include "em_agent.h"
 #include "em_cmd_sta_list.h"
+#include "em_configuration.h"
 
 
 class em_orch_agent_t_TEST : public testing::Test {
@@ -59,6 +60,27 @@
 
 } // namespace
 
+TEST(em_configuration_associated_clients_TEST,
+    WithdrawalTombstoneSuppressesStaleLiveRow)
+{
+    dm_easy_mesh_t dm{};
+    em_sta_info_t live = make_associated_sta("02:00:00:00:0c:00",
+        "02:00:00:10:00:01", "02:00:00:20:00:01");
+
+    ASSERT_EQ(dm.init(), 0);
+    dm.put_sta_info(&live, em_target_sta_map_consolidated);
+    EXPECT_TRUE(em_configuration_t::is_advertisable_association(&dm, live));
+
+    em_sta_info_t withdrawn = live;
+    withdrawn.associated = false;
+    dm.put_sta_info(&withdrawn, em_target_sta_map_disassoc);
+
+    /* A delayed aggregate or metrics stage may leave a stale copy in the
+     * live map.  The topology snapshot must still honor the newer tombstone. */
+    EXPECT_FALSE(em_configuration_t::is_advertisable_association(&dm, live));
+    dm.deinit();
+}
