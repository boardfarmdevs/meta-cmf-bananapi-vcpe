Subject: [PATCH] Notify the HAL once after successful station reauthorization

A station can return while its previous hostap authorization flag is still
set. Suppressing the new authorization callback leaves OneWifi's association
ownership stale. Arm one notification only after an acknowledged successful
association response, and consume it at authorization. Repeated authorization
calls without a new association remain silent. Do not clear authorization or
generate a synthetic disconnect to obtain the callback.

Upstream-Status: Pending

diff --git a/source/hostap-2.11/src/ap/sta_info.h b/source/hostap-2.11/src/ap/sta_info.h
--- a/source/hostap-2.11/src/ap/sta_info.h
+++ b/source/hostap-2.11/src/ap/sta_info.h
@@ -232,6 +232,7 @@ struct sta_info {
 #endif /* CONFIG_FST */
 
 	struct os_reltime connected_time;
+	unsigned int authorization_event_pending:1;
 
 #ifdef CONFIG_SAE
 	struct sae_data *sae;
diff --git a/source/hostap-2.11/src/ap/ieee802_11.c b/source/hostap-2.11/src/ap/ieee802_11.c
--- a/source/hostap-2.11/src/ap/ieee802_11.c
+++ b/source/hostap-2.11/src/ap/ieee802_11.c
@@ -6893,6 +6893,8 @@ static void handle_assoc_cb(struct hostapd_data *hapd,
 	if (status != WLAN_STATUS_SUCCESS)
 		goto handle_ml;
 
+	sta->authorization_event_pending = 1;
+
 	/* Stop previous accounting session, if one is started, and allocate
 	 * new session id for the new session. */
 	accounting_sta_stop(hapd, sta);
diff --git a/source/hostap-2.11/src/ap/sta_info.c b/source/hostap-2.11/src/ap/sta_info.c
--- a/source/hostap-2.11/src/ap/sta_info.c
+++ b/source/hostap-2.11/src/ap/sta_info.c
@@ -1558,11 +1558,14 @@ bool ap_sta_set_authorized_flag(struct hostapd_data *hapd, struct sta_info *sta,
 				int authorized)
 {
-	if (!!authorized == !!(sta->flags & WLAN_STA_AUTHORIZED))
+	if (!!authorized == !!(sta->flags & WLAN_STA_AUTHORIZED) &&
+	    !(authorized && sta->authorization_event_pending))
 		return false;
 
+	sta->authorization_event_pending = 0;
+
 	if (authorized) {
 		int mld_assoc_link_id = -1;
 
 #ifdef CONFIG_IEEE80211BE
 		if (ap_sta_is_mld(hapd, sta)) {
 			if (sta->mld_assoc_link_id == hapd->mld_link_id)
