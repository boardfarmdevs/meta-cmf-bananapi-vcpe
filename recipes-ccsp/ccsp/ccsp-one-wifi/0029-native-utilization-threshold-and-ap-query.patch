+static bus_error_t em_request_ap_metrics(char *event_name, raw_data_t *data, void *user_data)
+{
+    if (data == NULL || data->data_type != bus_data_type_string ||
+        data->raw_data.bytes == NULL || data->raw_data_len < 50 ||
+        data->raw_data_len > 4097) return bus_error_invalid_input;
+    const char *encoded = data->raw_data.bytes;
+    size_t length = strnlen(encoded, data->raw_data_len);
+    if ((length != data->raw_data_len && length != data->raw_data_len - 1) ||
+        length > 4096 || length % 2 != 0) return bus_error_invalid_input;
+    char request[4097];
+    memcpy(request, encoded, length);
+    request[length] = 0;
+    if (strspn(request, "0123456789abcdef") != length) return bus_error_invalid_input;
+    if (push_event_to_ctrl_queue(request, length + 1,
+        wifi_event_type_command, wifi_event_type_em_ap_metrics_query, NULL) != RETURN_OK) {
+        return bus_error_general;
+    }
+    return bus_error_success;
+}
