--- a/include/wifi_em_util_threshold.h	1969-12-31 16:00:00.000000000 -0800
+++ b/include/wifi_em_util_threshold.h	2026-09-15 15:09:29.517569882 -0700
@@ -0,0 +1,31 @@
+#ifndef WIFI_EM_UTIL_THRESHOLD_H
+#define WIFI_EM_UTIL_THRESHOLD_H
+
+#include <stdbool.h>
+
+typedef struct {
+    bool valid;
+    bool above;
+    unsigned int channel;
+    unsigned int threshold;
+} em_util_threshold_t;
+
+static bool em_util_threshold_crossed(em_util_threshold_t *state, unsigned int threshold,
+    unsigned int channel, unsigned int value, bool valid)
+{
+    if (threshold == 0 || threshold > 255) {
+        state->valid = false;
+        return false;
+    }
+    if (!valid || value > 255) return false;
+    bool above = value >= threshold;
+    bool crossed = state->valid && state->threshold == threshold &&
+        state->channel == channel && state->above != above;
+    state->valid = true;
+    state->above = above;
+    state->threshold = threshold;
+    state->channel = channel;
+    return crossed;
+}
+
+#endif
