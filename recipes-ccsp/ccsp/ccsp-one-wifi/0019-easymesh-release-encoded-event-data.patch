From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Tue, 25 Aug 2026 13:20:00 -0700
Subject: [PATCH] wifi_em: release encoded EasyMesh event data

webconfig_encode() allocates u.encoded.raw independently of the large
webconfig_subdoc_data_t wrapper.  The EasyMesh event publishers released the
decoded inputs and wrapper, but not that encoded allocation.  AP metrics are
published every five seconds, so the omission produced unbounded OneWifi heap
growth proportional to the report size.  A live bpiap report was about 8.9 KiB
and OneWifi continued growing by 6.4 MiB/hour even with its EasyMesh agent
stopped.

Use the webconfig ownership API on success and on every post-encode error
path.  Also release the beacon-report wrapper on success; that path previously
retained both the roughly 2.2 MiB wrapper and its encoded buffer per report.
Finally, release a removed client-stat cache entry instead of orphaning it on
each disassociation.

Upstream-Status: Pending
---
 source/apps/em/wifi_em.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

diff --git a/source/apps/em/wifi_em.c b/source/apps/em/wifi_em.c
index 640644f..ae8f21f 100644
--- a/source/apps/em/wifi_em.c
+++ b/source/apps/em/wifi_em.c
@@ -453,6 +453,7 @@ static int em_sta_stats_publish(wifi_app_t *app, client_assoc_data_t *stats, int
         wifi_util_error_print(WIFI_EM, "%s:%d Error in encoding assocdev stats\n", __func__,
             __LINE__);
         free(data->u.decoded.em_sta_link_metrics_rsp.per_sta_metrics);
+        webconfig_data_free(data);
         free(data);
         return RETURN_ERR;
     }
@@ -467,6 +468,7 @@ static int em_sta_stats_publish(wifi_app_t *app, client_assoc_data_t *stats, int
         wifi_util_error_print(WIFI_EM, "%s:%d: bus: bus_event_publish_fn Event failed %d\n",
             __func__, __LINE__, rc);
         free(data->u.decoded.em_sta_link_metrics_rsp.per_sta_metrics);
+        webconfig_data_free(data);
         free(data);
         return RETURN_ERR;
     }
@@ -478,6 +480,7 @@ static int em_sta_stats_publish(wifi_app_t *app, client_assoc_data_t *stats, int
     }
 
     free(data->u.decoded.em_sta_link_metrics_rsp.per_sta_metrics);
+    webconfig_data_free(data);
     free(data);
 }
 
@@ -879,6 +882,7 @@ static int em_publish_stats_data(channel_scan_response_t *scan_response)
         wifi_util_error_print(WIFI_EM, "%s:%d Error in encoding channel scan stats\n", __func__,
             __LINE__);
         free(data->u.decoded.collect_stats.stats);
+        webconfig_data_free(data);
         free(data);
         return RETURN_ERR;
     }
@@ -897,10 +901,12 @@ static int em_publish_stats_data(channel_scan_response_t *scan_response)
         wifi_util_error_print(WIFI_EM, "%s:%d: bus: bus_event_publish_fn Event failed %d\n",
             __func__, __LINE__, status);
         free(data->u.decoded.collect_stats.stats);
+        webconfig_data_free(data);
         free(data);
         return RETURN_ERR;
     }
     free(data->u.decoded.collect_stats.stats);
+    webconfig_data_free(data);
     free(data);
 
     wifi_util_dbg_print(WIFI_EM, "%s:%d Scan results published\n", __func__, __LINE__);
@@ -1630,7 +1636,8 @@ static int em_client_stats_rem(void *arg)
         return 0;
     }
     wifi_util_dbg_print(WIFI_EM, "%s:%d: Sta Mac %s disassociated\n", __func__,
         __LINE__, sta_mac_str);
+    free(stats);
 
     to_mac_str((unsigned char *)assoc_data->dev_stats.cli_MACAddress, client_mac);
     sta_client_info_t *t_sta_data = (sta_client_info_t *)hash_map_remove(
@@ -2037,6 +2044,7 @@ cleanup:
                 }
             }
         }
+        webconfig_data_free(data);
         free(data);
     }
 
@@ -2935,5 +2943,6 @@ static int em_beacon_report_publish(bus_handle_t *handle, void *msg_data)
         wifi_util_error_print(WIFI_CTRL, "%s:%d: Webconfig set failed\n", __func__, __LINE__);
         if (wb_data != NULL) {
+            webconfig_data_free(wb_data);
             free(wb_data);
         }
         return bus_error_general;
@@ -2951,12 +2960,16 @@ static int em_beacon_report_publish(bus_handle_t *handle, void *msg_data)
     if (rc != bus_error_success) {
         wifi_util_error_print(WIFI_EM, "%s:%d: bus_event_publish_fn Event failed %d\n", __func__,
             __LINE__, rc);
+        webconfig_data_free(wb_data);
         free(wb_data);
         return RETURN_ERR;
     } else {
         wifi_util_dbg_print(WIFI_EM, "%s:%d: bus_event_publish_fn Event for %s\n", __func__,
             __LINE__, WIFI_EM_BEACON_REPORT);
     }
 
+    webconfig_data_free(wb_data);
+    free(wb_data);
+
     return RETURN_OK;
 }
