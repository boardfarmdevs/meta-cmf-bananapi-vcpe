+extern INT wifi_hal_backhaul_root_admit(INT vap_index, const unsigned char *state);
+
+static void process_backhaul_root_admission(void *data, unsigned int len)
+{
+    if (data == NULL || len != 26) return;
+    const unsigned char *request = data;
+    const unsigned int vap_index = (unsigned int)request[0] << 24 |
+        (unsigned int)request[1] << 16 | (unsigned int)request[2] << 8 | request[3];
+    if (vap_index < getNumberRadios() * MAX_NUM_VAP_PER_RADIO &&
+        wifi_hal_backhaul_root_admit(vap_index, request + 4) == RETURN_OK)
+        wifi_util_info_print(WIFI_CTRL, "Backhaul admission: rooted vap=%u\n", vap_index);
+    else
+        wifi_util_error_print(WIFI_CTRL, "Backhaul admission: stale or failed vap=%u\n", vap_index);
+}
+
 void handle_command_event(wifi_ctrl_t *ctrl, void *data, unsigned int len,
     wifi_event_subtype_t subtype)
 {
     switch (subtype) {
+    case wifi_event_type_backhaul_root_admit:
+        process_backhaul_root_admission(data, len);
+        break;
     case wifi_event_type_active_gw_check:
         process_active_gw_check_command(*(bool *)data);
         break;
