+extern INT wifi_hal_backhaul_root_state(INT vap_index, unsigned char *state);
+
+static bus_error_t get_backhaul_root(char *name, raw_data_t *value, bus_user_data_t *user_data)
+{
+    unsigned int instance;
+    int consumed = 0;
+    unsigned char state[22];
+    wifi_mgr_t *mgr = get_wifimgr_obj();
+    (void)user_data;
+
+    if (name == NULL || value == NULL ||
+        sscanf(name, "Device.WiFi.STA.%u.X_RDK_BackhaulRoot%n", &instance, &consumed) != 1 ||
+        consumed == 0 || name[consumed] != '\0' || instance == 0 || instance > getNumberRadios())
+        return bus_error_invalid_input;
+    const unsigned int vap_index = get_sta_vap_index_for_radio(&mgr->hal_cap.wifi_prop, instance - 1);
+    if (wifi_hal_backhaul_root_state(vap_index, state) != RETURN_OK)
+        return bus_error_invalid_operation;
+    value->raw_data.bytes = malloc(sizeof(state));
+    if (value->raw_data.bytes == NULL) return bus_error_out_of_resources;
+    memcpy(value->raw_data.bytes, state, sizeof(state));
+    value->raw_data_len = sizeof(state);
+    value->data_type = bus_data_type_bytes;
+    return bus_error_success;
+}
+
+static bus_error_t set_backhaul_root(char *name, raw_data_t *value, bus_user_data_t *user_data)
+{
+    unsigned int instance;
+    int consumed = 0;
+    unsigned char queued[26];
+    wifi_mgr_t *mgr = get_wifimgr_obj();
+    (void)user_data;
+
+    if (name == NULL || value == NULL || value->data_type != bus_data_type_bytes ||
+        value->raw_data.bytes == NULL || value->raw_data_len != 22 ||
+        sscanf(name, "Device.WiFi.STA.%u.X_RDK_BackhaulRoot%n", &instance, &consumed) != 1 ||
+        consumed == 0 || name[consumed] != '\0' || instance == 0 || instance > getNumberRadios())
+        return bus_error_invalid_input;
+    const unsigned int vap_index = get_sta_vap_index_for_radio(&mgr->hal_cap.wifi_prop, instance - 1);
+    queued[0] = vap_index >> 24;
+    queued[1] = vap_index >> 16;
+    queued[2] = vap_index >> 8;
+    queued[3] = vap_index;
+    memcpy(queued + 4, value->raw_data.bytes, 22);
+    if (push_event_to_ctrl_queue(queued, sizeof(queued), wifi_event_type_command,
+            wifi_event_type_backhaul_root_admit, NULL) != RETURN_OK)
+        return bus_error_out_of_resources;
+    return bus_error_success;
+}
+
 hotspot_timing_t g_hotspot_timing;
 apply_ignite_config_t g_apply_ignite_config;
 
