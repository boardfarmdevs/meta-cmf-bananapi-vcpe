+static bool em_ap_query_selects(const em_ap_report_callback_arg_t *args, const wifi_vap_info_t *vap)
+{
+    if (args->query == NULL) return true;
+    if (vap->vap_mode != wifi_vap_mode_ap || !vap->u.bss_info.enabled) return false;
+    if (args->query_bss_count == 0) return true;
+    for (unsigned int index = 0; index < args->query_bss_count; ++index)
+        if (memcmp(vap->u.bss_info.bssid, args->query_bssids[index], sizeof(mac_addr_t)) == 0)
+            return true;
+    return false;
+}
