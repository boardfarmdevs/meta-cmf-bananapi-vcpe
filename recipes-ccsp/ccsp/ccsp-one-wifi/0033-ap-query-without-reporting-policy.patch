+static int em_refresh_ap_clients(int radio_index, const em_ap_report_callback_arg_t *request)
+{
+    rdk_wifi_radio_t *radio = find_radio_config_by_index(radio_index);
+    if (radio == NULL || radio_index < 0 || radio_index >= MAX_NUM_RADIOS) return RETURN_ERR;
+    for (unsigned int vap_slot = 0;
+         vap_slot < radio->vaps.num_vaps && vap_slot < MAX_NUM_VAP_PER_RADIO; ++vap_slot) {
+        wifi_vap_info_t *vap = &radio->vaps.vap_map.vap_array[vap_slot];
+        if (!em_ap_query_selects(request, vap)) continue;
+        ap_metrics_data_t *cached = &em_ap_metrics_report_cache.radio_report[radio_index].ap_data[vap_slot];
+        cached->vap_index = vap->vap_index;
+        if (cached->client_stats_map == NULL) cached->client_stats_map = hash_map_create();
+        if (cached->client_stats_map == NULL ||
+            em_client_stats_clear(radio_index, vap->vap_index) != RETURN_OK) return RETURN_ERR;
+        if (!vap->u.bss_info.enabled) continue;
+        wifi_associated_dev3_t *devices = NULL;
+        unsigned int device_count = 0;
+        struct timespec collected;
+        if (clock_gettime(CLOCK_MONOTONIC, &collected) != 0) return RETURN_ERR;
+        int status = wifi_getApAssociatedDeviceDiagnosticResult3(vap->vap_index, &devices, &device_count);
+        if (status != RETURN_OK || device_count > BSS_MAX_NUM_STATIONS ||
+            (device_count != 0 && devices == NULL)) {
+            free(devices);
+            return RETURN_ERR;
+        }
+        unsigned int active_count = 0;
+        for (unsigned int device_index = 0; device_index < device_count; ++device_index)
+            if (devices[device_index].cli_AuthenticationState) ++active_count;
+        for (unsigned int device_index = 0; device_index < device_count; ++device_index) {
+            if (!devices[device_index].cli_AuthenticationState) continue;
+            if (em_client_stats_store(radio_index, vap->vap_index, active_count,
+                &devices[device_index], &collected) != RETURN_OK) {
+                free(devices);
+                em_client_stats_clear(radio_index, vap->vap_index);
+                return RETURN_ERR;
+            }
+        }
+        free(devices);
+    }
+    return RETURN_OK;
+}
