+static int em_handle_ap_metrics_query(wifi_app_t *app, const char *encoded)
+{
+    mac_addr_t bssids[255];
+    unsigned int bssid_count = 0;
+    if (app == NULL || em_ap_query_bssids(encoded, bssids, &bssid_count) != RETURN_OK) return RETURN_ERR;
+    em_ap_report_callback_arg_t request = {0};
+    request.app = app;
+    request.query = encoded;
+    request.query_bssids = bssids;
+    request.query_bss_count = bssid_count;
+    wifi_mgr_t *manager = get_wifimgr_obj();
+    wifi_platform_property_t *property = &manager->hal_cap.wifi_prop;
+    for (unsigned int radio_index = 0;
+         radio_index < getNumberRadios() && radio_index < MAX_NUM_RADIOS; ++radio_index) {
+        rdk_wifi_radio_t *radio = find_radio_config_by_index(radio_index);
+        if (radio == NULL) continue;
+        bool selected = false;
+        for (unsigned int vap_slot = 0;
+             vap_slot < radio->vaps.num_vaps && vap_slot < MAX_NUM_VAP_PER_RADIO; ++vap_slot) {
+            wifi_vap_info_t *vap = &radio->vaps.vap_map.vap_array[vap_slot];
+            if (em_ap_query_selects(&request, vap)) selected = true;
+        }
+        if (!selected) continue;
+        radio_metrics_policy_t *policy = &request.policy_config.radio_metrics_policies.radio_metrics_policy[
+            request.policy_config.radio_metrics_policies.radio_count];
+        bool mapped = false;
+        for (size_t map_slot = 0;
+             map_slot < sizeof(property->radio_interface_map) / sizeof(property->radio_interface_map[0]); ++map_slot) {
+            radio_interface_mapping_t *mapping = &property->radio_interface_map[map_slot];
+            if (mapping->radio_index != radio_index || mapping->interface_name[0] == '\0') continue;
+            mac_address_from_name(mapping->interface_name, policy->ruid);
+            mapped = em_get_radio_index_from_mac(policy->ruid) == (int)radio_index;
+            break;
+        }
+        if (!mapped || em_refresh_ap_clients(radio_index, &request) != RETURN_OK ||
+            em_refresh_ap_survey(radio_index) != RETURN_OK) return RETURN_ERR;
+        policy->link_metrics = true;
+        ++request.policy_config.radio_metrics_policies.radio_count;
+    }
+    if (request.policy_config.radio_metrics_policies.radio_count == 0) return RETURN_ERR;
+    return ap_report_push_cb(&request);
+}
