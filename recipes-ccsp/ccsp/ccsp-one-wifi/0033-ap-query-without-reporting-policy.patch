+static int em_ap_query_bssids(const char *encoded, mac_addr_t *bssids, unsigned int *count)
+{
+    if (encoded == NULL || bssids == NULL || count == NULL) return RETURN_ERR;
+    size_t hex_length = strnlen(encoded, 4097);
+    if (hex_length < 50 || hex_length > 4096 || hex_length % 2 != 0) return RETURN_ERR;
+    unsigned char frame[2048];
+    for (size_t position = 0; position < hex_length; ++position) {
+        unsigned char digit = encoded[position];
+        unsigned int value;
+        if (digit >= '0' && digit <= '9') value = digit - '0';
+        else if (digit >= 'a' && digit <= 'f') value = digit - 'a' + 10;
+        else return RETURN_ERR;
+        if (position % 2 == 0) frame[position / 2] = value << 4;
+        else frame[position / 2] |= value;
+    }
+    size_t length = hex_length / 2;
+    if (frame[12] != 0x89 || frame[13] != 0x3a || frame[14] != 0 ||
+        frame[16] != 0x80 || frame[17] != 0x0b || frame[20] != 0 ||
+        (frame[21] & 0x80) == 0) return RETURN_ERR;
+    bool found = false;
+    *count = 0;
+    for (size_t offset = 22; offset + 3 <= length;) {
+        unsigned int type = frame[offset];
+        size_t size = ((size_t)frame[offset + 1] << 8) | frame[offset + 2];
+        offset += 3;
+        if (size > length - offset) return RETURN_ERR;
+        if (type == 0) return size == 0 && found ? RETURN_OK : RETURN_ERR;
+        if (type == 0x93) {
+            if (found || size < 1 || size != 1 + (size_t)frame[offset] * 6) return RETURN_ERR;
+            *count = frame[offset];
+            memcpy(bssids, frame + offset + 1, *count * sizeof(mac_addr_t));
+            found = true;
+        }
+        offset += size;
+    }
+    return RETURN_ERR;
+}
