Report associated clients even on a FULL associated-clients refresh.

translate_associated_clients_to_easymesh_sta_info() only iterated OneWifi's
associated_devices_diff_map (the association delta). When OneWifi publishes a
FULL associate-status refresh (webconfig_send_full_associate_status ->
WiFiAssociatedClients -> the full map, empty diff) -- which the co-located
agent on the controller hits routinely -- the diff map is empty, so the
EasyMesh agent emits NO Client Association Event, the controller never learns
the client, and it never appears in STAList / the CLI (clients list or network
topology). Fall back to the full associated_devices_map when the diff map is
empty/absent, treat those entries as associated, and tolerate a missing 802.11
assoc frame (frame-less event) so the client is still reported.

Signed-off-by: rev <revogelaar@gmail.com>
---
diff --git a/source/webconfig/wifi_easymesh_translator.c b/source/webconfig/wifi_easymesh_translator.c
index 95d6451f..69a83e86 100644
--- a/source/webconfig/wifi_easymesh_translator.c
+++ b/source/webconfig/wifi_easymesh_translator.c
@@ -1430,8 +1430,19 @@ webconfig_error_t translate_associated_clients_to_easymesh_sta_info(webconfig_su
                 return webconfig_error_translate_to_easymesh;
             }
 
-            if (rdk_vap_info->associated_devices_diff_map != NULL) {
-                assoc_dev_data = hash_map_get_first(rdk_vap_info->associated_devices_diff_map);
+            /* EM must emit Client Association Events even when OneWifi publishes a
+             * FULL associated-clients refresh (empty diff map) -- otherwise clients
+             * that arrive via the full-list path (common on the co-located agent)
+             * are never reported to the controller and never appear in the model.
+             * Fall back to the full associated_devices_map when the diff is empty. */
+            hash_map_t *em_assoc_src = rdk_vap_info->associated_devices_diff_map;
+            bool em_using_full_list = false;
+            if (em_assoc_src == NULL || hash_map_get_first(em_assoc_src) == NULL) {
+                em_assoc_src = rdk_vap_info->associated_devices_map;
+                em_using_full_list = true;
+            }
+            if (em_assoc_src != NULL) {
+                assoc_dev_data = hash_map_get_first(em_assoc_src);
                 while (assoc_dev_data != NULL) {
                     if (associated_client_count >= WEBCONFIG_MAX_ASSOCIATED_CLIENTS) {
                         wifi_util_error_print(WIFI_WEBCONFIG,"%s:%d: Exceeded max number of associated clients %d, vap_name '%s'\n", __func__, __LINE__, WEBCONFIG_MAX_ASSOCIATED_CLIENTS, rdk_vap_info->vap_name);
@@ -1472,21 +1483,28 @@ webconfig_error_t translate_associated_clients_to_easymesh_sta_info(webconfig_su
                     em_sta_dev_info->errors_tx=assoc_dev_data->dev_stats.cli_ErrorsSent;
 
                     if (assoc_dev_data->sta_data.msg_data.data == NULL) {
-                        wifi_util_error_print(WIFI_WEBCONFIG,"%s:%d: Association frame data not present\n", __func__, __LINE__);
-                        return webconfig_error_translate_to_easymesh;
-                    }
-                    mgmt = (struct ieee80211_mgmt *) assoc_dev_data->sta_data.msg_data.data;
-                    tag_len = assoc_dev_data->sta_data.msg_data.frame.len - IEEE80211_HDRLEN - sizeof(mgmt->u.assoc_req);
-                    /* Store the full 802.11 association request frame body:
-                     * fixed fields (capab_info 2B + listen_interval 2B) followed by IEs. */
-                    fixed_len = (unsigned int)sizeof(mgmt->u.assoc_req);
-                    if (fixed_len + tag_len > EM_MAX_FRAME_BODY_LEN) {
-                        tag_len = EM_MAX_FRAME_BODY_LEN - fixed_len;
+                        /* Full-list entries may not carry the 802.11 assoc frame.
+                         * Still emit the association event (frame-less) so the client
+                         * is reported; the diff path keeps the frame when present. */
+                        if (!em_using_full_list) {
+                            wifi_util_error_print(WIFI_WEBCONFIG,"%s:%d: Association frame data not present\n", __func__, __LINE__);
+                            return webconfig_error_translate_to_easymesh;
+                        }
+                        em_sta_dev_info->frame_body_len = 0;
+                    } else {
+                        mgmt = (struct ieee80211_mgmt *) assoc_dev_data->sta_data.msg_data.data;
+                        tag_len = assoc_dev_data->sta_data.msg_data.frame.len - IEEE80211_HDRLEN - sizeof(mgmt->u.assoc_req);
+                        /* Store the full 802.11 association request frame body:
+                         * fixed fields (capab_info 2B + listen_interval 2B) followed by IEs. */
+                        fixed_len = (unsigned int)sizeof(mgmt->u.assoc_req);
+                        if (fixed_len + tag_len > EM_MAX_FRAME_BODY_LEN) {
+                            tag_len = EM_MAX_FRAME_BODY_LEN - fixed_len;
+                        }
+                        memcpy(em_sta_dev_info->frame_body, &mgmt->u.assoc_req, fixed_len + tag_len);
+                        em_sta_dev_info->frame_body_len = fixed_len + tag_len;
                     }
-                    memcpy(em_sta_dev_info->frame_body, &mgmt->u.assoc_req, fixed_len + tag_len);
-                    em_sta_dev_info->frame_body_len = fixed_len + tag_len;
 
-                    if (assoc_dev_data->client_state == 0) {
+                    if (em_using_full_list || assoc_dev_data->client_state == 0) {
                         em_sta_dev_info->associated = true;
                         proto->put_sta_info(proto->data_model, em_sta_dev_info, em_target_sta_map_assoc);
                     } else {
@@ -1511,7 +1529,7 @@ webconfig_error_t translate_associated_clients_to_easymesh_sta_info(webconfig_su
                         }
                     }
                     associated_client_count++;
-                    assoc_dev_data = hash_map_get_next(rdk_vap_info->associated_devices_diff_map, assoc_dev_data);
+                    assoc_dev_data = hash_map_get_next(em_assoc_src, assoc_dev_data);
                 }
             }
         }
