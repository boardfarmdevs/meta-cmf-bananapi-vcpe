From 0000000000000000000000000000000000000012 Mon Sep 17 00:00:00 2001
From: Rob Vogelaar <rob.vogelaar@libertyglobal.com>
Date: Tue, 25 Aug 2026 19:20:00 -0700
Subject: [PATCH] webconfig: release decoded AP metrics objects

The current decoder already bounds radio counts and releases its cJSON tree
and partially decoded per-VAP arrays. Two ownership gaps remain: the decoded
per-VAP arrays survive after translation, and the encoded-json field retains
a dangling pointer after the decoder takes ownership of the tree.

Release the temporary decoded arrays immediately after translation and clear
the transferred cJSON pointer before any decoder exit. Periodic AP metrics
reporting then has one explicit owner at each stage and bounded temporary
storage.

Upstream-Status: Pending
---
 .../wifi_webconfig_em_ap_metrics_report.c     | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/source/webconfig/wifi_webconfig_em_ap_metrics_report.c b/source/webconfig/wifi_webconfig_em_ap_metrics_report.c
index 5a508ce..e8625ac 100644
--- a/source/webconfig/wifi_webconfig_em_ap_metrics_report.c
+++ b/source/webconfig/wifi_webconfig_em_ap_metrics_report.c
@@ -35,6 +35,8 @@ webconfig_subdoc_object_t   em_ap_metrics_objects[3] = {
     { webconfig_subdoc_object_type_em_ap_metrics_report, "EMAPMetricsReport" },
 };
 
+static void free_em_ap_metrics_report_params(webconfig_subdoc_decoded_data_t *params);
+
 webconfig_error_t init_em_ap_metrics_report_subdoc(webconfig_subdoc_t *doc)
 {
     doc->num_objects = sizeof(em_ap_metrics_objects)/sizeof(webconfig_subdoc_object_t);
@@ -51,7 +53,11 @@ webconfig_error_t access_check_em_ap_metrics_report_subdoc(webconfig_t *config,
 webconfig_error_t translate_from_em_ap_metrics_report_subdoc(webconfig_t *config, webconfig_subdoc_data_t *data)
 {
     if ((data->descriptor & webconfig_data_descriptor_translate_to_easymesh) == webconfig_data_descriptor_translate_to_easymesh) {
-        if (config->proto_desc.translate_to(webconfig_subdoc_type_em_ap_metrics_report, data) != webconfig_error_none) {
+        webconfig_error_t ret = config->proto_desc.translate_to(
+            webconfig_subdoc_type_em_ap_metrics_report, data);
+
+        free_em_ap_metrics_report_params(&data->u.decoded);
+        if (ret != webconfig_error_none) {
             if ((data->descriptor & webconfig_error_translate_to_easymesh) == webconfig_error_translate_to_easymesh) {
                 return webconfig_error_translate_to_easymesh;
             }
@@ -170,6 +176,7 @@ webconfig_error_t decode_em_ap_metrics_report_subdoc(webconfig_t *config, webcon
         wifi_util_error_print(WIFI_WEBCONFIG, "%s:%d: NULL json pointer\n", __func__, __LINE__);
         return webconfig_error_decode;
     }
+    data->u.encoded.json = NULL;
 
     char *str;
     str = cJSON_Print(json);
@@ -227,4 +234,4 @@ webconfig_error_t decode_em_ap_metrics_report_subdoc(webconfig_t *config, webcon
     cJSON_Delete(json);
     return webconfig_error_none;
 }
-#endif
\ No newline at end of file
+#endif
