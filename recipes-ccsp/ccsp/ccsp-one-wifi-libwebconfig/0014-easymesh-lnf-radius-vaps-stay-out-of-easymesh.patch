                 return webconfig_error_translate_to_easymesh;
             }
+            /* The stations of an lnf_radius VAP stay out of EasyMesh with the VAP:
+             * no association events for a BSS the agent does not report. */
+            if (strncmp(rdk_vap_info->vap_name, "lnf_radius", strlen("lnf_radius")) == 0) {
+                continue;
+            }
 
