Subject: [PATCH] Initialize the entire allocated station record

Clear the record, not only sizeof(pointer) bytes, before translating an
association. Unwritten metrics and association ages must not contain heap
garbage.

Upstream-Status: Pending

--- a/source/webconfig/wifi_easymesh_translator.c
+++ b/source/webconfig/wifi_easymesh_translator.c
@@ -1608,7 +1608,7 @@
                         return webconfig_error_translate_to_easymesh;
                     }
 
-                    memset(em_sta_dev_info, 0, sizeof(em_sta_dev_info));
+                    memset(em_sta_dev_info, 0, sizeof(*em_sta_dev_info));
 
                     em_radio_info_t *radio_info = proto->get_radio_info(proto->data_model, vap->radio_index);
                     em_bss_info_t *bss_info = proto->get_bss_info(proto->data_model, rdk_vap_info->vap_index);
