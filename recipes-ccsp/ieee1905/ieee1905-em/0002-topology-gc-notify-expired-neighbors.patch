+#[instrument(skip_all, name = "topology_change_notification_worker", fields(task = next_task_id()))]
+pub async fn cmdu_topology_change_notification_worker(
+    interface: String,
+    sender: Arc<EthernetSender>,
+    message_id_generator: Arc<MessageIdGenerator>,
+    local_al_mac_address: MacAddr,
+    forwarding_interface_mac: MacAddr,
+    mut topology_change_rx: tokio::sync::broadcast::Receiver<TopologyChangeEvent>,
+) {
+    loop {
+        match topology_change_rx.recv().await {
+            Ok(TopologyChangeEvent::NeighborExpired { al_mac }) => {
+                info!(
+                    expired_al_mac = %al_mac,
+                    "Sending Topology Notification for expired neighbor"
+                );
+                cmdu_topology_notification_transmission(
+                    interface.clone(),
+                    sender.clone(),
+                    message_id_generator.clone(),
+                    local_al_mac_address,
+                    forwarding_interface_mac,
+                )
+                .await;
+            }
+            Err(tokio::sync::broadcast::error::RecvError::Lagged(skipped)) => {
+                warn!(
+                    skipped,
+                    "Topology-change receiver lagged; sending convergence notification"
+                );
+                cmdu_topology_notification_transmission(
+                    interface.clone(),
+                    sender.clone(),
+                    message_id_generator.clone(),
+                    local_al_mac_address,
+                    forwarding_interface_mac,
+                )
+                .await;
+            }
+            Err(tokio::sync::broadcast::error::RecvError::Closed) => break,
+        }
+    }
+}
