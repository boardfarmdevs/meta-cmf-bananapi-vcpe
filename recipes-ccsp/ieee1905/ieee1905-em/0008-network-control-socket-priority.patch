@@ -0,0 +1,60 @@
+use std::io;
+use std::os::fd::{AsRawFd, FromRawFd, OwnedFd};
+
+pub fn open() -> io::Result<OwnedFd> {
+    let descriptor = unsafe {
+        libc::socket(
+            libc::AF_PACKET,
+            libc::SOCK_RAW | libc::SOCK_CLOEXEC,
+            (libc::ETH_P_ALL as u16).to_be() as i32,
+        )
+    };
+    if descriptor < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    let socket = unsafe { OwnedFd::from_raw_fd(descriptor) };
+    let priority: libc::c_int = 256 + 7;
+    let result = unsafe {
+        libc::setsockopt(
+            socket.as_raw_fd(),
+            libc::SOL_SOCKET,
+            libc::SO_PRIORITY,
+            (&priority as *const libc::c_int).cast(),
+            std::mem::size_of_val(&priority) as libc::socklen_t,
+        )
+    };
+    if result < 0 {
+        return Err(io::Error::last_os_error());
+    }
+    Ok(socket)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    #[ignore = "requires CAP_NET_RAW and CAP_NET_ADMIN"]
+    fn network_control_priority_and_close_on_exec() {
+        let socket = open().expect("requires CAP_NET_RAW and CAP_NET_ADMIN");
+        let mut priority: libc::c_int = 0;
+        let mut length = std::mem::size_of_val(&priority) as libc::socklen_t;
+        assert_eq!(
+            unsafe {
+                libc::getsockopt(
+                    socket.as_raw_fd(),
+                    libc::SOL_SOCKET,
+                    libc::SO_PRIORITY,
+                    (&mut priority as *mut libc::c_int).cast(),
+                    &mut length,
+                )
+            },
+            0
+        );
+        assert_eq!(priority, 263);
+        assert_ne!(
+            unsafe { libc::fcntl(socket.as_raw_fd(), libc::F_GETFD) } & libc::FD_CLOEXEC,
+            0
+        );
+    }
+}
