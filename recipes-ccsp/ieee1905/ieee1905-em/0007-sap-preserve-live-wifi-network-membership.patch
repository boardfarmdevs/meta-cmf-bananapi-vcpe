+    fn modern_wifi_membership_round_trip_preserves_supplied_bytes() {
+        for media in [MediaType::WIRELESS_802_11ax, MediaType::WIRELESS_802_11be] {
+            for details in [vec![], vec![2, 0, 0, 3, 0xae, 0x99, 0x40, 3, 0, 0]] {
+                let interface = LocalInterface::new(
+                    MacAddr::new(2, 0, 0, 0x0a, 0x91, 0x73),
+                    media,
+                    MediaTypeSpecialInfo::Other(details.clone()),
+                );
+                let encoded = interface.serialize();
+                assert_eq!(encoded[8] as usize, details.len());
+                assert_eq!(&encoded[9..], details.as_slice());
+                let (remaining, decoded) = LocalInterface::parse(&encoded).unwrap();
+                assert!(remaining.is_empty());
+                assert_eq!(decoded, interface);
+                assert_eq!(decoded.serialize(), encoded);
+            }
+        }
+    }
