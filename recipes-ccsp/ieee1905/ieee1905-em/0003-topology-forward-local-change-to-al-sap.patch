 use crate::SDU;
-use crate::al_sap::AlServiceAccessPoint;
+use crate::al_sap::{AlServiceAccessPoint, service_access_point_data_indication};
 use crate::artifact_exchange_service::server::ArtifactExchangeServer;
 use crate::cmdu::TLV;
 use crate::cmdu_codec::*;
@@ -514,6 +514,55 @@ pub async fn cmdu_topology_notification_transmission(
     }
 }
 
+async fn indicate_local_topology_change(
+    message_id_generator: &Arc<MessageIdGenerator>,
+    local_al_mac_address: MacAddr,
+    expired_al_mac_address: MacAddr,
+) {
+    if !AlServiceAccessPoint::is_connected_and_enabled().await {
+        return info!("AL-SAP is not active; local topology-change indication skipped");
+    }
+
+    let message_id = message_id_generator.next_id();
+    let payload = [
+        TLV::from(AlMacAddress {
+            al_mac_address: local_al_mac_address,
+        }),
+        TLV::from(VendorSpecificInfo {
+            oui: COMCAST_OUI,
+            vendor_data: COMCAST_QUERY_TAG,
+        }),
+        TLV::from(EndOfMessage),
+    ];
+    let cmdu = CMDU {
+        message_version: MessageVersion::Version2013.to_u8(),
+        reserved: 0,
+        message_type: CMDUType::TopologyNotification.to_u16(),
+        message_id,
+        fragment: 0,
+        flags: 0x80,
+        payload: payload.iter().flat_map(TLV::serialize).collect(),
+    };
+    let sdu = SDU {
+        // AL-SAP data indications place the local destination first and the
+        // remote/source AL second.  The endpoint metadata carries the expired
+        // neighbor so the local HLE probes only the affected agent.  This is
+        // not transmitted on Ethernet and does not add a private TLV.
+        source_al_mac_address: local_al_mac_address,
+        destination_al_mac_address: expired_al_mac_address,
+        is_fragment: 0,
+        is_last_fragment: 1,
+        fragment_id: 0,
+        payload: cmdu.serialize(),
+    };
+
+    if let Err(error) = service_access_point_data_indication(&sdu).await {
+        error!(message_id, %error, "Failed to deliver local topology-change indication");
+    } else {
+        info!(message_id, "Delivered local topology-change indication through AL-SAP");
+    }
+}
+
 #[instrument(skip_all, name = "topology_change_notification_worker", fields(task = next_task_id()))]
 pub async fn cmdu_topology_change_notification_worker(
     interface: String,
@@ -540,5 +589,10 @@ pub async fn cmdu_topology_change_notification_worker(
                 )
                 .await;
+                indicate_local_topology_change(
+                    &message_id_generator,
+                    local_al_mac_address,
+                    al_mac,
+                ).await;
             }
             Err(tokio::sync::broadcast::error::RecvError::Lagged(skipped)) => {
                 warn!(
