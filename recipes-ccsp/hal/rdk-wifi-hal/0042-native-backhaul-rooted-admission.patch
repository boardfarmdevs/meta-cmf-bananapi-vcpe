 }
 
+static pthread_mutex_t backhaul_root_lock = PTHREAD_MUTEX_INITIALIZER;
+static int backhaul_root_vap = -1;
+static uint64_t backhaul_root_generation;
+static bool backhaul_root_connected;
+static bool backhaul_root_admitted;
+static mac_address_t backhaul_root_parent;
+
+bool wifi_hal_backhaul_root_blocked(wifi_interface_info_t *interface)
+{
+    return interface != NULL && interface->vap_info.vap_mode == wifi_vap_mode_ap &&
+        is_backhaul_interface(interface) &&
+        __atomic_load_n(&backhaul_root_vap, __ATOMIC_ACQUIRE) >= 0 &&
+        !__atomic_load_n(&backhaul_root_admitted, __ATOMIC_ACQUIRE);
+}
+
+bool wifi_hal_backhaul_root_name_blocked(const char *name)
+{
+    unsigned int radio_index;
+    wifi_radio_info_t *radio;
+    wifi_interface_info_t *interface;
+
+    if (__atomic_load_n(&backhaul_root_vap, __ATOMIC_ACQUIRE) < 0) return false;
+    for (radio_index = 0; radio_index < g_wifi_hal.num_radios; radio_index++) {
+        radio = get_radio_by_index(radio_index);
+        if (radio == NULL) continue;
+        hash_map_foreach(radio->interface_map, interface) {
+            if (strcmp(interface->name, name) == 0)
+                return wifi_hal_backhaul_root_blocked(interface);
+        }
+    }
+    return false;
+}
+
+void wifi_hal_backhaul_root_link(wifi_interface_info_t *interface, bool connected)
+{
+    pthread_mutex_lock(&backhaul_root_lock);
+    if (backhaul_root_vap == (int)interface->vap_info.vap_index) {
+        if (!connected || (backhaul_root_connected &&
+                memcmp(backhaul_root_parent, interface->u.sta.backhaul.bssid, 6) != 0)) {
+            ++backhaul_root_generation;
+            __atomic_store_n(&backhaul_root_admitted, false, __ATOMIC_RELEASE);
+        }
+        backhaul_root_connected = connected;
+        if (connected) memcpy(backhaul_root_parent, interface->u.sta.backhaul.bssid, 6);
+        else memset(backhaul_root_parent, 0, 6);
+    }
+    pthread_mutex_unlock(&backhaul_root_lock);
+}
+
+static int backhaul_root_quiesce(void)
+{
+    unsigned int radio_index;
+    wifi_radio_info_t *radio;
+    wifi_interface_info_t *interface;
+    int result = RETURN_OK;
+    short flags;
+
+    if (g_wifi_hal.num_radios == 0) return RETURN_ERR;
+    for (radio_index = 0; radio_index < g_wifi_hal.num_radios; radio_index++) {
+        radio = get_radio_by_index(radio_index);
+        if (radio == NULL) {
+            result = RETURN_ERR;
+            continue;
+        }
+        hash_map_foreach(radio->interface_map, interface) {
+            if (!wifi_hal_backhaul_root_blocked(interface)) continue;
+            nl80211_enable_ap(interface, false);
+            if (nl80211_interface_enable(interface->name, false) != 0 ||
+                get_vap_state(interface->name, &flags) != 0 || (flags & IFF_UP)) {
+                wifi_hal_error_print("Backhaul admission: cannot quiesce %s\n", interface->name);
+                result = RETURN_ERR;
+                continue;
+            }
+            if (interface->bss_started && interface->u.ap.hapd.conf != NULL) {
+                if (reload_interface(interface) != 0) result = RETURN_ERR;
+            }
+            interface->bss_started = false;
+            interface->beacon_set = 0;
+        }
+    }
+    return result;
+}
+
+INT wifi_hal_backhaul_root_loss(INT vap_index)
+{
+    if (__atomic_load_n(&backhaul_root_vap, __ATOMIC_ACQUIRE) != vap_index) return RETURN_OK;
+    return backhaul_root_quiesce();
+}
+
+INT wifi_hal_backhaul_root_close(INT vap_index)
+{
+    wifi_interface_info_t *interface = get_interface_by_vap_index(vap_index);
+    uint64_t initial;
+
+    if (interface == NULL || interface->vap_info.vap_mode != wifi_vap_mode_sta ||
+        !is_wifi_hal_vap_mesh_sta(vap_index)) return RETURN_ERR;
+    pthread_mutex_lock(&backhaul_root_lock);
+    if (backhaul_root_generation == 0) {
+        if (getrandom(&initial, sizeof(initial), 0) != (ssize_t)sizeof(initial) || initial == 0) {
+            __atomic_store_n(&backhaul_root_admitted, false, __ATOMIC_RELEASE);
+            __atomic_store_n(&backhaul_root_vap, vap_index, __ATOMIC_RELEASE);
+            pthread_mutex_unlock(&backhaul_root_lock);
+            backhaul_root_quiesce();
+            return RETURN_ERR;
+        }
+        backhaul_root_generation = initial >> 1;
+    }
+    ++backhaul_root_generation;
+    backhaul_root_connected = false;
+    memset(backhaul_root_parent, 0, 6);
+    __atomic_store_n(&backhaul_root_admitted, false, __ATOMIC_RELEASE);
+    __atomic_store_n(&backhaul_root_vap, vap_index, __ATOMIC_RELEASE);
+    pthread_mutex_unlock(&backhaul_root_lock);
+    return backhaul_root_quiesce();
+}
+
+static void backhaul_root_encode(wifi_interface_info_t *interface, unsigned char *state)
+{
+    unsigned int byte_index;
+    for (byte_index = 0; byte_index < 8; byte_index++)
+        state[byte_index] = backhaul_root_generation >> (56 - 8 * byte_index);
+    memcpy(state + 8, interface->vap_info.u.sta_info.mac, 6);
+    memcpy(state + 14, backhaul_root_parent, 6);
+    state[20] = backhaul_root_connected;
+    state[21] = backhaul_root_admitted;
+}
+
+INT wifi_hal_backhaul_root_state(INT vap_index, unsigned char *state)
+{
+    wifi_interface_info_t *interface = get_interface_by_vap_index(vap_index);
+    int result = RETURN_ERR;
+
+    if (interface == NULL || state == NULL || interface->vap_info.vap_mode != wifi_vap_mode_sta)
+        return RETURN_ERR;
+    pthread_mutex_lock(&backhaul_root_lock);
+    if (backhaul_root_vap == vap_index && backhaul_root_generation != 0) {
+        backhaul_root_encode(interface, state);
+        result = RETURN_OK;
+    }
+    pthread_mutex_unlock(&backhaul_root_lock);
+    return result;
+}
+
+INT wifi_hal_backhaul_root_admit(INT vap_index, const unsigned char *state)
+{
+    wifi_interface_info_t *station = get_interface_by_vap_index(vap_index);
+    wifi_radio_info_t *radio;
+    wifi_interface_info_t *interface;
+    unsigned char current[22];
+    unsigned int radio_index;
+    int result = RETURN_OK;
+
+    if (station == NULL || state == NULL || station->vap_info.vap_mode != wifi_vap_mode_sta)
+        return RETURN_ERR;
+    pthread_mutex_lock(&backhaul_root_lock);
+    backhaul_root_encode(station, current);
+    if (backhaul_root_vap != vap_index || !backhaul_root_connected ||
+        memcmp(current, state, 21) != 0) {
+        pthread_mutex_unlock(&backhaul_root_lock);
+        return RETURN_ERR;
+    }
+    if (backhaul_root_admitted) {
+        pthread_mutex_unlock(&backhaul_root_lock);
+        return RETURN_OK;
+    }
+    __atomic_store_n(&backhaul_root_admitted, true, __ATOMIC_RELEASE);
+    pthread_mutex_unlock(&backhaul_root_lock);
+    for (radio_index = 0; radio_index < g_wifi_hal.num_radios; radio_index++) {
+        radio = get_radio_by_index(radio_index);
+        if (radio == NULL) {
+            result = RETURN_ERR;
+            continue;
+        }
+        if (!radio->configured || !radio->oper_param.enable) continue;
+        hash_map_foreach(radio->interface_map, interface) {
+            if (interface->vap_info.vap_mode != wifi_vap_mode_ap ||
+                !is_backhaul_interface(interface) || !interface->vap_initialized ||
+                !interface->vap_info.u.bss_info.enabled) continue;
+            if (wifi_hal_backhaul_root_blocked(interface) ||
+                nl80211_interface_enable(interface->name, true) != 0 ||
+                restart_interface(interface) != 0) result = RETURN_ERR;
+        }
+    }
+    if (wifi_hal_backhaul_root_state(vap_index, current) != RETURN_OK ||
+        memcmp(current, state, 21) != 0 || current[21] != 1) result = RETURN_ERR;
+    if (result != RETURN_OK) {
+        __atomic_store_n(&backhaul_root_admitted, false, __ATOMIC_RELEASE);
+        backhaul_root_quiesce();
+    }
+    return result;
+}
