# wpa_supplicant 2.10 build config for a WNM/BTM-capable WLAN test station.
#
# CONFIG_WNM=y is the one that matters: it compiles in wnm_sta.c, which receives
# the 802.11v BSS Transition Management Request (category 10 / action 7), sends
# the BTM Response, advertises the BSS-Transition Extended-Capability bit, and
# roams to the steer target. A stock Alpine wpa_supplicant is built WITHOUT it,
# so it receives the BTM Request and silently ignores it -- the client never
# moves on a controller-directed steer.
#
# The rest is the minimum for an nl80211 station on this lab: NL80211 driver,
# libnl-3.0, a control interface for wpa_cli, OpenSSL TLS, and the modern PHY/
# security features (11ac/11w/SAE/FT) so it associates cleanly to the mesh APs.
CONFIG_DRIVER_NL80211=y
CONFIG_LIBNL32=y
CONFIG_CTRL_IFACE=y
CONFIG_BACKEND=file
CONFIG_TLS=openssl
CONFIG_WNM=y
CONFIG_IEEE80211R=y
CONFIG_IEEE80211AC=y
CONFIG_IEEE80211W=y
CONFIG_SAE=y
