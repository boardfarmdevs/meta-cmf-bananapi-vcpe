+static struct wpa_bss *
+wnm_get_transition_candidate(struct wpa_supplicant *wpa_s, const u8 *bssid)
+{
+	struct wpa_bss *current = wpa_s->current_bss;
+	struct wpa_bss *target;
+
+	/*
+	 * A hidden BSS can have both an empty-SSID Beacon entry and a
+	 * full-SSID Probe Response entry in the BSS table. Prefer the entry
+	 * belonging to the current ESS. A BSSID-only lookup can otherwise pick
+	 * the empty entry and reject a valid transition as a different ESS.
+	 */
+	if (current) {
+		target = wpa_bss_get(wpa_s, bssid, current->ssid,
+				     current->ssid_len);
+		if (target)
+			return target;
+	}
+
+	return wpa_bss_get_bssid(wpa_s, bssid);
+}
