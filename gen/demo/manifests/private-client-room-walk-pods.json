    "allow_simulated_candidates": true,
    "request_only": true
  },
  "traffic": {
    "target": "10.0.0.1",
    "interval_seconds": 2,
    "timeout_seconds": 2
  },
  "health": {
    "interval_seconds": 10,
    "expected_mesh_devices": 5,
    "expected_clients": 20,
    "expected_private_clients": 10,
    "expected_iot_clients": 10
  },
  "narrative": [
    {
      "time_ms": 0,
      "label": "Stable near Extender-1"
    },
    {
      "time_ms": 30000,
      "label": "Walking away from the serving AP"
    },
    {
      "time_ms": 90000,
      "label": "Approaching the cell boundary"
    },
    {
      "time_ms": 140000,
      "label": "Crossing into the target room"
    },
    {
      "time_ms": 150000,
      "label": "Steering action window open"
    },
    {
      "time_ms": 220000,
      "label": "Action window closed; verify and cool down"
    }
  ],
  "worlds_root": "gen/wmediumd/configurator/worlds-pods"
