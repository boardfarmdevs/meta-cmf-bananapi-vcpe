{
  "schema": "easymesh.room-demo.v1",
  "name": "private-client-room-walk-pods",
  "description": "One private 5 GHz client walks from Extender-1 toward Extender-4. With two OpenSync pods (pod_1, pod_2) managed through the EMOSA adapter; the lab's own rooms with the pods added (gen/wmediumd/configurator/worlds-pods).",
  "world": "gen/wmediumd/configurator/worlds-pods/golden/home-a-private-client-room-walk.world.json",
