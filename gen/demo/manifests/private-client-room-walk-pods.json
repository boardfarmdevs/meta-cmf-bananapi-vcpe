  "policy": "gen/optimizer/configs/threshold-policy.yaml",
  "hero": {
    "role": "sta_mobile_01",
    "container": "wlan-client-007",
    "friendly_name": "Private-Laptop",
    "expected_ssid": "private_ssid",
    "expected_band": "5"
  },
  "optimizer": {
    "interval_seconds": 5,
    "action_window_ms": [
      150000,
      220000
