# The emosa-lab commit the EMOSA option deploys (build.sh emosa, EASYMESH_EMOSA=1): EMOSA_LAB
# must be a clean checkout of it, as gen/medium and gen/optimizer are pinned (EMOSA_LAB_UNPINNED=1
# takes another, noted). The VM records the one it got (user.easymesh.emosa-lab).
EMOSA_LAB_COMMIT=95a39da008a4b3f5638b5f537a53bdca4dfd9f70
