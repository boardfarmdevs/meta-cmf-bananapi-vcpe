#!/usr/bin/env bash
set -euo pipefail

# This is the terminal appliance-build step. It removes provisioning inputs
# that a packaged VM no longer needs, stops mutable lab state, and makes freed
# blocks compressible before LXD exports the VM backup.
systemctl stop easymesh-lab.service 2>/dev/null || true
systemctl stop wmediumd-console.service 2>/dev/null || true
docker stop dhcp-cpe1 wan-cpe1 >/dev/null 2>&1 || true

docker builder prune -af >/dev/null 2>&1 || true
docker image prune -af >/dev/null 2>&1 || true
apt-get clean
journalctl --rotate >/dev/null 2>&1 || true
journalctl --vacuum-size=16M >/dev/null 2>&1 || true

# Active services own non-empty systemd/snap private directories. Remove
# ordinary top-level temporary files, but leave those live private trees for
# shutdown instead of failing the terminal packaging step.
find /tmp /var/tmp -xdev -mindepth 1 -maxdepth 1 -delete 2>/dev/null || true
find /var/log -type f \( -name '*.gz' -o -name '*.old' -o -name '*.[0-9]' \) \
    -delete
rm -rf /home/easymesh/easymesh-assets

sync
set +e
dd if=/dev/zero of=/EMPTY bs=16M status=none
set -e
sync
rm -f /EMPTY
fstrim -av || true
sync
