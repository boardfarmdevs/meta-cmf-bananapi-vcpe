#!/usr/bin/env bash
set -euo pipefail

exec </dev/null

lab_user=${EASYMESH_LAB_USER:-easymesh}
lab_group=${EASYMESH_LAB_GROUP:-$(id -gn "$lab_user")}
lab_home=${EASYMESH_LAB_HOME:-$(getent passwd "$lab_user" | cut -d: -f6)}
gen=${EASYMESH_GEN:-$lab_home/git/meta-cmf-bananapi-vcpe/gen}
mesh='bpibroadband bpiap bpiap-001 bpiap-002 bpiap-003'
extenders='bpiap bpiap-001 bpiap-002 bpiap-003'
clients=$(lxc list -c n --format csv 2>/dev/null \
    | grep -E '^wlan-client(-[0-9]{3})?$' | sort -V | paste -sd' ' - || true)
client_count=$(printf '%s\n' $clients | sed '/^$/d' | wc -l)
[ "$client_count" -gt 0 ] || { echo 'no provisioned WLAN clients found' >&2; exit 1; }
expected_associated=$((client_count + 4))
# The lab's extenders on a wired backhaul (gen/wired-extender.sh): one more device each
# (three radios, ten BSSes) without a backhaul station association. They start with the
# Wi-Fi extenders (the medium needs every managed container's radios), and their HAL never
# connects a backhaul station (rdk-wifi-hal 0045), so the flat pre-medium medium cannot
# give them a second path into the LAN. They are checked once the medium runs.
wired_extenders=$(for container in $(lxc list -c n --format csv 2>/dev/null \
        | grep -E '^bpiap-[0-9]{3}$' | sort -V); do
    [ "$(lxc config get "$container" user.easymesh.backhaul 2>/dev/null)" = wired ] \
        && echo "$container"
done | paste -sd' ' - || true)
wired_count=$(printf '%s\n' $wired_extenders | sed '/^$/d' | wc -l)
model_devices=$((5 + wired_count))
model_expected="$model_devices/$((3 * model_devices))/$((10 * model_devices))"
state=${EASYMESH_ACCEPTANCE_STATE:-$lab_home/.local/state/easymesh-lab/reboot-acceptance}
medium_backend=${EASYMESH_MEDIUM_BACKEND:-userspace}
kernel_medium_parameter=/sys/module/mac80211_hwsim/parameters/kernel_medium
medium_runtime=/run/meta-cmf-wmediumd
kernel_metrics_socket=$medium_runtime/metrics/control.sock
kernel_metrics_unit=easymesh-kernel-metrics.service
# Controller-first launch is the appliance contract.  Starting the extenders
# in parallel with the controller can let their backhaul associations complete
# before the colocated OneWifi agent has published an authoritative associated-
# client snapshot.  The physical links then work, but the controller model can
# miss all four bSTA ownership rows after a warm reconstruction.
start_mode=${EASYMESH_START_MODE:-gated}
extender_start_parallelism=${EASYMESH_EXTENDER_START_PARALLELISM:-4}
extender_ready_parallelism=${EASYMESH_EXTENDER_READY_PARALLELISM:-4}
extender_stop_parallelism=${EASYMESH_EXTENDER_STOP_PARALLELISM:-4}
client_start_parallelism=${EASYMESH_CLIENT_START_PARALLELISM:-10}
client_ready_parallelism=${EASYMESH_CLIENT_READY_PARALLELISM:-10}
client_stop_parallelism=${EASYMESH_CLIENT_STOP_PARALLELISM:-16}
traffic_parallelism=${EASYMESH_TRAFFIC_PARALLELISM:-10}
client_stop_timeout=${EASYMESH_CLIENT_STOP_TIMEOUT:-2}
mesh_stop_timeout=${EASYMESH_MESH_STOP_TIMEOUT:-10}
burst_start_parallelism=${EASYMESH_BURST_START_PARALLELISM:-$((client_count + 5))}
lifecycle_started_ms=$(date +%s%3N)
lifecycle_timing_file=
lifecycle_phase=
lifecycle_phase_started_ms=0
thin_handoff=${EASYMESH_THIN_HANDOFF:-/run/easymesh-lab/thin-provisioned-handoff.env}

case "$medium_backend" in
userspace|kernel) ;;
*)
    echo "invalid EASYMESH_MEDIUM_BACKEND=$medium_backend (expected userspace or kernel)" >&2
    exit 2
    ;;
esac

case "$start_mode" in
gated|overlap|burst) ;;
*)
    echo "invalid EASYMESH_START_MODE=$start_mode (expected gated, overlap or burst)" >&2
    exit 2
    ;;
esac

action=${1:-start}
case "$action" in
start|stop)
    # systemd and an operator must never reconstruct the same radio pool at
    # once. The lock covers the complete transaction, including failure
    # evidence, and is inherited by every child process.
    exec {lab_runtime_lock}>/run/easymesh-lab-runtime.lock
    if ! flock -n "$lab_runtime_lock"; then
        echo "another EasyMesh lab lifecycle transaction is already active" >&2
        exit 75
    fi
    lifecycle_timing_file=$(mktemp /run/easymesh-lifecycle-timing.XXXXXX)
    for value in "$extender_start_parallelism" "$extender_ready_parallelism" \
            "$extender_stop_parallelism" "$client_start_parallelism" \
            "$client_ready_parallelism" "$client_stop_parallelism" \
            "$traffic_parallelism" "$client_stop_timeout" \
            "$mesh_stop_timeout" "$burst_start_parallelism"; do
        [[ "$value" =~ ^[1-9][0-9]*$ ]] || {
            echo 'lifecycle parallelism and timeout values must be positive integers' >&2
            exit 2
        }
    done
    ;;
esac

begin_phase() {
    lifecycle_phase=$1
    lifecycle_phase_started_ms=$(date +%s%3N)
    echo "EasyMesh lifecycle phase begin: action=$action phase=$lifecycle_phase"
}

end_phase() {
    local finished_ms elapsed_ms
    [ -n "$lifecycle_phase" ] || return 0
    finished_ms=$(date +%s%3N)
    elapsed_ms=$((finished_ms - lifecycle_phase_started_ms))
    printf '%s\t%s\n' "$lifecycle_phase" "$elapsed_ms" >> "$lifecycle_timing_file"
    echo "EasyMesh lifecycle phase end: action=$action phase=$lifecycle_phase elapsed_ms=$elapsed_ms"
    lifecycle_phase=
}

write_lifecycle_timing() {
    local result=$1 finished_ms total_ms output tmp
    finished_ms=$(date +%s%3N)
    total_ms=$((finished_ms - lifecycle_started_ms))
    install -d -m 0755 -o "$lab_user" -g "$lab_group" "$state"
    output=$state/last-$action-timing.json
    tmp=$output.tmp.$$
    jq -Rn \
        --arg action "$action" \
        --arg result "$result" \
        --arg backend "$medium_backend" \
        --arg start_mode "$start_mode" \
        --argjson containers "$((client_count + 5))" \
        --argjson mesh_nodes 5 \
        --argjson clients "$client_count" \
        --argjson total_ms "$total_ms" '
        [inputs | split("\t") | {phase: .[0], elapsed_ms: (.[1] | tonumber)}] as $phases
        | {
            schema_version: 1,
            action: $action,
            result: $result,
            medium_backend: $backend,
            start_mode: $start_mode,
            containers: $containers,
            mesh_nodes: $mesh_nodes,
            clients: $clients,
            elapsed_ms: $total_ms,
            phases: $phases
          }
    ' < "$lifecycle_timing_file" > "$tmp"
    chown "$lab_user:$lab_group" "$tmp"
    mv -f "$tmp" "$output"
    echo "EasyMesh lifecycle timing: action=$action containers=$((client_count + 5)) elapsed_ms=$total_ms output=$output"
    rm -f "$lifecycle_timing_file"
}

select_medium_backend() {
    case "$medium_backend" in
    userspace)
        stop_kernel_metrics_proxy
        # The accepted path remains the default. If the optional module is
        # installed, explicitly turn its data path off before any node starts;
        # wmediumd will register after the complete radio roster is active.
        if [ -w "$kernel_medium_parameter" ]; then
            printf 'N\n' > "$kernel_medium_parameter"
        fi
        ;;
    kernel)
        [ -w "$kernel_medium_parameter" ] || {
            echo 'kernel medium requested but the loaded hwsim module has no writable kernel_medium parameter' >&2
            return 1
        }
        printf 'Y\n' > "$kernel_medium_parameter"
        grep -Eq '^(Y|1)$' "$kernel_medium_parameter" || {
            echo 'kernel medium did not enable' >&2
            return 1
        }
        [ -r /sys/module/mac80211_hwsim/parameters/kernel_medium_generation ] || {
            echo 'kernel medium requested but atomic matrix controls are absent' >&2
            return 1
        }
        ;;
    esac
    echo "medium backend selected: $medium_backend"
}

stop_kernel_metrics_proxy() {
    systemctl stop "$kernel_metrics_unit" >/dev/null 2>&1 || true
    systemctl reset-failed "$kernel_metrics_unit" >/dev/null 2>&1 || true
    rm -f "$kernel_metrics_socket"
}

start_kernel_metrics_proxy() {
    local status
    stop_kernel_metrics_proxy
    install -d -m 0755 -o root -g root "$medium_runtime/metrics"
    systemd-run --quiet --collect --unit="$kernel_metrics_unit" \
        --property=Type=simple \
        --property=Restart=on-failure \
        --property=RestartSec=1 \
        /usr/bin/env PYTHONPATH="$gen/medium/configurator" \
            /usr/bin/python3 -m wmdcfg.kernel_metrics_proxy \
            --socket "$kernel_metrics_socket"
    for _ in $(seq 1 50); do
        [ -S "$kernel_metrics_socket" ] \
            && systemctl is-active --quiet "$kernel_metrics_unit" && break
        sleep 0.1
    done
    [ -S "$kernel_metrics_socket" ] \
        && systemctl is-active --quiet "$kernel_metrics_unit" || {
        journalctl -u "$kernel_metrics_unit" -n 30 --no-pager >&2 || true
        return 1
    }
    status=$(PYTHONPATH="$gen/medium/configurator" \
        python3 -m wmdcfg.cli status --socket "$kernel_metrics_socket")
    jq -e '.capabilities | index("read_only") != null' >/dev/null <<<"$status"
}

verify_medium_backend() {
    [ "$(cat /sys/module/cfg80211/version 2>/dev/null)" = lab-netns-owner-1 ] || {
        echo "cfg80211 lacks namespace-safe socket cleanup" >&2
        return 1
    }
    local status
    case "$medium_backend" in
    userspace)
        status=$("$gen/medium/wmediumd/wmediumd-up.sh" status)
        [[ "$status" == *'wmediumd running'* ]]
        ;;
    kernel)
        grep -Eq '^(Y|1)$' "$kernel_medium_parameter"
        status=$(PYTHONPATH="$gen/medium/configurator" \
            python3 -m wmdcfg.cli status --backend kernel)
        jq -e '.capabilities | index("kernel_data_path") != null' \
            >/dev/null <<< "$status"
        # A registered userspace daemon always takes precedence, which would
        # make a requested kernel run silently exercise the wrong data path.
        ! pgrep -f '^/home/[^[:space:]]+/.*/gen/medium/wmediumd/build/wmediumd([[:space:]]|$)' \
            >/dev/null 2>&1
        [ -S "$kernel_metrics_socket" ]
        systemctl is-active --quiet "$kernel_metrics_unit"
        ;;
    esac
}

publish_radio_identity_inventory() {
    local runtime=/run/meta-cmf-wmediumd
    local output=$runtime/identity-inventory.json
    install -d -m 0775 -o root -g lxd "$runtime"
    "$gen/medium/observer/generate-identity-inventory.sh" --output "$output"
    jq -e --argjson expected "$((client_count + 5))" \
        '(.stations | length) == $expected' "$output" >/dev/null
}

instance_state() {
    lxc info "$1" 2>/dev/null | sed -n 's/^Status: //p'
}

start_instance() {
    local container=$1 attempt poll
    lxc info "$container" >/dev/null 2>&1
    [ "$(instance_state "$container")" = RUNNING ] && return 0
    for attempt in 1 2 3; do
        lxc start "$container" >/dev/null 2>&1 || true
        for poll in $(seq 1 15); do
            [ "$(instance_state "$container")" = RUNNING ] && return 0
            sleep 1
        done
    done
    echo "$container did not start after three attempts" >&2
    return 1
}

wait_pid_batch() {
    local pid failed=0
    for pid in "$@"; do
        wait "$pid" || failed=1
    done
    return "$failed"
}

run_bounded() {
    local parallelism=$1 function=$2 item failed=0
    local -a pids=()
    shift 2
    for item in "$@"; do
        "$function" "$item" &
        pids+=("$!")
        if [ "${#pids[@]}" -ge "$parallelism" ]; then
            wait_pid_batch "${pids[@]}" || failed=1
            pids=()
        fi
    done
    wait_pid_batch "${pids[@]}" || failed=1
    return "$failed"
}

start_instances_bounded() {
    local parallelism=$1
    shift
    run_bounded "$parallelism" start_instance "$@"
}

stop_instance() {
    local container=$1 timeout=${2:-$mesh_stop_timeout}
    [ "$(instance_state "$container")" = RUNNING ] || return 0
    lxc stop "$container" --timeout "$timeout" >/dev/null 2>&1 \
        || lxc stop "$container" --force >/dev/null 2>&1 \
        || true
}

stop_client_instance() {
    local container=$1
    stop_instance "$container" "$client_stop_timeout"
    lxc config set "$container" boot.autostart false
}

stop_extender_instance() {
    local container=$1
    stop_instance "$container" "$mesh_stop_timeout"
    lxc config set "$container" boot.autostart false
}

stop_client_instances() {
    # Client namespaces are independent. Stop them in bounded batches so the
    # 50/100-client profiles do not exceed the systemd stop budget. They have
    # no persistent service state, so use a short graceful interval and then
    # let LXD force the individual namespace down. Finish every stop before
    # reclaiming returned PHYs.
    local -a reverse_clients=()
    mapfile -t reverse_clients < <(printf '%s\n' $clients | sort -Vr)
    run_bounded "$client_stop_parallelism" stop_client_instance \
        "${reverse_clients[@]}"
}

stop_mesh_instances() {
    run_bounded "$extender_stop_parallelism" stop_extender_instance $wired_extenders $extenders
    stop_instance bpibroadband "$mesh_stop_timeout"
    lxc config set bpibroadband boot.autostart false
}

reclaim_hwsim_vifs() {
    local phy netdevs pool_dev netdev
    # A stopped physical-NIC container returns its complete hwsim wiphy to the
    # host. OneWifi-created VAPs survive that move and exhaust the wiphy's
    # interface combinations on the next start (iw reports ENFILE). With every
    # managed instance stopped, retain only the stable virt-wlanN pool device.
    for phy in /sys/class/ieee80211/phy*; do
        netdevs=$(ls "$phy/device/net" 2>/dev/null || true)
        pool_dev=$(printf '%s\n' "$netdevs" | grep -m1 '^virt-wlan[0-9]\+$' || true)
        [ -n "$pool_dev" ] || continue
        while read -r netdev; do
            [ -n "$netdev" ] || continue
            [ "$netdev" = "$pool_dev" ] && continue
            iw dev "$netdev" del
        done <<< "$netdevs"
    done
}

wait_wan_provider() {
    local attempt
    for attempt in $(seq 1 60); do
        if [ "$(docker inspect -f '{{.State.Running}}' dhcp-cpe1 2>/dev/null || true)" = true ] \
            && [ "$(docker inspect -f '{{.State.Running}}' wan-cpe1 2>/dev/null || true)" = true ] \
            && docker exec dhcp-cpe1 ip -4 address show eth1 2>/dev/null \
                | grep -q '10\.101\.0\.10/24' \
            && docker exec dhcp-cpe1 ss -lun 2>/dev/null | grep -q ':67 ' \
            && docker exec wan-cpe1 ip -4 address show eth1 2>/dev/null \
                | grep -q '10\.101\.0\.20/24'; then
            echo "WAN provider ready after ${attempt}s"
            return 0
        fi
        sleep 1
    done
    echo 'Boardfarm WAN provider is not serving DHCP after 60 seconds' >&2
    return 1
}

al_mac_for() {
    local container=$1 base prefix octet value
    if [ "$container" = bpibroadband ]; then
        # The colocated agent derives its interface MAC from the controller's
        # deterministic WAN MAC and does not create em_al_base_mac.
        base=$(lxc profile get bpibroadband environment.STORED_MAC1 \
            | tr '[:upper:]' '[:lower:]')
    else
        base=$(lxc exec "$container" -- cat /nvram/em_al_base_mac 2>/dev/null)
    fi
    [[ "$base" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]] || return 1
    prefix=${base%:*}
    octet=${base##*:}
    value=$((0x$octet + 0x20))
    printf '%s:%02x\n' "$prefix" "$value"
}

model_bss_for() {
    local container=$1 al_mac
    al_mac=$(al_mac_for "$container") || return 0
    lxc exec bpibroadband -- mysql -N -ubpi -proot OneWifiMesh -e \
        "select count(*) from BSSList where ID like 'OneWifiMesh@${al_mac}@%';" \
        2>/dev/null || true
}

wait_controller() {
    local attempt private_count iot_count bss_count
    for attempt in $(seq 1 48); do
        private_count=$(lxc exec bpibroadband -- iw dev 2>/dev/null \
            | grep -c 'ssid private_ssid' || true)
        iot_count=$(lxc exec bpibroadband -- iw dev 2>/dev/null \
            | grep -c 'ssid iot_ssid' || true)
        bss_count=$(model_bss_for bpibroadband)
        if lxc exec bpibroadband -- systemctl is-active --quiet \
                onewifi ieee1905_em_ctrl em_ctrl ieee1905_em_agent em_agent em_cli \
                2>/dev/null \
            && lxc exec bpibroadband -- sh -c \
                "ip -4 -o address show erouter0 | grep -q 'inet '" \
            && [ "$private_count" -eq 3 ] \
            && [ "$iot_count" -eq 3 ] \
            && [ "${bss_count:-0}" -eq 10 ] \
            && curl -fsS http://127.0.0.1:8888/api/v1/topology >/dev/null; then
            return 0
        fi
        sleep 5
    done
    echo 'controller did not become ready after boot' >&2
    return 1
}

wait_extender_live() {
    local container=$1 attempt private_count iot_count bss_count
    for attempt in $(seq 1 48); do
        private_count=$(lxc exec "$container" -- iw dev 2>/dev/null \
            | grep -c 'ssid private_ssid' || true)
        iot_count=$(lxc exec "$container" -- iw dev 2>/dev/null \
            | grep -c 'ssid iot_ssid' || true)
        bss_count=$(model_bss_for "$container")
        if [ "$private_count" -eq 3 ] && [ "$iot_count" -eq 3 ] \
            && [ "${bss_count:-0}" -eq 10 ] \
            && lxc exec "$container" -- systemctl is-active --quiet \
                onewifi ieee1905_em_agent em_agent 2>/dev/null \
            && lxc exec "$container" -- sh -c \
                "iw dev wifi1.3 link | grep -q 'Connected to'"; then
            return 0
        fi
        sleep 5
    done
    echo "$container did not receive its complete tri-band configuration" >&2
    return 1
}

wait_wired_extender_live() {
    # its fronthaul up, its model complete, eth1 (its LAN port) in its brlan0, the
    # gateway's wired LAN port in the gateway's brlan0, and no Wi-Fi station up
    local container=$1 attempt private_count iot_count bss_count stations
    for attempt in $(seq 1 48); do
        private_count=$(lxc exec "$container" -- iw dev 2>/dev/null \
            | grep -c 'ssid private_ssid' || true)
        iot_count=$(lxc exec "$container" -- iw dev 2>/dev/null \
            | grep -c 'ssid iot_ssid' || true)
        bss_count=$(model_bss_for "$container")
        stations=$(lxc exec "$container" -- sh -c \
            'for n in /sys/class/net/*; do [ -e "$n/phy80211" ] || continue
                iw dev "${n##*/}" info 2>/dev/null | grep -q "type managed" || continue
                [ "$(cat "$n/operstate")" = down ] || echo "${n##*/}"; done' \
            2>/dev/null || echo unknown)
        if [ "$private_count" -eq 3 ] && [ "$iot_count" -eq 3 ] \
            && [ "${bss_count:-0}" -eq 10 ] && [ -z "$stations" ] \
            && lxc exec "$container" -- systemctl is-active --quiet \
                onewifi em_agent lab-wired-backhaul 2>/dev/null \
            && lxc exec "$container" -- sh -c \
                '[ "$(basename "$(readlink /sys/class/net/eth1/master)")" = brlan0 ]' \
            && lxc exec bpibroadband -- sh -c 'brctl show brlan0 | grep -qw eth2'; then
            return 0
        fi
        sleep 5
    done
    echo "$container did not come up on its wired backhaul (stations up: ${stations:-none})" >&2
    return 1
}

wait_mesh_model() {
    # wifi: the controller and the Wi-Fi extenders, before any wired extender runs (the
    # model may still hold a wired extender's rows); final: every mesh node, exact totals
    local scope=${1:-final} attempt counts complete container
    for attempt in $(seq 1 48); do
        counts=$(lxc exec bpibroadband -- mysql -N -ubpi -proot OneWifiMesh -e \
            'select concat((select count(*) from DeviceList),"/",(select count(*) from RadioList),"/",(select count(*) from BSSList))' \
            2>/dev/null || true)
        complete=1
        for container in $mesh $([ "$scope" = wifi ] || echo "$wired_extenders"); do
            [ "$(model_bss_for "$container")" = 10 ] || complete=0
        done
        if [ "$complete" -eq 1 ] && { [ "$counts" = "$model_expected" ] \
                || { [ "$scope" = wifi ] && [ "$wired_count" -gt 0 ]; }; }; then
            return 0
        fi
        sleep 5
    done
    echo "mesh did not converge after boot (model=${counts:-unavailable})" >&2
    return 1
}

enable_metrics_reporting() {
    # wifi: at least the Wi-Fi mesh (a wired extender may not run yet); final: every device
    local scope=${1:-final} attempt response devices=$model_devices
    [ "$scope" = final ] || devices=5
    for attempt in $(seq 1 12); do
        response=$(curl -fsS --max-time 45 -X POST \
            http://127.0.0.1:8888/api/v1/metricsreporting/enable 2>/dev/null || true)
        if jq -e --argjson devices "$devices" --arg scope "$scope" \
                '.success == true and .radios == 3 * .devices
                 and (if $scope == "final" then .devices == $devices else .devices >= $devices end)' \
                >/dev/null 2>&1 <<< "$response"; then
            echo "metrics policy active on $(jq -r .devices <<< "$response") devices / $(jq -r .radios <<< "$response") radios"
            return 0
        fi
        sleep 5
    done
    echo "metrics reporting could not be activated: ${response:-no API response}" >&2
    return 1
}

wait_client_live() {
    local client=$1 attempt
    for attempt in $(seq 1 36); do
        if lxc exec "$client" -- sh -c \
                "iw dev wlan0 link | grep -q 'Connected to' && ip -4 -o address show wlan0 | grep -q 'inet '" \
                2>/dev/null; then
            return 0
        fi
        if lxc exec "$client" -- sh -c \
                "iw dev wlan0 link | grep -q 'Connected to'" 2>/dev/null; then
            lxc exec "$client" -- udhcpc -i wlan0 -n -q >/dev/null 2>&1 || true
        fi
        # Warm LXC startup can race OpenRC against the physical hwsim
        # move/rename. The symptom is a live supplicant on a DOWN wlan0 which
        # never sends authentication. Repeat the persisted transaction only
        # when association has made no progress; this repairs the namespace
        # handoff without restarting an EasyMesh component.
        if [ "$attempt" -eq 12 ] || [ "$attempt" -eq 24 ]; then
            echo "$client association incomplete; retrying persisted WLAN configuration"
            lxc exec "$client" -- sh -c '
                for pid in $(pgrep -f "^[^ ]*wpa_supplicant" 2>/dev/null); do
                    kill "$pid" 2>/dev/null || true
                done
                sleep 1
                rm -f /run/wpa_supplicant/wlan0 /var/run/wpa_supplicant/wlan0
                ip link set wlan0 up
                # A previous association can have completed DHCP before the
                # link was lost. The BusyBox udhcpc default script adds its new
                # lease instead of replacing that address, leaving the old
                # lease as a secondary address after this recovery retry.
                ip -4 address flush dev wlan0 scope global 2>/dev/null || true
                /etc/local.d/wlan.start'
        fi
        sleep 5
    done
    echo "$client did not associate and obtain DHCP after boot" >&2
    return 1
}

verify_client_ipv4_ownership() {
    local client addresses count address
    local -A owner=()

    for client in $clients; do
        addresses=$(lxc exec "$client" -- ip -4 -o address show \
            dev wlan0 scope global 2>/dev/null | awk '{print $4}')
        count=$(wc -w <<< "$addresses")
        if [ "$count" -ne 1 ]; then
            echo "$client has $count global IPv4 addresses on wlan0; expected exactly one: ${addresses:-none}" >&2
            return 1
        fi
        address=${addresses%/*}
        if [ -n "${owner[$address]+present}" ]; then
            echo "$client and ${owner[$address]} both own IPv4 address $address" >&2
            return 1
        fi
        owner[$address]=$client
    done
    echo "all $client_count WLAN clients own one unique IPv4 address"
}

live_client_count() {
    curl -fsS http://127.0.0.1:8888/api/v1/topology 2>/dev/null \
        | jq -r '[.nodes[]?.STAList[]?.staMAC | select(. != null and . != "")] | unique | length' \
        2>/dev/null
}

live_client_metrics_count() {
    curl -fsS http://127.0.0.1:8888/api/v1/clients 2>/dev/null \
        | jq -r '[.clients[]? | select((.client_metrics.rcpi // 0) > 0)] | length' \
        2>/dev/null
}

trigger_client_metric_frames() {
    local client
    for client in $clients; do
        lxc exec "$client" -- ping -I wlan0 -q -c 1 -W 2 10.0.0.1 \
            >/dev/null 2>&1 &
    done
    wait || true
}

wait_client_metrics() {
    local attempt reporting
    for attempt in $(seq 1 24); do
        if [ "$attempt" -eq 1 ] || [ $((attempt % 4)) -eq 0 ]; then
            trigger_client_metric_frames
        fi
        reporting=$(live_client_metrics_count || true)
        if [ "$reporting" = "$client_count" ]; then
            echo "all $client_count WLAN clients report non-zero RCPI"
            return 0
        fi
        # A Policy Configuration ACK proves that an Agent accepted the CMDU,
        # but the useful end-to-end condition is that every associated STA is
        # actually present in a periodic metrics report.  A rare raw-frame
        # delivery miss can leave one Agent's volatile reporting timer idle
        # even though desired policy and all ACK bookkeeping look complete.
        # Re-deploy the complete idempotent policy while the observed result is
        # incomplete; this is a bounded convergence loop, not an operator
        # nudge, and it stops immediately once all reports are visible.
        if [ $((attempt % 4)) -eq 0 ]; then
            echo "metrics incomplete (${reporting:-?}/$client_count); replaying complete policy"
            enable_metrics_reporting
        fi
        sleep 5
    done
    echo "client metrics did not converge (non-zero RCPI=${reporting:-?}/$client_count)" >&2
    return 1
}

wait_clients() {
    local attempt topology_clients associated
    for attempt in $(seq 1 48); do
        topology_clients=$(live_client_count || true)
        associated=$(lxc exec bpibroadband -- mysql -N -ubpi -proot OneWifiMesh \
            -e 'select count(*) from STAList where Associated=1' 2>/dev/null || true)
        if [ "$topology_clients" = "$client_count" ] \
            && [ "$associated" = "$expected_associated" ]; then
            return 0
        fi
        sleep 5
    done
    echo "client model did not converge (live topology=${topology_clients:-?}, associated=${associated:-?})" >&2
    return 1
}

restart_report() {
    local container units
    for container in $mesh $wired_extenders; do
        units='onewifi em_agent'
        [ "$container" = bpibroadband ] && units="$units em_ctrl em_cli"
        # One namespace crossing per container is materially faster than one
        # lxc exec per unit, especially while the VM is under Docker I/O load.
        lxc exec "$container" -- sh -c '
            container=$1
            shift
            for unit do
                restarts=$(systemctl show "$unit" -p NRestarts --value) || exit 1
                printf "%s %s=%s\n" "$container" "$unit" "$restarts"
            done
        ' sh "$container" $units 2>/dev/null || return 1
    done
}

assert_zero_restarts() {
    local report
    report=$(restart_report) || return 1
    printf '%s\n' "$report"
    if printf '%s\n' "$report" | grep -Ev '=0$'; then
        echo 'an EasyMesh or OneWifi service restarted during reconstruction' >&2
        return 1
    fi
}

verify_stability_window() {
    local deadline model topology_clients
    deadline=$((SECONDS + 120))
    while :; do
        model=$(lxc exec bpibroadband -- mysql -N -ubpi -proot OneWifiMesh -e \
            'select concat((select count(*) from DeviceList),"/",(select count(*) from RadioList),"/",(select count(*) from BSSList),"/",(select count(*) from STAList where Associated=1))' \
            2>/dev/null || true)
        topology_clients=$(live_client_count || true)
        [ "$model" = "$model_expected/$expected_associated" ] \
            && [ "$topology_clients" = "$client_count" ]
        assert_zero_restarts >/dev/null
        [ "$SECONDS" -ge "$deadline" ] && break
        sleep 5
    done
    echo 'topology and zero-restart state held for 120 seconds'
}

client_traffic_one() {
    local client=$1 output loss
    output=$(lxc exec "$client" -- ping -q -c 3 -W 1 10.0.0.1 2>&1 || true)
    loss=$(printf '%s\n' "$output" \
        | sed -n 's/.* \([0-9]*%\) packet loss.*/\1/p')
    printf '%s packet_loss=%s\n' "$client" "${loss:-FAIL}"
}

client_traffic_report() {
    run_bounded "$traffic_parallelism" client_traffic_one $clients
}

verify_client_traffic_one() {
    local client=$1 attempt
    for attempt in 1 2 3; do
        if lxc exec "$client" -- ping -q -c 3 -W 1 10.0.0.1 \
                >/dev/null 2>&1; then
            return 0
        fi
        sleep 2
    done
    echo "$client cannot reach the WLAN gateway after three retries" >&2
    return 1
}

verify_client_traffic() {
    run_bounded "$traffic_parallelism" verify_client_traffic_one $clients
    echo "all $client_count WLAN clients reach 10.0.0.1"
}

capture_result() {
    local result=$1 boot_id run_id run
    boot_id=$(cat /proc/sys/kernel/random/boot_id)
    run_id=$(date -u +%Y%m%dT%H%M%SZ)
    run="$state/$boot_id/$run_id"
    install -d -o "$lab_user" -g "$lab_group" "$run"
    date -Ins > "$run/completed-at.txt"
    printf '%s\n' "$result" > "$run/result.txt"
    printf '%s\n' "$medium_backend" > "$run/medium-backend.txt"
    lxc list -c ns4t > "$run/lxc-list.txt" 2>&1 || true
    curl -fsS http://127.0.0.1:8888/api/v1/topology > "$run/topology.json" 2>/dev/null || true
    curl -fsS http://127.0.0.1:8888/api/v1/clients > "$run/clients.json" 2>/dev/null || true
    lxc exec bpibroadband -- mysql -N -ubpi -proot OneWifiMesh -e \
        'select count(*) from DeviceList; select count(*) from RadioList; select count(*) from BSSList; select count(*) from STAList where Associated=1;' \
        > "$run/model-counts.txt" 2>&1 || true
    for client in $clients; do
        lxc exec "$client" -- ip -4 -o address show dev wlan0 scope global \
            2>/dev/null | awk -v client="$client" '{print client, $4}'
    done > "$run/client-addresses.txt" 2>&1 || true
    restart_report > "$run/restarts.txt" 2>&1 || true
    client_traffic_report > "$run/client-traffic.txt" 2>&1 || true
    if [ "$medium_backend" = userspace ]; then
        if [ -f /run/meta-cmf-wmediumd/wmediumd.log ]; then
            cp /run/meta-cmf-wmediumd/wmediumd.log "$run/wmediumd.log"
        elif [ -f /tmp/wmediumd.log ]; then
            cp /tmp/wmediumd.log "$run/wmediumd.log"
        fi
    fi
    if [ -r /sys/module/mac80211_hwsim/parameters/kernel_medium ]; then
        for parameter in kernel_medium kernel_medium_cutoff \
            kernel_medium_loss_pct kernel_medium_bank \
            kernel_medium_generation; do
            [ -r "/sys/module/mac80211_hwsim/parameters/$parameter" ] || continue
            printf '%s=%s\n' "$parameter" \
                "$(cat "/sys/module/mac80211_hwsim/parameters/$parameter")"
        done > "$run/kernel-medium.txt"
    fi
    journalctl -b -u easymesh-lab.service -o short-iso > "$run/easymesh-lab-journal.txt" 2>&1 || true
    journalctl -b -u "$kernel_metrics_unit" -o short-iso > "$run/kernel-metrics-journal.txt" 2>&1 || true
    chown -R "$lab_user:$lab_group" "$run"
}

accept_thin_provisioned_handoff() {
    local expected_instances actual_instances running_instances repo_head

    [ -s "$thin_handoff" ] || return 1
    # shellcheck disable=SC1090
    . "$thin_handoff"
    : "${THIN_HANDOFF_CLIENTS:?missing THIN_HANDOFF_CLIENTS}"
    : "${THIN_HANDOFF_INSTANCES:?missing THIN_HANDOFF_INSTANCES}"
    : "${THIN_HANDOFF_REPO_HEAD:?missing THIN_HANDOFF_REPO_HEAD}"
    [[ "$THIN_HANDOFF_CLIENTS" =~ ^[0-9]+$ ]]
    [[ "$THIN_HANDOFF_INSTANCES" =~ ^[0-9]+$ ]]
    [ "$THIN_HANDOFF_CLIENTS" -eq "$client_count" ]
    expected_instances=$((client_count + 5))
    [ "$THIN_HANDOFF_INSTANCES" -eq "$expected_instances" ]

    actual_instances=$(lxc list -c n --format csv | awk '
        /^(bpibroadband|bpiap(-[0-9]{3})?|wlan-client(-[0-9]{3})?)$/ {n++}
        END {print n+0}')
    running_instances=$(lxc list -c ns --format csv | awk -F, '
        $1 ~ /^(bpibroadband|bpiap(-[0-9]{3})?|wlan-client(-[0-9]{3})?)$/ &&
            $2 == "RUNNING" {n++}
        END {print n+0}')
    [ "$actual_instances" -eq "$expected_instances" ]
    [ "$running_instances" -eq "$expected_instances" ]

    repo_head=$(git -c safe.directory="${gen%/gen}" -C "${gen%/gen}" rev-parse HEAD)
    [ "$repo_head" = "$THIN_HANDOFF_REPO_HEAD" ]
    verify_medium_backend
    [ "$(live_client_count)" -eq "$client_count" ]
    [ "$(lxc exec bpibroadband -- mysql -N -ubpi -proot OneWifiMesh -e \
        'select count(*) from DeviceList;' 2>/dev/null)" -eq 5 ]
}

case "$action" in
start)
    result=FAIL
    trap 'if [ "$result" != PASS ]; then capture_result "$result"; fi; rm -f "$lifecycle_timing_file"' EXIT
    if [ -s "$thin_handoff" ]; then
        begin_phase thin_provisioned_handoff
        if accept_thin_provisioned_handoff; then
            rm -f "$thin_handoff"
            end_phase
            result=PASS
            write_lifecycle_timing "$result"
            trap - EXIT
            echo "EasyMesh thin first-boot handoff PASS: preserving $((client_count + 5)) running instances for final acceptance"
            exit 0
        fi
        echo 'thin first-boot handoff validation failed; falling back to normal reconstruction' >&2
        rm -f "$thin_handoff"
        end_phase
    fi
    begin_phase infrastructure
    systemctl start docker.service snap.lxd.daemon.service
    for attempt in $(seq 1 30); do
        ip link show br-wan101 >/dev/null 2>&1 \
            && docker inspect dhcp-cpe1 wan-cpe1 >/dev/null 2>&1 \
            && break
        sleep 1
    done
    ip link show br-wan101 >/dev/null
    docker start dhcp-cpe1 wan-cpe1 >/dev/null
    wait_wan_provider
    end_phase

    # A pre-fix appliance may let LXD restore clients from its previous-power
    # state. Quiesce every managed node so this service still establishes the
    # same controller -> extenders -> clients order on its first corrected boot.
    # LXD is installed as a snap in the appliance. A non-login `sudo -u`
    # process started by systemd cannot be tracked by snapd, so its `lxc`
    # discovery calls return no containers even when the user is in the lxd
    # group. Keep lifecycle ownership in this root service; wmediumd-up still
    # applies its narrow socket permissions for operator access.
    begin_phase quiesce_and_radio_reset
    "$gen/medium/wmediumd/wmediumd-up.sh" down >/dev/null 2>&1 || true
    stop_client_instances
    stop_mesh_instances
    reclaim_hwsim_vifs
    select_medium_backend
    end_phase

    case "$start_mode" in
    gated)
        begin_phase controller
        start_instance bpibroadband
        wait_controller
        end_phase

        begin_phase extenders
        start_instances_bounded "$extender_start_parallelism" $extenders $wired_extenders
        run_bounded "$extender_ready_parallelism" wait_extender_live $extenders
        ;;
    overlap)
        begin_phase mesh_launch
        start_instances_bounded "$extender_start_parallelism" $mesh $wired_extenders
        end_phase

        begin_phase controller
        wait_controller
        end_phase

        begin_phase extenders
        run_bounded "$extender_ready_parallelism" wait_extender_live $extenders
        ;;
    burst)
        begin_phase all_container_launch
        start_instances_bounded "$burst_start_parallelism" $mesh $wired_extenders $clients
        end_phase

        begin_phase controller
        wait_controller
        end_phase

        begin_phase extenders
        run_bounded "$extender_ready_parallelism" wait_extender_live $extenders
        ;;
    esac
    wait_mesh_model wifi
    end_phase

    begin_phase initial_metrics_policy
    enable_metrics_reporting wifi
    end_phase

    begin_phase clients
    if [ "$start_mode" != burst ]; then
        start_instances_bounded "$client_start_parallelism" $clients
    fi
    run_bounded "$client_ready_parallelism" wait_client_live $clients
    end_phase

    begin_phase medium
    if [ "$medium_backend" = userspace ]; then
        env SNR=40 "$gen/medium/wmediumd/wmediumd-up.sh" up
    else
        # Stable radio ownership is consumed by steering, the Console and
        # test tooling independently of the packet data path.  Userspace
        # wmediumd creates it while starting; publish the same contract when
        # the in-kernel backend owns frame delivery.
        publish_radio_identity_inventory
        start_kernel_metrics_proxy
        verify_medium_backend
    fi
    end_phase

    if [ "$wired_count" -gt 0 ]; then
        begin_phase wired_extenders
        run_bounded "$extender_ready_parallelism" wait_wired_extender_live $wired_extenders
        end_phase
    fi

    begin_phase convergence_and_acceptance
    wait_clients
    verify_client_ipv4_ownership
    wait_mesh_model
    # Policy state in the agents is volatile.  The first application starts
    # reporting early, but an agent can finish its operational transition
    # while the WLAN clients are associating and lose that timer.  Replay the
    # complete, idempotent policy after the live client model has converged so
    # every operational agent receives the same final policy state.
    enable_metrics_reporting
    wait_client_metrics
    verify_stability_window
    assert_zero_restarts
    verify_client_traffic
    end_phase
    result=PASS

    begin_phase evidence_capture
    capture_result "$result"
    end_phase
    write_lifecycle_timing "$result"
    trap - EXIT
    echo "EasyMesh cold-boot reconstruction PASS: model=$model_expected clients=$client_count/$client_count metrics=$client_count/$client_count associated=$expected_associated restarts=0"
    ;;
stop)
    begin_phase medium
    stop_kernel_metrics_proxy
    "$gen/medium/wmediumd/wmediumd-up.sh" down >/dev/null 2>&1 || true
    end_phase

    begin_phase clients
    stop_client_instances
    end_phase

    begin_phase mesh
    stop_mesh_instances
    end_phase

    begin_phase radio_reset
    if [ -w "$kernel_medium_parameter" ]; then
        printf 'N\n' > "$kernel_medium_parameter"
    fi
    end_phase
    write_lifecycle_timing PASS
    ;;
status)
    systemctl is-active --quiet docker.service snap.lxd.daemon.service
    docker inspect -f '{{.State.Running}}' dhcp-cpe1 wan-cpe1 | grep -vx true && exit 1 || true
    for container in $mesh $wired_extenders $clients; do
        [ "$(instance_state "$container")" = RUNNING ] || exit 1
    done
    verify_medium_backend
    [ "$(lxc exec bpibroadband -- mysql -N -ubpi -proot OneWifiMesh -e \
        'select concat((select count(*) from DeviceList),"/",(select count(*) from RadioList),"/",(select count(*) from BSSList),"/",(select count(*) from STAList where Associated=1))' \
        2>/dev/null)" = "$model_expected/$expected_associated" ]
    [ "$(live_client_count)" = "$client_count" ]
    [ "$(live_client_metrics_count)" = "$client_count" ]
    verify_client_ipv4_ownership >/dev/null
    assert_zero_restarts >/dev/null
    verify_client_traffic >/dev/null
    ;;
*)
    echo "usage: $0 {start|stop|status}" >&2
    exit 2
    ;;
esac
