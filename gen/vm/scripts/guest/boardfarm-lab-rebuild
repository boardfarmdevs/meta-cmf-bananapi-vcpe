#!/usr/bin/env bash
set -euo pipefail

: "${BOARDFARM_WORKSPACE:=/home/vagrant/boardfarm-open-0406}"
: "${BF_LAB_CONFIG:=boardfarm-easymesh.json}"
: "${BF_INVENTORY:=boardfarm-easymesh.json}"
export BOARDFARM_WORKSPACE BF_LAB_CONFIG BF_INVENTORY

lab_repo="$BOARDFARM_WORKSPACE/boardfarm-lab-staging"
bf_lab="$BOARDFARM_WORKSPACE/.venv/bin/bf-lab"

test -x "$bf_lab"
test -f "$lab_repo/lab/$BF_LAB_CONFIG"
test -f "$lab_repo/inventories/$BF_INVENTORY"

# A forced host power-off can leave LXD's volatile state marked RUNNING even
# though boot.autostart is false. Release br-wan105 before bf-lab removes and
# recreates that Docker bridge.
for instance in wlan-client-009 wlan-client-008 wlan-client-007 wlan-client-006 \
    wlan-client-005 wlan-client-004 wlan-client-003 wlan-client-002 \
    wlan-client-001 wlan-client bpiap-003 bpiap-002 bpiap-001 bpiap \
    bpibroadband; do
    if [ "$(lxc info "$instance" 2>/dev/null | sed -n 's/^Status: //p')" = RUNNING ]; then
        lxc stop "$instance" --force
    fi
done

cd "$lab_repo/lab"
"$bf_lab" teardown,setup,status

test "$(docker network inspect wan-cpe5 -f '{{index .Options "com.docker.network.bridge.name"}}')" = br-wan105
ip link show br-wan105 >/dev/null
docker inspect -f '{{.State.Running}}' dhcp-cpe5 wan-cpe5 | grep -vx true && exit 1 || true
docker exec dhcp-cpe5 ip -4 address show eth1 | grep -q '10\.105\.0\.10/24'
docker exec wan-cpe5 ip -4 address show eth1 | grep -q '10\.105\.0\.20/24'

install -d /var/lib/easymesh-vagrant
date -Ins > /var/lib/easymesh-vagrant/boardfarm.completed-at
printf '%s\n' 'boardfarm-wan-ready' > /var/lib/easymesh-vagrant/boardfarm.status
