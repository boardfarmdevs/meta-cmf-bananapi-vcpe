#!/usr/bin/env bash
set -euo pipefail

: "${BOARDFARM_WORKSPACE:=/home/easymesh/boardfarm-open-0406}"
: "${BF_LAB_CONFIG:=ca-desk6.json}"
: "${BF_INVENTORY:=ca-desk6.json}"
export BOARDFARM_WORKSPACE BF_LAB_CONFIG BF_INVENTORY

lab_repo="$BOARDFARM_WORKSPACE/boardfarm-lab-staging"
bf_lab="$BOARDFARM_WORKSPACE/.venv/bin/bf-lab"

test -x "$bf_lab"
test -f "$lab_repo/lab/$BF_LAB_CONFIG"
test -f "$lab_repo/inventories/$BF_INVENTORY"

boardfarm_ready() {
    test "$(docker ps --format '{{.Names}}' | sort | paste -sd, -)" = \
        dhcp-cpe1,wan-cpe1 \
        && test "$(docker inspect -f '{{.State.Running}}' dhcp-cpe1 wan-cpe1 \
            | grep -c '^true$')" -eq 2 \
        && test "$(docker network inspect wan-cpe1 \
            -f '{{index .Options "com.docker.network.bridge.name"}}')" = br-wan101 \
        && ip link show br-wan101 >/dev/null 2>&1 \
        && docker exec dhcp-cpe1 ip -4 address show eth1 \
            | grep -q '10\.101\.0\.10/24' \
        && docker exec wan-cpe1 ip -4 address show eth1 \
            | grep -q '10\.101\.0\.20/24' \
        && docker exec dhcp-cpe1 pidof kea-dhcp4 >/dev/null \
        && docker exec dhcp-cpe1 pidof kea-dhcp6 >/dev/null
}

wait_boardfarm_ready() {
    local attempt attempts=${1:-20}
    for attempt in $(seq 1 "$attempts"); do
        boardfarm_ready && return 0
        sleep 1
    done
    return 1
}

restart_dhcp_clean() {
    docker container inspect dhcp-cpe1 >/dev/null 2>&1 || return 1
    # Kea stores runtime PID files in the container writable layer. They can
    # survive a Docker stop or appliance power-off even though the recorded
    # processes do not. Remove them immediately before the bounded restart.
    docker exec dhcp-cpe1 sh -c 'rm -f /var/run/kea/*.pid /run/kea/*.pid'
    docker restart dhcp-cpe1 >/dev/null
}

# Docker preserves the two Boardfarm containers and their networks in the
# appliance, but older releases created them without a restart policy.  A
# normal guest reboot must revive that preserved state instead of entering the
# destructive teardown/setup recovery path (which also discards cached
# images).  Starting an already-running container is harmless.
for container in dhcp-cpe1 wan-cpe1; do
    if docker container inspect "$container" >/dev/null 2>&1; then
        docker start "$container" >/dev/null 2>&1 || true
    fi
done

# Give a normally starting preserved container time to launch Kea before
# touching its state. If it does not become ready, repair only the known stale
# PID state and give that single clean restart another bounded interval.
if ! wait_boardfarm_ready 20; then
    restart_dhcp_clean || true
fi
wait_boardfarm_ready 30 || true

if ! boardfarm_ready; then
    # A forced host power-off can leave LXD's volatile state marked RUNNING
    # even though boot.autostart is false. Release br-wan101 before bf-lab
    # removes and recreates that Docker bridge.
    for instance in $(lxc list -c n --format csv 2>/dev/null \
            | grep -E '^wlan-client(-[0-9]{3})?$' | sort -Vr) \
        bpiap-003 bpiap-002 bpiap-001 bpiap bpibroadband; do
        if [ "$(lxc info "$instance" 2>/dev/null | sed -n 's/^Status: //p')" = RUNNING ]; then
            lxc stop "$instance" --force
        fi
    done

    cd "$lab_repo/lab"
    "$bf_lab" teardown,setup,status
fi

# bf-lab status proves the Docker topology, but not that Kea survived a rapid
# second container start during boot. Enforce the service-level postcondition
# here, with one final stale-state repair before declaring reconstruction bad.
if ! wait_boardfarm_ready 60; then
    restart_dhcp_clean || true
    wait_boardfarm_ready 30 || {
        echo 'Boardfarm containers exist but Kea DHCP did not become ready' >&2
        exit 1
    }
fi

# Make Docker perform the fast path itself on subsequent boots.  The explicit
# start above keeps imported appliances made by older releases compatible.
docker update --restart unless-stopped dhcp-cpe1 wan-cpe1 >/dev/null

# Keep an existing controller profile aligned with the selected WAN provider.
# New cold deployments create this parent directly through bpi.sh.
if lxc profile device get bpibroadband eth0 parent >/dev/null 2>&1; then
    lxc profile device set bpibroadband eth0 parent br-wan101
fi

test "$(docker network inspect wan-cpe1 -f '{{index .Options "com.docker.network.bridge.name"}}')" = br-wan101
ip link show br-wan101 >/dev/null
docker inspect -f '{{.State.Running}}' dhcp-cpe1 wan-cpe1 | grep -vx true && exit 1 || true
docker exec dhcp-cpe1 ip -4 address show eth1 | grep -q '10\.101\.0\.10/24'
docker exec wan-cpe1 ip -4 address show eth1 | grep -q '10\.101\.0\.20/24'
test "$(docker ps --format '{{.Names}}' | sort | paste -sd, -)" = \
    dhcp-cpe1,wan-cpe1
boardfarm_ready

install -d /var/lib/easymesh-lab
date -Ins > /var/lib/easymesh-lab/boardfarm.completed-at
printf '%s\n' 'boardfarm-wan-ready' > /var/lib/easymesh-lab/boardfarm.status
