[Unit]
Description=Permit LXD bridge forwarding through Docker's firewall
After=docker.service snap.lxd.daemon.service boardfarm-lab.service
Requires=docker.service boardfarm-lab.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/easymesh-lxd-docker-forward
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
