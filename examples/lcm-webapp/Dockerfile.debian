# Same lcm-webapp content, but glibc-based (debian) instead of musl (alpine).
# Used to test whether the cthulhu "silent daemon dies" issue is
# musl/alpine-specific or affects glibc daemons too.

FROM i386/debian:bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends lighttpd && \
    rm -rf /var/lib/apt/lists/* /var/www/html && \
    mkdir -p /var/www/htdocs

COPY www/             /var/www/htdocs/
COPY lighttpd.conf    /etc/lighttpd/lighttpd.conf
COPY entrypoint.sh    /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
